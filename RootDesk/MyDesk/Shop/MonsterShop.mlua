@Logic
script MonsterShop extends Logic

	property table DevCounters = {}

	property table PaidPromptPending = {}

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		        self.PaidPromptPending = {}
		        _WorldShopService:SetProcessPurchaseCallback(function(info)
		            return self:ProcessPlatformPurchase(info)
		        end)
		        log("[MonsterShop] WorldShop 구매 콜백 등록")
	end

	method table GetProduct(string productId)
		        -- 기존 플랫폼 상품 ID만 재사용하고, 네 상품의 보상 정책은 여기에서 고정한다.
		        local policies = {
		            PRODUCT_A = {name = "성장 코어", price = 0, rewardType = "GROWTH_CORE", amount = 5, limit = 1, resetType = "DAILY"},
		            PRODUCT_D = {name = "성장 점수", price = 0, rewardType = "GROWTH_ESSENCE", amount = 5, limit = 3, resetType = "WEEKLY"},
		            PRODUCT_B = {name = "몬스터 코어 성장권", price = 100, rewardType = "MONSTER_GROWTH_TICKET", amount = 1, limit = 3, resetType = "WEEKLY"},
		            PRODUCT_C = {name = "몬스터 점수 성장권", price = 200, rewardType = "MONSTER_SCORE_GROWTH_TICKET", amount = 1, limit = 5, resetType = "MONTHLY"},
		        }
		        local policy = policies[productId]
		        if policy == nil then return nil end
		        local data = _DataService:GetTable("MonsterProductCatalog")
		        local row = data ~= nil and data:FindRow("ProductId", productId) or nil
		        local result = {
		            id = productId, name = policy.name, productType = "CONSUMABLE",
		            price = policy.price,
		            platformId = policy.price > 0 and row ~= nil and (row:GetItem("PlatformProductId") or "") or "",
		            rewardType = policy.rewardType, rewardId = "",
		            amount = policy.amount, limit = policy.limit, resetType = policy.resetType,
		            enabled = row == nil and policy.price == 0 or row ~= nil and row:GetItem("Enabled") == "1",
		        }
		        if result.amount <= 0 or result.amount > 100000 or result.limit < 0 then return nil end
		        if result.rewardType ~= "MONSTER_GROWTH_TICKET"
		            and result.rewardType ~= "MONSTER_SELECTION_TICKET"
		            and result.rewardType ~= "MONSTER_SCORE_GROWTH_TICKET"
		            and result.rewardType ~= "GROWTH_ESSENCE"
		            and result.rewardType ~= "GROWTH_CORE" then return nil end
		        if result.resetType ~= "NONE" and result.resetType ~= "DAILY"
		            and result.resetType ~= "WEEKLY" and result.resetType ~= "MONTHLY"
		            and result.resetType ~= "ACCOUNT_ONCE" then return nil end
		        return result
	end

	@ExecSpace("ServerOnly")
	method table FindProductByPlatformId(string platformId)
		        if platformId == nil or platformId == "" then return nil end
		        local data = _DataService:GetTable("MonsterProductCatalog")
		        if data == nil then return nil end
		        for i = 1, data:GetRowCount() do
		            local row = data:GetRow(i)
		            local product = self:GetProduct(row:GetItem("ProductId"))
		            if product ~= nil and product.platformId == platformId then return product end
		        end
		        return nil
	end

	@ExecSpace("ServerOnly")
	method integer GetUtcOrdinal(integer year, integer month, integer day)
		        local y = year - 1
		        local ordinal = 365 * y + math.floor(y / 4) - math.floor(y / 100)
		            + math.floor(y / 400)
		        local monthDays = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}
		        if year % 4 == 0 and (year % 100 ~= 0 or year % 400 == 0) then
		            monthDays[2] = 29
		        end
		        for i = 1, month - 1 do ordinal += monthDays[i] end
		        return ordinal + day
	end

	method table GetCatalogProductIds()
		        -- 무료 재료를 먼저, 유료 성장권을 뒤에 표시한다.
		        return {"PRODUCT_A", "PRODUCT_D", "PRODUCT_B", "PRODUCT_C"}
	end

	@ExecSpace("ServerOnly")
	method string GetLimitKey(table product)
		        if product.resetType == "NONE" then return "" end
		        if product.resetType == "ACCOUNT_ONCE" then return product.id .. ":ALL" end
		        local now = DateTime.UtcNow
		        if product.resetType == "DAILY" then
		            return string.format("%s:D:%04d%02d%02d", product.id, now.Year, now.Month, now.Day)
		        end
		        if product.resetType == "MONTHLY" then
		            return string.format("%s:M:%04d%02d", product.id, now.Year, now.Month)
		        end
		        -- Gregorian 일수 기준 UTC 월요일 시작 7일 버킷. 월말에 조기 초기화되지 않는다.
		        local ordinal = self:GetUtcOrdinal(now.Year, now.Month, now.Day)
		        return product.id .. ":W:" .. tostring(math.floor((ordinal - 1) / 7))
	end

	@ExecSpace("ServerOnly")
	method integer GetPurchaseCount(table product, table limits)
		        if limits == nil then return 0 end
		        local count = limits[self:GetLimitKey(product)] or 0
		        -- 이전 정책의 마지막 일/주 구매 기록도 새 기간에 속하면 이월한다.
		        local now = DateTime.UtcNow
		        local ordinal = self:GetUtcOrdinal(now.Year, now.Month, now.Day)
		        if product.id == "PRODUCT_B" and product.resetType == "WEEKLY" then
		            local currentWeek = math.floor((ordinal - 1) / 7)
		            for key, value in pairs(limits) do
		                local stamp = string.match(key, "^PRODUCT_B:D:(%d%d%d%d%d%d%d%d)$")
		                if stamp ~= nil then
		                    local year = tonumber(string.sub(stamp, 1, 4))
		                    local month = tonumber(string.sub(stamp, 5, 6))
		                    local day = tonumber(string.sub(stamp, 7, 8))
		                    if month >= 1 and month <= 12 and day >= 1 and day <= 31 then
		                        local oldOrdinal = self:GetUtcOrdinal(year, month, day)
		                        if oldOrdinal <= ordinal and math.floor((oldOrdinal - 1) / 7) == currentWeek then
		                            count = math.max(count, value)
		                        end
		                    end
		                end
		            end
		        elseif product.id == "PRODUCT_C" and product.resetType == "MONTHLY" then
		            local firstWeek = math.floor((self:GetUtcOrdinal(now.Year, now.Month, 1) - 1) / 7)
		            local currentWeek = math.floor((ordinal - 1) / 7)
		            for key, value in pairs(limits) do
		                local oldWeek = tonumber(string.match(key, "^PRODUCT_C:W:(%d+)$"))
		                if oldWeek ~= nil and oldWeek >= firstWeek and oldWeek <= currentWeek then
		                    count = math.max(count, value)
		                end
		            end
		        end
		        return count
	end

	@ExecSpace("ServerOnly")
	method boolean ProcessReward(string userId, string productId, string purchaseId, boolean platformVerified)
		        if type(userId) ~= "string" or userId == "" or type(purchaseId) ~= "string"
		            or purchaseId == "" or #purchaseId > 160 then return false end
		        local product = self:GetProduct(productId)
		        if product == nil or product.enabled == false then return false end
		        -- 무료 성장권만 서버 발급 영수증으로 청구할 수 있다. 유료 상품은 플랫폼
		        -- 콜백(또는 Maker 개발 테스트)을 거치지 않으면 지급하지 않는다.
		        local freeClaim = product.price == 0 and product.platformId == ""
		            and string.sub(purchaseId, 1, 5) == "FREE:"
		        if platformVerified == false and Environment:IsMakerPlay() == false
		            and freeClaim == false then return false end
		        if platformVerified and product.platformId == "" then return false end
		        local player = _UserService:GetUserEntityByUserId(userId)
		        if not isvalid(player) then return false end
		        ---@type PlayerDBManager
		        local db = player:GetComponent("script.PlayerDBManager")
		        ---@type PlayerCollection
		        local collection = player:GetComponent("script.PlayerCollection")
		        if db == nil or collection == nil or db:IsRogueEconomyReady() == false then return false end
		        local payload = db.RogueSavedPayload
		        if (payload.purchase_receipts or {})[purchaseId] ~= nil then
		            log("[MonsterShop] 중복 지급 거부 id=" .. purchaseId)
		            return false
		        end
		        local limitKey = self:GetLimitKey(product)
		        local oldLimit = limitKey ~= "" and self:GetPurchaseCount(product, payload.purchase_limits) or 0
		        -- A completed platform charge must not become an unpaid entitlement merely
		        -- because two purchase windows raced the server-side limit check.
		        if limitKey ~= "" and oldLimit >= product.limit then
		            if not platformVerified then return false end
		            log_warning("[MonsterShop] 결제 후 한도 경합: 보상은 지급하고 운영 점검 필요 product="
		                .. product.id .. " limit=" .. tostring(product.limit))
		        end
		        local candidate = db:PrepareRogueEconomyPayload()
		        if candidate == nil then return false end
		        candidate.purchase_receipts = candidate.purchase_receipts or {}
		        candidate.purchase_receipt_order = candidate.purchase_receipt_order or {}
		        candidate.purchase_limits = candidate.purchase_limits or {}
		        local oldEssence = collection.MonsterGrowthCurrency
		        local oldCore = collection.MonsterGrowthCore
		        local oldTicket = collection.MonsterSelectionTickets
		        local oldScoreTicket = collection.MonsterEnhancementTickets
		        if product.rewardType == "MONSTER_GROWTH_TICKET"
		            or product.rewardType == "MONSTER_SELECTION_TICKET" then
		            if oldTicket > 2000000000 - product.amount then return false end
		            candidate.monster_selection_tickets = oldTicket + product.amount
		        elseif product.rewardType == "MONSTER_SCORE_GROWTH_TICKET" then
		            if oldScoreTicket > 2000000000 - product.amount then return false end
		            candidate.monster_enhance_tickets = oldScoreTicket + product.amount
		        elseif product.rewardType == "GROWTH_ESSENCE" then
		            if oldEssence > 2000000000 - product.amount then return false end
		            candidate.monster_growth_currency = oldEssence + product.amount
		        else
		            if oldCore > 2000000000 - product.amount then return false end
		            candidate.growth_core = oldCore + product.amount
		        end
		        candidate.purchase_receipts[purchaseId] = productId
		        local order = candidate.purchase_receipt_order
		        order[#order + 1] = purchaseId
		        if limitKey ~= "" then
		            -- 지난 기간 및 이전 정책 버킷을 제거해 구매 제한 기록이 무한히 커지지 않게 한다.
		            for key, _ in pairs(candidate.purchase_limits) do
		                if string.sub(key, 1, #productId + 1) == productId .. ":"
		                    and key ~= limitKey then candidate.purchase_limits[key] = nil end
		            end
		            candidate.purchase_limits[limitKey] = oldLimit + 1
		        end
		        if #order > 256 then
		            -- 표시/순서 원장만 제한한다. 성공 PurchaseId는 재전달 방지를 위해 삭제하지 않는다.
		            table.remove(order, 1)
		        end
		        if db:CommitRogueEconomyPayload(candidate, "상품 지급 " .. productId) == false then return false end
		        if product.rewardType == "MONSTER_GROWTH_TICKET"
		            or product.rewardType == "MONSTER_SELECTION_TICKET" then
		            collection.MonsterSelectionTickets += product.amount
		        elseif product.rewardType == "MONSTER_SCORE_GROWTH_TICKET" then
		            collection.MonsterEnhancementTickets += product.amount
		        elseif product.rewardType == "GROWTH_ESSENCE" then
		            collection.MonsterGrowthCurrency += product.amount
		        else
		            collection.MonsterGrowthCore += product.amount
		        end
		        log("[MonsterShop] 지급 완료 user=" .. userId .. " product=" .. productId
		            .. " purchase=" .. purchaseId)
		        local rewardMessage = product.name .. " ×" .. tostring(product.amount)
		        if product.rewardType == "GROWTH_ESSENCE" then
		            rewardMessage = "성장 점수 " .. tostring(product.amount) .. "개를 획득했습니다."
		        elseif product.rewardType == "GROWTH_CORE" then
		            rewardMessage = "성장 코어 " .. tostring(product.amount) .. "개를 획득했습니다."
		        end
		        self:NotifyPurchaseMessage("구매 완료", rewardMessage, userId)
		        return true
	end

	@ExecSpace("Client")
	method void NotifyPurchaseMessage(string title, string message)
		        if _GateNotice ~= nil then _GateNotice:ShowNotice(title, message) end
	end

	@ExecSpace("ServerOnly")
	method boolean ProcessPlatformPurchase(WorldShopPurchaseInfo info)
		        if info == nil or info.UserId == nil or info.PurchaseId == nil then return false end
		        if self.PaidPromptPending ~= nil then self.PaidPromptPending[info.UserId] = nil end
		        local product = self:FindProductByPlatformId(info.ProductId)
		        if product == nil then return false end
		        local player = _UserService:GetUserEntityByUserId(info.UserId)
		        if not isvalid(player) then return false end
		        local db = player:GetComponent("script.PlayerDBManager")
		        if db == nil or db.IsLoadSuccess == false then return false end
		        local purchaseId = "MSW:" .. info.PurchaseId
		        -- 이미 지급된 콜백은 true로 ACK해 플랫폼 재전달을 끝내되 다시 지급하지 않는다.
		        local priorProductId = (db.RogueSavedPayload.purchase_receipts or {})[purchaseId]
		        if priorProductId ~= nil then return priorProductId == product.id end
		        local delivered = self:ProcessReward(info.UserId, product.id, purchaseId, true)
		        if delivered and not Environment:IsMakerPlay() then
		            _LogStorageService:LogPurchaseInfo(info, "MonsterShop " .. product.id .. " delivered")
		        end
		        if not delivered then
		            self:NotifyPurchaseMessage("구매 실패", "구매를 완료하지 못했습니다.", info.UserId)
		        end
		        return delivered
	end

	@ExecSpace("Server")
	method void RequestDevPurchase(string productId)
		        if Environment:IsMakerPlay() == false then return end
		        if self.DevCounters == nil then self.DevCounters = {} end
		        local n = (self.DevCounters[senderUserId] or 0) + 1
		        self.DevCounters[senderUserId] = n
		        local purchaseId = "DEV:" .. senderUserId .. ":" .. tostring(_UtilLogic.ElapsedSeconds)
		            .. ":" .. tostring(n)
		        if self:ProcessReward(senderUserId, productId, purchaseId, false) == false then
		            self:NotifyPurchaseMessage("구매할 수 없음", "상품 또는 구매 한도를 확인해 주세요.", senderUserId)
		        end
	end

	@ExecSpace("Server")
	method void RequestFreeProduct(string productId)
		        -- 무료 상품만 서버에서 발급한 영수증과 저장된 기간 한도로 지급한다.
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        -- 다른 참가자의 Run 상태와 무관하게, 청구자 본인이 로비에 있을 때만 허용한다.
		        if not isvalid(player) or player.CurrentMap == nil
		            or player.CurrentMap.Name ~= "maptown" then return end
		        local product = self:GetProduct(productId)
		        if product == nil or not product.enabled or product.price ~= 0
		            or product.platformId ~= "" then return end
		        if self.DevCounters == nil then self.DevCounters = {} end
		        local n = (self.DevCounters[senderUserId] or 0) + 1
		        self.DevCounters[senderUserId] = n
		        local purchaseId = "FREE:" .. senderUserId .. ":"
		            .. tostring(_UtilLogic.ElapsedSeconds) .. ":" .. tostring(n)
		        if self:ProcessReward(senderUserId, product.id, purchaseId, false) == false then
		            self:NotifyPurchaseMessage("받을 수 없음", "이번 기간의 무료 횟수 또는 저장 상태를 확인해 주세요.", senderUserId)
		        end
	end

	@ExecSpace("ClientOnly")
	method void RequestCatalogPurchase(string productId)
		        local product = self:GetProduct(productId)
		        if product == nil or product.enabled == false then return end
		        if product.price == 0 and product.platformId == "" then
		            self:RequestFreeProduct(productId)
		        elseif product.platformId ~= "" then
		            self:RequestPaidPurchaseEligibility(productId)
		        end
	end

	@ExecSpace("Server")
	method void RequestPaidPurchaseEligibility(string productId)
		-- 잠금은 상품 조회 중에만 유지한다. 플랫폼 취소는 구매 완료 콜백을 보내지 않는다.
		        local userId = senderUserId
		        local product = self:GetProduct(productId)
		        local player = _UserService:GetUserEntityByUserId(userId)
		        if product == nil or not product.enabled or product.price <= 0
		            or product.platformId == "" or not isvalid(player)
		            or player.CurrentMap == nil or player.CurrentMap.Name ~= "maptown" then
		            log("[MonsterShop] 플랫폼 구매 사전검증 거절 product=" .. tostring(productId)
		                .. " reason=UNAVAILABLE")
		            self:NotifyPurchaseMessage("상품 준비 중", "구매 가능한 상품이 아닙니다.", userId)
		            return
		        end
		        local db = player:GetComponent("script.PlayerDBManager")
		        if db == nil or db:IsRogueEconomyReady() == false
		            or db:PrepareRogueEconomyPayload() == nil then
		            self:NotifyPurchaseMessage("구매할 수 없음", "저장 준비 상태를 확인해 주세요.", userId)
		            return
		        end
		        local key = self:GetLimitKey(product)
		        if key ~= "" and self:GetPurchaseCount(product, db.RogueSavedPayload.purchase_limits) >= product.limit then
		            local limitMessage = "이번 기간의 구매 가능 횟수를 모두 사용했습니다."
		            if product.resetType == "DAILY" then
		                limitMessage = "오늘 구매 가능한 횟수를 모두 사용했습니다."
		            elseif product.resetType == "WEEKLY" then
		                limitMessage = "이번 주 구매 가능한 횟수를 모두 사용했습니다."
		            elseif product.resetType == "MONTHLY" then
		                limitMessage = "이번 달 구매 가능한 횟수를 모두 사용했습니다."
		            end
		            self:NotifyPurchaseMessage("구매 횟수 도달", limitMessage, userId)
		            return
		        end
		        if self.PaidPromptPending == nil then self.PaidPromptPending = {} end
		        local now = _UtilLogic.ElapsedSeconds
		        local pending = self.PaidPromptPending[userId]
		        if pending ~= nil and now - pending < 120 then
		            self:NotifyPurchaseMessage("상품 확인 중", "상품 정보를 확인하고 있습니다. 잠시 후 다시 눌러 주세요.", userId)
		            return
		        end
		        self.PaidPromptPending[userId] = now
		        local platform = _WorldShopService:GetProductAndWait(product.platformId)
		        if platform == nil or platform.Id ~= product.platformId
		            or platform.Name ~= product.name
		            or platform.Type ~= WorldShopProductType.Item
		            or platform.Status ~= WorldShopProductStatus.Ing
		            or platform.Price ~= product.price then
		            self.PaidPromptPending[userId] = nil
		            self:NotifyPurchaseMessage("상품 준비 중", "현재 판매 중인 상품이 아닙니다.", userId)
		            return
		        end
		        log("[MonsterShop] 플랫폼 구매 사전검증 통과 product=" .. product.id
		            .. " price=" .. tostring(platform.Price))
		        self:PromptEligiblePaidPurchase(productId, product.platformId, platform.Price, userId)
		        -- PromptPurchase는 완료/취소를 기다리지 않는 API다. 지급은 별도의 검증된 콜백만 처리한다.
		        self.PaidPromptPending[userId] = nil
	end

	@ExecSpace("Client")
	method void PromptEligiblePaidPurchase(string productId, string platformId, integer serverPrice)
		        local product = self:GetProduct(productId)
		        if product == nil or product.platformId ~= platformId then return end
		        local platform = _WorldShopService:GetProductAndWait(platformId)
		        if platform == nil or platform.Id ~= platformId
		            or platform.Name ~= product.name
		            or platform.Status ~= WorldShopProductStatus.Ing
		            or platform.Type ~= WorldShopProductType.Item
		            or platform.Price ~= product.price
		            or platform.Price ~= serverPrice then
		            if _GateNotice ~= nil then
		                _GateNotice:ShowNotice("상품 준비 중", "플랫폼 상품 정보를 다시 확인해 주세요.")
		            end
		            return
		        end
		        _WorldShopService:PromptPurchase(platformId)
	end

	@ExecSpace("Server")
	method void RequestUseGrowthTicket(string monsterId)
		        -- 기존 호출은 코어 성장권으로 유지한다.
		        self:UseMonsterGrowthTicket(senderUserId, monsterId, "CORE")
	end

	@ExecSpace("Server")
	method void RequestUseMonsterGrowthTicket(string monsterId, string kind)
		        -- 성장권 종류를 클라이언트가 보내도 서버가 소유량·상한을 다시 검증한다.
		        self:UseMonsterGrowthTicket(senderUserId, monsterId, kind)
	end

	@ExecSpace("ServerOnly")
	method void UseMonsterGrowthTicket(string userId, string monsterId, string kind)
		        -- 저장 성공 후에만 선택 몬스터의 성장 단계와 해당 성장권을 갱신한다.
		        if kind ~= "CORE" and kind ~= "SCORE" then return end
		        local player = _UserService:GetUserEntityByUserId(userId)
		        if not isvalid(player) or player.CurrentMap == nil
		            or player.CurrentMap.Name ~= "maptown" or _GameData.RogueRunActive then return end
		        ---@type PlayerCollection
		        local collection = player:GetComponent("script.PlayerCollection")
		        ---@type PlayerDBManager
		        local db = player:GetComponent("script.PlayerDBManager")
		        if collection == nil or db == nil or db:IsRogueEconomyReady() == false then return end
		        local tickets = kind == "CORE" and collection.MonsterSelectionTickets or collection.MonsterEnhancementTickets
		        if tickets < 1 then return end
		        local oldTamed = collection:GetTamedCount(monsterId)
		        local oldLevel = collection:GetMonsterLevel(monsterId)
		        local levelCap = math.max(1, math.floor(_GameData:GetBalance("monster_level_cap")))
		        local oldStage = kind == "CORE" and oldLevel or collection:GetMonsterEnhance(monsterId)
		        local cap = kind == "CORE" and levelCap or math.max(0, math.floor(_GameData:GetBalance("monster_enhance_cap")))
		        -- 클라이언트가 미보유 ID를 보내도 성장권으로 신규 해금할 수 없다.
		        if _GameData:IsTameableMonster(monsterId) == false or oldTamed <= 0
		            or oldLevel <= 0 or oldStage >= cap then return end
		        local candidate = db:PrepareRogueEconomyPayload()
		        if candidate == nil then return end
		        if kind == "CORE" then
		            candidate.monster_levels = candidate.monster_levels or {}
		            candidate.monster_selection_tickets = tickets - 1
		            candidate.monster_levels[monsterId] = oldStage + 1
		        else
		            candidate.monster_enhances = candidate.monster_enhances or {}
		            candidate.monster_enhance_tickets = tickets - 1
		            candidate.monster_enhances[monsterId] = oldStage + 1
		        end
		        if db:CommitRogueEconomyPayload(candidate, "몬스터 성장권 사용 " .. kind) == false then return end
		        if kind == "CORE" then
		            collection.MonsterLevels[monsterId] = oldStage + 1
		            collection.MonsterSelectionTickets -= 1
		        else
		            collection.MonsterEnhances[monsterId] = oldStage + 1
		            collection.MonsterEnhancementTickets -= 1
		        end
		        collection:RefreshPlayerInheritedStats()
		        log("[MonsterShop] 성장권 사용 monster=" .. monsterId
		            .. " kind=" .. kind .. " stage=" .. tostring(oldStage + 1))
	end

end
