-- 임시 로비 상점 UI. 게임 Run HUD에는 버튼을 노출하지 않는다.
@Logic
script MonsterShopUi extends Logic

    property table ButtonEntities = {}
    property table ButtonHandlers = {}
    property any RefreshTimer = nil
    property boolean ShopOpen = false

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self.ButtonEntities = {}
        self.ButtonHandlers = {}
        _TimerService:SetTimerOnce(function()
            self:BindShopUi()
        end, 0.7)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for i = 1, #self.ButtonEntities do
            local entity = self.ButtonEntities[i]
            if isvalid(entity) then
                entity:DisconnectEvent(ButtonClickEvent, self.ButtonHandlers[i])
            end
        end
        self.ButtonEntities = {}
        self.ButtonHandlers = {}
        if self.RefreshTimer ~= nil then
            _TimerService:ClearTimer(self.RefreshTimer)
            self.RefreshTimer = nil
        end
    end

    @ExecSpace("ClientOnly")
    method Entity GetShopUi(string suffix)
        return _EntityService:GetEntityByPath("/ui/PlayerHud/" .. suffix)
    end

    @ExecSpace("ClientOnly")
    method void BindShopButton(string suffix, any fn)
        local entity = self:GetShopUi(suffix)
        if not isvalid(entity) then
            log_warning("[MonsterShopUi] 누락 " .. suffix)
            return
        end
        self.ButtonEntities[#self.ButtonEntities + 1] = entity
        self.ButtonHandlers[#self.ButtonHandlers + 1] = entity:ConnectEvent(ButtonClickEvent, fn)
    end

    @ExecSpace("ClientOnly")
    method void BindShopUi()
        self:BindShopButton("ShopOpenButton", function() self:SetShopOpen(true) end)
        self:BindShopButton("MonsterShopWindow/Dialog/CloseButton", function() self:SetShopOpen(false) end)
        for i = 1, 3 do
            local index = i
            self:BindShopButton("MonsterShopWindow/Dialog/Product" .. tostring(i), function()
                _MonsterShop:RequestCatalogPurchase("PRODUCT_" .. string.char(64 + index))
                self:RefreshShopUi()
            end)
        end
        self:BindShopButton("MonsterShopWindow/Dialog/UseTicketButton", function()
            local player = _UserService.LocalPlayer
            if not isvalid(player) then return end
            local collection = player:GetComponent("script.PlayerCollection")
            if collection == nil or collection.MonsterSelectionTickets < 1 then return end
            self:SetShopOpen(false)
            _EquipPanel:OpenTicketSelection()
        end)
        self:SetShopOpen(false)
        self.RefreshTimer = _TimerService:SetTimerRepeat(function()
            self:RefreshShopUi()
        end, 0.5)
        log("[MonsterShopUi] 로비 상점 UI 준비")
    end

    @ExecSpace("ClientOnly")
    method boolean IsLobby()
        local player = _UserService.LocalPlayer
        return isvalid(player) and isvalid(player.CurrentMap)
            and player.CurrentMap.Name == "maptown" and _GameData.RogueRunActive == false
    end

    @ExecSpace("ClientOnly")
    method void SetShopOpen(boolean open)
        self.ShopOpen = open and self:IsLobby()
        local window = self:GetShopUi("MonsterShopWindow")
        if isvalid(window) then
            window.Enable = self.ShopOpen
            window:SetVisible(self.ShopOpen)
        end
        self:RefreshShopUi()
    end

    @ExecSpace("ClientOnly")
    method void RefreshShopUi()
        local lobby = self:IsLobby()
        local opener = self:GetShopUi("ShopOpenButton")
        if isvalid(opener) then
            opener.Enable = lobby and not self.ShopOpen
            opener:SetVisible(lobby and not self.ShopOpen)
        end
        if not lobby and self.ShopOpen then self:SetShopOpen(false) end
        if not self.ShopOpen then return end
        local player = _UserService.LocalPlayer
        local collection = isvalid(player) and player:GetComponent("script.PlayerCollection") or nil
        for i = 1, 3 do
            local product = _MonsterShop:GetProduct("PRODUCT_" .. string.char(64 + i))
            local card = self:GetShopUi("MonsterShopWindow/Dialog/Product" .. tostring(i))
            if isvalid(card) and isvalid(card.TextGUIRendererComponent) then
                if product == nil then
                    card.Enable = false
                    card.TextGUIRendererComponent.Text = "상품 데이터 미로드"
                else
                    local mode = Environment:IsMakerPlay() and "DEV TEST"
                        or (product.platformId ~= "" and (tostring(product.price) .. " 플랫폼 가격") or "판매 준비 중")
                    local limit = product.resetType == "NONE" and "제한 없음"
                        or (product.resetType .. " " .. tostring(product.limit) .. "회")
                    card.Enable = product.enabled and (Environment:IsMakerPlay() or product.platformId ~= "")
                    card.TextGUIRendererComponent.Text = product.name .. " · "
                        .. tostring(product.amount) .. "개\n" .. mode .. " · " .. limit
                end
            end
        end
        local useTicket = self:GetShopUi("MonsterShopWindow/Dialog/UseTicketButton")
        if isvalid(useTicket) then
            local tickets = collection ~= nil and collection.MonsterSelectionTickets or 0
            useTicket.Enable = tickets > 0
            useTicket.TextGUIRendererComponent.Text = "몬스터 선택권 사용 · 보유 " .. tostring(tickets)
        end
        local status = self:GetShopUi("MonsterShopWindow/Dialog/StatusText")
        if isvalid(status) and isvalid(status.TextGUIRendererComponent) then
            status.TextGUIRendererComponent.Text = "성장 정수 "
                .. tostring(collection ~= nil and collection.MonsterGrowthCurrency or 0)
                .. " · 성장 코어 "
                .. tostring(collection ~= nil and collection.MonsterGrowthCore or 0)
        end
    end
end
