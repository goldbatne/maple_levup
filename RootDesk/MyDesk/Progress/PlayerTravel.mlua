-- @서버
--
-- 사망·귀환의 중립적인 이동 책임. Phase 3에서 환생과 생명주기를 분리한다.

@Logic
script PlayerTravel extends Logic

    @ExecSpace("ServerOnly")
    method void ReturnToStart(Entity player, PlayerDBManager db)
        local startRoom = _GameData:GetStartRoom()
        if startRoom == nil then
            log_error("[PlayerTravel] RoomTable에 is_start 방이 없다 — 복귀하지 못했다")
            return
        end
        if startRoom.map_name == "" then
            log_error("[PlayerTravel] 시작방 " .. startRoom.id .. " 에 map_name이 없다")
            return
        end

        if db ~= nil then db.CurrentRoom = startRoom.id end

        local map = player.CurrentMap
        if map ~= nil and map.Name == startRoom.map_name then
            log("[PlayerTravel] 이미 시작방(" .. startRoom.id .. ")에 있다 — 이동 없음")
            return
        end

        log("[PlayerTravel] 시작방 복귀 → " .. startRoom.id .. "(" .. startRoom.map_name .. ")")
        if _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5 and _RoomService:IsInstanceRoom() then
            -- InstanceRoom에서 정적 로비로의 이동은 맵 텔레포트가 아닌 Room 전환이다.
            local userId = player.PlayerComponent.UserId
            local destination = startRoom.map_name
            -- 피격 이벤트의 비-yield 콜백에서 Room 전환을 직접 호출하지 않는다.
            _TimerService:SetTimerOnce(function()
                _RoomService:MoveUsersToStaticRoom({userId}, destination)
            end, 0.1)
            return
        end
        _TeleportService:TeleportToMapPosition(player, Vector3(0, 0, 0), startRoom.map_name)
    end

end
