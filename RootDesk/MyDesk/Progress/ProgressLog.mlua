@Logic
script ProgressLog extends Logic

	property table sessions = {}

	method string Stamp()
		        -- UTC 시각 문자열.
		        --
		        -- ToFormattedString(format)을 쓰지 않고 구성 요소를 직접 조립하는 이유:
		        -- 포맷 문자열 규격(.NET 지정자로 보이지만 확인 못 함)이 틀리면 예외가 나고,
		        -- 그러면 **모든 로그 호출이 죽는다**. Year/Month/... 는 문서화된 int32
		        -- 프로퍼티라 실패할 여지가 없다. 기록이 기록 때문에 게임을 멈추면 안 된다.
		        local n = DateTime.UtcNow
		        return string.format("%04d-%02d-%02dT%02d:%02d:%02dZ",
		            n.Year, n.Month, n.Day, n.Hour, n.Minute, n.Second)
	end

	method table Session(string userId)
		        -- 이 유저의 세션 카운터. 없으면 지금 만든다.
		        --
		        -- Begin()을 못 받은 경우에도 만들어 두는 이유: 로깅이 세션 시작 순서에
		        -- 의존하면, 순서가 어긋난 날 로그가 통째로 비어 원인을 못 찾는다.
		        local s = self.sessions[userId]
		        if s == nil then
		            s = {
		                startedAt = _UtilLogic.ElapsedSeconds,
		                levelUps = 0,
		                captures = 0,
		                gatePasses = 0,
		                rebirths = 0,
		            }
		            self.sessions[userId] = s
		        end
		        return s
	end

	@ExecSpace("ServerOnly")
	method void Emit(string event, string userId, string detail)
		        -- 한 줄 규격. 여기 말고 다른 데서 [PROGRESS]를 찍지 않는다 —
		        -- 형식이 두 곳에 생기면 나중에 걸러낼 때 한쪽이 빠진다.
		        log("[PROGRESS] " .. event
		            .. " | " .. self:Stamp()
		            .. " | t=" .. string.format("%.1f", _UtilLogic.ElapsedSeconds)
		            .. " | user=" .. tostring(userId)
		            .. " | " .. detail)
	end

	@ExecSpace("ServerOnly")
	method void Begin(string userId)
		        -- 세션 시작. 카운터를 새로 깐다.
		        --
		        -- 줄을 찍지 않는 이유: 작업지시서가 정한 이벤트는 5종이고 session_start는
		        -- 거기 없다. 시작 시각은 session_end의 dur=로 되돌려준다.
		        self.sessions[userId] = nil
		        self:Session(userId)
	end

	@ExecSpace("ServerOnly")
	method void LevelUp(string userId, integer level)
		        local s = self:Session(userId)
		        s.levelUps = s.levelUps + 1
		        self:Emit("level_up", userId, "lv=" .. tostring(level))
	end

	@ExecSpace("ServerOnly")
	method void Capture(string userId, string monsterId, string skillId, integer owned, boolean byPity)
		        -- 성공한 포획만 남긴다. 실패까지 남기면 처치 수만큼 줄이 늘어나
		        -- 정작 보고 싶은 사건이 묻힌다.
		        local s = self:Session(userId)
		        s.captures = s.captures + 1
		        self:Emit("capture", userId,
		            "monster=" .. monsterId
		            .. " | skill=" .. skillId
		            .. " | owned=" .. tostring(owned)
		            .. " | by=" .. (byPity and "pity" or "roll"))
	end

	@ExecSpace("ServerOnly")
	method void GatePass(string userId, string roomId, string gateType)
		        -- 게이트가 걸린 방을 **실제로 통과했을 때만**. 조건 없는 문은 사건이 아니다.
		        local s = self:Session(userId)
		        s.gatePasses = s.gatePasses + 1
		        self:Emit("gate_pass", userId, "room=" .. roomId .. " | gate=" .. gateType)
	end

	@ExecSpace("ServerOnly")
	method void Rebirth(string userId, integer rebirthCount, integer fromLevel)
		        -- 부르는 쪽이 아직 없다. T7 환생이 확정되는 지점에서 부른다.
		        -- 미리 만들어 두는 이유: 다섯 이벤트가 한 파일에 모여 있어야
		        -- 형식이 갈라지지 않는다.
		        local s = self:Session(userId)
		        s.rebirths = s.rebirths + 1
		        self:Emit("rebirth", userId,
		            "count=" .. tostring(rebirthCount) .. " | from_lv=" .. tostring(fromLevel))
	end

	@ExecSpace("ServerOnly")
	method void SessionEnd(string userId, integer finalLevel)
		        -- 세션 요약. 이 한 줄만 봐도 "이번 판이 어땠나"가 나온다.
		        local s = self:Session(userId)
		        local dur = _UtilLogic.ElapsedSeconds - s.startedAt
		
		        self:Emit("session_end", userId,
		            "dur=" .. string.format("%.1f", dur) .. "s"
		            .. " | final_lv=" .. tostring(finalLevel)
		            .. " | level_ups=" .. tostring(s.levelUps)
		            .. " | captures=" .. tostring(s.captures)
		            .. " | gate_passes=" .. tostring(s.gatePasses)
		            .. " | rebirths=" .. tostring(s.rebirths))
		
		        -- 나간 유저의 카운터는 버린다. 남겨두면 재접속했을 때 이전 세션 수치가
		        -- 이어져 세션 요약이 세션 요약이 아니게 된다.
		        self.sessions[userId] = nil
	end

end