-- @서버 (장착 판정은 서버. 클라는 표시와 요청만 — 개발 규칙 2)
--
-- 슬롯 구조.
--
--   스킬 슬롯 : **차수 + 1칸, 상한 5.** 차수는 전직 레벨에서 나온다 (T18-1).
--               몬스터 스킬과 NPC 스킬이 **합쳐서** 이 칸을 놓고 경쟁한다.
--               무엇을 끼울지가 곧 빌드다.
--
-- ~~직업 스킬 슬롯~~ 은 없다. 직업 자체가 폐기됐다 (2026-08-16).
-- 한동안 환생이 직업을 심고 그 직업에서 스킬을 유도하는 코드가 남아 있어
-- 강타·돌진이 스킬 바에 떴다 — 2026-08-21에 전부 걷어냈다.
--
-- 끼운 것은 SaveRunData.equipped_monster_skills(회차)에, 슬롯 수는 영구에 저장한다.
-- 슬롯 수는 누적하지 않고 차수에서 **매번 다시 계산**한다 — 누적하면 로드가 두 번
-- 돌 때 계속 늘어난다.

@Component
script PlayerSkillSlots extends Component

    -- 몬스터 슬롯 장착 상태. slotIndex(1~) -> skillId. 빈 슬롯은 키가 없다.
    @TargetUserSync property SyncTable<integer, string> MonsterSlots

    -- Mega Area Run의 일회성 스킬 재고. OwnedSkillPool에서 5초마다 복원 추출하며
    -- 같은 SkillID가 여러 칸에 들어갈 수 있다. 성공 사용한 정확한 칸만 소비한다.
    @TargetUserSync property SyncTable<integer, string> RandomSlots
    @TargetUserSync property boolean RandomModeActive = false
    @TargetUserSync property SyncTable<string, integer> OwnedSkillPool
    @TargetUserSync property boolean RunFirstEligibleResolved = false
    @TargetUserSync property number NextSupplyAt = 0

    -- 현재 방에서 얻은 서로 다른 후보는 FIFO로 보존한다. 전환/Run 종료에 정리한다.
    @TargetUserSync property string PendingAbilitySkillId = ""
    @TargetUserSync property string PendingAbilityMonsterId = ""
    @TargetUserSync property integer PendingAbilityRevision = 0
    @TargetUserSync property integer PendingAbilityCount = 0
    property table PendingAbilityQueue = {}
    @TargetUserSync property boolean RogueliteRunActive = false

    -- Phase 2 특성 레거시 값. Phase 3.5 신규 랜덤 전투에서는 읽되 추첨/효과에
    -- 사용하지 않는다. 기능 플래그 OFF인 레거시 비교 모드만 기존 의미를 보존한다.
    @TargetUserSync property string SelectedTrait = "balance"

    @HideFromInspector property integer randomSupplyTimer = 0

    -- 슬롯 수(영구). 확장 2축의 계산 결과를 담는다.
    @TargetUserSync property integer MonsterSlotCount = 1

    -- 확장 2축의 원장. 슬롯 수를 직접 올리지 않고 이 둘을 올린 뒤 재계산한다.
    @TargetUserSync property integer BossesCleared = 0
    @TargetUserSync property integer RebirthCount = 0

    -- 지금까지 **환생한 레벨 중 최고치** (영구). 환생 보상의 유일한 근거다
    -- (설계 변경 2026-08-21).
    --
    -- 왜 횟수가 아니라 최고 레벨인가: 보상이 횟수에 붙으면 Lv1에서 환생을 반복하는 것이
    -- 최적 전략이 된다(몇 분이면 되니까). 최고 레벨에 붙으면 **더 깊이 갔다 돌아와야만**
    -- 오르고, 같은 자리를 반복하는 것은 아무 의미가 없다.
    --
    -- 왜 "마지막 환생 레벨"이 아닌가: 실수로 얕게 환생했을 때 지금까지 쌓은 것이
    -- 날아가면 안 된다. 기록은 내려가지 않는다.
    @TargetUserSync property integer BestRebirthLevel = 0

    -- 지금까지 밟은 **전직 차수의 최고치**. 영구 데이터이고 갱신형이다 (T23-7).
    --
    -- 왜 영구인가 (대표 지시 2026-08-25): **전직 퀘스트는 한 번만 하면 된다.**
    -- 환생하면 레벨이 1로 가지만 이미 마친 전직이 취소되지는 않는다.
    -- 그래서 차수는 레벨에서 유도하되 **한 번 오르면 안 내려간다**.
    @TargetUserSync property integer BestTier = 0

    -- 개방된 구역. areaId -> 1. 환생 게이트가 이 값을 본다 (RoomGate.EvaluateRebirth).
    --
    -- 슬롯과 무관한 값이 왜 여기 있는가: 이 컴포넌트가 이미 **영구 진행 원장**
    -- 노릇을 하고 있다(BossesCleared / RebirthCount). T7의 환생은 세 값을 한꺼번에
    -- 갱신하므로 한곳에 두는 편이 어긋날 여지가 적다. 플레이어에 네 번째 컴포넌트를
    -- 붙이려면 Global/DefaultPlayer.model을 건드려야 하는 것도 이유다.
    -- 영구 진행이 더 커지면 그때 별도 컴포넌트로 떼는 게 맞다.
    @TargetUserSync property SyncTable<string, integer> UnlockedAreas


    -- 클리어한 보스방. roomId -> **마지막으로 깬 회차 번호**(1부터). 영구 데이터다.
    --
    -- BossesCleared(개수)와 따로 두는 이유: 개수만으로는 "이 보스를 이미 잡았는가"를
    -- 알 수 없어 같은 보스를 두 번 잡으면 슬롯이 또 늘어난다.
    -- 원장으로 막고, 개수는 원장에 **처음** 들어갈 때만 올린다.
    --
    -- 값이 1/0 플래그가 아니라 회차 번호인 이유 (T9-1): 보스는 회차당 한 번만 선다.
    -- "언젠가 깼다"(nil 아님)와 "이번 회차에 깼다"(== 지금 회차)를 구분해야 하는데,
    -- 플래그로는 환생 뒤에도 깬 것으로 남아 보스가 영영 안 나온다.
    -- 1회차 클리어가 곧 1이라 예전 저장값과도 그대로 맞는다.
    @TargetUserSync property SyncTable<string, integer> BossRoomsCleared

    -- 스킬 슬롯의 키 배치 (T14-2). "Z,X,C,V,B,N,M" 같은 쉼표 구분 한 줄.
    -- 빈 문자열이면 SkillBar의 기본값을 쓴다.
    --
    -- 왜 여기 있는가: 조작 설정 전용 컴포넌트를 새로 만들면 Global/DefaultPlayer.model을
    -- 건드려야 한다. 슬롯과 슬롯의 키는 인접한 관심사이고, UnlockedAreas가 여기 얹혀 있는
    -- 것과 같은 판단이다 (위 주석 참고). 영구 진행이 더 커지면 그때 함께 떼는 게 맞다.
    --
    -- @TargetUserSync인 이유: 당사자 클라만 알면 된다. SkillBar가 이 값을 읽어 키를 붙인다.
    @TargetUserSync property string KeyOrder = ""

    -- 저장에 들어가는 문자열이라 상한을 둔다.
    -- 키 이름이 열거형 멤버명 그대로여서 길다 ("KeypadMultiply" 14자).
    -- 슬롯 7칸 × 최장 이름 + 쉼표를 넉넉히 덮는 값으로 잡았다.
    property integer keyOrderMaxLength = 200

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 슬롯 수를 직접 대입하지 않고 두 축에서 다시 계산한다 (T8).
        -- 대입하면 PlayerDBManager가 먼저 로드해 채워둔 보스/환생 축을 무시하고
        -- 시작값으로 되돌려버린다 — 컴포넌트 OnBeginPlay 순서는 정해져 있지 않다.
        -- RecomputeSlotCount는 축에서 유도하므로 언제 돌든 결과가 같다.
        self:RecomputeSlotCount()
        self:InitializeRuntimeSkills()
        log("[SkillSlots] 초기화  몬스터 슬롯 " .. tostring(self.MonsterSlotCount)
            .. "/" .. tostring(math.floor(_GameData:GetBalance("monster_slot_max"))))
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        -- 랜덤 공급 타이머가 맵 이동/스크립트 리로드 뒤에 남지 않게 정리한다.
        self:StopRandomSkillSupply()
    end

    @ExecSpace("ServerOnly")
    method void StopRandomSkillSupply()
        if self.randomSupplyTimer ~= 0 then
            _TimerService:ClearTimer(self.randomSupplyTimer)
            self.randomSupplyTimer = 0
        end
    end

    method boolean IsPhase1CombatEnabled()
        -- 오래된 호출부를 위한 별칭. 신규 작업본에서는 roguelite_run_mode_enabled가
        -- 우선하며, 레거시 비교본에서만 예전 Phase 1 플래그를 읽는다.
        if _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5 then return true end
        return _GameData:GetBalance("phase1_random_combat_enabled") >= 0.5
    end

    method boolean IsRogueliteRunMode()
        -- 원본 프로젝트가 최종 로그라이트 구조로 전환됐으므로 신규 전투가 기본값이다.
        -- imported DataSet 로드 순서 때문에 첫 프레임에 0이 보이더라도 구형 5초 공급
        -- 타이머를 시작하지 않는다.
        return true
    end

    method integer GetSkillSlotMax()
        -- 신규 Run 고정 슬롯 상한. UI가 5칸이므로 현재 구현 상한도 5다.
        local n = math.floor(_GameData:GetBalance("run_skill_slot_max"))
        if n < 1 then n = math.floor(_GameData:GetBalance("skill_slot_max")) end
        if n < 1 then return 5 end
        if n > 5 then return 5 end
        return n
    end

    method table GetOwnedActiveSkillIds()
        -- M2A: 동행 선택과 무관하게 테이밍한 모든 액티브 몬스터의 능력을 돌려준다.
        -- ★ 개수는 후보를 복제하지 않으므로 랜덤 Weight에는 영향을 주지 않는다.
        ---@type PlayerCollection
        local collection = self.Entity:GetComponent("script.PlayerCollection")
        if collection == nil then return {} end

        local out = {}
        for _, monsterId in ipairs(_GameData:GetTameableMonsterIds()) do
            local monster = _GameData:GetMonster(monsterId)
            local id = monster ~= nil and monster.drop_skill_id or ""
            local skill = _GameData:GetSkill(id)
            if skill ~= nil
                and skill.source == "monster"
                and skill.slot_type == "monster"
                and skill.skill_kind ~= "passive"
                and collection:GetTamedCount(monsterId) > 0 then
                out[#out + 1] = id
            end
        end
        return out
    end

    method table GetRunOwnedSkillIds()
        local out = {}
        for _, id in ipairs(_GameData:GetCapturableActiveSkillIds()) do
            if self.OwnedSkillPool[id] ~= nil and self.OwnedSkillPool[id] > 0 then out[#out + 1] = id end
        end
        table.sort(out)
        return out
    end

    method boolean HasRunOwnedSkill(string skillId)
        return skillId ~= nil and skillId ~= ""
            and self.OwnedSkillPool[skillId] ~= nil and self.OwnedSkillPool[skillId] > 0
    end

    @ExecSpace("ServerOnly")
    method void ClearRandomSlots()
        -- SyncTable은 # 길이에 의존하지 않고 실제 슬롯 범위를 전부 비운다.
        for i = 1, self:GetSkillSlotMax() do
            self.RandomSlots[i] = nil
        end
    end

    @ExecSpace("ServerOnly")
    method string PickRandomOwnedActive(table pool)
        -- 복원 추출. 신규 랜덤 전투에서는 모든 보유 액티브 종이 정확히 Weight 1이다.
        -- 보유 장수는 후보를 복제하지 않으며 슬롯 안 중복은 매 추첨의 독립 결과다.
        if pool == nil or #pool <= 0 then return "" end
        local total = 0
        local scaled = {}
        for i = 1, #pool do
            local weight = self:GetSkillSupplyWeight(pool[i], self.SelectedTrait)
            local units = math.max(1, math.floor(weight * 1000 + 0.5))
            scaled[i] = units
            total += units
        end
        local roll = _UtilLogic:RandomIntegerRange(1, total)
        local cursor = 0
        for i = 1, #pool do
            cursor += scaled[i]
            if roll <= cursor then return pool[i] end
        end
        return pool[#pool]
    end

    method string NormalizeTraitId(string traitId)
        if traitId == nil or traitId == "" or _GameData:GetTrait(traitId) == nil then
            return "balance"
        end
        return traitId
    end

    method boolean SkillMatchesTrait(string skillId, string traitId)
        local trait = _GameData:GetTrait(self:NormalizeTraitId(traitId))
        if trait == nil or trait.preferred_tags == nil or #trait.preferred_tags <= 0 then return false end
        local tags = _GameData:GetSkillTags(skillId)
        for i = 1, #tags do
            for j = 1, #trait.preferred_tags do
                if tags[i] == trait.preferred_tags[j] then return true end
            end
        end
        return false
    end

    method number GetSkillSupplyWeight(string skillId, string traitId)
        if self:IsPhase1CombatEnabled() then return 1 end
        local trait = _GameData:GetTrait(self:NormalizeTraitId(traitId))
        if trait == nil or self:SkillMatchesTrait(skillId, trait.id) == false then return 1 end
        return math.max(0.01, trait.weight_multiplier)
    end

    method number GetTraitEffectMultiplierForSkill(string skillId)
        -- Phase 3.5: 신규 전투에서 Trait는 완전 비활성이다. 기존 데이터와 호출부는
        -- 세이브/레거시 호환을 위해 남기되 어떤 액티브에도 성능 배율을 주지 않는다.
        if self:IsPhase1CombatEnabled() then return 1 end
        if _GameData:IsCapturableMonsterSkill(skillId) == false then return 1 end
        local trait = _GameData:GetTrait(self:NormalizeTraitId(self.SelectedTrait))
        if trait == nil or self:SkillMatchesTrait(skillId, trait.id) == false then return 1 end
        return math.max(1, trait.effect_multiplier)
    end

    method boolean CanChangeTrait()
        -- 초기 구현의 안전 상태는 전투가 없는 시작 마을 하나로 명확히 한정한다.
        local map = self.Entity.CurrentMap
        local start = _GameData:GetStartRoom()
        if map == nil or start == nil then return false end
        return map.Name == start.map_name
    end

    @ExecSpace("Server")
    method void RequestSetTrait(string traitId)
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if self:IsPhase1CombatEnabled() then
            log_warning("[Trait] 신규 랜덤 전투에서는 특성 선택을 사용하지 않는다")
            return
        end
        self:SetTrait(traitId)
    end

    @ExecSpace("ServerOnly")
    method boolean SetTrait(string traitId)
        if self:IsPhase1CombatEnabled() then
            log_warning("[Trait] 신규 랜덤 전투에서는 레거시 특성을 변경하지 않는다")
            return false
        end
        local normalized = self:NormalizeTraitId(traitId)
        if _GameData:GetTrait(traitId) == nil then
            log_warning("[Trait] 존재하지 않는 특성: " .. tostring(traitId))
            return false
        end
        if self:CanChangeTrait() == false then
            log_warning("[Trait] 특성은 시작 마을에서만 바꿀 수 있다")
            return false
        end
        if self.SelectedTrait == normalized then return true end
        self.SelectedTrait = normalized
        -- 현재 5칸은 그대로 둔다. 다음 5초 공급부터 새 가중치를 읽는다.
        self:MarkSavePerm("특성 변경")
        log("[Trait] 선택 " .. normalized .. " — 현재 손패 유지, 다음 공급부터 적용")
        return true
    end

    method void DebugDescribeTraitWeights(string traitId)
        -- Maker 콘솔에서 보유 풀의 태그·기본/최종 가중치·정규화 확률을 확인한다.
        local pool = self:GetOwnedActiveSkillIds()
        local total = 0
        for i = 1, #pool do total += self:GetSkillSupplyWeight(pool[i], traitId) end
        log("[TraitDebug] trait=" .. self:NormalizeTraitId(traitId)
            .. " pool=" .. tostring(#pool) .. " totalWeight=" .. string.format("%.2f", total))
        for i = 1, #pool do
            local tags = _GameData:GetSkillTags(pool[i])
            local weight = self:GetSkillSupplyWeight(pool[i], traitId)
            local chance = total > 0 and weight / total * 100 or 0
            log("[TraitDebug] " .. pool[i] .. " tags=" .. table.concat(tags, "|")
                .. " base=1.00 final=" .. string.format("%.2f", weight)
                .. " chance=" .. string.format("%.4f", chance) .. "%")
        end
    end

    @ExecSpace("ServerOnly")
    method table DebugSampleTrait(string traitId, integer iterations)
        -- 실제 포획 경로가 있는 66종 전체를 대상으로 서버 RNG를 표본 추출한다.
        -- 10,000회 검증이 한 프레임에서 끝나도록 누적 가중치는 한 번만 만든다.
        local pool = _GameData:GetCapturableActiveSkillIds()
        local counts = {}
        if iterations < 1 then iterations = 10000 end

        local cumulative = {}
        local total = 0
        for i = 1, #pool do
            local units = math.max(1, math.floor(self:GetSkillSupplyWeight(pool[i], traitId) * 1000 + 0.5))
            total += units
            cumulative[i] = total
        end
        for i = 1, iterations do
            local roll = _UtilLogic:RandomIntegerRange(1, total)
            local index = 1
            while index < #pool and roll > cumulative[index] do index += 1 end
            local id = pool[index]
            counts[id] = (counts[id] or 0) + 1
        end
        log("[TraitSample] " .. self:NormalizeTraitId(traitId) .. " "
            .. tostring(iterations) .. "회 / 후보 " .. tostring(#pool) .. "종")
        return counts
    end

    @ExecSpace("ServerOnly")
    method void DebugStartTraitSample(string traitId, integer iterations)
        -- Maker 실행 스크립트의 한 프레임 예산을 넘지 않도록 500회씩 나눠 집계한다.
        local normalized = self:NormalizeTraitId(traitId)
        local pool = _GameData:GetCapturableActiveSkillIds()
        if iterations < 1 then iterations = 10000 end

        local tickets = {}
        for i = 1, #pool do
            local ticketCount = math.max(1, math.floor(self:GetSkillSupplyWeight(pool[i], normalized) * 10 + 0.5))
            for k = 1, ticketCount do tickets[#tickets + 1] = pool[i] end
        end

        local counts = {}
        local remaining = iterations
        local timer = 0
        timer = _TimerService:SetTimerRepeat(function()
            local batch = math.min(500, remaining)
            for i = 1, batch do
                local index = _UtilLogic:RandomIntegerRange(1, #tickets)
                local id = tickets[index]
                counts[id] = (counts[id] or 0) + 1
            end
            remaining -= batch
            if remaining <= 0 then
                _TimerService:ClearTimer(timer)
                local minCount = iterations + 1
                local maxCount = 0
                local zero = 0
                local preferred = 0
                for i = 1, #pool do
                    local n = counts[pool[i]] or 0
                    if n <= 0 then zero += 1 end
                    if n < minCount then minCount = n end
                    if n > maxCount then maxCount = n end
                    if self:SkillMatchesTrait(pool[i], normalized) then preferred += n end
                end
                log("[TraitSampleDone] trait=" .. normalized
                    .. " total=" .. tostring(iterations)
                    .. " candidates=" .. tostring(#pool)
                    .. " preferred=" .. tostring(preferred)
                    .. " min=" .. tostring(minCount)
                    .. " max=" .. tostring(maxCount)
                    .. " zero=" .. tostring(zero))
            end
        end, 0.05)
    end

    @ExecSpace("ServerOnly")
    method void InitializeRuntimeSkills()
        -- Roguelite 전투는 Run마다 빈 고정 슬롯으로 시작한다. 능력은 처치로만 들어오며
        -- 타이머 공급은 생성하지 않는다. 레거시 MonsterSlots는 건드리지 않는다.
        self:StopRandomSkillSupply()
        self:ClearRandomSlots()
        self.PendingAbilitySkillId = ""
        self.PendingAbilityMonsterId = ""
        self.RogueliteRunActive = false
        if self:IsRogueliteRunMode() then
            self.RandomModeActive = true
            log("[SkillSlots] Roguelite 고정 5슬롯 준비 — Run 시작 대기")
            return
        end
        if self:IsPhase1CombatEnabled() == false then
            self.RandomModeActive = false
            return
        end

        local pool = self:GetOwnedActiveSkillIds()
        if #pool <= 0 then
            self.RandomModeActive = false
            log("[SkillSlots] 랜덤 전투 대기  보유 액티브 0종")
            return
        end

        self.RandomModeActive = true
        self:StartRandomSkillSupply()
        log("[SkillSlots] 일회성 스킬 재고 시작  보유 액티브 " .. tostring(#pool)
            .. "종 / 초기 재고 0개")
    end

    @ExecSpace("ServerOnly")
    method void OnOwnedSkillPoolChanged()
        if self:IsRogueliteRunMode() then
            -- 영구 컬렉션은 신규 Run의 시작 전투력을 만들지 않는다.
            return
        end
        -- 포획은 추첨 풀만 넓힌다. 이미 생성된 재고는 다시 뽑거나 밀어내지 않는다.
        -- 첫 액티브를 얻었을 때만 빈 재고의 첫 5초 타이머를 시작한다.
        if self:IsPhase1CombatEnabled() == false then return end
        local pool = self:GetOwnedActiveSkillIds()
        if #pool <= 0 then
            self.RandomModeActive = false
            self:StopRandomSkillSupply()
            self:ClearRandomSlots()
            return
        end

        if self.RandomModeActive == false then
            self.RandomModeActive = true
            self:StartRandomSkillSupply()
            log("[SkillSlots] 첫 액티브 획득 — 5초 공급 시작")
        elseif self.randomSupplyTimer == 0 and self:HasEmptyRandomSlot() then
            self:StartRandomSkillSupply()
        end
    end

    method boolean HasEmptyRandomSlot()
        for i = 1, self:GetSkillSlotMax() do
            if self.RandomSlots[i] == nil or self.RandomSlots[i] == "" then return true end
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method void StartRandomSkillSupply()
        -- 한 번짜리 서버 타이머다. 빈칸 하나를 채운 뒤에도 빈칸이 남으면 다음 5초를
        -- 다시 예약한다. 가득 찬 동안에는 타이머 자체가 없고, 소비 순간부터 새로 센다.
        self:StopRandomSkillSupply()
        if self:IsPhase1CombatEnabled() == false then return end
        if self.RandomModeActive == false then return end
        if self:HasEmptyRandomSlot() == false then return end
        local pool = self:IsRogueliteRunMode() and self:GetRunOwnedSkillIds() or self:GetOwnedActiveSkillIds()
        if #pool <= 0 then return end

        local interval = _GameData:GetBalance("run_skill_supply_interval")
        if self:IsRogueliteRunMode() == false then interval = _GameData:GetBalance("random_skill_supply_interval") end
        if interval <= 0 then interval = 5 end
        self.NextSupplyAt = _UtilLogic.ElapsedSeconds + interval
        self.randomSupplyTimer = _TimerService:SetTimerOnce(function()
            self.randomSupplyTimer = 0
            self.NextSupplyAt = 0
            self:SupplyOneRandomSkill()
            self:StartRandomSkillSupply()
        end, interval)
    end

    @ExecSpace("ServerOnly")
    method boolean SupplyOneRandomSkill()
        -- 전체 OwnedSkills 액티브 풀에서 복원 추출해 앞쪽 빈칸 하나만 채운다.
        if self:IsPhase1CombatEnabled() == false then return false end
        if self.RandomModeActive == false then return false end

        local pool = self:IsRogueliteRunMode() and self:GetRunOwnedSkillIds() or self:GetOwnedActiveSkillIds()
        if #pool <= 0 then return false end

        for i = 1, self:GetSkillSlotMax() do
            if self.RandomSlots[i] == nil or self.RandomSlots[i] == "" then
                local id = ""
                if self:IsRogueliteRunMode() then
                    id = pool[_GameData:RogueStreamNextInt("supply:" .. self.Entity.PlayerComponent.UserId, #pool)]
                else
                    id = self:PickRandomOwnedActive(pool)
                end
                if id ~= "" then
                    self.RandomSlots[i] = id
                    log("[SkillSlots] 랜덤 공급  " .. tostring(i) .. "번 ← " .. id)
                    return true
                end
                return false
            end
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method boolean ConsumeRandomSlot(integer slotIndex, string expectedSkillId)
        -- 실행에 성공한 요청만 자신이 사용한 정확한 칸을 소비한다.
        if self:IsPhase1CombatEnabled() == false or self.RandomModeActive == false then return false end
        if slotIndex < 1 or slotIndex > self:GetSkillSlotMax() then return false end
        if self.RandomSlots[slotIndex] ~= expectedSkillId then
            log_warning("[SkillSlots] 소비 시 슬롯 내용이 달라졌다: " .. tostring(slotIndex)
                .. " expected=" .. tostring(expectedSkillId)
                .. " actual=" .. tostring(self.RandomSlots[slotIndex]))
            return false
        end
        self.RandomSlots[slotIndex] = nil
        -- 가득 찬 재고에는 타이머가 없다. 성공 소비 시점부터 정확히 5초를 다시 센다.
        -- 이미 빈칸을 충전 중이면 기존 공급 시각을 보존한다.
        if self.randomSupplyTimer == 0 then self:StartRandomSkillSupply() end
        log("[SkillSlots] 랜덤 슬롯 소비  " .. tostring(slotIndex) .. "번 ["
            .. tostring(expectedSkillId) .. "]")
        return true
    end

    @ExecSpace("ServerOnly")
    method void BeginRogueliteRun()
        -- 이전 판의 선택 요청을 무효화한다.
        self:ClearPendingAbilities()
        self:ResetRunTransientState()
        self:StopRandomSkillSupply()
        self:ClearRandomSlots()
        self.PendingAbilitySkillId = ""
        self.PendingAbilityMonsterId = ""
        self.RandomModeActive = true
        self.RogueliteRunActive = true
        self.RunFirstEligibleResolved = false
        self.NextSupplyAt = 0
        for _, id in ipairs(_GameData:GetCapturableActiveSkillIds()) do self.OwnedSkillPool[id] = nil end
        log("[SkillSlots] Mega Run 시작 — 빈 랜덤 재고 " .. tostring(self:GetSkillSlotMax()) .. "칸")
    end

    @ExecSpace("ServerOnly")
    method void EndRogueliteRun()
        -- 종료 경로는 모두 이 메서드로 모아 후보와 타이머를 함께 정리한다.
        -- 정상 CLEAR/FAILED는 GameData에서 먼저 정산한다. 그 외 종료는 임시
        -- 발견만 폐기하며, 기존 영구 도감에는 손대지 않는다.
        _GameData:DiscardRogueliteDiscoveries(self.Entity.PlayerComponent.UserId)
        self:ClearPendingAbilities()
        self:ResetRunTransientState()
        self:StopRandomSkillSupply()
        self:ClearRandomSlots()
        self.PendingAbilitySkillId = ""
        self.PendingAbilityMonsterId = ""
        self.RogueliteRunActive = false
        self.RandomModeActive = self:IsRogueliteRunMode()
        self.RunFirstEligibleResolved = false
        self.NextSupplyAt = 0
        for _, id in ipairs(_GameData:GetCapturableActiveSkillIds()) do self.OwnedSkillPool[id] = nil end
        log("[SkillSlots] Roguelite Run 전투 상태 정리")
    end

    method boolean HasRunSkill(string skillId)
        if skillId == nil or skillId == "" then return false end
        for i = 1, self:GetSkillSlotMax() do
            if self.RandomSlots[i] == skillId then return true end
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method boolean OfferRunAbility(string monsterId, string skillId)
        if self:IsRogueliteRunMode() == false or self.RogueliteRunActive == false then return false end
        local skill = _GameData:GetSkill(skillId)
        if skill == nil or skill.source ~= "monster" or skill.slot_type ~= "monster"
            or skill.skill_kind == "passive" then return false end
        -- Run-owned pool은 고유 SkillID 집합이다. 재획득은 장착·강화·즉시 공급을 하지 않는다.
        if self:HasRunOwnedSkill(skillId) then return false end
        self.OwnedSkillPool[skillId] = 1
        if self.randomSupplyTimer == 0 and self:HasEmptyRandomSlot() then self:StartRandomSkillSupply() end
        log("[SkillSlots] Run 능력 풀 추가 " .. skillId .. " (" .. tostring(monsterId) .. ")")
        self:ShowRunAbilityToast(monsterId, skillId, self.Entity.PlayerComponent.UserId)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean TryAcquireRunAbility(string monsterId, string skillId)
        if self.RogueliteRunActive == false or self:HasRunOwnedSkill(skillId) then return false end
        local guaranteed = self.RunFirstEligibleResolved == false
        self.RunFirstEligibleResolved = true
        local chance = guaranteed and 1 or _GameData:GetBalance("run_ability_acquire_rate")
        if chance <= 0 then chance = 0.10 end
        local roll = _GameData:RogueStreamNextDouble("acquisition:" .. self.Entity.PlayerComponent.UserId)
        local acquired = guaranteed or roll < chance
        log("[RunAcquire] monster=" .. monsterId .. " skill=" .. skillId
            .. " first=" .. tostring(guaranteed) .. " roll=" .. string.format("%.5f", roll)
            .. " chance=" .. string.format("%.2f", chance) .. " acquired=" .. tostring(acquired))
        if acquired == false then return false end
        return self:OfferRunAbility(monsterId, skillId)
    end

    @ExecSpace("Client")
    method void ShowRunAbilityToast(string monsterId, string skillId)
        _SkillBar:ShowRunAbilityToast(monsterId, skillId)
    end

    @ExecSpace("Client")
    method void ShowRunAbilityOffer(string monsterId, string skillId)
        local monster = _GameData:GetMonster(monsterId)
        local skill = _GameData:GetSkill(skillId)
        local monsterName = monster ~= nil and monster.name or monsterId
        local skillName = skill ~= nil and skill.name or skillId
        _GateNotice:ShowNotice(monsterName .. " 능력 발견", skillName .. " · 교체할 슬롯을 선택하거나 포기")
    end

    @ExecSpace("Server")
    method void RequestReplacePendingAbility(integer slotIndex, integer expectedRevision)
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if self:IsRogueliteRunMode() == false or self.RogueliteRunActive == false then return end
        if expectedRevision ~= self.PendingAbilityRevision then return end
        if slotIndex < 1 or slotIndex > self:GetSkillSlotMax() then return end
        local skillId = self.PendingAbilitySkillId
        if skillId == "" or self:HasRunSkill(skillId) then return end
        local old = self.RandomSlots[slotIndex]
        self.RandomSlots[slotIndex] = skillId
        self.PendingAbilitySkillId = ""
        self.PendingAbilityMonsterId = ""
        log("[SkillSlots] 능력 교체 " .. tostring(slotIndex) .. "번 "
            .. tostring(old) .. " → " .. skillId)
        self:AdvancePendingAbility()
    end

    @ExecSpace("Server")
    method void RequestDeclinePendingAbility(integer expectedRevision)
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if self.RogueliteRunActive == false or expectedRevision ~= self.PendingAbilityRevision then return end
        if self.PendingAbilitySkillId == "" then return end
        log("[SkillSlots] 능력 포기 " .. self.PendingAbilitySkillId)
        self.PendingAbilitySkillId = ""
        self.PendingAbilityMonsterId = ""
        self:AdvancePendingAbility()
    end

    @ExecSpace("ServerOnly")
    method void AdvancePendingAbility()
        -- 처리한 후보의 토큰은 재전송돼도 다음 후보에 적용되지 않는다.
        self.PendingAbilityRevision += 1
        self.PendingAbilitySkillId = ""
        self.PendingAbilityMonsterId = ""
        while #self.PendingAbilityQueue > 0 do
            local candidate = table.remove(self.PendingAbilityQueue, 1)
            if self:HasRunSkill(candidate.skillId) == false then
                self.PendingAbilitySkillId = candidate.skillId
                self.PendingAbilityMonsterId = candidate.monsterId
                self:ShowRunAbilityOffer(candidate.monsterId, candidate.skillId, self.Entity.PlayerComponent.UserId)
                break
            end
        end
        self.PendingAbilityCount = #self.PendingAbilityQueue
        if self.PendingAbilitySkillId ~= "" then self.PendingAbilityCount += 1 end
    end

    @ExecSpace("ServerOnly")
    method void ClearPendingAbilities()
        -- 후보는 보관함이 아니다. 방을 떠나면 미처리 획득 기회가 만료된다.
        self.PendingAbilityQueue = {}
        self.PendingAbilitySkillId = ""
        self.PendingAbilityMonsterId = ""
        self.PendingAbilityCount = 0
        self.PendingAbilityRevision += 1
    end

    @ExecSpace("ServerOnly")
    method void ResetRunTransientState()
        -- 판 경계에서만 쿨다운/일시 방어를 초기화한다. 슬롯 이동·맵 이동·부활은 호출하지 않는다.
        ---@type PlayerAttack
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if attack ~= nil then
            for _, skillId in ipairs(_GameData:GetAllSkillIds()) do
                attack.SkillReadyAt[skillId] = nil
            end
        end
        ---@type PlayerHit
        local hit = self.Entity:GetComponent("script.PlayerHit")
        if hit ~= nil then
            hit.ShieldRatio = 0
            hit.ShieldUntil = 0
        end
        self:ResetRunCooldownDisplay(self.Entity.PlayerComponent.UserId)
    end

    @ExecSpace("Client")
    method void ResetRunCooldownDisplay()
        -- 서버의 판 경계 통지만 클라이언트 쿨다운 시계를 지운다.
        ---@type PlayerAttack
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if attack ~= nil then attack.clientReadyAt = {} end
    end

    @ExecSpace("ServerOnly")
    method void OnMapLeave(Entity leaveEntity)
        -- 장착 스킬과 SkillID별 쿨다운은 유지하고 선택 후보만 만료한다.
        if self:IsRogueliteRunMode() then self:ClearPendingAbilities() end
    end

    @ExecSpace("Server")
    method void RequestSwapRunSlots(integer firstIndex, integer secondIndex)
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if self:IsRogueliteRunMode() == false or self.RogueliteRunActive == false then return end
        local maxSlot = self:GetSkillSlotMax()
        if firstIndex < 1 or firstIndex > maxSlot or secondIndex < 1 or secondIndex > maxSlot then return end
        local first = self.RandomSlots[firstIndex]
        self.RandomSlots[firstIndex] = self.RandomSlots[secondIndex]
        self.RandomSlots[secondIndex] = first
    end

    @ExecSpace("Server")
    method void RequestSetKeyOrder(string order)
        -- 클라가 키 배치를 바꿔 달라고 요청한다 (T14-2). 저장까지 서버가 한다.
        --
        -- 남의 설정을 못 바꾸게 senderUserId를 확인한다. 조작 설정이라 남용 여지는
        -- 작지만, 클라가 부르는 창구는 전부 같은 규칙으로 막아 둔다.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then
            log_warning("[SkillSlots] 남의 키 설정 변경 시도 차단: " .. tostring(senderUserId))
            return
        end

        -- 키 **이름**의 유효성은 클라가 판정한다. 이름 → KeyboardKey 표가
        -- SkillBar(클라 전용)에 있고, 서버에 같은 표를 복사해 두면 두 곳이 어긋난다.
        -- 서버는 모양만 본다 — 길이와 빈 값. 모르는 이름은 SkillBar가 경고를 남기고 건너뛴다.
        if order == nil then return end
        if string.len(order) > self.keyOrderMaxLength then
            log_warning("[SkillSlots] 키 배치가 너무 길다(" .. tostring(string.len(order))
                .. " > " .. tostring(self.keyOrderMaxLength) .. ") — 무시한다")
            return
        end

        if self.KeyOrder == order then return end   -- 같은 값이면 저장하지 않는다

        self.KeyOrder = order
        log("[SkillSlots] 키 배치 변경 → '" .. order .. "'")
        self:MarkSavePerm("키 배치 변경")
    end

    @ExecSpace("ServerOnly")
    method void MarkSavePerm(string reason)
        -- 슬롯 수·보스 원장·환생 횟수·개방 구역은 영구 데이터다.
        ---@type PlayerDBManager
        local db = self.Entity:GetComponent("script.PlayerDBManager")
        if db == nil then return end
        db:MarkPermDirty(reason)
    end

    @ExecSpace("ServerOnly")
    method void MarkSaveRun(string reason)
        -- 무엇을 끼고 있는지는 회차 데이터다. 환생하면 다시 고른다.
        ---@type PlayerDBManager
        local db = self.Entity:GetComponent("script.PlayerDBManager")
        if db == nil then return end
        db:MarkRunDirty(reason)
    end

    ---------------------------------------------------------------
    -- 슬롯 수 (확장 2축)
    ---------------------------------------------------------------

    @ExecSpace("ServerOnly")
    method void RecomputeSlotCount()
        -- **슬롯 수 = 차수 + 1**, 상한에서 자른다.
        -- 0차 1칸 → 1차 2칸 → 2차 3칸 → 3차 4칸 → 4차 5칸 → 5차 5칸(상한).
        --
        -- +1인 이유 (2026-08-21): 시작이 0차가 되면서 그냥 `차수`로 두면 **시작 슬롯이
        -- 0칸**이 된다. 스킬을 하나도 못 끼우는 상태로 게임이 시작되면 안 된다.
        -- `max(차수, 1)`로 보정하지 않고 +1을 쓰는 것은, 그러면 0차와 1차가 둘 다 1칸이라
        -- **첫 전직에 슬롯 보상이 없어지기** 때문이다. +1이면 전직마다 한 칸씩 열린다
        -- (5차만 상한에 걸려 안 늘어난다).
        --
        -- ## 보스 클리어 축을 뺐다
        --
        -- 원래는 `시작 + 보스클리어수 + 환생횟수`(상한 3)였다. 2026-08-16에 "슬롯은
        -- 환생할 때만 +1"로 정해졌고, 이제 그것을 구현으로 굳힌다. 늘어나는 축이
        -- **차수 하나뿐**이라 "환생하면 한 칸 열린다"가 흐려질 데가 없다.
        --
        -- BossesCleared는 지우지 않는다 — 환생 조건(`Rebirth.Evaluate`)이 누적
        -- 클리어 수를 보고, 게이트(`HasEverClearedBoss`)도 원장을 본다. 슬롯 계산에서만 뺀다.
        --
        -- 누적값이 아니라 "매번 다시 계산"하는 이유는 그대로다: 축마다 +1씩 더하면
        -- 로드가 두 번 돌 때 슬롯이 계속 늘어난다.
        -- 슬롯을 세기 전에 전직 기록부터 올린다 (T23-7). 순서가 바뀌면 전직한 그 순간에는
        -- 아직 옛 차수로 칸을 세고, 다음 갱신 때에야 늘어난다.
        if _GameData:GetBalance("phase3_simplified_growth_enabled") >= 0.5 then
            local randomMax = math.floor(_GameData:GetBalance("skill_slot_max"))
            if randomMax < 1 then randomMax = 5 end
            self.MonsterSlotCount = randomMax
            return
        end
        self:RefreshBestTier()

        local maxSlot = math.floor(_GameData:GetBalance("monster_slot_max"))
        if maxSlot < 1 then maxSlot = 1 end

        local tier = self:GetTier()
        local computed = tier + 1
        if computed > maxSlot then computed = maxSlot end

        if computed ~= self.MonsterSlotCount then
            log("[SkillSlots] 슬롯 " .. tostring(self.MonsterSlotCount) .. " → " .. tostring(computed)
                .. "  (차수 " .. tostring(tier) .. " + 1, 상한 " .. tostring(maxSlot) .. ")")
            self.MonsterSlotCount = computed
            self:TrimOverflow()
        end
    end

    @ExecSpace("ServerOnly")
    method boolean ClearBoss(string roomId)
        -- 보스방 클리어를 원장에 적는다.
        --
        -- ⚠ **더 이상 슬롯을 주지 않는다** (T16-4b). 슬롯은 차수(환생)로만 늘어난다.
        -- 여기서 세는 `BossesCleared`는 **환생 조건**(`Rebirth.Evaluate`)이 읽고,
        -- `BossRoomsCleared` 원장은 **보스 게이트**(`HasEverClearedBoss`)와
        -- 스포너의 "이번 회차에 깼는가"가 읽는다. 둘 다 그대로 필요하다.
        if roomId == nil or roomId == "" then return false end

        local run = self.RebirthCount + 1
        local prev = self.BossRoomsCleared[roomId]
        if prev == run then
            log("[SkillSlots] 이번 회차에 이미 클리어한 보스방: " .. roomId)
            return false
        end

        -- 원장은 회차와 무관하게 갱신한다. 보스가 회차마다 다시 서므로
        -- "이번 회차에 깼는가"를 여기서 기록해야 스포너가 안 세운다.
        self.BossRoomsCleared[roomId] = run

        if prev ~= nil then
            -- 지난 회차에 깬 보스를 또 깼다. 누적 카운터는 이미 올라가 있어 다시 세지 않는다.
            log("[SkillSlots] 보스 재클리어 " .. roomId .. " (" .. tostring(prev) .. "회차에 이미 기록)")
            self:MarkSavePerm("보스 재클리어")
            return true
        end

        self.BossesCleared = self.BossesCleared + 1
        log("[SkillSlots] 보스 클리어 " .. roomId
            .. "  누적 " .. tostring(self.BossesCleared) .. "  (슬롯은 차수로만 늘어난다)")

        self:MarkSavePerm("보스 클리어")
        return true
    end

    -- 실행공간을 비워둔다. 장착 판정은 서버가, 표시는 클라가 같은 값을 본다
    -- (RebirthCount가 @TargetUserSync라 양쪽에서 같은 답이 나온다).
    method integer TierFromLevel()
        -- **이번 회차의 레벨**이 가리키는 차수. 아직 전직하지 않은 값이다.
        --
        --   Lv1~19 = 0차   Lv20 = 1차   Lv30 = 2차   Lv60 = 3차   Lv100 = 4차   Lv200 = 5차
        --
        -- ## 환생 횟수가 아니라 레벨인 이유 (2026-08-21)
        --
        -- 환생이 "얼마든 가능"으로 바뀌면서 차수의 근거가 될 수 없어졌다. 환생을 반복하면
        -- 차수가 공짜로 올라가기 때문이다. 대신 전직 레벨을 밟는 것이 차수의 근거가 된다.
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return 0 end

        local level = stats.Level
        local tier = 0
        -- 표에 있는 만큼만 센다. tier_level_N이 없으면 GetBalance가 0을 주므로 거기서 멈춘다.
        for i = 1, 5 do
            local need = _GameData:GetBalance("tier_level_" .. tostring(i))
            if need <= 0 then break end
            if level >= need then tier = i else break end
        end
        return tier
    end

    method integer GetTier()
        -- 내 전직 차수. 레벨에서 유도하되 **한 번 오르면 안 내려간다** (T23-7).
        --
        -- ## 환생해도 차수가 유지된다 (대표 지시 2026-08-25)
        --
        -- *"전직퀘스트는 한번만 하면 되는거야 따라서 환생하면 전직 차수는 유지되는 형식"*
        --
        -- 환생하면 레벨이 1로 가지만 **이미 마친 전직이 취소되지는 않는다.** 그래서
        -- 영구 기록(`BestTier`)과 이번 회차 레벨(`TierFromLevel`) 중 **큰 쪽**이 내 차수다.
        --
        -- ⚠ 이것이 2026-08-21의 "환생하면 차수가 0으로 떨어진다"를 뒤집는다.
        --   파생: **슬롯도 유지된다**(슬롯 = 차수 + 1). 환생 직후에도 칸이 안 줄어든다.
        --
        -- 레벨 쪽을 여전히 보는 이유: 영구 기록이 비어 있는 기존 세이브와, 아직 저장이
        -- 한 번도 안 돌아간 첫 전직 순간을 같은 식으로 덮는다.
        if _GameData:GetBalance("phase3_simplified_growth_enabled") >= 0.5 then return 0 end
        local byLevel = self:TierFromLevel()
        if self.BestTier > byLevel then return self.BestTier end
        return byLevel
    end

    @ExecSpace("ServerOnly")
    method boolean RefreshBestTier()
        -- 이번 회차 레벨이 기록을 넘었으면 영구 기록을 올린다. 올랐으면 true.
        --
        -- **갱신형이라 내려가지 않는다** — BestRebirthLevel과 같은 규칙이다.
        if _GameData:GetBalance("phase3_simplified_growth_enabled") >= 0.5 then return false end
        local byLevel = self:TierFromLevel()
        if byLevel <= self.BestTier then return false end

        log("[SkillSlots] 전직 차수 갱신 " .. tostring(self.BestTier)
            .. " → " .. tostring(byLevel) .. "차 (영구)")
        self.BestTier = byLevel
        self:MarkSavePerm("전직 차수 갱신")
        return true
    end

    method integer NextTierLevel()
        -- 다음 전직에 필요한 레벨. 이미 최고 차수면 0 (더 오를 데가 없다).
        -- 잠긴 스킬에 "무엇이 부족한지"를 적을 때 쓴다.
        -- `next`는 Lua 전역 함수 이름이라 지역 변수로 가리지 않는다.
        if _GameData:GetBalance("phase3_simplified_growth_enabled") >= 0.5 then return 0 end
        local nextTier = self:GetTier() + 1
        if nextTier > 5 then return 0 end
        local need = _GameData:GetBalance("tier_level_" .. tostring(nextTier))
        if need <= 0 then return 0 end
        return math.floor(need)
    end

    method integer RebirthBonus()
        -- 환생 보너스 단계. **10레벨당 1** (대표 지시 2026-08-23 — 처음엔 5였다).
        -- Lv10에서 환생 → 1, Lv20 → 2, Lv100 → 10.
        -- 5레벨 단위는 스탯이 너무 빨리 불었다 (대표 판정: "스텟이 조금 과한거 같아보였어").
        --
        -- 두 곳이 이 값을 쓴다:
        --   레벨업당 스탯 포인트 = 기본 5 + 이 값        (PlayerStats.GrantLevelPoints)
        --   방마다 몬스터 +N마리(상한 있음)               (RoomSpawner)
        -- 한 창구에서 유도해야 둘이 어긋나지 않는다.
        if _GameData:GetBalance("phase3_simplified_growth_enabled") >= 0.5 then return 0 end
        local unit = _GameData:GetBalance("rebirth_bonus_level_unit")
        if unit <= 0 then return 0 end
        return math.floor(self.BestRebirthLevel / unit)
    end

    method integer LevelForTier(integer tier)
        -- 그 차수가 열리는 레벨. 0차는 처음부터라 1.
        if tier <= 0 then return 1 end
        if tier > 5 then return 0 end
        local need = _GameData:GetBalance("tier_level_" .. tostring(tier))
        if need <= 0 then return 0 end
        return math.floor(need)
    end

    method boolean CanUseTier(string skillId)
        -- 이 스킬을 지금 차수로 장착·사용할 수 있는가. 표에 없는 스킬은 false.
        local skill = _GameData:GetSkill(skillId)
        if skill == nil then return false end
        if _GameData:GetBalance("phase3_simplified_growth_enabled") >= 0.5 then return true end
        return math.floor(skill.tier) <= self:GetTier()
    end

    method boolean IsBossClearedThisRun(string roomId)
        -- 이번 회차에 이 보스방을 깼는가. 지난 회차 기록은 false다.
        if roomId == nil or roomId == "" then return false end
        return self.BossRoomsCleared[roomId] == self.RebirthCount + 1
    end

    -- 실행공간을 비워둔다. 서버는 게이트 판정에, 클라는 잠김 표시에 쓴다.
    method boolean HasEverClearedBoss(string roomId)
        -- **한 번이라도** 이 보스방을 깼는가 (T16-3 보스 게이트).
        --
        -- IsBossClearedThisRun과 갈라 두는 이유: 저 함수는 "이번 회차"를 묻고,
        -- 게이트는 **해금**을 묻는다. 환생했다고 이미 연 문이 다시 잠기면
        -- "성장의 결과로 열린 땅"이 회차마다 도로 닫히는 셈이라 코어와 어긋난다.
        -- BossRoomsCleared는 영구 데이터라 회차와 무관하게 기록이 남는다.
        if roomId == nil or roomId == "" then return false end
        return self.BossRoomsCleared[roomId] ~= nil
    end

    -- 실행공간을 비워둔다. 서버(마을 게이트의 이동 판정)와 클라(선택 목록 그리기)가
    -- 같은 답을 봐야 한다. UnlockedAreas가 @TargetUserSync라 양쪽에서 같은 값이 나온다.
    method boolean IsAreaUnlocked(string areaId)
        -- 이 지역에 들어갈 수 있는가. **지역 진입 판정은 여기 하나만 쓴다** (T12-3).
        --
        -- 두 곳에서 각자 판정하면 한쪽만 고쳤을 때 조용히 뚫린다. 마을 게이트가
        -- 목록을 그릴 때도, 실제로 보낼 때도 이 함수를 부른다.
        if areaId == nil or areaId == "" then return false end
        if _GameData:GetBalance("phase3_simplified_growth_enabled") >= 0.5 then
            return _GameData:GetArea(areaId) ~= nil
        end

        -- 시작 지역처럼 조건 없이 열려 있는 곳은 AreaTable이 그렇게 선언한다.
        local area = _GameData:GetArea(areaId)
        if area ~= nil and area.default_unlocked then return true end

        return self.UnlockedAreas[areaId] ~= nil
    end

    @ExecSpace("Client")
    method void OnSlotExpanded(integer newCount)
        -- "슬롯이 늘었다"를 당사자에게 알린다 (기획서 T6: 성취가 보여야 한다).
        -- 대상 userId는 선언부가 아니라 호출부 마지막 인자로 붙인다 —
        -- 첫 인자로 넘겼다가 [LEA-3032]로 실패한 적이 있다 (RoomPortal 주석 참고).
        log("[SkillSlots] 슬롯 확장 연출  몬스터 슬롯 " .. tostring(newCount) .. "개")

        _GateNotice:ShowNotice("보스 격파!", "몬스터 스킬 슬롯 " .. tostring(newCount) .. "개")

        -- 레벨 캡 도달과 같은 연출을 쓴다. RUID 없이 enum만으로 재생되고
        -- isLoop=false라 알아서 사라진다 (PlayerStats.OnReachedCap과 동일한 근거).
        _ParticleService:PlayBasicParticleAttached(
            BasicParticleType.PillarBurst, self.Entity,
            Vector3(0, 0, 0), 0, Vector3(1.5, 1.5, 1.5), false)
    end

    @ExecSpace("ServerOnly")
    method void TrimOverflow()
        -- 슬롯이 줄어드는 경우(환생 초기화 등)에 범위 밖 장착을 비운다.
        -- 안 비우면 못 쓰는 스킬이 장착된 채로 남아 UI와 실제가 어긋난다.
        local maxSlot = math.floor(_GameData:GetBalance("monster_slot_max"))
        for i = self.MonsterSlotCount + 1, maxSlot do
            if self.MonsterSlots[i] ~= nil then
                log("[SkillSlots] 슬롯 " .. tostring(i) .. " 범위 밖 → 장착 해제")
                self.MonsterSlots[i] = nil
            end
        end
        self:DropUnknownSkills()
    end

    @ExecSpace("ServerOnly")
    method void DropUnknownSkills()
        -- **SkillTable에서 사라진 스킬을 장착 슬롯에서 걷어낸다** (T17-1).
        --
        -- 왜 필요한가 (실측): 몬스터 구성을 헤네시스로 갈아엎으면서 s_mon_slime /
        -- s_mon_skeleton이 표에서 빠졌는데, **옛 세이브의 장착 슬롯에는 그대로 남았다.**
        -- PlayerAttack.UseSkill이 GetSkill(nil)에서 조용히 return false 하기 때문에
        -- 에러 없이 **아무 일도 안 일어나는 죽은 버튼**이 된다 — 제일 찾기 어려운 고장이다.
        --
        -- 컬렉션(OwnedSkills)의 옛 기록은 건드리지 않는다. 표에 없는 id는 어차피
        -- 어디에도 안 뜨고, 지웠다가 나중에 그 몬스터를 되살리면 기록이 사라져 있다.
        local maxSlot = math.floor(_GameData:GetBalance("monster_slot_max"))
        for i = 1, maxSlot do
            local id = self.MonsterSlots[i]
            if id ~= nil and id ~= "" then
                local skill = _GameData:GetSkill(id)
                if skill == nil or skill.source ~= "monster" then
                    log_warning("[SkillSlots] 플레이어 포획 스킬이 아닌 항목이 장착돼 있어 해제한다: "
                        .. tostring(id) .. " (슬롯 " .. tostring(i) .. ")")
                    self.MonsterSlots[i] = nil
                end
            end
        end
    end

    ---------------------------------------------------------------
    -- 보유 스킬 조회
    ---------------------------------------------------------------

    -- ⚠ @ExecSpace를 일부러 붙이지 않았다(= 부르는 쪽에서 실행).
    --   HUD가 같은 목록을 그려야 하는데, 클라에서 따로 조립하면 순서 규칙이
    --   두 곳에 생겨 언젠가 어긋난다. 읽는 값이 전부 @TargetUserSync + GameData라
    --   양쪽에서 같은 결과가 나온다.
    method table GetOwnedSkillIds()
        -- 지금 **보유한** 스킬 전부 (장착 여부와 무관). 열쇠 게이트가 쓴다.
        --
        -- 예전에는 여기가 GetJobSkills였다 — 직업에서 스킬을 유도했다.
        -- 직업이 폐기되면서(2026-08-16) 유도할 것이 없어졌고, 대신 컬렉션이
        -- 몬스터 스킬과 NPC 스킬을 다 들고 있으므로 그것을 그대로 돌려준다.
        ---@type PlayerCollection
        local collection = self.Entity:GetComponent("script.PlayerCollection")
        if collection == nil then return {} end

        local out = {}
        for _, id in ipairs(_GameData:GetMonsterSkillIds()) do
            if collection:GetOwnedCount(id) > 0 then out[#out + 1] = id end
        end
        return out
    end

    ---------------------------------------------------------------
    -- 몬스터 슬롯 (플레이어가 고른다)
    ---------------------------------------------------------------

    @ExecSpace("Server")
    method void RequestEquip(integer slotIndex, string skillId)
        -- 클라 요청 진입점. senderUserId는 서버가 채우므로 위조할 수 없다.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then
            log_warning("[SkillSlots] 남의 슬롯 장착 시도 차단: " .. tostring(senderUserId))
            return
        end
        self:EquipMonsterSkill(slotIndex, skillId)
    end

    @ExecSpace("ServerOnly")
    method boolean EquipMonsterSkill(integer slotIndex, string skillId)
        -- 신규 전투에서는 MonsterSlots가 추첨 풀도 전투 재고도 아니다.
        -- 저장 호환을 위해 값은 보존하되 장착 변경 요청은 받지 않는다.
        if self:IsPhase1CombatEnabled() then
            log_warning("[SkillSlots] 랜덤 전투에서는 스킬을 직접 장착할 수 없다")
            return false
        end

        -- 검증에 실패하면 아무것도 바꾸지 않고 false.
        if slotIndex < 1 or slotIndex > self.MonsterSlotCount then
            log_warning("[SkillSlots] 슬롯 범위 밖: " .. tostring(slotIndex)
                .. " (보유 슬롯 " .. tostring(self.MonsterSlotCount) .. ")")
            return false
        end

        local skill = _GameData:GetSkill(skillId)
        if skill == nil then
            log_warning("[SkillSlots] SkillTable에 없는 스킬: " .. tostring(skillId))
            return false
        end

        if skill.source ~= "monster" then
            log_warning("[SkillSlots] 적 전용 스킬은 장착할 수 없다: " .. skillId)
            return false
        end

        -- ⚠ **패시브는 슬롯을 안 먹는다** (설계 변경 2026-08-29, 대표 지시).
        -- 보유만 해도 항상 켜지므로 끼울 대상이 아니다 — 끼우게 두면 칸을 하나
        -- 잡아먹으면서 아무 일도 안 하고, "무엇을 끼울지가 곧 빌드"라는 핵심 설계가
        -- 그만큼 얇아진다. 지역당 5종 중 2종이 패시브고 나머지 3종이 이 칸을 겨룬다.
        if skill.skill_kind == "passive" then
            log_warning("[SkillSlots] 패시브 스킬은 끼우는 것이 아니다 (보유만 해도 켜진다): "
                .. skillId)
            return false
        end

        -- 슬롯에 끼울 수 있는 것은 `slot_type=monster`뿐이다.
        -- 플레이어가 포획한 몬스터 스킬만 monster 슬롯을 사용한다.
        if skill.slot_type ~= "monster" then
            log_warning("[SkillSlots] 몬스터 슬롯에는 몬스터 스킬만 끼울 수 있다: "
                .. skillId .. " (slot_type=" .. tostring(skill.slot_type) .. ")")
            return false
        end

        -- 보유하지 않은 스킬은 끼울 수 없다.
        ---@type PlayerCollection
        local collection = self.Entity:GetComponent("script.PlayerCollection")
        if collection == nil or collection:GetOwnedCount(skillId) <= 0 then
            log_warning("[SkillSlots] 보유하지 않은 스킬: " .. skillId)
            return false
        end

        -- 차수가 모자라면 못 끼운다 (T16-4a). **보유는 되지만 장착이 안 되는 것**이
        -- 이 설계의 핵심이다 — 상위 차수 스킬을 미리 뺏어 두고 환생으로 여는 것이
        -- 환생의 보상이 된다 (설계 변경 2026-08-16).
        if self:CanUseTier(skillId) == false then
            log_warning("[SkillSlots] 차수 부족: " .. skillId
                .. " (스킬 " .. tostring(math.floor(skill.tier)) .. "차 / 내 차수 "
                .. tostring(self:GetTier()) .. "차)")
            return false
        end

        -- 같은 스킬을 두 슬롯에 중복 장착하지 않는다.
        for i = 1, self.MonsterSlotCount do
            if i ~= slotIndex and self.MonsterSlots[i] == skillId then
                log_warning("[SkillSlots] 이미 " .. tostring(i) .. "번 슬롯에 장착됨: " .. skillId)
                return false
            end
        end

        self.MonsterSlots[slotIndex] = skillId
        log("[SkillSlots] 장착 " .. tostring(slotIndex) .. "번 ← [" .. skill.name .. "]")
        self:MarkSaveRun("장착")
        return true
    end

    @ExecSpace("ServerOnly")
    method void UnequipMonsterSkill(integer slotIndex)
        if self:IsPhase1CombatEnabled() then
            log_warning("[SkillSlots] 랜덤 전투에서는 레거시 장착 슬롯을 해제하지 않는다")
            return
        end
        if self.MonsterSlots[slotIndex] == nil then return end
        self.MonsterSlots[slotIndex] = nil
        log("[SkillSlots] 해제 " .. tostring(slotIndex) .. "번")
        self:MarkSaveRun("장착 해제")
    end

    ---------------------------------------------------------------
    -- 통합 인터페이스 (작업지시서 T5 요청 3: 사용 인터페이스는 통일)
    ---------------------------------------------------------------

    -- 실행공간을 열어둔다. 서버는 판정에, 클라는 HUD에 쓴다.
    method table GetActiveSkills()
        -- Phase 1 플래그가 켜졌으면 보유 종수와 관계없이 일회성 전투 재고만 돌려준다.
        --
        -- 예전에는 직업 스킬을 앞에 붙였다. 직업이 폐기되면서(2026-08-16) 그 줄을 뺐다 —
        -- 안 빼 두는 바람에 환생 후 강타·돌진이 스킬 바에 그대로 떴다(대표 발견 2026-08-21).
        if self:IsPhase1CombatEnabled() then
            local randomOut = {}
            for i = 1, self:GetSkillSlotMax() do
                local id = self.RandomSlots[i]
                if id ~= nil and id ~= "" then randomOut[i] = id end
            end
            return randomOut
        end

        local out = {}
        for i = 1, self.MonsterSlotCount do
            local id = self.MonsterSlots[i]
            if id ~= nil then table.insert(out, id) end
        end
        return out
    end

end
