-- @서버 (장착 판정은 서버. 클라는 표시와 요청만 — 개발 규칙 2)
--
-- 슬롯 구조. 기획서에서 "직업을 선택하는 이유"로 못박은 부분이라 경계를 정확히 지킨다.
--
--   직업 스킬 슬롯 : 고정. 직업 선택 시 자동 장착되고 항상 사용 가능.
--                    몬스터 슬롯을 잠식하지 않는다. 플레이어가 끄고 켤 수 없다.
--   몬스터 스킬 슬롯: 시작 1개, 상한 3. 플레이어가 컬렉션에서 골라 끼운다.
--
-- 두 슬롯은 저장 위치부터 다르다:
--   직업 슬롯 = current_job에서 JobTable로 매번 유도한다 (별도 저장 없음).
--   몬스터 슬롯 = SaveRunData.equipped_monster_skills (회차 데이터).
-- 이렇게 두면 "직업 스킬이 몬스터 슬롯을 차지하는" 실수가 구조적으로 불가능하다.
--
-- 슬롯 수는 영구 데이터다. 확장 2축(보스 클리어=공간, 환생=회차)이 같은 값을
-- 중복으로 올리지 않도록 축별 카운터를 따로 두고 슬롯 수는 매번 다시 계산한다 (기획서 4.3).

@Component
script PlayerSkillSlots extends Component

    -- 몬스터 슬롯 장착 상태. slotIndex(1~) -> skillId. 빈 슬롯은 키가 없다.
    @TargetUserSync property SyncTable<integer, string> MonsterSlots

    -- 슬롯 수(영구). 확장 2축의 계산 결과를 담는다.
    @TargetUserSync property integer MonsterSlotCount = 1

    -- 확장 2축의 원장. 슬롯 수를 직접 올리지 않고 이 둘을 올린 뒤 재계산한다.
    @TargetUserSync property integer BossesCleared = 0
    @TargetUserSync property integer RebirthCount = 0

    -- 개방된 구역. areaId -> 1. 환생 게이트가 이 값을 본다 (RoomGate.EvaluateRebirth).
    --
    -- 슬롯과 무관한 값이 왜 여기 있는가: 이 컴포넌트가 이미 **영구 진행 원장**
    -- 노릇을 하고 있다(BossesCleared / RebirthCount). T7의 환생은 세 값을 한꺼번에
    -- 갱신하므로 한곳에 두는 편이 어긋날 여지가 적다. 플레이어에 네 번째 컴포넌트를
    -- 붙이려면 Global/DefaultPlayer.model을 건드려야 하는 것도 이유다.
    -- 영구 진행이 더 커지면 그때 별도 컴포넌트로 떼는 게 맞다.
    @TargetUserSync property SyncTable<string, integer> UnlockedAreas

    -- 해금된 직업. jobId -> 1. 랜드마크의 job 보상이 여기 쌓인다 (기획서 4.5).
    --
    -- 시작 직업(JobTable.is_starter)은 여기 없어도 항상 고를 수 있다.
    -- 저장에 넣으면 "해금"의 의미가 흐려지고, 시트에서 시작 직업을 바꿨을 때
    -- 옛 값이 남아 어긋난다. 해금은 **추가로 열린 것**만 담는다.
    @TargetUserSync property SyncTable<string, integer> UnlockedJobs

    -- 클리어한 보스방. roomId -> **마지막으로 깬 회차 번호**(1부터). 영구 데이터다.
    --
    -- BossesCleared(개수)와 따로 두는 이유: 개수만으로는 "이 보스를 이미 잡았는가"를
    -- 알 수 없어 같은 보스를 두 번 잡으면 슬롯이 또 늘어난다.
    -- 원장으로 막고, 개수는 원장에 **처음** 들어갈 때만 올린다.
    --
    -- 값이 1/0 플래그가 아니라 회차 번호인 이유 (T9-1): 보스는 회차당 한 번만 선다.
    -- "언젠가 깼다"(nil 아님)와 "이번 회차에 깼다"(== 지금 회차)를 구분해야 하는데,
    -- 플래그로는 환생 뒤에도 깬 것으로 남아 보스가 영영 안 나온다.
    -- 1회차 클리어가 곧 1이라 예전 저장값과도 그대로 맞는다.
    @TargetUserSync property SyncTable<string, integer> BossRoomsCleared

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 슬롯 수를 직접 대입하지 않고 두 축에서 다시 계산한다 (T8).
        -- 대입하면 PlayerDBManager가 먼저 로드해 채워둔 보스/환생 축을 무시하고
        -- 시작값으로 되돌려버린다 — 컴포넌트 OnBeginPlay 순서는 정해져 있지 않다.
        -- RecomputeSlotCount는 축에서 유도하므로 언제 돌든 결과가 같다.
        self:RecomputeSlotCount()
        log("[SkillSlots] 초기화  몬스터 슬롯 " .. tostring(self.MonsterSlotCount)
            .. "/" .. tostring(math.floor(_GameData:GetBalance("monster_slot_max"))))
    end

    @ExecSpace("ServerOnly")
    method void MarkSavePerm(string reason)
        -- 슬롯 수·보스 원장·환생 횟수·개방 구역은 영구 데이터다.
        ---@type PlayerDBManager
        local db = self.Entity:GetComponent("script.PlayerDBManager")
        if db == nil then return end
        db:MarkPermDirty(reason)
    end

    @ExecSpace("ServerOnly")
    method void MarkSaveRun(string reason)
        -- 무엇을 끼고 있는지는 회차 데이터다. 환생하면 다시 고른다.
        ---@type PlayerDBManager
        local db = self.Entity:GetComponent("script.PlayerDBManager")
        if db == nil then return end
        db:MarkRunDirty(reason)
    end

    ---------------------------------------------------------------
    -- 슬롯 수 (확장 2축)
    ---------------------------------------------------------------

    @ExecSpace("ServerOnly")
    method void RecomputeSlotCount()
        -- 시작값 + 보스 축 + 환생 축, 상한에서 자른다.
        -- 슬라이스 사다리: 시작 1 → 첫 보스 2 → 첫 환생 3 (기획서 4.3).
        --
        -- 누적값이 아니라 "매번 다시 계산"하는 이유: 축마다 +1씩 더하는 방식이면
        -- 같은 보스를 두 번 클리어하거나 로드가 두 번 돌 때 슬롯이 계속 늘어난다.
        local start = math.floor(_GameData:GetBalance("monster_slot_start"))
        local maxSlot = math.floor(_GameData:GetBalance("monster_slot_max"))

        local computed = start + self.BossesCleared + self.RebirthCount
        if computed > maxSlot then computed = maxSlot end

        if computed ~= self.MonsterSlotCount then
            log("[SkillSlots] 슬롯 " .. tostring(self.MonsterSlotCount) .. " → " .. tostring(computed)
                .. "  (시작 " .. tostring(start) .. " + 보스 " .. tostring(self.BossesCleared)
                .. " + 환생 " .. tostring(self.RebirthCount) .. ", 상한 " .. tostring(maxSlot) .. ")")
            self.MonsterSlotCount = computed
            self:TrimOverflow()
        end
    end

    @ExecSpace("ServerOnly")
    method boolean ClearBoss(string roomId)
        -- 보스방을 처음 클리어했을 때만 슬롯 축을 올린다.
        -- 이미 잡은 보스면 아무것도 하지 않고 false (기획서 T6: 중복 지급 안 됨).
        if roomId == nil or roomId == "" then return false end

        local run = self.RebirthCount + 1
        local prev = self.BossRoomsCleared[roomId]
        if prev == run then
            log("[SkillSlots] 이번 회차에 이미 클리어한 보스방: " .. roomId)
            return false
        end

        -- 원장은 회차와 무관하게 갱신한다. 보스가 회차마다 다시 서므로
        -- "이번 회차에 깼는가"를 여기서 기록해야 스포너가 안 세운다.
        self.BossRoomsCleared[roomId] = run

        if prev ~= nil then
            -- 지난 회차에 깬 보스를 또 깼다. 슬롯 축은 이미 올라가 있어 다시 주지 않는다
            -- (기획서 T6: 중복 지급 없음). 회차 표시만 갱신하고 끝낸다.
            log("[SkillSlots] 보스 재클리어 " .. roomId .. " (" .. tostring(prev)
                .. "회차에 이미 지급) — 슬롯 지급 없음")
            self:MarkSavePerm("보스 재클리어")
            return true
        end

        local before = self.MonsterSlotCount
        self.BossesCleared = self.BossesCleared + 1
        self:RecomputeSlotCount()

        log("[SkillSlots] 보스 클리어 " .. roomId
            .. "  슬롯 " .. tostring(before) .. " → " .. tostring(self.MonsterSlotCount))

        -- 슬롯이 실제로 늘었을 때만 알린다. 상한(3)에 걸려 그대로면 축하할 게 없다.
        if self.MonsterSlotCount > before then
            self:OnSlotExpanded(self.MonsterSlotCount, self.Entity.PlayerComponent.UserId)
        end

        self:MarkSavePerm("보스 클리어")
        return true
    end

    -- 실행공간을 비워둔다. 서버 스포너가 "세울까"를 묻고, 클라도 같은 값을 본다
    -- (BossRoomsCleared / RebirthCount 둘 다 @TargetUserSync).
    method boolean IsBossClearedThisRun(string roomId)
        -- 이번 회차에 이 보스방을 깼는가. 지난 회차 기록은 false다.
        if roomId == nil or roomId == "" then return false end
        return self.BossRoomsCleared[roomId] == self.RebirthCount + 1
    end

    @ExecSpace("Client")
    method void OnSlotExpanded(integer newCount)
        -- "슬롯이 늘었다"를 당사자에게 알린다 (기획서 T6: 성취가 보여야 한다).
        -- 대상 userId는 선언부가 아니라 호출부 마지막 인자로 붙인다 —
        -- 첫 인자로 넘겼다가 [LEA-3032]로 실패한 적이 있다 (RoomPortal 주석 참고).
        log("[SkillSlots] 슬롯 확장 연출  몬스터 슬롯 " .. tostring(newCount) .. "개")

        _GateNotice:ShowNotice("보스 격파!", "몬스터 스킬 슬롯 " .. tostring(newCount) .. "개")

        -- 레벨 캡 도달과 같은 연출을 쓴다. RUID 없이 enum만으로 재생되고
        -- isLoop=false라 알아서 사라진다 (PlayerStats.OnReachedCap과 동일한 근거).
        _ParticleService:PlayBasicParticleAttached(
            BasicParticleType.PillarBurst, self.Entity,
            Vector3(0, 0, 0), 0, Vector3(1.5, 1.5, 1.5), false)
    end

    @ExecSpace("ServerOnly")
    method void TrimOverflow()
        -- 슬롯이 줄어드는 경우(환생 초기화 등)에 범위 밖 장착을 비운다.
        -- 안 비우면 못 쓰는 스킬이 장착된 채로 남아 UI와 실제가 어긋난다.
        local maxSlot = math.floor(_GameData:GetBalance("monster_slot_max"))
        for i = self.MonsterSlotCount + 1, maxSlot do
            if self.MonsterSlots[i] ~= nil then
                log("[SkillSlots] 슬롯 " .. tostring(i) .. " 범위 밖 → 장착 해제")
                self.MonsterSlots[i] = nil
            end
        end
    end

    ---------------------------------------------------------------
    -- 직업 슬롯 (고정, 자동)
    ---------------------------------------------------------------

    -- ⚠ @ExecSpace를 일부러 붙이지 않았다(= 부르는 쪽에서 실행).
    --   HUD가 같은 목록을 그려야 하는데, 클라에서 따로 조립하면 순서 규칙이
    --   두 곳에 생겨 언젠가 어긋난다. 읽는 값이 전부 @TargetUserSync + GameData라
    --   양쪽에서 같은 결과가 나온다.
    method table GetJobSkills()
        -- 직업 스킬은 저장하지 않고 current_job에서 매번 유도한다.
        -- 저장해두면 JobTable을 고쳤을 때 옛 값이 남아 어긋난다.
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil or stats.CurrentJob == "" then return {} end

        local job = _GameData:GetJob(stats.CurrentJob)
        if job == nil then
            log_warning("[SkillSlots] JobTable에 없는 직업: " .. tostring(stats.CurrentJob))
            return {}
        end
        return job.skill_ids
    end

    ---------------------------------------------------------------
    -- 몬스터 슬롯 (플레이어가 고른다)
    ---------------------------------------------------------------

    @ExecSpace("Server")
    method void RequestEquip(integer slotIndex, string skillId)
        -- 클라 요청 진입점. senderUserId는 서버가 채우므로 위조할 수 없다.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then
            log_warning("[SkillSlots] 남의 슬롯 장착 시도 차단: " .. tostring(senderUserId))
            return
        end
        self:EquipMonsterSkill(slotIndex, skillId)
    end

    @ExecSpace("ServerOnly")
    method boolean EquipMonsterSkill(integer slotIndex, string skillId)
        -- 검증에 실패하면 아무것도 바꾸지 않고 false.
        if slotIndex < 1 or slotIndex > self.MonsterSlotCount then
            log_warning("[SkillSlots] 슬롯 범위 밖: " .. tostring(slotIndex)
                .. " (보유 슬롯 " .. tostring(self.MonsterSlotCount) .. ")")
            return false
        end

        local skill = _GameData:GetSkill(skillId)
        if skill == nil then
            log_warning("[SkillSlots] SkillTable에 없는 스킬: " .. tostring(skillId))
            return false
        end

        -- 직업 스킬은 몬스터 슬롯에 끼울 수 없다. 이게 허용되면
        -- "직업 슬롯이 몬스터 슬롯을 잠식하지 않는다"는 설계가 무너진다.
        if skill.slot_type ~= "monster" then
            log_warning("[SkillSlots] 몬스터 슬롯에는 몬스터 스킬만 끼울 수 있다: "
                .. skillId .. " (slot_type=" .. tostring(skill.slot_type) .. ")")
            return false
        end

        -- 보유하지 않은 스킬은 끼울 수 없다.
        ---@type PlayerCollection
        local collection = self.Entity:GetComponent("script.PlayerCollection")
        if collection == nil or collection:GetOwnedCount(skillId) <= 0 then
            log_warning("[SkillSlots] 보유하지 않은 스킬: " .. skillId)
            return false
        end

        -- 같은 스킬을 두 슬롯에 중복 장착하지 않는다.
        for i = 1, self.MonsterSlotCount do
            if i ~= slotIndex and self.MonsterSlots[i] == skillId then
                log_warning("[SkillSlots] 이미 " .. tostring(i) .. "번 슬롯에 장착됨: " .. skillId)
                return false
            end
        end

        self.MonsterSlots[slotIndex] = skillId
        log("[SkillSlots] 장착 " .. tostring(slotIndex) .. "번 ← [" .. skill.name .. "]")
        self:MarkSaveRun("장착")
        return true
    end

    @ExecSpace("ServerOnly")
    method void UnequipMonsterSkill(integer slotIndex)
        if self.MonsterSlots[slotIndex] == nil then return end
        self.MonsterSlots[slotIndex] = nil
        log("[SkillSlots] 해제 " .. tostring(slotIndex) .. "번")
        self:MarkSaveRun("장착 해제")
    end

    ---------------------------------------------------------------
    -- 통합 인터페이스 (작업지시서 T5 요청 3: 사용 인터페이스는 통일)
    ---------------------------------------------------------------

    -- GetJobSkills와 같은 이유로 실행공간을 열어둔다. 서버는 판정에, 클라는 HUD에 쓴다.
    method table GetActiveSkills()
        -- 지금 쓸 수 있는 액티브 전부. 직업 스킬이 앞, 몬스터 스킬이 뒤.
        -- 호출부는 이 목록만 보면 되고 어느 슬롯 출신인지 몰라도 된다.
        local out = {}
        for _, id in ipairs(self:GetJobSkills()) do
            table.insert(out, id)
        end
        for i = 1, self.MonsterSlotCount do
            local id = self.MonsterSlots[i]
            if id ~= nil then table.insert(out, id) end
        end
        return out
    end

end
