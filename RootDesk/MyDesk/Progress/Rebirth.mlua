-- @서버 (환생 실행은 반드시 서버. 클라는 조건을 읽어 표시만 한다 — 개발 규칙 2)
--
-- 환생 판정과 실행. 기획서 4.5 / 작업지시서 T7.
--
-- ## 진입 조건은 AND다 (승인 2026-08-07)
--
--     환생 가능 = 레벨 캡 도달  AND  영역 보스 격파
--
-- 성장 축과 공간 축을 동시에 요구한다. 둘은 보통 시간차로 채워진다 —
-- 보스(Lv10대)를 먼저 잡고 레벨을 채우러 다시 나간다.
--
-- ## 판정 메서드에 @ExecSpace를 붙이지 않는 이유
--
-- "환생 가능" HUD(T7-3)가 같은 판정을 그려야 한다. 클라에서 따로 조립하면
-- 조건이 두 곳에 생겨 언젠가 어긋난다. 읽는 값이 전부 @TargetUserSync라
-- 주인 클라에도 그대로 있어서 양쪽 결과가 같다.
-- (ServerOnly로 뒀다가 클라가 조용히 0/false를 받은 사고가 T5-4·T5-5에서 두 번 있었다)
--
-- ## RoomGate와 왜 따로인가
--
-- RoomGate는 "이 문을 지날 수 있나"를 본다. 환생은 문이 아니라 상태 전이다.
-- 게이트에 끼워 넣으면 방 이동 판정이 회차 로직을 알게 되어 둘 다 지저분해진다.
-- 반환 모양({passed, reason})만 맞춰서 UI가 같은 방식으로 다룰 수 있게 했다.

@Logic
script Rebirth extends Logic

    ---------------------------------------------------------------
    -- 판정 (서버·클라 공용)
    ---------------------------------------------------------------

    method table Evaluate(Entity player)
        -- { passed, reason }. reason은 **무엇이 부족한지**를 담는다 (게이트 3종과 같은 어법).
        if player == nil then
            return { passed = false, reason = "플레이어를 찾을 수 없다" }
        end

        ---@type PlayerStats
        local stats = player:GetComponent("script.PlayerStats")
        ---@type PlayerSkillSlots
        local slots = player:GetComponent("script.PlayerSkillSlots")
        if stats == nil or slots == nil then
            return { passed = false, reason = "진행 정보를 찾을 수 없다" }
        end

        -- ## 조건이 없다 (설계 변경 2026-08-21, 대표 지시)
        --
        -- ~~레벨 캡 AND 영역 보스 격파~~ → **얼마든 환생할 수 있다.**
        --
        -- 조건을 없앤 이유: 환생의 보상이 "다음 단계를 연다"에서 **"성장이 빨라진다"**로
        -- 바뀌었기 때문이다. 보상이 밟은 레벨에 비례하므로(5레벨당 +1) 일찍 환생하면
        -- 적게 받는다 — 조건으로 막지 않아도 **덜 받는 것 자체가 억제**다.
        -- 반대로 조건을 남겨 두면 "언제든 다시 시작해도 된다"는 새 규칙과 정면으로 어긋난다.
        --
        -- ⚠ 그래서 `stats.CanRebirth`(캡 도달 플래그)와 `slots.BossesCleared`는
        -- 이제 환생 판정에 쓰이지 않는다. 두 값 자체는 남는다 —
        -- CanRebirth는 캡 도달 연출에, BossesCleared는 보스 게이트 원장에 각각 쓰인다.
        --
        -- Lv1에서도 환생된다. 얻는 것이 0일 뿐이고, 그 사실은 환생 창이 미리 적어 준다.
        return { passed = true, reason = "" }
    end

    method boolean CanRebirth(Entity player)
        -- HUD가 쓰는 짧은 형태.
        return self:Evaluate(player).passed
    end

    ---------------------------------------------------------------
    -- 직업 (환생 시 고른다 — 기획서 4.4)
    ---------------------------------------------------------------

    method table GetAvailableJobs(Entity player)
        -- 이번 회차에 고를 수 있는 직업 id 목록.
        --
        --   시작 직업(JobTable.is_starter)  항상 고를 수 있다
        --   해금 직업(UnlockedJobs)         랜드마크로 열린 것
        --
        -- @ExecSpace를 붙이지 않는다. 확인 화면이 이 목록을 그려야 하는데
        -- 클라에서 따로 조립하면 규칙이 두 곳에 생긴다.
        -- UnlockedJobs가 @TargetUserSync라 양쪽 결과가 같다.
        ---@type PlayerSkillSlots
        local slots = player:GetComponent("script.PlayerSkillSlots")

        local out = {}
        for _, id in ipairs(_GameData:GetAllJobIds()) do
            local job = _GameData:GetJob(id)
            if job ~= nil then
                local unlocked = slots ~= nil and slots.UnlockedJobs[id] ~= nil
                if job.is_starter or unlocked then
                    out[#out + 1] = id
                end
            end
        end
        return out
    end

    method boolean IsJobAvailable(Entity player, string jobId)
        if jobId == "" then return false end
        for _, id in ipairs(self:GetAvailableJobs(player)) do
            if id == jobId then return true end
        end
        return false
    end

    ---------------------------------------------------------------
    -- 실행 (서버 전용)
    ---------------------------------------------------------------

    @ExecSpace("ServerOnly")
    method boolean Execute(Entity player, string jobId)
        -- 조건을 다시 검사한다. 클라가 HUD로 먼저 걸렀더라도 여기서 또 본다 —
        -- 클라 판정은 표시일 뿐이고 권한은 서버에 있다.
        local gate = self:Evaluate(player)
        if gate.passed == false then
            log_warning("[Rebirth] 환생 거부 — " .. gate.reason)
            return false
        end

        -- 직업도 서버에서 다시 고른다. 클라가 잠긴 직업을 보내도 통과시키지 않는다.
        -- 빈 값이면 첫 번째 가능한 직업으로 대체한다 — 직업 없이 시작하면
        -- 직업 스킬 슬롯이 비어 "직업을 선택하는 이유"가 사라진다 (기획서 4.3).
        local available = self:GetAvailableJobs(player)
        if #available == 0 then
            log_error("[Rebirth] 고를 수 있는 직업이 없다 — JobTable에 is_starter가 있는지 확인")
            return false
        end
        if self:IsJobAvailable(player, jobId) == false then
            if jobId ~= "" then
                log_warning("[Rebirth] 고를 수 없는 직업: " .. tostring(jobId)
                    .. " — " .. available[1] .. " 로 대체한다")
            end
            jobId = available[1]
        end

        ---@type PlayerStats
        local stats = player:GetComponent("script.PlayerStats")
        ---@type PlayerSkillSlots
        local slots = player:GetComponent("script.PlayerSkillSlots")
        ---@type PlayerDBManager
        local db = player:GetComponent("script.PlayerDBManager")

        local fromLevel = stats.Level
        local userId = player.PlayerComponent.UserId
        log("[Rebirth] 환생 시작  Lv" .. tostring(fromLevel)
            .. "  (환생 " .. tostring(slots.RebirthCount) .. "회차 → "
            .. tostring(slots.RebirthCount + 1) .. "회차)")

        -- 1. 랜드마크 먼저. "그 레벨에서 **환생해야** 지급"이므로 리셋 전에 도달 레벨로 준다.
        self:GrantLandmarks(fromLevel, db, slots)

        -- 2. 환생 기록. **여기가 환생의 실제 보상이다** (설계 변경 2026-08-21).
        --
        --    BestRebirthLevel = 지금까지 환생한 레벨 중 최고치. **갱신형**이라
        --    같은 레벨에서 반복해도 안 오른다 — 저레벨 반복 환생이 최적 전략이 되는 것을
        --    막는 장치다(대표와 함께 검토). 더 깊이 갔다 돌아와야 오른다.
        --
        --    RebirthCount는 표시·기록용으로 남긴다. 차수는 이제 레벨에서 나오므로
        --    (T18-1) 이 값이 차수나 슬롯을 움직이지 않는다.
        slots.RebirthCount = slots.RebirthCount + 1
        if fromLevel > slots.BestRebirthLevel then
            log("[Rebirth] 최고 환생 레벨 갱신 " .. tostring(slots.BestRebirthLevel)
                .. " → " .. tostring(fromLevel))
            slots.BestRebirthLevel = fromLevel
        else
            log("[Rebirth] 최고 기록(" .. tostring(slots.BestRebirthLevel)
                .. ") 이하라 보너스는 그대로다")
        end
        -- ⚠ 슬롯 재계산은 **여기서 하지 않는다.** 차수가 레벨에서 나오므로(T18-1)
        -- 아직 옛 레벨인 이 시점에 부르면 칸이 남아 있는 것처럼 계산된다.
        -- 레벨을 1로 되돌리는 ResetRun 뒤(4b)에 부른다 (실측: 차수 0인데 슬롯이 2칸이었다).
        -- 로드 경로에서도 같은 순서 역전이 있었다 — PlayerDBManager.LoadFromDB 주석 참고.

        -- 3. 장착 비우기. 컬렉션(보유)은 영구지만 "이번 회차에 뭘 끼고 갈지"는
        --    회차마다 다시 고르는 선택이다 (SaveRunData 주석).
        local maxSlot = math.floor(_GameData:GetBalance("monster_slot_max"))
        for i = 1, maxSlot do
            slots.MonsterSlots[i] = nil
        end

        -- 4. 회차 초기화. 영구 데이터는 건드리지 않는다.
        stats:ResetRun()

        -- 4b. 이제서야 슬롯을 다시 센다. 레벨이 1로 내려갔으므로 차수 0 → 1칸이 된다.
        slots:RecomputeSlotCount()

        -- 5. 고른 직업을 새 회차에 심는다. ResetRun이 CurrentJob을 ""로 비우므로
        --    반드시 그 뒤에 와야 한다. 직업 스킬은 저장하지 않고
        --    CurrentJob에서 JobTable로 매번 유도한다 (PlayerSkillSlots.GetJobSkills).
        stats.CurrentJob = jobId
        local job = _GameData:GetJob(jobId)
        log("[Rebirth] 직업 = " .. ((job ~= nil) and job.name or jobId))

        -- 6. 시작방으로. 스탯이 초기화된 채 깊은 방에 남지 않게 한다 (기획서 4.5).
        self:ReturnToStart(player, db)

        -- 7. 즉시 저장. 스로틀에 맡기면 그 사이에 앱이 죽었을 때
        --    회차만 초기화되고 영구가 안 써진 반쪽 상태가 남는다.
        if db ~= nil then db:SaveNow("환생") end

        log("[Rebirth] 환생 완료  Lv" .. tostring(stats.Level)
            .. "  환생 " .. tostring(slots.RebirthCount) .. "회"
            .. "  몬스터 슬롯 " .. tostring(slots.MonsterSlotCount) .. "개"
            .. "  직업 " .. tostring(stats.CurrentJob))

        _ProgressLog:Rebirth(userId, slots.RebirthCount, fromLevel)
        return true
    end

    ---------------------------------------------------------------
    -- 랜드마크
    ---------------------------------------------------------------

    @ExecSpace("ServerOnly")
    method void GrantLandmarks(integer level, PlayerDBManager db, PlayerSkillSlots slots)
        -- 도달 레벨의 보상을 지급한다. 같은 레벨을 두 번 받지 않도록 원장에 기록한다.
        if db == nil then
            log_error("[Rebirth] PlayerDBManager가 없어 랜드마크 원장을 쓸 수 없다")
            return
        end

        -- 원장 키를 문자열로 쓰는 이유: 저장이 JSON을 거치는데 JSON 객체 키는
        -- 문자열이라야 한다. 숫자 인덱스로 넣으면 디코드했을 때 키 타입이 달라져
        -- 같은 랜드마크를 다시 받게 된다 (equipped_monster_skills와 같은 이유).
        local key = tostring(level)
        if db.LandmarkClaimed[key] ~= nil then
            log("[Rebirth] Lv" .. key .. " 랜드마크는 이미 받았다 — 지급 없음")
            return
        end

        local rewards = _GameData:GetLandmarksAtLevel(level)
        if #rewards == 0 then
            log("[Rebirth] Lv" .. key .. " 에 걸린 랜드마크 없음")
            return
        end

        db.LandmarkClaimed[key] = 1

        for i = 1, #rewards do
            local r = rewards[i]

            if r.reward_type == "job" then
                if slots.UnlockedJobs[r.reward_value] == nil then
                    slots.UnlockedJobs[r.reward_value] = 1
                    local job = _GameData:GetJob(r.reward_value)
                    local name = r.reward_value
                    if job ~= nil then name = job.name end
                    log("[Rebirth] 랜드마크 Lv" .. key .. " — 직업 해금 [" .. name .. "]")
                end

            elseif r.reward_type == "area" then
                if slots.UnlockedAreas[r.reward_value] == nil then
                    slots.UnlockedAreas[r.reward_value] = 1

                    -- 이름은 AreaTable이 갖고 있다. 없으면 id라도 보여준다 —
                    -- 조용히 넘어가면 "뭔가 열렸는데 뭔지 모르는" 상태가 된다.
                    local area = _GameData:GetArea(r.reward_value)
                    local areaName = r.reward_value
                    if area ~= nil and area.name ~= "" then areaName = area.name end

                    log("[Rebirth] 랜드마크 Lv" .. key .. " — 구역 개방 [" .. areaName .. "]")

                    -- 당사자에게 알린다. 새 지역이 열린 건 회차의 보상이라
                    -- 로그에만 남기면 플레이어는 알 길이 없다 (T12-3).
                    local pc = slots.Entity.PlayerComponent
                    if isvalid(pc) then
                        self:NoticeAreaUnlocked(areaName, pc.UserId)
                    end
                end

            elseif r.reward_type == "slot" then
                -- 일부러 아무것도 하지 않는다.
                --
                -- 기획서가 슬롯 확장을 두 군데로 적어 두었다:
                --   4.3  슬롯 = 시작 + 보스 클리어 축 + 환생 횟수 축
                --   4.5  Lv30 랜드마크가 슬롯 +1 (2→3)
                -- 슬라이스에서는 **같은 사건**이다. 첫 환생이 곧 Lv30 랜드마크다.
                -- RecomputeSlotCount가 이미 환생 축으로 이 +1을 계산하므로
                -- 여기서 또 더하면 이중 계산이 된다
                -- (작업지시서 T7 요청 4: "보스 축과 중복 계산되지 않도록").
                log("[Rebirth] 랜드마크 Lv" .. key .. " — 슬롯 +" .. r.reward_value
                    .. " 는 환생 축이 이미 반영한다 (중복 지급 안 함)")

            else
                log_warning("[Rebirth] 알 수 없는 랜드마크 보상 종류: " .. tostring(r.reward_type))
            end
        end
    end

    @ExecSpace("Client")
    method void NoticeAreaUnlocked(string areaName)
        -- 새 지역이 열렸음을 당사자에게 알린다.
        --
        -- 대상 userId는 선언부가 아니라 호출부 마지막 인자다. 선언에 넣으면
        -- [LEA-3032]가 난다 (PlayerHit.OnDied와 같은 규칙).
        --
        -- GateNotice.ShowNotice는 로그를 남기지 않는다. 여기서 한 줄 남겨야
        -- "RPC가 클라까지 왔는지"를 로그로 확인할 수 있다 (T12-3 검증에서 필요했다).
        log("[Rebirth] 지역 해금 알림 — " .. areaName)
        _GateNotice:ShowNotice("새 지역이 열렸다", areaName .. " — 마을 동쪽 문에서 갈 수 있다")
    end

    ---------------------------------------------------------------
    -- 시작방 복귀
    ---------------------------------------------------------------

    @ExecSpace("ServerOnly")
    method void ReturnToStart(Entity player, PlayerDBManager db)
        -- 저장된 방까지 함께 바꾼다. 안 바꾸면 재접속했을 때 초기화된 스탯으로
        -- 깊은 방에서 시작한다.
        local startRoom = _GameData:GetStartRoom()
        if startRoom == nil then
            log_error("[Rebirth] RoomTable에 is_start 방이 없다 — 복귀하지 못했다")
            return
        end
        if startRoom.map_name == "" then
            log_error("[Rebirth] 시작방 " .. startRoom.id .. " 에 map_name이 없다")
            return
        end

        if db ~= nil then db.CurrentRoom = startRoom.id end

        local map = player.CurrentMap
        if map ~= nil and map.Name == startRoom.map_name then
            log("[Rebirth] 이미 시작방(" .. startRoom.id .. ")에 있다 — 이동 없음")
            return
        end

        -- 도착점은 방 한가운데(0,0,0). 포탈은 가장자리에 있어 트리거에 걸리지 않는다.
        log("[Rebirth] 시작방 복귀 → " .. startRoom.id .. "(" .. startRoom.map_name .. ")")
        _TeleportService:TeleportToMapPosition(player, Vector3(0, 0, 0), startRoom.map_name)
    end

end
