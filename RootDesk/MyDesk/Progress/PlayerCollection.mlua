-- @서버 (포획 판정은 반드시 서버. 클라는 결과만 받는다 — 개발 규칙 2)
--
-- 영구 데이터의 런타임 소유자. 필드는 SavePermanentData 스키마와 대응하며,
-- T8에서 저장에 연결한다. 회차 데이터(PlayerStats)와 물리적으로 분리한다 (개발 규칙 5).
--
-- 신규 모드 포획 = 첫 획득 10% / 중복 3%의 순수 확률. 천장은 사용하지 않는다.
-- 레거시 모드는 기존 3% + LUK x 0.1%p, 40킬 천장을 보존한다.
-- 수치는 전부 GameBalance에서 읽는다 (하드코딩 금지 — 개발 규칙 3).

@Component
script PlayerCollection extends Component

    -- 레거시 호환 미러. 신규 모드에서는 절대 이 값을 직접 성장 원장으로 쓰지 않는다.
    -- TamedMonsters 변경 뒤 대응 drop_skill_id에 단방향으로만 동기화한다.
    @TargetUserSync property SyncTable<string, integer> OwnedSkills

    -- M2A 신규 모드의 유일한 수집·해금·강화 원장. monsterId -> 1~5.
    @TargetUserSync property SyncTable<string, integer> TamedMonsters

    -- 선택한 비전투 동행. 서버가 보유 여부를 검증하고 저장한다.
    @TargetUserSync property string SelectedCompanionMonsterId = ""

    -- 레거시 종별 천장 카운터. 신규 모드는 읽거나 변경하지 않는다.
    @TargetUserSync property SyncTable<string, integer> SpeciesKills

    -- 신규 모드의 순수 누적 처치 기록. 옛 SpeciesKills는 실패 카운터였으므로
    -- 과거 값을 통계로 오해하지 않도록 별도 원장으로 시작한다.
    @TargetUserSync property SyncTable<string, integer> TotalMonsterKills

    -- Roguelite 영구 발견 기록. 전투력·시작 스킬을 주지 않는 도감 원장이다.
    -- 기존 TamedMonsters/OwnedSkills와 분리해 과거 RPG 저장을 보존한다.
    @TargetUserSync property SyncTable<string, integer> RogueDiscoveredMonsters
    @TargetUserSync property SyncTable<string, integer> RogueDiscoveredAbilities

    -- 동행 런타임 상태는 저장하지 않는다. 맵 전환/재접속 때 선택 id로 다시 만든다.
    @HideFromInspector property Entity CompanionEntity = nil
    @HideFromInspector property string companionMapName = ""
    @HideFromInspector property number companionTickLeft = 0

    property string companionModelId = "companionvisual"
    property number companionUpdateInterval = 0.1
    property number companionFollowSpeed = 4
    property number companionTeleportDistance = 4
    property Vector3 companionOffset = Vector3(-0.8, -0.45, 0)

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 컬렉션 로드는 PlayerDBManager가 한다 (T8). 여기서는 아무것도 초기화하지
        -- 않는다 — 컴포넌트 OnBeginPlay 순서가 정해져 있지 않아, 로드된 값을
        -- 나중에 도는 초기화가 덮어쓸 수 있다.
        log("[PlayerCollection] 초기화  테이밍률=" .. string.format("%.4f", self:GetCaptureRate()))
    end

    @ExecSpace("ServerOnly")
    method void MarkSave(string reason)
        -- 컬렉션·레거시 천장·누적 처치 기록은 영구 데이터다.
        ---@type PlayerDBManager
        local db = self.Entity:GetComponent("script.PlayerDBManager")
        if db == nil then return end
        db:MarkPermDirty(reason)
    end

    @ExecSpace("ServerOnly")
    method number GetCaptureRate()
        -- 몬스터가 정해지지 않은 UI/기본 표시에는 신규 모드의 첫 획득 확률을 보여 준다.
        if _GameData:GetBalance("phase1_random_combat_enabled") >= 0.5 then
            local rate = _GameData:GetBalance("first_capture_rate")
                * _GameData:GetBalance("capture_rate_global_multiplier")
                * _GameData:GetBalance("collection_capture_multiplier")
            local maxRate = _GameData:GetBalance("capture_rate_max")
            if rate < 0 then rate = 0 end
            if maxRate > 0 and rate > maxRate then rate = maxRate end
            return rate
        end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return _GameData:GetBalance("capture_base_rate") end
        return stats:GetCaptureRate()
    end

    @ExecSpace("ServerOnly")
    method number GetCaptureRateForMonster(string monsterId)
        if _GameData:GetBalance("phase1_random_combat_enabled") < 0.5 then
            return self:GetCaptureRate()
        end

        local record = _GameData:GetMonster(monsterId)
        local rate = _GameData:GetBalance("first_capture_rate")
        if record ~= nil and self:GetTamedCount(monsterId) > 0 then
            rate = _GameData:GetBalance("duplicate_capture_rate")
        end
        rate *= _GameData:GetBalance("capture_rate_global_multiplier")
        rate *= _GameData:GetBalance("collection_capture_multiplier")
        local modifier = _GameData:GetBalance("capture_monster_modifier_default")
        if record ~= nil and record.capture_modifier > 0 then modifier = record.capture_modifier end
        rate *= modifier
        local maxRate = _GameData:GetBalance("capture_rate_max")
        if rate < 0 then rate = 0 end
        if maxRate > 0 and rate > maxRate then rate = maxRate end
        return rate
    end

    @ExecSpace("ServerOnly")
    method integer GetCapturePityForSkill(string skillId)
        -- 신규 모드는 천장을 쓰지 않는다. 이 함수는 레거시 플래그 OFF 호환 전용이다.
        if _GameData:GetBalance("phase1_random_combat_enabled") >= 0.5 then return 0 end
        if _GameData:GetBalance("phase1_random_combat_enabled") < 0.5 then
            return math.max(1, math.floor(_GameData:GetBalance("capture_pity_kills")))
        end
        return 0
    end

    -- 실행공간을 일부러 비워둔다. 서버는 장착 검증에, 클라는 장착 UI 목록에 쓴다.
    --
    -- ServerOnly였을 때 클라 호출이 **에러 없이** 0을 돌려줬다 (실측):
    --   [DBG] 보유수 s_mon_slime = 0     <- GetOwnedCount()
    --   [DBG] OwnedSkills 직접 = 2       <- 동기화된 실제 값
    -- 그래서 장착 UI의 보유 목록이 통째로 비어 보였다.
    -- 읽는 값이 @TargetUserSync라 주인 클라에도 그대로 있어서 양쪽 결과가 같다.
    -- (T5-4에서 GetActiveSkills/GetJobSkills에 같은 판단을 적용했다)
    method integer GetOwnedCount(string skillId)
        -- 레거시 호출부를 위한 호환 조회. 신규 모드에서 매핑된 101종은 반드시
        -- TamedMonsters를 읽는다. 대응이 없는 s_mon_snail 같은 옛 스킬만 미러를 읽는다.
        if _GameData:GetBalance("phase1_random_combat_enabled") >= 0.5 then
            local monsterId = _GameData:GetMonsterIdByDropSkillId(skillId)
            if monsterId ~= "" then return self:GetTamedCount(monsterId) end
        end
        local n = self.OwnedSkills[skillId]
        if n == nil then return 0 end
        local stackMax = math.floor(_GameData:GetBalance("skill_stack_max"))
        if stackMax < 1 then stackMax = 1 end
        n = math.floor(n)
        if n < 0 then return 0 end
        if n > stackMax then return stackMax end
        return n
    end

    method integer GetTamedCount(string monsterId)
        local n = self.TamedMonsters[monsterId]
        if n == nil then return 0 end
        local stackMax = math.floor(_GameData:GetBalance("skill_stack_max"))
        if stackMax < 1 then stackMax = 1 end
        n = math.floor(n)
        if n < 0 then return 0 end
        if n > stackMax then return stackMax end
        return n
    end

    method integer GetAbilityStackCount(string skillId)
        -- 플레이어 공격·UI가 공유하는 신규 강화 조회 창구.
        -- 신규 모드에서는 항상 monster_id 원장을 통해 읽는다.
        return self:GetOwnedCount(skillId)
    end

    method number GetAbilityMultiplier(string skillId)
        -- 로그라이트 발견 기록/레거시 테이밍 개수는 방어 효과에도 전투 보너스를 주지 않는다.
        if _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5 then return 1 end
        local count = self:GetAbilityStackCount(skillId)
        if count < 1 then count = 1 end
        return 1 + _GameData:GetBalance("skill_stack_bonus") * (count - 1)
    end

    method boolean IsTamed(string monsterId)
        return self:GetTamedCount(monsterId) > 0
    end

    @ExecSpace("ServerOnly")
    method void MirrorOwnedSkillFromTamed(string monsterId)
        -- M2A 단방향 동기화의 유일한 쓰기 지점.
        local monster = _GameData:GetMonster(monsterId)
        if monster == nil or monster.drop_skill_id == "" then return end
        local count = self:GetTamedCount(monsterId)
        if count > 0 then self.OwnedSkills[monster.drop_skill_id] = count
        else self.OwnedSkills[monster.drop_skill_id] = nil end
    end

    @ExecSpace("ServerOnly")
    method boolean SetTamedCount(string monsterId, integer count)
        if _GameData:IsTameableMonster(monsterId) == false then return false end
        local stackMax = math.floor(_GameData:GetBalance("skill_stack_max"))
        if stackMax < 1 then stackMax = 1 end
        local normalized = math.floor(count)
        if normalized < 0 then normalized = 0 end
        if normalized > stackMax then normalized = stackMax end
        if normalized > 0 then self.TamedMonsters[monsterId] = normalized
        else self.TamedMonsters[monsterId] = nil end
        self:MirrorOwnedSkillFromTamed(monsterId)
        return true
    end

    @ExecSpace("ServerOnly")
    method integer GetSpeciesKills(string monsterId)
        local n = self.SpeciesKills[monsterId]
        if n == nil then return 0 end
        return n
    end

    method integer GetTotalMonsterKills(string monsterId)
        local n = self.TotalMonsterKills[monsterId]
        if n == nil then return 0 end
        return n
    end

    ---------------------------------------------------------------
    -- 포획 판정
    ---------------------------------------------------------------

    @ExecSpace("ServerOnly")
    method boolean TryCapture(string monsterId)
        -- 처치 시 자동 판정. 성공하면 true.
        local record = _GameData:GetMonster(monsterId)
        if record == nil then
            log_warning("[PlayerCollection] MonsterTable에 없는 몬스터: " .. tostring(monsterId))
            return false
        end

        local isRoguelite = _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5
        if isRoguelite then
            -- 신규 모드의 확정 능력 획득은 서버가 확정한 instance Run 안에서만 유효하다.
            -- 레거시 고정 필드에서 몬스터를 잡아 영구 발견/Run 슬롯을 우회하지 못하게 한다.
            if _GameData.RogueRunActive == false then return false end
            return self:GrantRogueliteAbility(monsterId, record)
        end

        local isNewMode = _GameData:GetBalance("phase1_random_combat_enabled") >= 0.5
        if isNewMode then
            self.TotalMonsterKills[monsterId] = self:GetTotalMonsterKills(monsterId) + 1
            self:MarkSave("누적 처치")
        end

        local skillId = record.drop_skill_id
        if skillId == "" then
            -- 드랍 스킬이 없는 몬스터는 포획 대상이 아니다. 신규 누적 처치는 위에서
            -- 이미 기록했고, 레거시 포획 실패 카운터만 쌓지 않는다.
            return false
        end

        local skill = _GameData:GetSkill(skillId)
        if skill == nil then
            log_warning("[PlayerCollection] SkillTable에 없는 테이밍 연결 능력: " .. tostring(skillId))
            return false
        end

        -- 이미 만작이면 굴리지 않는다 (T15-2).
        --
        -- 천장 카운터도 올리지 않는다: 더 얻을 것이 없는데 40마리를 세는 것은
        -- 의미가 없고, 상한을 나중에 6으로 올리면 그 순간 확정 포획이 튀어나온다.
        local stackMax = math.floor(_GameData:GetBalance("skill_stack_max"))
        if stackMax < 1 then stackMax = 1 end
        local ownedBefore = isNewMode and self:GetTamedCount(monsterId) or self:GetOwnedCount(skillId)
        if ownedBefore >= stackMax then
            log("[PlayerCollection] " .. record.name .. " 는 이미 만작 "
                .. tostring(stackMax) .. "/" .. tostring(stackMax) .. " — 포획을 굴리지 않는다")
            return false
        end

        local rate = self:GetCaptureRateForMonster(monsterId)
        local roll = _UtilLogic:RandomDouble()

        local byPity = false
        local success = roll < rate
        if isNewMode == false then
            local kills = self:GetSpeciesKills(monsterId) + 1
            local pity = self:GetCapturePityForSkill(skillId)
            byPity = kills >= pity
            success = success or byPity
            if success then self.SpeciesKills[monsterId] = 0
            else self.SpeciesKills[monsterId] = kills end
        end

        log("[CAPTURE_ROLL] monster_id=" .. monsterId
            .. " skill_id=" .. skillId
            .. " current_owned_count=" .. tostring(ownedBefore)
            .. " capture_rate=" .. string.format("%.4f", rate)
            .. " random_roll=" .. string.format("%.4f", roll)
            .. " result=" .. (success and "success" or "fail")
            .. " total_kills=" .. tostring(self:GetTotalMonsterKills(monsterId)))

        if success == false then
            if isNewMode == false then self:MarkSave("레거시 천장 누적") end
            return false
        end

        local owned = ownedBefore + 1
        if isNewMode then
            -- 신규 모드는 TamedMonsters만 변경한다. SetTamedCount가 OwnedSkills를
            -- 단방향 미러링하므로 두 원장이 서로 독립적으로 변할 수 없다.
            self:SetTamedCount(monsterId, owned)
        else
            self.OwnedSkills[skillId] = owned
        end

        -- Phase 1: 영구 보유 액티브 풀이 바뀐 사실을 런타임 슬롯 관리자에 알린다.
        -- 같은 스킬의 중복 포획은 풀의 종류 수를 늘리지 않으므로 기존 랜덤 손패가 유지된다.
        ---@type PlayerSkillSlots
        local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
        if slots ~= nil then slots:OnOwnedSkillPoolChanged() end

        local skillName = skillId
        if skill ~= nil then skillName = skill.name end

        if owned == 1 then
            log("[PlayerCollection] 테이밍 성공 " .. record.name .. " → 신규 능력 [" .. skillName .. "]"
                .. (byPity and "  (천장)" or "  (확률)"))
        else
            -- 강화된 계수를 같이 남긴다 (T15-2). 개수만 적으면 그게 데미지에
            -- 반영됐는지 로그에서 확인할 방법이 없다 — T15-2 이전이 정확히 그 상태였다.
            local coefText = ""
            if skill ~= nil then
                coefText = "  계수 " .. string.format("%.2f", skill.coefficient)
                    .. " → " .. string.format("%.2f", _CombatFormula:StackedCoefficient(skill.coefficient, owned))
            end
            log("[PlayerCollection] 중복 테이밍 " .. record.name .. " → [" .. skillName .. "] 강화 "
                .. tostring(owned) .. "/" .. tostring(stackMax)
                .. (byPity and "  (천장)" or "  (확률)") .. coefText)
        end

        self:MarkSave(isNewMode and "테이밍" or "포획")
        _ProgressLog:Capture(self.Entity.PlayerComponent.UserId, monsterId, skillId, owned, byPity)
        self:OnCaptured(record.name, skillName, skill.skill_kind, owned, self.Entity.PlayerComponent.UserId)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean GrantRogueliteAbility(string monsterId, table record)
        -- 처치/능력 발견은 Run 종료 전에는 임시 원장에만 남긴다. TotalMonsterKills의
        -- 기존 정책은 유지하며, 도감은 CLEAR/FAILED에서만 영구 반영한다.
        self.TotalMonsterKills[monsterId] = self:GetTotalMonsterKills(monsterId) + 1
        _GameData:StageRogueliteDiscovery(self.Entity.PlayerComponent.UserId, monsterId, "")

        local skillId = record.drop_skill_id
        local skill = skillId ~= "" and _GameData:GetSkill(skillId) or nil
        if skill == nil or skill.source ~= "monster" or skill.slot_type ~= "monster"
            or skill.skill_kind == "passive" then
            self:MarkSave("Roguelite 몬스터 발견")
            self:OnRogueliteDiscovery(record.name, "", false,
                self.Entity.PlayerComponent.UserId)
            return true
        end

        ---@type PlayerSkillSlots
        local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
        local acquired = false
        if slots ~= nil then acquired = slots:TryAcquireRunAbility(monsterId, skillId) end
        if acquired then _GameData:StageRogueliteDiscovery(self.Entity.PlayerComponent.UserId, monsterId, skillId) end
        self:MarkSave(acquired and "Roguelite 능력 발견" or "Roguelite 몬스터 발견")
        if acquired then
            self:OnRogueliteDiscovery(record.name, skill.name, true,
                self.Entity.PlayerComponent.UserId)
        end
        log("[RogueliteReward] monster=" .. monsterId .. " skill=" .. skillId
            .. " acquired=" .. tostring(acquired))
        return acquired
    end

    @ExecSpace("ServerOnly")
    method void FinalizeRogueliteDiscoveries(string result)
        if _GameData:GetBalance("roguelite_run_mode_enabled") < 0.5 then return end
        local userId = self.Entity.PlayerComponent.UserId
        if _GameData.RogueParticipantResults[userId] == "ABANDONED" then
            _GameData:DiscardRogueliteDiscoveries(userId)
            return
        end
        if (result ~= "CLEAR" and result ~= "FAILED") or _GameData.RogueRunResult ~= result
            or _GameData:IsRunParticipant(userId) == false then return end
        if type(_GameData.RoguePendingDiscoveries) ~= "table" then return end
        local pending = _GameData.RoguePendingDiscoveries[userId]
        if pending == nil then return end
        -- 기존 도감/payload를 롤백하거나 초기화하지 않는다. 확정된 신규 ID만 합친다.
        for monsterId, value in pairs(pending.monsters) do
            if value == 1 and _GameData:GetMonster(monsterId) ~= nil then self.RogueDiscoveredMonsters[monsterId] = 1 end
        end
        for skillId, value in pairs(pending.abilities) do
            if value == 1 and _GameData:GetSkill(skillId) ~= nil then self.RogueDiscoveredAbilities[skillId] = 1 end
        end
        _GameData:DiscardRogueliteDiscoveries(userId)
        self:MarkSave("Roguelite " .. result .. " 발견 확정")
    end

    @ExecSpace("Client")
    method void OnRogueliteDiscovery(string monsterName, string skillName, boolean offered)
        -- Mega Run에서는 PlayerSkillSlots가 SkillBar의 작은 자동 숨김 토스트를
        -- 직접 표시한다. 예전 GateNotice를 함께 띄우면 화면 중앙에 큰 배너가
        -- 중복으로 남으므로 이 클라이언트 콜백은 기록만 남긴다.
        if skillName == "" then
            log("[RogueliteDiscovery] " .. monsterName .. " — 사용 가능한 액티브 능력 없음")
        elseif offered then
            log("[RogueliteDiscovery] " .. monsterName .. " 능력 획득 — " .. skillName)
        else
            log("[RogueliteDiscovery] " .. monsterName .. " 발견 — " .. skillName .. " (이미 보유)")
        end
    end

    @ExecSpace("Client")
    method void OnCaptured(string monsterName, string skillName, string skillKind, integer ownedCount)
        -- 테이밍 성공 연출. 판정은 서버, 연출은 클라.
        -- 신규 획득과 강화를 다르게 터뜨려서 "또 같은 거네"가 바로 읽히게 한다.
        if ownedCount == 1 then
            _ParticleService:PlayBasicParticleAttached(
                BasicParticleType.StarVortex, self.Entity,
                Vector3(0, 0, 0), 0, Vector3(1.2, 1.2, 1.2), false)
            log("[PlayerCollection] (클라) 신규 테이밍 연출 [" .. monsterName .. "]")
        else
            _ParticleService:PlayBasicParticleAttached(
                BasicParticleType.ChargeOrb, self.Entity,
                Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false)
            log("[PlayerCollection] (클라) 중복 테이밍 연출 [" .. monsterName .. "] ★" .. tostring(ownedCount))
        end
        if skillKind == "passive" then
            if ownedCount == 1 then
                _GateNotice:ShowNotice(monsterName .. " 테이밍 성공", "★1 · 컬렉션 등록")
            else
                _GateNotice:ShowNotice(monsterName .. " ★" .. tostring(ownedCount), "컬렉션 성장")
            end
            return
        end

        if ownedCount == 1 then
            _GateNotice:ShowNotice(monsterName .. " 테이밍 성공", "★1 · " .. skillName .. " 해금")
        else
            local multiplier = 1 + _GameData:GetBalance("skill_stack_bonus") * (ownedCount - 1)
            _GateNotice:ShowNotice(monsterName .. " ★" .. tostring(ownedCount),
                skillName .. " ×" .. string.format("%.1f", multiplier))
        end
    end

    ---------------------------------------------------------------
    -- M2A 비전투 동행 몬스터
    ---------------------------------------------------------------

    @ExecSpace("Server")
    method void RequestSetCompanion(string monsterId)
        -- 신규 Run에서 숨긴 동행 기능은 서버 요청으로도 실행할 수 없다.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5 then return end
        if monsterId == nil then monsterId = "" end

        if monsterId ~= "" then
            if _GameData:IsTameableMonster(monsterId) == false then
                log_warning("[Companion] 테이밍 대상이 아닌 선택 요청: " .. tostring(monsterId))
                return
            end
            if self:GetTamedCount(monsterId) <= 0 then
                log_warning("[Companion] 미획득 몬스터 선택 요청: " .. tostring(monsterId))
                return
            end
            local monster = _GameData:GetMonster(monsterId)
            if monster == nil or monster.companion_visual_ruid == "" then
                log_warning("[Companion] 표시 리소스가 없는 몬스터: " .. tostring(monsterId))
                return
            end
        end

        if self.SelectedCompanionMonsterId == monsterId then return end
        self.SelectedCompanionMonsterId = monsterId
        self:RefreshCompanion()
        self:MarkSave(monsterId == "" and "동행 해제" or "동행 선택")
        log("[Companion] 선택=" .. (monsterId == "" and "(없음)" or monsterId))
    end

    @ExecSpace("ServerOnly")
    method void DestroyCompanion()
        if isvalid(self.CompanionEntity) then self.CompanionEntity:Destroy() end
        self.CompanionEntity = nil
        self.companionMapName = ""
    end

    @ExecSpace("ServerOnly")
    method void RefreshCompanion()
        -- 기존 선택 기록은 지우지 않고 신규 모드의 월드 표현만 비활성화한다.
        self:DestroyCompanion()
        if _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5 then return end
        local monsterId = self.SelectedCompanionMonsterId
        if monsterId == "" or self:GetTamedCount(monsterId) <= 0 then return end

        local monster = _GameData:GetMonster(monsterId)
        local map = self.Entity.CurrentMap
        local playerTransform = self.Entity.TransformComponent
        if monster == nil or monster.companion_visual_ruid == ""
            or map == nil or not isvalid(playerTransform) then return end

        local p = playerTransform.WorldPosition
        local at = Vector3(p.x + self.companionOffset.x, p.y + self.companionOffset.y, p.z)
        local name = "Companion_" .. tostring(self.Entity.PlayerComponent.UserId)
        local entity = _SpawnService:SpawnByModelId(self.companionModelId, name, at, map)
        if entity == nil then
            log_error("[Companion] 모델 스폰 실패: " .. self.companionModelId)
            return
        end

        local sprite = entity.SpriteRendererComponent
        if not isvalid(sprite) then
            entity:Destroy()
            log_error("[Companion] SpriteRendererComponent 없음")
            return
        end
        sprite.SpriteRUID = monster.companion_visual_ruid
        sprite.PlayRate = 1
        entity.TransformComponent.Scale = Vector3(0.75, 0.75, 1)

        self.CompanionEntity = entity
        self.companionMapName = map.Name
        log("[Companion] 생성 monster_id=" .. monsterId .. " map=" .. map.Name
            .. " combat_components=none")
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        -- 매 프레임 동기화하지 않고 10Hz 기본값으로 제한한다.
        if _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5 then
            if isvalid(self.CompanionEntity) then self:DestroyCompanion() end
            return
        end
        self.companionTickLeft -= delta
        if self.companionTickLeft > 0 then return end
        self.companionTickLeft = self.companionUpdateInterval

        local map = self.Entity.CurrentMap
        if self.SelectedCompanionMonsterId == "" then
            if isvalid(self.CompanionEntity) then self:DestroyCompanion() end
            return
        end
        if map == nil then
            self:DestroyCompanion()
            return
        end

        -- 맵 이동 또는 외부 파괴를 감지하면 옛 엔티티를 없애고 정확히 하나만 다시 만든다.
        if not isvalid(self.CompanionEntity) or self.companionMapName ~= map.Name then
            self:RefreshCompanion()
            return
        end

        local playerTransform = self.Entity.TransformComponent
        local companionTransform = self.CompanionEntity.TransformComponent
        if not isvalid(playerTransform) or not isvalid(companionTransform) then return end

        local p = playerTransform.WorldPosition
        local c = companionTransform.WorldPosition
        local targetX = p.x + self.companionOffset.x
        local targetY = p.y + self.companionOffset.y
        local dx = targetX - c.x
        local dy = targetY - c.y
        local distanceSq = dx * dx + dy * dy
        local teleportSq = self.companionTeleportDistance * self.companionTeleportDistance

        if distanceSq >= teleportSq then
            companionTransform.WorldPosition = Vector3(targetX, targetY, p.z)
            return
        end
        if distanceSq <= 0.0025 then return end

        local distance = math.sqrt(distanceSq)
        local step = self.companionFollowSpeed * self.companionUpdateInterval
        if step > distance then step = distance end
        companionTransform.WorldPosition = Vector3(c.x + dx / distance * step, c.y + dy / distance * step, p.z)

        local sprite = self.CompanionEntity.SpriteRendererComponent
        if isvalid(sprite) and math.abs(dx) > 0.05 then sprite.FlipX = dx > 0 end
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        self:DestroyCompanion()
    end

end
