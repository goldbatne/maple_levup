-- @서버 (포획 판정은 반드시 서버. 클라는 결과만 받는다 — 개발 규칙 2)
--
-- 영구 데이터의 런타임 소유자. 필드는 SavePermanentData 스키마와 대응하며,
-- T8에서 저장에 연결한다. 회차 데이터(PlayerStats)와 물리적으로 분리한다 (개발 규칙 5).
--
-- 포획 = 3% + LUK x 0.1%p, 종별 40킬 천장 (기획서 4.8 / 밸런스시트).
-- 수치는 전부 GameBalance에서 읽는다 (하드코딩 금지 — 개발 규칙 3).

@Component
script PlayerCollection extends Component

    -- 스킬 컬렉션. skillId -> 보유 개수. 중복 포획은 강화 카운트로 쌓인다.
    -- 개인 데이터라 @TargetUserSync — @Sync면 남의 컬렉션까지 새어 나간다.
    @TargetUserSync property SyncTable<string, integer> OwnedSkills

    -- 종별 천장 카운터. monsterId -> 마지막 포획 이후 누적 킬.
    @TargetUserSync property SyncTable<string, integer> SpeciesKills

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- T8에서 여기가 DataStorage 로드로 바뀐다. 지금은 빈 컬렉션으로 시작한다.
        log("[PlayerCollection] 초기화  포획률=" .. string.format("%.4f", self:GetCaptureRate()))
    end

    @ExecSpace("ServerOnly")
    method number GetCaptureRate()
        -- 판정에 쓰는 확률. PlayerStats가 LUK을 들고 있으므로 거기서 읽는다.
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return _GameData:GetBalance("capture_base_rate") end
        return stats:GetCaptureRate()
    end

    -- 실행공간을 일부러 비워둔다. 서버는 장착 검증에, 클라는 장착 UI 목록에 쓴다.
    --
    -- ServerOnly였을 때 클라 호출이 **에러 없이** 0을 돌려줬다 (실측):
    --   [DBG] 보유수 s_mon_slime = 0     <- GetOwnedCount()
    --   [DBG] OwnedSkills 직접 = 2       <- 동기화된 실제 값
    -- 그래서 장착 UI의 보유 목록이 통째로 비어 보였다.
    -- 읽는 값이 @TargetUserSync라 주인 클라에도 그대로 있어서 양쪽 결과가 같다.
    -- (T5-4에서 GetActiveSkills/GetJobSkills에 같은 판단을 적용했다)
    method integer GetOwnedCount(string skillId)
        -- 보유 개수(=강화 카운트). 없으면 0.
        local n = self.OwnedSkills[skillId]
        if n == nil then return 0 end
        return n
    end

    @ExecSpace("ServerOnly")
    method integer GetSpeciesKills(string monsterId)
        local n = self.SpeciesKills[monsterId]
        if n == nil then return 0 end
        return n
    end

    ---------------------------------------------------------------
    -- 포획 판정
    ---------------------------------------------------------------

    @ExecSpace("ServerOnly")
    method boolean TryCapture(string monsterId)
        -- 처치 시 자동 판정. 성공하면 true.
        local record = _GameData:GetMonster(monsterId)
        if record == nil then
            log_warning("[PlayerCollection] MonsterTable에 없는 몬스터: " .. tostring(monsterId))
            return false
        end

        local skillId = record.drop_skill_id
        if skillId == "" then
            -- 드랍 스킬이 없는 몬스터는 포획 대상이 아니다. 킬 카운트도 세지 않는다.
            return false
        end

        local kills = self:GetSpeciesKills(monsterId) + 1
        local pity = math.floor(_GameData:GetBalance("capture_pity_kills"))
        local rate = self:GetCaptureRate()
        local roll = _UtilLogic:RandomDouble()

        -- 천장은 확률과 OR다. 40마리째는 굴림 결과와 무관하게 확정 포획한다.
        local byPity = kills >= pity
        local success = (roll < rate) or byPity

        if success == false then
            self.SpeciesKills[monsterId] = kills
            log("[PlayerCollection] 포획 실패 " .. record.name
                .. "  굴림=" .. string.format("%.3f", roll) .. " / 확률=" .. string.format("%.3f", rate)
                .. "  천장 " .. tostring(kills) .. "/" .. tostring(pity))
            return false
        end

        -- 성공. 천장 카운터는 0으로 되돌린다 — 다음 포획까지 다시 40마리를 보장한다.
        self.SpeciesKills[monsterId] = 0
        local owned = self:GetOwnedCount(skillId) + 1
        self.OwnedSkills[skillId] = owned

        local skill = _GameData:GetSkill(skillId)
        local skillName = skillId
        if skill ~= nil then skillName = skill.name end

        if owned == 1 then
            log("[PlayerCollection] 포획 성공 " .. record.name .. " → 신규 스킬 [" .. skillName .. "]"
                .. (byPity and "  (천장)" or "  (확률)"))
        else
            log("[PlayerCollection] 포획 성공 " .. record.name .. " → [" .. skillName .. "] 강화 "
                .. tostring(owned) .. (byPity and "  (천장)" or "  (확률)"))
        end

        self:OnCaptured(skillName, owned, self.Entity.PlayerComponent.UserId)
        return true
    end

    @ExecSpace("Client")
    method void OnCaptured(string skillName, integer ownedCount)
        -- 포획 성공 연출 (작업지시서 T5 요청 2). 판정은 서버, 연출은 클라.
        -- 신규 획득과 강화를 다르게 터뜨려서 "또 같은 거네"가 바로 읽히게 한다.
        if ownedCount == 1 then
            _ParticleService:PlayBasicParticleAttached(
                BasicParticleType.StarVortex, self.Entity,
                Vector3(0, 0, 0), 0, Vector3(1.2, 1.2, 1.2), false)
            log("[PlayerCollection] (클라) 신규 포획 연출 [" .. skillName .. "]")
        else
            _ParticleService:PlayBasicParticleAttached(
                BasicParticleType.ChargeOrb, self.Entity,
                Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false)
            log("[PlayerCollection] (클라) 강화 포획 연출 [" .. skillName .. "] x" .. tostring(ownedCount))
        end
    end

end
