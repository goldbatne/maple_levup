@Component
script PlayerAttack extends AttackComponent

	@HideFromInspector
	property any Shape = nil
	@HideFromInspector
	property integer autoAttackTimer = 0

	-- 이번 한 방이 때릴 수 있는 대상 수 (T17-3).
	-- 엔진에 "최대 타격 수"가 없어서(msw-combat-system 1-2: "not native. Manage in script")
	-- 후보를 훑는 IsAttackTarget 훅에서 직접 센다.
	--   hitLimited=false  제한 없음 (기본 공격 · area 스킬)
	--   hitLimited=true   hitBudget 만큼만 맞고 나머지는 걸러낸다
	@HideFromInspector property boolean hitLimited = false
	@HideFromInspector property integer hitBudget = 0

	-- 이번 한 방에 얹을 돌진 보너스 (T21-2). 0이면 없다.
	-- hitLimited/hitBudget과 같은 방식 — 한 방 앞에서 걸고 바로 지운다.
	@HideFromInspector property number dashBonus = 0

	-- skillId -> 다시 쓸 수 있게 되는 시각(월드 경과초). 비어 있으면 즉시 사용 가능.
	--
	-- @TargetUserSync인 이유: 판정은 서버가 하지만 HUD도 남은 시간을 그려야 한다.
	-- 서버만 들고 있으면 클라가 매번 물어봐야 하고, 클라만 들고 있으면 위조된다.
	-- 이 값은 **서버 시계**의 시각이고 서버 판정에만 쓴다.
	@TargetUserSync property SyncTable<string, number> SkillReadyAt

	-- 같은 쿨다운을 **클라 시계**로 다시 적은 것. 스킬 바 표시만 이걸 본다.
	-- 왜 갈랐는지는 GetCooldownRemain 주석에 있다. 저장하지 않는다 —
	-- 몇 초짜리라 재접속하면 어차피 끝나 있다.
	property table clientReadyAt = {}

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 판정을 원형으로 둔다. 우리 맵은 RectTile 탑다운이라 사방에서 몬스터가 붙는데,
		-- LookDirectionX 방향 박스는 좌우만 커버해서 위/아래 몬스터를 못 때린다.
		-- 반경은 시트가 아니라 GameBalance의 구현 상수에서 읽는다 (하드코딩 금지 — 개발 규칙 3).
		self.Shape = CircleShape(Vector2.zero, _GameData:GetBalance("player_attack_range"))

		-- 기본 공격은 자동이다 (작업지시서 T3: "기본 공격은 자동(근접 범위 판정)").
		-- 버튼 탭은 T5의 액티브 스킬 몫이라 여기서 입력을 받지 않는다.
		self.autoAttackTimer = _TimerService:SetTimerRepeat(function()
			self:AttackNormal()
		end, _GameData:GetBalance("player_attack_interval"))
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 타이머를 남기면 맵을 옮기거나 스크립트를 리로드할 때 유령 공격이 계속 돈다.
		if self.autoAttackTimer ~= 0 then
			_TimerService:ClearTimer(self.autoAttackTimer)
			self.autoAttackTimer = 0
		end
	end

	@ExecSpace("ServerOnly")
	method void AttackNormal()
		-- 플레이어를 중심으로 한 원형 판정. 방향에 상관없이 닿는 몬스터를 전부 친다.
		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then return end

		local worldPosition = transform.WorldPosition
		-- 발밑이 원점이라 반 칸 올려야 몸통 높이에서 판정된다.
		self.Shape.Position = Vector2(worldPosition.x, worldPosition.y + 0.5)
		-- 기본 공격은 예나 지금이나 닿는 것을 전부 친다. 제한을 걸지 않는다.
		self.hitLimited = false
		self:AttackFast(self.Shape, nil, CollisionGroups.Monster)
	end

	@ExecSpace("ServerOnly")
	method boolean UseDefenseSkill(table skill)
		-- 방어 스킬의 효과를 건다 (T17-3b). 실제로 효과가 들어갔을 때만 true —
		-- false면 호출부가 쿨다운을 걸지 않는다.
		--
		-- 효과 자체는 PlayerHit이 갖고 있다. 여기서 pc.Hp나 감쇄 상태를 직접 만지지
		-- 않는다 — 받는 피해를 만지는 곳이 둘로 갈라지면 반드시 어긋난다
		-- (PlayerInventory가 Heal을 부르는 것과 같은 판단).
		---@type PlayerHit
		local hit = self.Entity:GetComponent("script.PlayerHit")
		if hit == nil then
			log_warning("[PlayerAttack] PlayerHit이 없어 방어 스킬을 걸 수 없다")
			return false
		end

		if skill.effect_type == "shield" then
			hit:ApplyShield(skill.effect_value, skill.duration)
			log("[PlayerAttack] 방어 스킬 [" .. skill.name .. "] 실드 "
				.. tostring(math.floor(skill.effect_value * 100)) .. "% / "
				.. tostring(skill.duration) .. "초")
			return true
		end

		if skill.effect_type == "heal" then
			-- 회복 스킬은 아직 데이터에 없다 (모험가 NPC 몫 — T16-3). 미리 열어 두면
			-- 그때 CSV 한 줄로 붙는다. 만피면 0을 돌려받아 쿨다운도 안 걸린다
			-- (포션과 같은 규칙 — 효과가 없으면 대가도 없다).
			local healed = hit:Heal(skill.effect_value)
			if healed <= 0 then
				log("[PlayerAttack] [" .. skill.name .. "] 이미 체력이 가득해 쓰지 않았다")
				return false
			end
			log("[PlayerAttack] 방어 스킬 [" .. skill.name .. "] 회복 " .. tostring(healed))
			return true
		end

		log_warning("[PlayerAttack] 모르는 방어 효과라 아무것도 하지 않았다: ["
			.. skill.name .. "] " .. tostring(skill.effect_type))
		return false
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		-- 대상 수 제한 (T17-3). `max_targets`가 1이면 범위 안에 여럿이 있어도 하나만 맞는다.
		--
		-- ⚠ 부모 AttackComponent.IsAttackTarget에는 @ExecSpace가 없다.
		--   여기에 붙이면 LEA-3014 SignatureMismatch가 난다 (CalcDamage와 같은 함정).
		--
		-- 왜 이 훅에서 세는가: 엔진에 최대 타격 수가 없다. 판정 후보를 하나씩 물어보는
		-- 곳이 여기뿐이라, 예산을 깎아 가며 false를 돌려주는 것이 유일한 방법이다.
		if __base:IsAttackTarget(defender, attackInfo) == false then return false end
		if self.hitLimited == false then return true end
		if self.hitBudget <= 0 then return false end

		self.hitBudget = self.hitBudget - 1
		return true
	end

	@ExecSpace("Server")
	method void RequestUseSkill(integer activeIndex, number aimX, number aimY)
		-- 클라 버튼 → 서버. senderUserId는 서버가 채우므로 위조할 수 없다.
		if senderUserId ~= self.Entity.PlayerComponent.UserId then
			log_warning("[PlayerAttack] 남의 스킬 사용 시도 차단: " .. tostring(senderUserId))
			return
		end
		-- 조준 방향은 클라가 실어 보낸다 (T22-1). 서버는 입력을 모르고,
		-- 몸의 속도로 읽으려 했더니 항상 0이었다 (실측).
		--
		-- 위조 걱정은 없다 — 이 값이 하는 일은 **어느 쪽으로 돌진하나**뿐이고,
		-- 거리·피해·쿨다운은 전부 서버가 데이터에서 읽는다. 방향을 조작해 봐야
		-- 자기가 원하는 쪽으로 3.5유닛 가는 것이고, 그건 원래 되는 일이다.
		self:UseSkill(activeIndex, aimX, aimY)
	end

	@ExecSpace("ServerOnly")
	method boolean UseSkill(integer activeIndex, number aimX, number aimY)
		-- GetActiveSkills()의 순번으로 쏜다. 호출부는 스킬의 출처를 구분하지 않는다
		-- (작업지시서 T5 요청 3: 사용 인터페이스는 통일).
		---@type PlayerSkillSlots
		local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
		if slots == nil then return false end

		local active = slots:GetActiveSkills()
		local skillId = active[activeIndex]
		if skillId == nil then
			log_warning("[PlayerAttack] 그 자리에 장착된 스킬이 없다: " .. tostring(activeIndex)
				.. " (보유 액티브 " .. tostring(#active) .. "개)")
			return false
		end

		local skill = _GameData:GetSkill(skillId)
		if skill == nil then return false end

		-- 쿨다운 판정은 서버가 한다. 클라 HUD도 같은 값을 보고 버튼을 흐리지만,
		-- 그건 안내일 뿐이고 실제로 막는 건 여기다 (개발 규칙 2).
		--
		-- 공격·방어 갈래보다 **앞에** 둔다. 방어 스킬만 쿨다운을 안 타면
		-- 실드를 연타해 계속 유지할 수 있다.
		local remain = self:GetCooldownRemain(skillId)
		if remain > 0 then
			log("[PlayerAttack] 쿨다운 중 [" .. skill.name .. "] "
				.. string.format("%.1f", remain) .. "초 남음")
			return false
		end

		-- 방어 스킬은 때리지 않는다 (T17-3b). 여기서 갈라 보내지 않으면
		-- 계수 0이 기준 계수(1.2)로 대체돼 **실드가 때리는 스킬로 나간다.**
		if skill.skill_kind == "defense" then
			if self:UseDefenseSkill(skill) == false then return false end
			-- 연출은 효과가 실제로 걸린 뒤에만 (T19-2). 만피라 회복이 안 됐는데
			-- 이펙트만 터지면 "썼는데 안 먹었다"가 화면에서 안 읽힌다.
			-- 방어 스킬은 자기 몸에 걸리는 연출이라 방향을 안 뒤집는다.
			_SkillEffect:PlayCast(skillId, self.Entity, false)
			self:StartCooldown(skillId, skill.cooldown)
			return true
		end

		-- 판정 모양은 스킬마다 다르다 (T17-3). range가 0이면 기본 근접 반경을 쓴다.
		--
		-- 판정이 **플레이어 중심 원형**이라는 것이 여기서 중요하다 — 넓히면 사방이 같이
		-- 넓어진다. 방향이 있는 스킬(전방 부채꼴 등)이 필요해지면 모양 자체를 바꿔야 한다.
		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then return false end
		local worldPosition = transform.WorldPosition

		local radius = _GameData:GetBalance("player_attack_range")
		if skill.range > 0 then radius = skill.range end

		-- 던지는 스킬은 **닿을 때** 아프다 (T19-4). 보스 쪽과 같은 규칙이라
		-- 같은 스킬을 누가 쓰든 화면에서 같은 일이 일어난다.
		if skill.projectile_ruid ~= "" then
			return self:ThrowSkill(skillId, skill, worldPosition, radius, aimX, aimY)
		end

		-- 돌진하는 스킬은 **도착해서** 아프다 (T21-2). 던지는 스킬과 같은 꼴이다 —
		-- 연출이 끝나는 자리에서 판정한다.
		if skill.dash_distance > 0 then
			return self:DashSkill(skillId, skill, radius, aimX, aimY)
		end

		local shape = CircleShape(Vector2(worldPosition.x, worldPosition.y + 0.5), radius)

		-- 대상 수 예산을 이 한 방에만 걸어 둔다. IsAttackTarget이 이걸 깎는다.
		self.hitLimited = (skill.max_targets > 0)
		self.hitBudget = math.floor(skill.max_targets)

		-- 스킬 id를 attackInfo로 태운다. CalcDamage가 이걸로 계수와 scaling_stat을 고른다.
		log("[PlayerAttack] 스킬 사용 " .. tostring(activeIndex) .. "번 [" .. skill.name
			.. "]  계수=" .. tostring(skill.coefficient) .. " 스탯=" .. skill.scaling_stat
			.. "  반경=" .. string.format("%.2f", radius)
			.. "  대상=" .. (self.hitLimited and (skill.target_mode .. " 최대 " .. tostring(self.hitBudget))
				or (skill.target_mode .. " 제한 없음")))
		self:AttackFast(shape, skillId, CollisionGroups.Monster)

		-- 원작 이펙트·소리 (T19-2). 판정 뒤에 부른다 — 앞에 두면 판정이 에러로 죽었을 때
		-- 이펙트만 나가서 "때린 것 같은데 안 아픈" 화면이 된다.
		--
		-- 방향은 **바라보는 쪽**이다. 판정 자체는 플레이어 중심 원형이라 방향이 없지만
		-- (UseSkill 위 주석), 이펙트는 한쪽으로 뻗는 그림이라 등 뒤로 나가면 어색하다.
		local ctrl = self.Entity.PlayerControllerComponent
		local flip = isvalid(ctrl) and ctrl.LookDirectionX < 0
		_SkillEffect:PlayCast(skillId, self.Entity, flip)

		-- 쐈으면 쿨다운을 건다. cooldown이 0이면 걸지 않는다 (데이터로 끌 수 있게).
		self:StartCooldown(skillId, skill.cooldown)
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean ThrowSkill(string skillId, table skill, Vector3 fromPos, number radius, number aimX, number aimY)
		-- 던져서 **닿을 때** 아프게 한다 (T19-4). 몬스터 쪽 MonsterAttack.ThrowSkill과
		-- 같은 규칙이다 — 같은 스킬을 누가 쓰든 화면에서 같은 일이 일어나야 한다.
		--
		-- 조준은 **조준한 쪽의 가장 가까운 몬스터**다 (T23-2, 대표 선택 2026-08-24).
		--
		-- ⚠ 원래는 "바라보는 방향으로 **사거리만큼**" 던졌는데, T19-5에서 사거리를
		--   3.5 → 10.5로 올리면서 이 스킬이 사실상 못 쓰게 됐다: 바위가 **항상 정확히
		--   10.5유닛 자리**에 떨어지고 착탄 반경이 0.8이라, 몬스터가 10.5±0.8에 서 있어야만
		--   맞았다. **바로 옆의 몬스터는 절대 안 맞는다.** (대표 발견: "좌우로만 바위가
		--   날아가고 몬스터가 맞지 않는거 같아")
		--
		-- 자동 조준이 아니다 — **방향은 여전히 내가 겨눈다.** 겨눈 45도 부채꼴 안에서만
		-- 고르므로 엉뚱한 쪽의 몬스터는 잡히지 않는다. 사라진 것은 "거리까지 맞춰야 하는"
		-- 부분뿐이고, 그건 재미가 아니라 사고였다.
		if radius <= 0 then radius = _GameData:GetBalance("player_attack_range") end

		-- 방향: 클라가 재서 보낸 8방향 (T22-1). 0이면 바라보는 쪽으로 물러난다.
		local dx, dy = aimX, aimY
		local len = math.sqrt(dx * dx + dy * dy)
		if len > 0.01 then
			dx, dy = dx / len, dy / len
		else
			local ctrl = self.Entity.PlayerControllerComponent
			dx, dy = 1, 0
			if isvalid(ctrl) and ctrl.LookDirectionX < 0 then dx = -1 end
		end

		-- 겨눈 부채꼴 안에서 가장 가까운 몬스터를 고른다. 없으면 최대 사거리로 날아가
		-- 빗나간다 — 빈 쪽으로 던지면 헛치는 것이 맞다.
		local target = self:PickThrowTarget(fromPos, dx, dy, radius)
		local toPos = nil
		if target ~= nil then
			toPos = Vector3(target.x, target.y, fromPos.z)
		else
			toPos = Vector3(fromPos.x + dx * radius, fromPos.y + dy * radius, fromPos.z)
		end

		_SkillEffect:PlayCast(skillId, self.Entity, dx < 0)
		_SkillEffect:PlayProjectile(skillId, self.Entity, toPos)

		-- 바위와 **같은 시간**을 쓴다. 갈라지면 숫자와 그림이 어긋난다.
		local flight = _GameData:GetBalance("projectile_seconds")
		local maxTargets = skill.max_targets
		_TimerService:SetTimerOnce(function()
			self:ResolveThrowHit(skillId, toPos, maxTargets)
		end, flight)

		-- 쿨다운은 **던지는 순간** 건다 (설계 이력 2026-08-23).
		-- 닿을지는 0.35초 뒤에 정해지므로 착탄 시각에 걸면 두 가지가 깨진다:
		--   1) 빗나가면 공짜로 다시 던지게 되어 "비켜서기"가 무의미해진다
		--   2) 비행 중에는 아직 안 걸려 있어 **연타로 계속 던질 수 있다**
		-- ⚠ 2번이 실제로 났다 (대표 발견 2026-08-24: "바위 던지기가 쿨타임이 없더라고").
		--   이 갈래만 쿨다운을 안 걸고 return 했다 — 일반 공격·방어·돌진은 전부 걸고 있었다.
		self:StartCooldown(skillId, skill.cooldown)

		log("[PlayerAttack] [" .. skill.name .. "] 던짐 "
			.. string.format("%.2f,%.2f", dx, dy)
			.. (target ~= nil and " → 조준 " or " → 허공 ")
			.. string.format("%.1f,%.1f", toPos.x, toPos.y)
			.. "  " .. string.format("%.2f", flight) .. "초 뒤 착탄")
		return true
	end

	@ExecSpace("ServerOnly")
	method any PickThrowTarget(Vector3 fromPos, number dirX, number dirY, number radius)
		-- 겨눈 부채꼴 안에서 **가장 가까운** 몬스터 좌표를 돌려준다. 없으면 nil.
		--
		-- 부채꼴 반각은 데이터다 (`projectile_aim_degrees`, 기본 22.5도).
		-- 22.5도인 이유: 조준이 8방향 격자라 22.5도면 **평면이 정확히 8등분**된다 —
		-- 어느 몬스터든 여덟 방향 중 정확히 한 쪽에만 속한다. 겹치지도 비지도 않는다.
		--
		-- 몬스터 목록은 방의 RoomSpawner가 이미 들고 있다 (`spawned`). 따로 훑지 않는 이유는
		-- 그것이 스폰의 단일 원장이기 때문이다 — 여기서 별도로 모으면 두 목록이 어긋난다.
		local map = self.Entity.CurrentMap
		if map == nil then return nil end
		---@type RoomSpawner
		local spawner = map:GetComponent("script.RoomSpawner")
		if spawner == nil then return nil end

		local halfAngle = _GameData:GetBalance("projectile_aim_degrees")
		if halfAngle <= 0 then halfAngle = 22.5 end
		local minDot = math.cos(math.rad(halfAngle))

		local bestPos = nil
		local bestDist = radius + 1
		for i = 1, #spawner.spawned do
			local e = spawner.spawned[i]
			if isvalid(e) then
				local mon = e:GetComponent("script.RoomMonster")
				-- 죽은 것은 잠깐 남아 있다 (파괴 전). 그쪽으로 던지면 허공에 떨어진다.
				if mon ~= nil and mon.IsDead == false then
					local p = e.TransformComponent.WorldPosition
					local tx, ty = p.x - fromPos.x, p.y - fromPos.y
					local dist = math.sqrt(tx * tx + ty * ty)
					if dist > 0.01 and dist <= radius and dist < bestDist then
						-- 방향이 맞는지: 단위벡터끼리의 내적이 곧 사잇각의 코사인이다.
						if (tx / dist) * dirX + (ty / dist) * dirY >= minDot then
							bestDist = dist
							bestPos = p
						end
					end
				end
			end
		end
		return bestPos
	end

	@ExecSpace("ServerOnly")
	method boolean DashSkill(string skillId, table skill, number radius, number aimX, number aimY)
		-- 가고 있는 쪽으로 빠르게 돌진하고, **도착한 자리에서** 더 아프게 때린다 (T21-2).
		--
		-- 방향은 **클라가 재서 보낸 8방향**이다 (T22-1, 대표 지시 "8방향으로 통일해줘").
		--
		-- ⚠ 원래는 서버에서 `KinematicbodyComponent.MoveVelocity`를 읽었는데
		--   **그 값이 항상 0이다** (실측). 그래서 상하좌우조차 제대로 안 나오고
		--   늘 바라보는 쪽으로만 나갔다 — 대표가 "상하좌우밖에 안 된다"고 한 것이 이것이다.
		--   입력은 클라에만 있으므로 방향도 클라가 정해야 한다 (PlayerAimInput).
		local dir = Vector2(aimX, aimY)
		local len = math.sqrt(dir.x * dir.x + dir.y * dir.y)
		if len > 0.01 then
			dir = Vector2(dir.x / len, dir.y / len)
		else
			-- 서 있고 이동 이력도 없으면 **바라보는 쪽**으로 나간다.
			-- 안 그러면 멈춰서 쓰면 아무 일도 안 일어나 "먹통"으로 보인다.
			local ctrl = self.Entity.PlayerControllerComponent
			local look = 1
			if isvalid(ctrl) and ctrl.LookDirectionX < 0 then look = -1 end
			dir = Vector2(look, 0)
		end

		local seconds = _GameData:GetBalance("skill_dash_seconds")
		if seconds <= 0 then seconds = 0.2 end

		-- InputSpeed는 월드 유닛/초가 아니다. 맵 종류마다 환산이 달라
		-- (platform.md 10: RectTile은 1.2로 나눈다) 그 몫을 상수로 뺐다.
		-- 환산이 조금 틀려도 **판정은 틀리지 않는다** — 도착한 자리에서 재기 때문에
		-- 오차는 "얼마나 멀리 갔나"에만 남는다.
		local speed = skill.dash_distance / seconds * _GameData:GetBalance("skill_dash_speed_scale")

		-- 움직이는 것은 클라다 (실측: 서버 MoveToDirection은 0.00). 그 사람에게만 보낸다.
		_PlayerDash:Begin(dir.x, dir.y, seconds, speed, self.Entity.PlayerComponent.UserId)

		-- ⚠ **서버가 보는 플레이어 좌표를 믿으면 안 된다.** 움직이는 것은 클라라
		--   서버 쪽 좌표가 크게 늦는다 (실측: 실제 도착 -3.42 / -2.90인데 판정 시각에
		--   서버는 두 번 다 -1.4였다). 기다려도 안 따라온다 — 0.15초를 더 줘도 같았다.
		--   그래서 **도착 지점을 계산해서** 그 자리에서 잰다. 벽에 막히면 실제로는
		--   덜 갔을 수 있지만, 막힌 방향에는 어차피 때릴 것이 없다.
		local transform = self.Entity.TransformComponent
		local from = transform.WorldPosition
		local toPos = Vector3(
			from.x + dir.x * skill.dash_distance,
			from.y + dir.y * skill.dash_distance,
			from.z)

		local maxTargets = skill.max_targets
		_TimerService:SetTimerOnce(function()
			self:ResolveDashHit(skillId, toPos, radius, maxTargets)
		end, seconds)

		-- 쿨다운은 **떠나는 순간** 건다. 도착해서 걸면 벽에 막혀 못 간 경우에
		-- 공짜로 다시 쓸 수 있다 (던지는 스킬을 던진 순간에 거는 것과 같은 이유).
		self:StartCooldown(skillId, skill.cooldown)

		log("[PlayerAttack] [" .. skill.name .. "] 돌진 방향 "
			.. string.format("%.2f,%.2f", dir.x, dir.y)
			.. "  거리 " .. string.format("%.1f", skill.dash_distance)
			.. "  " .. string.format("%.2f", seconds) .. "초 뒤 판정")
		return true
	end

	@ExecSpace("ServerOnly")
	method void ResolveDashHit(string skillId, Vector3 pos, number radius, number maxTargets)
		-- 돌진이 끝나는 순간의 판정. 출발한 자리가 아니라 **도착할 자리**를 본다.
		-- 좌표를 인자로 받는 이유는 위 DashSkill 주석 참고 — 서버가 보는 플레이어
		-- 위치는 이 시점에 아직 출발점 근처다.
		if not isvalid(self.Entity) then return end

		local skill = _GameData:GetSkill(skillId)
		if skill == nil then return end

		self.hitLimited = (maxTargets > 0)
		self.hitBudget = math.floor(maxTargets)
		-- 부딪힌 만큼 더 아프다. CalcDamage가 이 값을 읽어 계수를 올린다 —
		-- hitLimited/hitBudget과 같은 방식이다 (한 방에만 걸고 바로 지운다).
		self.dashBonus = _GameData:GetBalance("skill_dash_damage_bonus")

		-- 몇 명 맞았는지가 로그에 남아야 "돌진했는데 허공이었다"가 보인다.
		local hits = self:Attack(
			CircleShape(Vector2(pos.x, pos.y + 0.5), radius), skillId, CollisionGroups.Monster)

		self.hitLimited = false
		self.dashBonus = 0

		-- 부딪히는 충격은 **도착해서** 터진다. 출발할 때 터지면 아무것도 없는 자리에서 번쩍인다.
		local ctrl = self.Entity.PlayerControllerComponent
		local flip = isvalid(ctrl) and ctrl.LookDirectionX < 0
		_SkillEffect:PlayCast(skillId, self.Entity, flip)

		local n = 0
		if hits ~= nil then n = #hits end
		log("[돌진] " .. skill.name .. "  도착 " .. string.format("%.1f,%.1f", pos.x, pos.y)
			.. "  반경 " .. string.format("%.2f", radius) .. " → " .. tostring(n) .. "명")
	end

	@ExecSpace("ServerOnly")
	method void ResolveThrowHit(string skillId, Vector3 pos, number maxTargets)
		-- 바위가 떨어지는 순간의 판정. 던진 자리가 아니라 **떨어진 자리**를 본다.
		if not isvalid(self.Entity) then return end

		local skill = _GameData:GetSkill(skillId)
		if skill == nil then return end

		self.hitLimited = (maxTargets > 0)
		self.hitBudget = math.floor(maxTargets)

		local r = _GameData:GetBalance("projectile_hit_radius")
		-- 평타와 달리 Attack을 쓴다 — 몇 명 맞았는지를 로그로 남겨야 "비켜서 빗나갔다"가
		-- 보인다. 던지는 스킬은 자주 나가지 않아 판정 테이블 비용이 문제가 안 된다.
		local hits = self:Attack(
			CircleShape(Vector2(pos.x, pos.y + 0.5), r), skillId, CollisionGroups.Monster)

		self.hitLimited = false

		local n = 0
		if hits ~= nil then n = #hits end
		log("[착탄] " .. skill.name .. "  " .. string.format("%.1f,%.1f", pos.x, pos.y)
			.. "  반경 " .. string.format("%.2f", r) .. " → " .. tostring(n) .. "명")
	end

	-- 실행공간을 일부러 비워둔다. 서버는 사용 판정에, 클라는 HUD 표시에 쓴다.
	-- 읽는 값이 @TargetUserSync + GameData라 양쪽에서 같은 결과가 나온다.
	-- (T5-4 GetActiveSkills, T5-5 GetOwnedCount와 같은 판단)
	method number GetCooldownRemain(string skillId)
		-- 남은 재사용 대기시간(초). 지금 쓸 수 있으면 0.
		--
		-- ⚠ 서버와 클라가 **다른 표**를 본다. `_UtilLogic.ElapsedSeconds`가 두 쪽에서
		--   다르기 때문이다 (실측 2026-08-24: 차이가 1.3초 / 10초 / 94초로 **일정하지도
		--   않다**). 서버가 적은 절대 시각을 클라에서 빼면 남은 시간이 그만큼 틀리고,
		--   차이가 크면 **늘 0으로 읽혀 스킬 바에 쿨다운이 아예 안 그려진다** (실측).
		--   그래서 서버는 `StartCooldown`에서 **길이(초)**만 넘기고 클라가 자기 시계로 센다.
		local readyAt = nil
		if self:IsClient() then
			readyAt = self.clientReadyAt[skillId]
		else
			readyAt = self.SkillReadyAt[skillId]
		end
		if readyAt == nil then return 0 end

		local remain = readyAt - _UtilLogic.ElapsedSeconds
		if remain <= 0 then return 0 end
		return remain
	end

	@ExecSpace("ServerOnly")
	method void StartCooldown(string skillId, number cooldown)
		-- 쿨다운을 거는 **유일한 창구**. 스킬이 나간 갈래마다 이걸 부른다.
		--
		-- 왜 한 곳으로 모았나: 전에는 갈래마다(일반·방어·던지기·돌진) 같은 두 줄을
		-- 손으로 적었고, **던지기 갈래에서 빠뜨려 바위 던지기가 무한 연타됐다**
		-- (T23-1, 대표 발견). 갈래가 늘 때마다 다시 빠뜨릴 자리가 생기므로 창구를 하나로 둔다.
		if cooldown <= 0 then return end
		self.SkillReadyAt[skillId] = _UtilLogic.ElapsedSeconds + cooldown
		-- 클라에는 **길이**를 보낸다. 시각을 보내면 시계 차이만큼 틀린다.
		self:OnCooldownStarted(skillId, cooldown, self.Entity.PlayerComponent.UserId)
	end

	@ExecSpace("Client")
	method void OnCooldownStarted(string skillId, number cooldown)
		-- 서버가 쿨다운을 걸었다고 알려 준다. 길이만 받아 **클라 시계**로 다시 적는다.
		if cooldown <= 0 then return end
		self.clientReadyAt[skillId] = _UtilLogic.ElapsedSeconds + cooldown
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		-- 데미지 공식은 CombatFormula 한 곳에만 둔다.
		-- 작업지시서 T3 함정: 계산을 클라로 옮기면 이후 전부 재작업이다.
		-- 이 훅은 서버 히트 파이프라인만 호출하므로 결과는 서버 권한이다.
		--
		-- ⚠ 부모 AttackComponent.CalcDamage에는 @ExecSpace가 없다.
		--   여기에 붙이면 LEA-3014 SignatureMismatch가 난다.
		-- attackInfo에 스킬 id가 실려 온다. 기본 공격은 nil이라 시트 기준 계수가 쓰인다.
		-- 스킬마다 scaling_stat이 다르므로(SkillTable: ATK / INT) 어느 스탯을 쓸지도
		-- 여기서 갈린다. 마법사 스킬을 ATK로 계산하면 조용히 틀린 숫자가 나온다.
		--
		-- 스킬은 자기 scaling_stat을 그대로 따르고, **기본 공격만 ATK/INT 중 높은 쪽**을 쓴다
		-- (밸런스시트 v0.2 "자동 공격 계수 스탯 = max(ATK, INT)", 작업지시서 T9-4 결정).
		--
		-- 왜 필요했나 (T9-3 실측): 기본 공격이 ATK 고정이었는데 그게 총딜의 83%를 낸다.
		-- 그래서 INT에 투자하면 총딜이 1/3로 떨어져 INT 빌드가 성립할 수 없었다.
		-- 높은 쪽을 쓰면 "스탯을 어디에 찍었나"가 곧 계열을 정한다.
		---@type PlayerStats
		local stats = attacker:GetComponent("script.PlayerStats")

		local statName = "ATK"
		if attackInfo ~= nil and attackInfo ~= "" then
			local skill = _GameData:GetSkill(attackInfo)
			if skill ~= nil and skill.scaling_stat ~= "" then
				statName = skill.scaling_stat
			end
		elseif stats ~= nil and stats:GetTotalInt() > stats:GetTotalAtk() then
			statName = "INT"
		end

		local power = _GameData:GetBalance("player_base_atk")
		if stats ~= nil then
			if statName == "INT" then
				power = stats:GetTotalInt()
			elseif statName == "LUK" then
				-- LUK 계수 스킬 (T10-4 결정). LUK 기본값은 0이라 안 찍으면 데미지도 0이다 —
				-- 그게 의도다. 투자한 사람만 쓰는 스킬이 된다 (포자 살포와 같은 성질).
				power = stats:GetTotalLuk()
			elseif statName == "ATK" then
				power = stats:GetTotalAtk()
			else
				-- 알 수 없는 계수 스탯은 조용히 ATK로 떨어뜨리지 않는다.
				-- 여기가 실제로 새어나간 자리다: LUK 스킬을 넣기 전 이 분기는
				-- "INT가 아니면 ATK"였고, scaling_stat=LUK이 아무 경고 없이
				-- ATK로 계산됐다. 새 스탯을 추가할 때 같은 함정에 빠지지 않게 남긴다.
				log_warning("[PlayerAttack] SkillTable의 scaling_stat을 모르겠다: '"
					.. tostring(statName) .. "' — ATK로 계산한다")
				power = stats:GetTotalAtk()
			end
		end

		local def = 0
		---@type RoomMonster
		local monster = defender:GetComponent("script.RoomMonster")
		if monster ~= nil then
			def = monster.Def
		end

		-- 중복 보유가 계수를 올린다 (T15-2). 몇 장 가졌는지는 플레이어의 것이라
		-- CombatFormula가 알 수 없어, 여기서 개수를 읽어 계수를 만들고 넘긴다.
		--
		-- 몬스터 스킬만 쌓인다(`source == "monster"`): NPC 스킬은 격파로 **1장 고정**이라
		-- 중복 자체가 생기지 않는다 (설계 이력 2026-08-20). 안 가르면 NPC 스킬이
		-- 보유수 0으로 읽혀 계수가 깎인다.
		local coefficient = _CombatFormula:GetSkillCoefficient(attackInfo)
		local stack = 1
		if attackInfo ~= nil and attackInfo ~= "" then
			local skill = _GameData:GetSkill(attackInfo)
			if skill ~= nil and skill.source == "monster" then
				---@type PlayerCollection
				local collection = attacker:GetComponent("script.PlayerCollection")
				if collection ~= nil then
					local owned = collection:GetOwnedCount(attackInfo)
					if owned > 1 then
						stack = owned
						coefficient = _CombatFormula:StackedCoefficient(coefficient, owned)
					end
				end
			end
		end

		-- 돌진해서 부딪힌 한 방은 더 아프다 (T21-2). 계수에 얹는 이유는 중복 강화와 같다 —
		-- 데미지 산술은 CombatFormula 한 곳에만 두고, 여기서는 **계수만** 만든다.
		if self.dashBonus > 0 then
			coefficient = coefficient * (1 + self.dashBonus)
		end

		local damage = _CombatFormula:CalcDamage(power, def, coefficient)

		-- 몬스터 실드 감쇄 (T19-1). 보스가 자기 방어 스킬을 쓰면 여기서 깎인다.
		--
		-- **여기서** 깎는 이유는 MonsterAttack.CalcDamage와 같다 — 이 반환값이 곧
		-- 화면에 뜨는 데미지 숫자다. RoomMonster.HandleHitEvent에서 깎으면 숫자는
		-- 그대로인데 HP만 덜 닳아 "실드가 먹었는지"가 화면에서 안 읽힌다.
		local reduceText = ""
		if monster ~= nil then
			local reduction = monster:GetDamageReduction()
			if reduction > 0 then
				local before = damage
				damage = math.floor(damage * (1 - reduction) + 0.5)
				if damage < 1 then damage = 1 end
				reduceText = "  [상대 실드 " .. tostring(math.floor(reduction * 100)) .. "% : "
					.. tostring(before) .. " → " .. tostring(damage) .. "]"
			end
		end

		log("[PlayerAttack] " .. statName .. "=" .. tostring(power) .. " vs DEF=" .. tostring(def)
			.. "  스킬=" .. tostring(attackInfo == nil and "기본공격" or attackInfo)
			.. "  계수=" .. string.format("%.3f", coefficient)
			.. (stack > 1 and " (중복 " .. tostring(stack) .. "장 강화)" or "")
			.. " → 데미지 " .. tostring(damage) .. reduceText)
		return damage
	end

	method boolean CalcCritical(Entity attacker, Entity defender, string attackInfo)
		-- 크리티컬은 밸런스시트에 없다. 샘플의 30%/2배는 우리 시트에 근거가 없어 끈다
		-- (하드코딩 금지 — 개발 규칙 3). 켜두면 T3 완료 조건인
		-- "시트 예측과 일치"가 무너진다(3~4타가 2~4타로 흔들린다).
		-- 시트 v0.2에서 확률·배율이 정해지면 GameBalance 키를 읽어 되살린다.
		return false
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandlePlayerActionEvent(PlayerActionEvent event)
		-- 자동 공격으로 바뀌었으니 여기서 AttackNormal을 또 부르지 않는다.
		-- 부르면 버튼을 누를 때마다 주기와 무관하게 한 대가 더 들어가 DPS가 튄다.
		-- 이 핸들러는 T5에서 액티브 스킬 입력을 받을 자리로 남겨둔다.
		if event.ActionName == "Attack" then
			-- T5: 장착된 액티브 스킬 발동
		end
	end

end