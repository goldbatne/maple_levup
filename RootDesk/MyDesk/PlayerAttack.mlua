@Component
script PlayerAttack extends AttackComponent

	@HideFromInspector
	property any Shape = nil
	@HideFromInspector
	property integer autoAttackTimer = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 판정을 원형으로 둔다. 우리 맵은 RectTile 탑다운이라 사방에서 몬스터가 붙는데,
		-- LookDirectionX 방향 박스는 좌우만 커버해서 위/아래 몬스터를 못 때린다.
		-- 반경은 시트가 아니라 GameBalance의 구현 상수에서 읽는다 (하드코딩 금지 — 개발 규칙 3).
		self.Shape = CircleShape(Vector2.zero, _GameData:GetBalance("player_attack_range"))

		-- 기본 공격은 자동이다 (작업지시서 T3: "기본 공격은 자동(근접 범위 판정)").
		-- 버튼 탭은 T5의 액티브 스킬 몫이라 여기서 입력을 받지 않는다.
		self.autoAttackTimer = _TimerService:SetTimerRepeat(function()
			self:AttackNormal()
		end, _GameData:GetBalance("player_attack_interval"))
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 타이머를 남기면 맵을 옮기거나 스크립트를 리로드할 때 유령 공격이 계속 돈다.
		if self.autoAttackTimer ~= 0 then
			_TimerService:ClearTimer(self.autoAttackTimer)
			self.autoAttackTimer = 0
		end
	end

	@ExecSpace("ServerOnly")
	method void AttackNormal()
		-- 플레이어를 중심으로 한 원형 판정. 방향에 상관없이 닿는 몬스터를 전부 친다.
		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then return end

		local worldPosition = transform.WorldPosition
		-- 발밑이 원점이라 반 칸 올려야 몸통 높이에서 판정된다.
		self.Shape.Position = Vector2(worldPosition.x, worldPosition.y + 0.5)
		self:AttackFast(self.Shape, nil, CollisionGroups.Monster)
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		-- 데미지 공식은 CombatFormula 한 곳에만 둔다.
		-- 작업지시서 T3 함정: 계산을 클라로 옮기면 이후 전부 재작업이다.
		-- 이 훅은 서버 히트 파이프라인만 호출하므로 결과는 서버 권한이다.
		--
		-- ⚠ 부모 AttackComponent.CalcDamage에는 @ExecSpace가 없다.
		--   여기에 붙이면 LEA-3014 SignatureMismatch가 난다.
		local atk = _GameData:GetBalance("player_base_atk")
		---@type PlayerStats
		local stats = attacker:GetComponent("script.PlayerStats")
		if stats ~= nil then
			atk = stats:GetTotalAtk()
		end

		local def = 0
		---@type RoomMonster
		local monster = defender:GetComponent("script.RoomMonster")
		if monster ~= nil then
			def = monster.Def
		end

		local damage = _CombatFormula:CalcSkillDamage(atk, def, attackInfo)
		log("[PlayerAttack] ATK=" .. tostring(atk) .. " vs DEF=" .. tostring(def)
			.. " → 데미지 " .. tostring(damage))
		return damage
	end

	method boolean CalcCritical(Entity attacker, Entity defender, string attackInfo)
		-- 크리티컬은 밸런스시트에 없다. 샘플의 30%/2배는 우리 시트에 근거가 없어 끈다
		-- (하드코딩 금지 — 개발 규칙 3). 켜두면 T3 완료 조건인
		-- "시트 예측과 일치"가 무너진다(3~4타가 2~4타로 흔들린다).
		-- 시트 v0.2에서 확률·배율이 정해지면 GameBalance 키를 읽어 되살린다.
		return false
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandlePlayerActionEvent(PlayerActionEvent event)
		-- 자동 공격으로 바뀌었으니 여기서 AttackNormal을 또 부르지 않는다.
		-- 부르면 버튼을 누를 때마다 주기와 무관하게 한 대가 더 들어가 DPS가 튄다.
		-- 이 핸들러는 T5에서 액티브 스킬 입력을 받을 자리로 남겨둔다.
		if event.ActionName == "Attack" then
			-- T5: 장착된 액티브 스킬 발동
		end
	end

end