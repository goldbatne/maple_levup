@Component
script PlayerAttack extends AttackComponent

	@HideFromInspector
	property any Shape = nil
	@HideFromInspector
	property integer autoAttackTimer = 0

	-- 이번 한 방이 때릴 수 있는 대상 수 (T17-3).
	-- 엔진에 "최대 타격 수"가 없어서(msw-combat-system 1-2: "not native. Manage in script")
	-- 후보를 훑는 IsAttackTarget 훅에서 직접 센다.
	--   hitLimited=false  제한 없음 (기본 공격 · area 스킬)
	--   hitLimited=true   hitBudget 만큼만 맞고 나머지는 걸러낸다
	@HideFromInspector property boolean hitLimited = false
	@HideFromInspector property integer hitBudget = 0

	-- skillId -> 다시 쓸 수 있게 되는 시각(월드 경과초). 비어 있으면 즉시 사용 가능.
	--
	-- @TargetUserSync인 이유: 판정은 서버가 하지만 HUD도 남은 시간을 그려야 한다.
	-- 서버만 들고 있으면 클라가 매번 물어봐야 하고, 클라만 들고 있으면 위조된다.
	@TargetUserSync property SyncTable<string, number> SkillReadyAt

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 판정을 원형으로 둔다. 우리 맵은 RectTile 탑다운이라 사방에서 몬스터가 붙는데,
		-- LookDirectionX 방향 박스는 좌우만 커버해서 위/아래 몬스터를 못 때린다.
		-- 반경은 시트가 아니라 GameBalance의 구현 상수에서 읽는다 (하드코딩 금지 — 개발 규칙 3).
		self.Shape = CircleShape(Vector2.zero, _GameData:GetBalance("player_attack_range"))

		-- 기본 공격은 자동이다 (작업지시서 T3: "기본 공격은 자동(근접 범위 판정)").
		-- 버튼 탭은 T5의 액티브 스킬 몫이라 여기서 입력을 받지 않는다.
		self.autoAttackTimer = _TimerService:SetTimerRepeat(function()
			self:AttackNormal()
		end, _GameData:GetBalance("player_attack_interval"))
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 타이머를 남기면 맵을 옮기거나 스크립트를 리로드할 때 유령 공격이 계속 돈다.
		if self.autoAttackTimer ~= 0 then
			_TimerService:ClearTimer(self.autoAttackTimer)
			self.autoAttackTimer = 0
		end
	end

	@ExecSpace("ServerOnly")
	method void AttackNormal()
		-- 플레이어를 중심으로 한 원형 판정. 방향에 상관없이 닿는 몬스터를 전부 친다.
		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then return end

		local worldPosition = transform.WorldPosition
		-- 발밑이 원점이라 반 칸 올려야 몸통 높이에서 판정된다.
		self.Shape.Position = Vector2(worldPosition.x, worldPosition.y + 0.5)
		-- 기본 공격은 예나 지금이나 닿는 것을 전부 친다. 제한을 걸지 않는다.
		self.hitLimited = false
		self:AttackFast(self.Shape, nil, CollisionGroups.Monster)
	end

	@ExecSpace("ServerOnly")
	method boolean UseDefenseSkill(table skill)
		-- 방어 스킬의 효과를 건다 (T17-3b). 실제로 효과가 들어갔을 때만 true —
		-- false면 호출부가 쿨다운을 걸지 않는다.
		--
		-- 효과 자체는 PlayerHit이 갖고 있다. 여기서 pc.Hp나 감쇄 상태를 직접 만지지
		-- 않는다 — 받는 피해를 만지는 곳이 둘로 갈라지면 반드시 어긋난다
		-- (PlayerInventory가 Heal을 부르는 것과 같은 판단).
		---@type PlayerHit
		local hit = self.Entity:GetComponent("script.PlayerHit")
		if hit == nil then
			log_warning("[PlayerAttack] PlayerHit이 없어 방어 스킬을 걸 수 없다")
			return false
		end

		if skill.effect_type == "shield" then
			hit:ApplyShield(skill.effect_value, skill.duration)
			log("[PlayerAttack] 방어 스킬 [" .. skill.name .. "] 실드 "
				.. tostring(math.floor(skill.effect_value * 100)) .. "% / "
				.. tostring(skill.duration) .. "초")
			return true
		end

		if skill.effect_type == "heal" then
			-- 회복 스킬은 아직 데이터에 없다 (모험가 NPC 몫 — T16-3). 미리 열어 두면
			-- 그때 CSV 한 줄로 붙는다. 만피면 0을 돌려받아 쿨다운도 안 걸린다
			-- (포션과 같은 규칙 — 효과가 없으면 대가도 없다).
			local healed = hit:Heal(skill.effect_value)
			if healed <= 0 then
				log("[PlayerAttack] [" .. skill.name .. "] 이미 체력이 가득해 쓰지 않았다")
				return false
			end
			log("[PlayerAttack] 방어 스킬 [" .. skill.name .. "] 회복 " .. tostring(healed))
			return true
		end

		log_warning("[PlayerAttack] 모르는 방어 효과라 아무것도 하지 않았다: ["
			.. skill.name .. "] " .. tostring(skill.effect_type))
		return false
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		-- 대상 수 제한 (T17-3). `max_targets`가 1이면 범위 안에 여럿이 있어도 하나만 맞는다.
		--
		-- ⚠ 부모 AttackComponent.IsAttackTarget에는 @ExecSpace가 없다.
		--   여기에 붙이면 LEA-3014 SignatureMismatch가 난다 (CalcDamage와 같은 함정).
		--
		-- 왜 이 훅에서 세는가: 엔진에 최대 타격 수가 없다. 판정 후보를 하나씩 물어보는
		-- 곳이 여기뿐이라, 예산을 깎아 가며 false를 돌려주는 것이 유일한 방법이다.
		if __base:IsAttackTarget(defender, attackInfo) == false then return false end
		if self.hitLimited == false then return true end
		if self.hitBudget <= 0 then return false end

		self.hitBudget = self.hitBudget - 1
		return true
	end

	@ExecSpace("Server")
	method void RequestUseSkill(integer activeIndex)
		-- 클라 버튼 → 서버. senderUserId는 서버가 채우므로 위조할 수 없다.
		if senderUserId ~= self.Entity.PlayerComponent.UserId then
			log_warning("[PlayerAttack] 남의 스킬 사용 시도 차단: " .. tostring(senderUserId))
			return
		end
		self:UseSkill(activeIndex)
	end

	@ExecSpace("ServerOnly")
	method boolean UseSkill(integer activeIndex)
		-- GetActiveSkills()의 순번으로 쏜다. 호출부는 스킬의 출처를 구분하지 않는다
		-- (작업지시서 T5 요청 3: 사용 인터페이스는 통일).
		---@type PlayerSkillSlots
		local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
		if slots == nil then return false end

		local active = slots:GetActiveSkills()
		local skillId = active[activeIndex]
		if skillId == nil then
			log_warning("[PlayerAttack] 그 자리에 장착된 스킬이 없다: " .. tostring(activeIndex)
				.. " (보유 액티브 " .. tostring(#active) .. "개)")
			return false
		end

		local skill = _GameData:GetSkill(skillId)
		if skill == nil then return false end

		-- 쿨다운 판정은 서버가 한다. 클라 HUD도 같은 값을 보고 버튼을 흐리지만,
		-- 그건 안내일 뿐이고 실제로 막는 건 여기다 (개발 규칙 2).
		--
		-- 공격·방어 갈래보다 **앞에** 둔다. 방어 스킬만 쿨다운을 안 타면
		-- 실드를 연타해 계속 유지할 수 있다.
		local remain = self:GetCooldownRemain(skillId)
		if remain > 0 then
			log("[PlayerAttack] 쿨다운 중 [" .. skill.name .. "] "
				.. string.format("%.1f", remain) .. "초 남음")
			return false
		end

		-- 방어 스킬은 때리지 않는다 (T17-3b). 여기서 갈라 보내지 않으면
		-- 계수 0이 기준 계수(1.2)로 대체돼 **실드가 때리는 스킬로 나간다.**
		if skill.skill_kind == "defense" then
			if self:UseDefenseSkill(skill) == false then return false end
			if skill.cooldown > 0 then
				self.SkillReadyAt[skillId] = _UtilLogic.ElapsedSeconds + skill.cooldown
			end
			return true
		end

		-- 판정 모양은 스킬마다 다르다 (T17-3). range가 0이면 기본 근접 반경을 쓴다.
		--
		-- 판정이 **플레이어 중심 원형**이라는 것이 여기서 중요하다 — 넓히면 사방이 같이
		-- 넓어진다. 방향이 있는 스킬(전방 부채꼴 등)이 필요해지면 모양 자체를 바꿔야 한다.
		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then return false end
		local worldPosition = transform.WorldPosition

		local radius = _GameData:GetBalance("player_attack_range")
		if skill.range > 0 then radius = skill.range end
		local shape = CircleShape(Vector2(worldPosition.x, worldPosition.y + 0.5), radius)

		-- 대상 수 예산을 이 한 방에만 걸어 둔다. IsAttackTarget이 이걸 깎는다.
		self.hitLimited = (skill.max_targets > 0)
		self.hitBudget = math.floor(skill.max_targets)

		-- 스킬 id를 attackInfo로 태운다. CalcDamage가 이걸로 계수와 scaling_stat을 고른다.
		log("[PlayerAttack] 스킬 사용 " .. tostring(activeIndex) .. "번 [" .. skill.name
			.. "]  계수=" .. tostring(skill.coefficient) .. " 스탯=" .. skill.scaling_stat
			.. "  반경=" .. string.format("%.2f", radius)
			.. "  대상=" .. (self.hitLimited and (skill.target_mode .. " 최대 " .. tostring(self.hitBudget))
				or (skill.target_mode .. " 제한 없음")))
		self:AttackFast(shape, skillId, CollisionGroups.Monster)

		-- 쐈으면 쿨다운을 건다. cooldown이 0이면 걸지 않는다 (데이터로 끌 수 있게).
		if skill.cooldown > 0 then
			self.SkillReadyAt[skillId] = _UtilLogic.ElapsedSeconds + skill.cooldown
		end
		return true
	end

	-- 실행공간을 일부러 비워둔다. 서버는 사용 판정에, 클라는 HUD 표시에 쓴다.
	-- 읽는 값이 @TargetUserSync + GameData라 양쪽에서 같은 결과가 나온다.
	-- (T5-4 GetActiveSkills, T5-5 GetOwnedCount와 같은 판단)
	method number GetCooldownRemain(string skillId)
		-- 남은 재사용 대기시간(초). 지금 쓸 수 있으면 0.
		local readyAt = self.SkillReadyAt[skillId]
		if readyAt == nil then return 0 end

		local remain = readyAt - _UtilLogic.ElapsedSeconds
		if remain <= 0 then return 0 end
		return remain
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		-- 데미지 공식은 CombatFormula 한 곳에만 둔다.
		-- 작업지시서 T3 함정: 계산을 클라로 옮기면 이후 전부 재작업이다.
		-- 이 훅은 서버 히트 파이프라인만 호출하므로 결과는 서버 권한이다.
		--
		-- ⚠ 부모 AttackComponent.CalcDamage에는 @ExecSpace가 없다.
		--   여기에 붙이면 LEA-3014 SignatureMismatch가 난다.
		-- attackInfo에 스킬 id가 실려 온다. 기본 공격은 nil이라 시트 기준 계수가 쓰인다.
		-- 스킬마다 scaling_stat이 다르므로(SkillTable: ATK / INT) 어느 스탯을 쓸지도
		-- 여기서 갈린다. 마법사 스킬을 ATK로 계산하면 조용히 틀린 숫자가 나온다.
		--
		-- 스킬은 자기 scaling_stat을 그대로 따르고, **기본 공격만 ATK/INT 중 높은 쪽**을 쓴다
		-- (밸런스시트 v0.2 "자동 공격 계수 스탯 = max(ATK, INT)", 작업지시서 T9-4 결정).
		--
		-- 왜 필요했나 (T9-3 실측): 기본 공격이 ATK 고정이었는데 그게 총딜의 83%를 낸다.
		-- 그래서 INT에 투자하면 총딜이 1/3로 떨어져 INT 빌드가 성립할 수 없었다.
		-- 높은 쪽을 쓰면 "스탯을 어디에 찍었나"가 곧 계열을 정한다.
		---@type PlayerStats
		local stats = attacker:GetComponent("script.PlayerStats")

		local statName = "ATK"
		if attackInfo ~= nil and attackInfo ~= "" then
			local skill = _GameData:GetSkill(attackInfo)
			if skill ~= nil and skill.scaling_stat ~= "" then
				statName = skill.scaling_stat
			end
		elseif stats ~= nil and stats:GetTotalInt() > stats:GetTotalAtk() then
			statName = "INT"
		end

		local power = _GameData:GetBalance("player_base_atk")
		if stats ~= nil then
			if statName == "INT" then
				power = stats:GetTotalInt()
			elseif statName == "LUK" then
				-- LUK 계수 스킬 (T10-4 결정). LUK 기본값은 0이라 안 찍으면 데미지도 0이다 —
				-- 그게 의도다. 투자한 사람만 쓰는 스킬이 된다 (포자 살포와 같은 성질).
				power = stats:GetTotalLuk()
			elseif statName == "ATK" then
				power = stats:GetTotalAtk()
			else
				-- 알 수 없는 계수 스탯은 조용히 ATK로 떨어뜨리지 않는다.
				-- 여기가 실제로 새어나간 자리다: LUK 스킬을 넣기 전 이 분기는
				-- "INT가 아니면 ATK"였고, scaling_stat=LUK이 아무 경고 없이
				-- ATK로 계산됐다. 새 스탯을 추가할 때 같은 함정에 빠지지 않게 남긴다.
				log_warning("[PlayerAttack] SkillTable의 scaling_stat을 모르겠다: '"
					.. tostring(statName) .. "' — ATK로 계산한다")
				power = stats:GetTotalAtk()
			end
		end

		local def = 0
		---@type RoomMonster
		local monster = defender:GetComponent("script.RoomMonster")
		if monster ~= nil then
			def = monster.Def
		end

		-- 중복 보유가 계수를 올린다 (T15-2). 몇 장 가졌는지는 플레이어의 것이라
		-- CombatFormula가 알 수 없어, 여기서 개수를 읽어 계수를 만들고 넘긴다.
		--
		-- 몬스터 스킬만 쌓인다(`source == "monster"`): NPC 스킬은 격파로 **1장 고정**이라
		-- 중복 자체가 생기지 않는다 (설계 이력 2026-08-20). 안 가르면 NPC 스킬이
		-- 보유수 0으로 읽혀 계수가 깎인다.
		local coefficient = _CombatFormula:GetSkillCoefficient(attackInfo)
		local stack = 1
		if attackInfo ~= nil and attackInfo ~= "" then
			local skill = _GameData:GetSkill(attackInfo)
			if skill ~= nil and skill.source == "monster" then
				---@type PlayerCollection
				local collection = attacker:GetComponent("script.PlayerCollection")
				if collection ~= nil then
					local owned = collection:GetOwnedCount(attackInfo)
					if owned > 1 then
						stack = owned
						coefficient = _CombatFormula:StackedCoefficient(coefficient, owned)
					end
				end
			end
		end

		local damage = _CombatFormula:CalcDamage(power, def, coefficient)

		-- 몬스터 실드 감쇄 (T19-1). 보스가 자기 방어 스킬을 쓰면 여기서 깎인다.
		--
		-- **여기서** 깎는 이유는 MonsterAttack.CalcDamage와 같다 — 이 반환값이 곧
		-- 화면에 뜨는 데미지 숫자다. RoomMonster.HandleHitEvent에서 깎으면 숫자는
		-- 그대로인데 HP만 덜 닳아 "실드가 먹었는지"가 화면에서 안 읽힌다.
		local reduceText = ""
		if monster ~= nil then
			local reduction = monster:GetDamageReduction()
			if reduction > 0 then
				local before = damage
				damage = math.floor(damage * (1 - reduction) + 0.5)
				if damage < 1 then damage = 1 end
				reduceText = "  [상대 실드 " .. tostring(math.floor(reduction * 100)) .. "% : "
					.. tostring(before) .. " → " .. tostring(damage) .. "]"
			end
		end

		log("[PlayerAttack] " .. statName .. "=" .. tostring(power) .. " vs DEF=" .. tostring(def)
			.. "  스킬=" .. tostring(attackInfo == nil and "기본공격" or attackInfo)
			.. "  계수=" .. string.format("%.3f", coefficient)
			.. (stack > 1 and " (중복 " .. tostring(stack) .. "장 강화)" or "")
			.. " → 데미지 " .. tostring(damage) .. reduceText)
		return damage
	end

	method boolean CalcCritical(Entity attacker, Entity defender, string attackInfo)
		-- 크리티컬은 밸런스시트에 없다. 샘플의 30%/2배는 우리 시트에 근거가 없어 끈다
		-- (하드코딩 금지 — 개발 규칙 3). 켜두면 T3 완료 조건인
		-- "시트 예측과 일치"가 무너진다(3~4타가 2~4타로 흔들린다).
		-- 시트 v0.2에서 확률·배율이 정해지면 GameBalance 키를 읽어 되살린다.
		return false
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandlePlayerActionEvent(PlayerActionEvent event)
		-- 자동 공격으로 바뀌었으니 여기서 AttackNormal을 또 부르지 않는다.
		-- 부르면 버튼을 누를 때마다 주기와 무관하게 한 대가 더 들어가 DPS가 튄다.
		-- 이 핸들러는 T5에서 액티브 스킬 입력을 받을 자리로 남겨둔다.
		if event.ActionName == "Attack" then
			-- T5: 장착된 액티브 스킬 발동
		end
	end

end