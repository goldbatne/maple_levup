-- @서버 (HP 차감·사망 판정은 서버 권한. 클라는 동기화된 HP를 표시만 한다)
--
-- 샘플은 i-frame만 있었고 **HP를 깎는 코드가 없었다.**
-- 그래서 T10-3 실측에서 4초간 맞아도 HP가 1000 → 1000이었다 — 플레이어는 사실상 불사였다.
-- 맞는 것에 대가가 없으면 DEF도, "방어가 필요한 방"도 의미가 없다.
--
-- HP는 PlayerComponent가 네이티브로 갖고 있다. 커스텀 Hp 프로퍼티를 만들지 않는다
-- (msw-combat-system 9: "Do not create custom Hp/MaxHp properties").

@Component
script PlayerHit extends HitComponent

	@MinValue(0)
	property number ImmuneCooldown = 1

	@HideFromInspector
	property number LastHitTime = 0

	-- 실드 (T17-3b). 받는 피해를 ShieldRatio만큼 깎는 상태를 ShieldUntil까지 유지한다.
	--
	-- @TargetUserSync인 이유: 판정은 서버가 하지만 HUD도 "지금 실드 중"을 그려야 한다.
	-- 남의 실드까지 새어 나가면 안 되므로 @Sync가 아니다 (SkillReadyAt과 같은 판단).
	--
	-- 왜 PlayerHit에 있는가: 받는 피해를 만지는 것은 이 파일의 일이다. 새 컴포넌트를
	-- 만들면 DefaultPlayer.model도 건드려야 하고 피해 규칙이 두 곳으로 갈라진다
	-- (OnMapEnter·Heal 주석과 같은 이유).
	@TargetUserSync property number ShieldRatio = 0
	@TargetUserSync property number ShieldUntil = 0

	method void OnHit(Entity attacker, integer damage, boolean isCritical, string attackInfo, int32 hitCount)
		-- 실제 HP 차감. 데미지 자체는 공격자(MonsterAttack.CalcDamage)가 계산했고
		-- 거기서 플레이어 DEF가 이미 반영됐다.
		--
		-- ⚠ 부모 HitComponent.OnHit에는 @ExecSpace가 없다 — 붙이면 LEA-3014.
		--   히트 파이프라인이 서버에서 도므로 실제 실행은 서버다.
		local pc = self.Entity.PlayerComponent
		if not isvalid(pc) then return end
		if pc:IsDead() then return end

		pc.Hp = pc.Hp - damage
		log("[PlayerHit] 피격 -" .. tostring(damage) .. "  HP " .. tostring(pc.Hp + damage)
			.. " → " .. tostring(pc.Hp) .. " / " .. tostring(pc.MaxHp))

		if pc.Hp <= 0 then
			self:HandleDeath()
		end
	end

	@ExecSpace("ServerOnly")
	method void OnMapEnter(Entity enterEntity)
		-- 마을에 들어오면 HP를 전부 채운다 (T13-1).
		--
		-- 왜 필요한가: 이걸 넣기 전까지 **회복 수단이 하나도 없었다.** HP 1000은
		-- 엔진 기본값 고정이고 레벨로 자라지도 않는데, 채우는 경로가 아래 HandleDeath의
		-- Respawn() 뿐이었다. 그래서 "일부러 죽는 것"이 유일한 회복법이 되어,
		-- 죽음의 대가(시작방 귀환)가 대가가 아니라 **회복 보상**으로 뒤집혀 있었다.
		--
		-- 왜 PlayerHit에 있는가: HP를 만지는 코드를 한 파일에 모아 둔다. 새 컴포넌트를
		-- 만들면 DefaultPlayer.model도 건드려야 하고, HP 규칙이 두 곳으로 갈라진다.
		--
		-- 왜 맵 이름이 아니라 room_type인가: "maptown"을 코드에 박으면 마을을 옮기거나
		-- 둘째 마을을 만들 때 조용히 깨진다. RoomTable이 town을 알고 있으므로 그걸 읽는다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end

		local room = _GameData:GetRoomByMapName(map.Name)
		if room == nil or room.room_type ~= "town" then return end

		local pc = self.Entity.PlayerComponent
		if not isvalid(pc) then return end
		if pc:IsDead() then return end

		-- 이미 만피면 조용히 물러난다. 사망 직후에는 Respawn()이 먼저 채우고
		-- 마을로 옮기므로 여기서 또 알리면 배너가 두 번 뜬다.
		if pc.Hp >= pc.MaxHp then return end

		local before = pc.Hp
		pc.Hp = pc.MaxHp
		log("[PlayerHit] 마을 회복  HP " .. tostring(before)
			.. " → " .. tostring(pc.Hp) .. " / " .. tostring(pc.MaxHp))
		self:OnRested(pc.UserId)
	end

	@ExecSpace("ServerOnly")
	method number Heal(number amount)
		-- HP를 채운다. **실제로 채운 양**을 돌려준다 (T13-7).
		--
		-- 0을 돌려주면 "이미 가득하거나 죽었다"는 뜻이다. 포션(PlayerInventory.UseItem)이
		-- 이 값을 보고 소모할지 정한다 — 만피에서 마시면 개수만 줄고 아무 일도 안 일어나는
		-- 것이 제일 나쁘다.
		--
		-- 왜 여기 있는가: HP를 만지는 코드를 이 파일에 모아 둔다 (OnMapEnter 주석과 같은 이유).
		-- 인벤토리가 pc.Hp를 직접 만지면 HP 규칙이 두 곳으로 갈라진다.
		if amount <= 0 then return 0 end

		local pc = self.Entity.PlayerComponent
		if not isvalid(pc) then return 0 end
		if pc:IsDead() then return 0 end
		if pc.Hp >= pc.MaxHp then return 0 end

		local before = pc.Hp
		local after = before + amount
		if after > pc.MaxHp then after = pc.MaxHp end
		pc.Hp = after

		local healed = after - before
		log("[PlayerHit] 회복 +" .. tostring(healed)
			.. "  HP " .. tostring(before) .. " → " .. tostring(after) .. " / " .. tostring(pc.MaxHp))
		return healed
	end

	@ExecSpace("ServerOnly")
	method void ApplyShield(number ratio, number seconds)
		-- 실드를 건다 (T17-3b). 이미 걸려 있으면 덮어쓴다 — 겹쳐 쌓지 않는다.
		--
		-- 겹치기를 막는 이유: 같은 스킬을 연타해 감쇄가 누적되면 쿨다운만 버티면
		-- 사실상 무적이 된다. 지속 시간만 새로 고치는 편이 규칙이 단순하다.
		if ratio <= 0 or seconds <= 0 then return end

		-- 상한을 둔다. CSV에 1.0이 들어가면 **피해가 0이 되어 무적**이 되는데,
		-- 그건 데이터 오타 한 번으로 게임이 무너지는 자리다. 최소 한 대는 아파야 한다.
		if ratio > 0.9 then
			log_warning("[PlayerHit] 실드 감쇄율이 너무 크다(" .. tostring(ratio) .. ") — 0.9로 자른다")
			ratio = 0.9
		end

		self.ShieldRatio = ratio
		self.ShieldUntil = _UtilLogic.ElapsedSeconds + seconds
		log("[PlayerHit] 실드 " .. tostring(math.floor(ratio * 100)) .. "% 감쇄  "
			.. tostring(seconds) .. "초")

		local pc = self.Entity.PlayerComponent
		if isvalid(pc) then
			self:OnShielded(math.floor(ratio * 100), seconds, pc.UserId)
		end
	end

	-- 실행공간을 비워둔다. 서버는 데미지 감쇄에, 클라는 표시에 쓴다.
	-- 읽는 값이 @TargetUserSync라 주인 클라에도 같은 값이 있다.
	method number GetDamageReduction()
		-- 지금 받는 피해를 얼마나 깎는가. 실드가 없거나 만료면 0.
		if self.ShieldRatio <= 0 then return 0 end
		if _UtilLogic.ElapsedSeconds >= self.ShieldUntil then return 0 end
		return self.ShieldRatio
	end

	@ExecSpace("Client")
	method void OnShielded(integer percent, number seconds)
		-- 당사자에게만 알린다 (OnRested·OnDied와 같은 규칙).
		_GateNotice:ShowNotice("껍질에 숨었다",
			tostring(seconds) .. "초간 받는 피해 " .. tostring(percent) .. "% 감소")
	end

	@ExecSpace("Client")
	method void OnRested()
		-- 당사자에게만 알린다. 대상 userId는 호출부 마지막 인자다 (OnDied와 같은 규칙).
		_GateNotice:ShowNotice("마을에서 쉬었다", "체력을 모두 회복했다")
	end

	@ExecSpace("ServerOnly")
	method void HandleDeath()
		-- 죽음의 대가 = **시작방으로 돌려보낸다** (T10-3 결정).
		-- 잃는 것이 "탐험 진행"이라 방 단위 탐험 코어와 맞고, 레벨·스탯은 건드리지 않아
		-- 환생의 비용 구조(기획서 4.5)와 충돌하지 않는다.
		--
		-- Respawn()이 HP를 채우고 ReviveEvent를 자동으로 띄운다. 그 뒤에 시작방으로 옮긴다 —
		-- 순서를 바꾸면 죽은 상태로 이동해 조작이 막힌 채 서 있게 된다.
		local pc = self.Entity.PlayerComponent
		log("[PlayerHit] 사망 — 시작방으로 돌려보낸다")
		pc:Respawn()
		-- db를 함께 넘긴다. 안 넘기면 저장된 방이 그대로라 재접속했을 때
		-- 죽은 그 깊은 방에서 다시 시작한다 (환생과 같은 이유).
		---@type PlayerDBManager
		local db = self.Entity:GetComponent("script.PlayerDBManager")
		_Rebirth:ReturnToStart(self.Entity, db)
		self:OnDied(pc.UserId)
	end

	@ExecSpace("Client")
	method void OnDied()
		-- 당사자에게만 알린다. 대상 userId는 선언부가 아니라 호출부 마지막 인자다
		-- (첫 인자로 넘겼다가 [LEA-3032]로 실패한 적이 있다 — RoomPortal 주석 참고).
		_GateNotice:ShowNotice("쓰러졌다", "시작방으로 돌아왔다")
	end

	method boolean IsHitTarget(string attackInfo)
		-- Enforce ImmuneCooldown between successful hits.
		local currentTime = _UtilLogic.ElapsedSeconds
		if self.LastHitTime + self.ImmuneCooldown < currentTime then
			self.LastHitTime = _UtilLogic.ElapsedSeconds
			return true
		end
		
		return false
	end

end