-- @서버 (스폰은 서버 권한. 클라가 몬스터를 만들 수 있으면 안 된다)
--
-- 방 하나의 몬스터를 책임진다. 어떤 몬스터가 몇 마리 사는지는 RoomTable이 소유한다
-- (작업지시서 T3: "몬스터는 방(RoomTable)에 속하며, 방 진입 시 스폰").
--
-- 왜 @Logic이 아니라 맵 엔티티의 @Component인가:
-- 이 상태(스폰 목록·리필 타이머)는 그 맵에서만 의미가 있다. @Logic으로 두면
-- 맵을 옮겨도 살아남아 다른 방의 몬스터를 채우려 든다.
--
-- 리스폰은 개체가 아니라 방 단위로 센다. RoomMonster는 죽으면 파괴되고(RespawnOn=false),
-- 여기서 살아있는 수를 세어 모자란 만큼 다시 채운다. 개체별 리스폰을 쓰면
-- 방 정원이 데이터가 아니라 개체 설정에 흩어진다.

@Component
script RoomSpawner extends Component

    -- 리필 검사 주기(초). 죽은 자리를 이 간격으로 메운다.
    property number RespawnCheckInterval = 3.0

    -- 보스방 전용 입장 감지 주기(초). 리필 주기보다 훨씬 짧게 둔다 —
    -- 이 값이 곧 "방에 들어서고 보스가 나타나기까지의 지연"이라 3초면 눈에 띈다.
    property number BossEntryCheckInterval = 0.4

    -- 스폰 분포 영역(월드 유닛). 슬라이스의 맵 5개는 전부 28x16이고
    -- 외곽이 (-14,-7)~(14,9)라, 가장자리에 붙지 않도록 안쪽으로 여유를 뒀다.
    -- 맵마다 다르게 하려면 인스펙터에서 이 값만 바꾸면 된다.
    property number SpawnMinX = -10
    property number SpawnMaxX = 10
    property number SpawnMinY = -4
    property number SpawnMaxY = 6

    @HideFromInspector property string monsterId = ""
    @HideFromInspector property string modelId = ""
    @HideFromInspector property integer monsterCount = 0
    @HideFromInspector property integer spawnIndex = 0
    @HideFromInspector property integer checkTimer = 0
    -- 보스방이면 리필 규칙이 다르다 (아래 ShouldSpawn 참고).
    @HideFromInspector property string roomId = ""
    @HideFromInspector property boolean isBossRoom = false
    @HideFromInspector property any userEnterHandler = nil
    @HideFromInspector property integer bossEntryTimer = 0
    -- 지난 검사 때 이 방에 있던 userId 집합. 여기 없던 사람이 나타나면 "새로 들어왔다"다.
    @HideFromInspector property table presentUserIds = {}
    -- 이 방이 스폰한 엔티티들. 파괴되면 isvalid가 false가 된다.
    @HideFromInspector property table spawned = {}

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 맵 이름으로 방을 역인덱스한다 (RoomCamera와 같은 방식).
        local room = _GameData:GetRoomByMapName(self.Entity.Name)
        if room == nil then
            log_warning("[RoomSpawner] RoomTable에 없는 맵: " .. self.Entity.Name)
            return
        end

        self.monsterId = room.monster_id
        self.monsterCount = math.floor(room.monster_count)
        self.roomId = room.id
        self.isBossRoom = (room.room_type == "boss")

        if self.monsterId == "" or self.monsterCount <= 0 then
            log("[RoomSpawner] " .. self.Entity.Name .. "(" .. room.name .. ") 몬스터 없음")
            return
        end

        local record = _GameData:GetMonster(self.monsterId)
        if record == nil then
            log_error("[RoomSpawner] MonsterTable에 없는 몬스터: " .. self.monsterId
                .. " (방 " .. room.id .. ")")
            return
        end

        -- 모델을 아직 안 만든 몬스터는 건너뛴다. 그냥 스폰하면 SpawnByModelId가
        -- 조용히 nil을 주고 "왜 안 나오지"로 끝난다.
        self.modelId = record.model_id
        if self.modelId == "" then
            log_warning("[RoomSpawner] " .. self.Entity.Name .. " 스폰 생략 — "
                .. self.monsterId .. "(" .. record.name .. ")의 model_id가 비어 있다")
            return
        end

        log("[RoomSpawner] " .. self.Entity.Name .. "(" .. room.name .. ") "
            .. self.monsterId .. " x" .. tostring(self.monsterCount)
            .. " 배치 시작 (모델 " .. self.modelId .. ")")

        self:Refill()
        self.checkTimer = _TimerService:SetTimerRepeat(function()
            self:Refill()
        end, self.RespawnCheckInterval)

        -- 보스방은 **입장이 유일한 스폰 계기**다 (T16-1). 주기 리필은 ShouldSpawn에서
        -- 막히므로, 이 감시가 없으면 보스가 영영 서지 않는다.
        --
        -- ⚠ UserEnterEvent에 의존하지 않는다 (T16-1 실측): 텔레포트로 맵을 옮기면
        --   이 방의 스포너에게 이벤트가 오지 않았고, 맵이 로드되는 시점(OnBeginPlay)에는
        --   GetUsersByMapName이 아직 0을 돌려준다. 그래서 이벤트만 믿으면 보스가
        --   한 번도 서지 않는다 — 예전 코드가 실제로 보스를 세우던 곳은
        --   OnUserEnter가 아니라 3초 주기 리필이었다.
        --   대신 **방에 있는 사람 목록의 상승 엣지**(없던 사람이 생김)를 직접 본다.
        if self.isBossRoom then
            self.userEnterHandler = _UserService:ConnectEvent(UserEnterEvent, self.OnUserEnter)
            self.bossEntryTimer = _TimerService:SetTimerRepeat(function()
                self:CheckBossEntry()
            end, self.BossEntryCheckInterval)
        end
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        -- 맵이 내려갈 때 타이머를 놓으면 파괴된 엔티티를 계속 채우려 든다.
        if self.checkTimer ~= 0 then
            _TimerService:ClearTimer(self.checkTimer)
            self.checkTimer = 0
        end
        if self.userEnterHandler ~= nil then
            _UserService:DisconnectEvent(UserEnterEvent, self.userEnterHandler)
            self.userEnterHandler = nil
        end
        if self.bossEntryTimer ~= 0 then
            _TimerService:ClearTimer(self.bossEntryTimer)
            self.bossEntryTimer = 0
        end
    end

    @ExecSpace("ServerOnly")
    method void OnUserEnter(UserEnterEvent event)
        -- UserEnterEvent는 어느 맵으로 들어가든 전부 온다 (RoomCamera와 같다).
        -- 내 맵에 들어온 경우만 본다.
        local user = _UserService:GetUserEntityByUserId(event.UserId)
        if user == nil or user.CurrentMap ~= self.Entity then return end

        if self.isBossRoom then
            self:SpawnBossOnEntry()
            return
        end
        self:Refill()
    end

    @ExecSpace("ServerOnly")
    method void CheckBossEntry()
        -- 방에 있는 사람 목록을 훑어, **지난번에 없던 사람**이 있으면 새로 들어온 것이다.
        -- 이벤트가 아니라 상태 비교로 판정하는 이유는 OnBeginPlay 주석에 있다.
        local users = _UserService:GetUsersByMapName(self.Entity.Name)

        local nowIds = {}
        local entered = false
        for i = 1, #users do
            local pc = users[i].PlayerComponent
            if isvalid(pc) then
                nowIds[pc.UserId] = true
                if self.presentUserIds[pc.UserId] == nil then entered = true end
            end
        end
        -- 나간 사람은 목록에서 빠진다. 그래야 다시 들어올 때 상승 엣지가 잡힌다.
        self.presentUserIds = nowIds

        if entered then
            self:SpawnBossOnEntry()
        end
    end

    @ExecSpace("ServerOnly")
    method void SpawnBossOnEntry()
        -- 보스는 **방에 새로 들어올 때마다** 다시 선다 (T16-1, 대표 지시 2026-08-14).
        --
        -- 바뀐 것: 예전에는 회차당 한 번만 섰다(T9-1). 그래서 한 회차에 보스는
        -- 한 판뿐이었고, 그 뒤로는 Lv30까지 잡몹만 잡는 긴 구간이 남았다 —
        -- 대표 판정 *"너무 구간이 루즈해지네 몬스터만 잡다보니까"*.
        --
        -- T9-1이 막으려던 것은 **대기 없는 리스폰**이었다(격파 직후 같은 자리에
        -- 바로 다시 서서 보스방이 최고 효율 사냥터가 됐다). 그 문제는 재입장을
        -- 요구하는 것으로 여전히 막힌다 — 방을 나갔다 돌아오는 왕복이 곧 대기다.
        -- 그래서 주기 리필(ShouldSpawn)에서는 절대 세우지 않고, 세우는 곳을
        -- 이 함수 하나로 둔다.
        --
        -- 아직 살아 있으면 그대로 둔다. 안 그러면 죽지도 않은 보스 옆에 한 마리가
        -- 더 서고, 나갔다 들어올 때마다 방이 보스로 가득 찬다.
        local missing = self.monsterCount - self:CountAlive()
        if missing <= 0 then return end

        for i = 1, missing do
            self:SpawnOne()
        end
        log("[RoomSpawner] " .. self.Entity.Name .. " 보스 재등장 +" .. tostring(missing)
            .. "  (입장 시 스폰 — 주기 리필로는 서지 않는다)")
    end

    @ExecSpace("ServerOnly")
    method boolean ShouldSpawn()
        -- 보스방은 **주기 리필로 절대 서지 않는다** (T16-1). 세우는 곳은
        -- SpawnBossOnEntry 하나뿐이다.
        --
        -- 여기서 막지 않으면 보스를 잡은 자리에 그대로 서 있어도 RespawnCheckInterval
        -- 뒤에 다시 나온다 — 그게 정확히 T9-1이 없앤 "대기 없는 사냥터"다.
        --
        -- 격파 기록(PlayerSkillSlots.BossRoomsCleared)은 더 이상 스폰 판정에 쓰지
        -- 않는다. 슬롯 중복 지급은 ClearBoss가 자체적으로 막고 있고(최초 1회만 지급),
        -- 환생 조건은 누적 BossesCleared를 보므로 둘 다 영향받지 않는다.
        return self.isBossRoom == false
    end

    @ExecSpace("ServerOnly")
    method integer CountAlive()
        -- 살아있는 수를 세면서 죽은 참조는 목록에서 걷어낸다.
        local alive = {}
        for i = 1, #self.spawned do
            local e = self.spawned[i]
            if isvalid(e) then
                table.insert(alive, e)
            end
        end
        self.spawned = alive
        return #alive
    end

    @ExecSpace("ServerOnly")
    method integer EffectiveCount()
        -- 이 방의 실제 정원. **환생 보너스만큼 더 선다** (설계 변경 2026-08-21).
        --
        --   정원 = RoomTable.monster_count + min(환생 보너스, rebirth_monster_bonus_max)
        --
        -- 환생 보상이 스탯 성장률만이면 눈에 안 보인다(Lv20까지 가야 19P 차이).
        -- 방이 빽빽해지는 것은 들어서는 순간 보이고, 방을 헤쳐나가는 것이 이 게임의
        -- 코어라 보상이 코어를 직접 강화한다. EXP 총량도 같이 늘어 빨라진 성장과 맞물린다.
        --
        -- ⚠ **보스방은 제외한다.** 보스는 이미 배율 ×3이 붙어 한 판이 사건이다.
        -- 히어로가 둘이 되면 사건이 아니라 사고가 된다(4대 → 2대에 죽는다).
        --
        -- ⚠ 상한을 두는 이유: 보너스는 `floor(최고환생레벨/5)`라 Lv100 환생이면 20이다.
        -- r_04가 25마리가 되면 스폰 영역(28×16) 안에서 겹치고 AIChase 25개가 매 프레임 돈다.
        --
        -- 방(맵)은 하나인데 보너스는 사람마다 다르다. 지금 그 방에 있는 사람에게서
        -- 읽는다 — 1인 플레이 전제이고, 여러 명이면 먼저 잡힌 사람 기준이 된다.
        -- 정원을 OnBeginPlay에 고정하지 않고 리필마다 다시 재는 이유이기도 하다:
        -- 환생하고 돌아오면 다음 리필부터 바로 반영된다.
        if self.isBossRoom then return self.monsterCount end

        local users = _UserService:GetUsersByMapName(self.Entity.Name)
        if users == nil or #users == 0 then return self.monsterCount end

        ---@type PlayerSkillSlots
        local slots = users[1]:GetComponent("script.PlayerSkillSlots")
        if slots == nil then return self.monsterCount end

        local bonus = slots:RebirthBonus()
        local cap = math.floor(_GameData:GetBalance("rebirth_monster_bonus_max"))
        if cap < 0 then cap = 0 end
        if bonus > cap then bonus = cap end
        return self.monsterCount + bonus
    end

    @ExecSpace("ServerOnly")
    method void Refill()
        -- 정원에서 모자란 만큼만 채운다.
        local target = self:EffectiveCount()
        local missing = target - self:CountAlive()
        if missing <= 0 then return end
        if self:ShouldSpawn() == false then return end

        for i = 1, missing do
            self:SpawnOne()
        end
        log("[RoomSpawner] " .. self.Entity.Name .. " 리필 +" .. tostring(missing)
            .. "  (현재 " .. tostring(#self.spawned) .. "/" .. tostring(target)
            .. (target > self.monsterCount
                and ("  기본 " .. tostring(self.monsterCount) .. " + 환생 "
                     .. tostring(target - self.monsterCount)) or "") .. ")")
    end

    @ExecSpace("ServerOnly")
    method void SpawnOne()
        -- parent는 nil이면 안 된다. 맵 엔티티 자신을 넘긴다.
        self.spawnIndex = self.spawnIndex + 1
        local x = self.SpawnMinX + _UtilLogic:RandomDouble() * (self.SpawnMaxX - self.SpawnMinX)
        local y = self.SpawnMinY + _UtilLogic:RandomDouble() * (self.SpawnMaxY - self.SpawnMinY)

        local name = self.monsterId .. "_" .. self.Entity.Name .. "_" .. tostring(self.spawnIndex)
        local e = _SpawnService:SpawnByModelId(self.modelId, name, Vector3(x, y, 0), self.Entity)
        if e == nil then
            log_error("[RoomSpawner] 스폰 실패 modelId=" .. self.modelId
                .. " — 같은 id의 .model이 등록돼 있는지 확인할 것")
            return
        end
        table.insert(self.spawned, e)
    end

end
