@Component
script ReturnPortal extends Component

	property string TargetRoomId = ""

	property string openRUID = ""

	property string lockedRUID = ""

	property any enterHandler = nil

	property any visualTimer = nil

	property number visualInterval = 0.5

	method void OnBeginPlay()
		        -- 열기 전까지는 잠긴 그림으로 시작한다. 열린 그림으로 시작하면
		        -- 첫 0.5초 동안 "열려 있는데 안 통과되는" 문이 보인다.
		        self:ApplySprite(true)
		
		        if self:IsServer() then
		            self.enterHandler = self.Entity:ConnectEvent(TriggerEnterEvent, self.OnTriggerEnter)
		        end
		
		        if self:IsClient() then
		            self.visualTimer = _TimerService:SetTimerRepeat(function()
		                self:RefreshVisualForMe()
		            end, self.visualInterval)
		        end
	end

	method void OnEndPlay()
		        -- 실행공간을 비워둔 이유: 서버는 이벤트를, 클라는 타이머를 정리해야 한다.
		        -- ServerOnly로 두면 클라 타이머가 남아 맵을 옮길 때마다 쌓인다
		        -- (RoomPortal.OnEndPlay와 같은 근거).
		        if self.enterHandler ~= nil then
		            self.Entity:DisconnectEvent(TriggerEnterEvent, self.enterHandler)
		            self.enterHandler = nil
		        end
		        if self.visualTimer ~= nil then
		            _TimerService:ClearTimer(self.visualTimer)
		            self.visualTimer = nil
		        end
	end

	method boolean IsOpenFor(Entity player)
		        -- @ExecSpace를 붙이지 않는다. 서버는 통과 판정에, 클라는 스프라이트에 쓴다.
		        -- 읽는 값(BossRoomsCleared)이 @TargetUserSync라 양쪽 결과가 같다.
		        if player == nil then return false end
		
		        local map = self.Entity.CurrentMap
		        if map == nil then return false end
		
		        local room = _GameData:GetRoomByMapName(map.Name)
		        if room == nil then return false end
		
		        ---@type PlayerSkillSlots
		        local slots = player:GetComponent("script.PlayerSkillSlots")
		        if slots == nil then return false end
		
		        return slots.BossRoomsCleared[room.id] ~= nil
	end

	method void ApplySprite(boolean showLocked)
		        -- RoomPortal.ApplySprite와 같은 규칙. 같은 값이면 쓰지 않는다 —
		        -- 0.5초마다 도는 경로라 불필요한 대입을 줄인다.
		        local renderer = self.Entity.SpriteRendererComponent
		        if renderer == nil then return end
		
		        local ruid = self.openRUID
		        if showLocked and self.lockedRUID ~= "" then
		            ruid = self.lockedRUID
		        end
		        if ruid ~= "" and renderer.SpriteRUID ~= ruid then
		            renderer.SpriteRUID = ruid
		        end
	end

	@ExecSpace("ClientOnly")
	method void RefreshVisualForMe()
		        -- 내 플레이어 기준으로 열렸는지 보고 스프라이트를 고른다.
		        local me = _UserService.LocalPlayer
		        if me == nil then return end
		
		        local map = self.Entity.CurrentMap
		        if map == nil then return end
		
		        -- 내가 있는 방의 문만 건드린다. 다른 맵의 문을 내 기준으로 칠하면
		        -- 그 맵에 있는 사람 화면이 엉킨다.
		        local myMap = me.CurrentMap
		        if myMap == nil or myMap.Name ~= map.Name then return end
		
		        self:ApplySprite(not self:IsOpenFor(me))
	end

	@ExecSpace("ServerOnly")
	method void OnTriggerEnter(TriggerEnterEvent event)
		        local other = event.TriggerBodyEntity
		        if other == nil then return end
		        if other.PlayerComponent == nil then return end
		        self:TryReturn(other)
	end

	@ExecSpace("ServerOnly")
	method void TryReturn(Entity player)
		        -- 방금 포탈을 탄 플레이어는 잠시 무시한다 (RoomPortal과 같은 가드).
		        local userId = player.PlayerComponent.UserId
		        if not _PortalGuard:CanPass(userId) then return end
		
		        if not self:IsOpenFor(player) then
		            -- 조용히 막지 않고 왜 막혔는지 알린다 (게이트 3종과 같은 어법).
		            local map = self.Entity.CurrentMap
		            local roomName = "이 구역"
		            if map ~= nil then
		                local room = _GameData:GetRoomByMapName(map.Name)
		                if room ~= nil then roomName = room.name end
		            end
		            log("[ReturnPortal] 아직 닫혀 있다 — " .. roomName .. " 보스 미격파")
		            self:OnBlocked(userId)
		            return
		        end
		
		        local targetRoom = nil
		        if self.TargetRoomId ~= "" then
		            targetRoom = _GameData:GetRoom(self.TargetRoomId)
		        else
		            targetRoom = _GameData:GetStartRoom()
		        end
		        if targetRoom == nil or targetRoom.map_name == "" then
		            log_error("[ReturnPortal] 귀환할 방을 찾지 못했다: " .. tostring(self.TargetRoomId))
		            return
		        end
		
		        _PortalGuard:Mark(userId)
		        log("[ReturnPortal] 귀환 → " .. targetRoom.id .. "(" .. targetRoom.map_name .. ")")
		
		        -- 목적지의 표준 진입 좌표를 쓴다. 직업 NPC 옆으로 정확히 돌아가는 좌표는
		        -- 맵이 아니라 RoomTable의 portal_x/y가 소유한다.
		        _TeleportService:TeleportToMapPosition(player,
		            Vector3(targetRoom.portal_x, targetRoom.portal_y, 0), targetRoom.map_name)
		
		        -- 방향키를 누른 채 포탈에 들어가면 도착 후에도 계속 걸어간다.
		        -- 근거와 실측은 RoomPortal.StopAfterArrive / MoveInputGuard 주석에 있다.
		        local movement = player.MovementComponent
		        if movement ~= nil then movement:Stop() end
		        _MoveInputGuard:Begin(userId)
	end

	@ExecSpace("Client")
	method void OnBlocked()
		        -- 당사자에게만 알린다. 대상 userId는 선언부가 아니라 호출부 마지막 인자로 붙인다
		        -- (첫 인자로 넘겼다가 [LEA-3032]로 실패한 적이 있다 — RoomPortal 주석 참고).
		        _GateNotice:ShowNotice("닫혀 있다", "이 구역의 보스를 잡아야 열린다")
	end

end