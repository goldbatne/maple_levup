@Component
script HeroNpc extends Component

	property string TargetRoomId = "r_job_01"

	property string ChallengerMonsterId = "m_adv_hero"

	property number ConfirmWindowSeconds = 8

	property any touchHandler = nil

	@HideFromInspector
	property number promptedAt = 0

	method void OnBeginPlay()
		        if _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5 then
		            self.Entity:SetVisible(false)
		            self.Entity.Enable = false
		            log("[HeroNpc] Mega Run — 시험 NPC 비표시/비활성")
		            return
		        end
		        -- 터치는 클라에서만 받는다. 서버에는 입력이 오지 않는다.
		        if self:IsClient() then
		            self.touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouch)
		            log("[HeroNpc] 터치 대기 (" .. tostring(self.Entity.Name) .. ")")
		        end
	end

	method void OnEndPlay()
		        if self.touchHandler ~= nil then
		            self.Entity:DisconnectEvent(TouchEvent, self.touchHandler)
		            self.touchHandler = nil
		        end
	end

	@ExecSpace("ClientOnly")
	method string ChallengerName()
		        -- 상대 이름. 표에 없으면 빈 문자열 — 문구에서 조용히 빠진다.
		        local monster = _GameData:GetMonster(self.ChallengerMonsterId)
		        if monster == nil then return "" end
		        return monster.name
	end

	@ExecSpace("ClientOnly")
	method void OnTouch(TouchEvent event)
		        -- 시험/전직 이동은 신규 Run의 탐색 경로가 아니다.
		        if _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5 then return end
		        local me = _UserService.LocalPlayer
		        if me == nil then return end
		
		        local name = self:ChallengerName()
		        local now = _UtilLogic.ElapsedSeconds
		
		        -- 첫 터치(또는 시간이 지난 뒤) = 경고만.
		        if self.promptedAt <= 0 or (now - self.promptedAt) > self.ConfirmWindowSeconds then
		            self.promptedAt = now
		            log("[HeroNpc] 경고 표시 — 상대 " .. tostring(name))
		            _GateNotice:ShowNotice("시험을 받겠는가",
		                (name ~= "" and ("[" .. name .. "]이(가) 기다린다. ") or "")
		                .. "한 번 더 누르면 시험의 방으로 간다.")
		            return
		        end
		
		        -- 두 번째 터치 = 이동. 창구를 닫아 두 번 연속으로 안 들어가게 한다.
		        self.promptedAt = 0
		        log("[HeroNpc] 시험의 방으로 이동 요청")
		        self:RequestEnter()
	end

	@ExecSpace("Server")
	method void RequestEnter()
		        -- 클라 요청 진입점. senderUserId는 서버가 채우므로 위조할 수 없다.
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if player == nil then
		            log_warning("[HeroNpc] 요청자를 찾지 못했다: " .. tostring(senderUserId))
		            return
		        end
		        self:SendToTrial(player)
	end

	@ExecSpace("ServerOnly")
	method void SendToTrial(Entity player)
		        -- 방 표에서 목적지를 읽는다. 도착 좌표까지 표가 들고 있어야
		        -- 맵을 바꿨을 때 좌표만 남아 엉뚱한 데로 떨어지는 일이 없다.
		        if _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5 then return end
		        local room = _GameData:GetRoom(self.TargetRoomId)
		        if room == nil then
		            log_error("[HeroNpc] RoomTable에 없는 방: " .. tostring(self.TargetRoomId))
		            return
		        end
		        if room.map_name == "" then
		            log_error("[HeroNpc] 방에 맵이 없다: " .. self.TargetRoomId)
		            return
		        end
		
		        log("[HeroNpc] 이동 " .. self.TargetRoomId .. " (" .. room.map_name .. ") "
		            .. tostring(room.portal_x) .. "," .. tostring(room.portal_y))
		        _TeleportService:TeleportToMapPosition(player,
		            Vector3(room.portal_x, room.portal_y, 0), room.map_name)
	end

end