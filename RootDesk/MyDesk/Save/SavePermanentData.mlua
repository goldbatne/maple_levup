@Struct
script SavePermanentData

	property integer schema_version = 5

	property table owned_skills = {}

	property table tamed_monsters = {}

	property string selected_companion_monster_id = ""

	property table species_kills = {}

	property table total_monster_kills = {}

	property integer rebirth_count = 0

	property integer highest_level = 1

	property integer best_rebirth_level = 0

	property integer best_tier = 0

	property table landmark_claimed = {}

	property table unlocked_areas = {}

	property integer monster_slot_count = 0

	property table bosses_cleared = {}

	property string key_order = ""

	property string selected_trait = "balance"

	property table inventory = {}

	property table equipped = {}

	property integer roguelite_schema_version = 2

	property table roguelite_discovered_monsters = {}

	property table roguelite_discovered_abilities = {}

	property table roguelite_area_clears = {}

	property table roguelite_optional_encounters = {}

	property table roguelite_settings = {}

	property table roguelite_permanent_skills = {}

	property table roguelite_monster_loadouts = {}

	method void Init(number startingSlotCount)
		        -- 신규 계정 기본값. startingSlotCount는 호출자가 GameBalance의
		        -- monster_slot_start에서 읽어 넘긴다 (구조체가 데이터 소스에 의존하지 않도록).
		        self.schema_version = 5
		        self.owned_skills = {}
		        self.tamed_monsters = {}
		        self.selected_companion_monster_id = ""
		        self.species_kills = {}
		        self.total_monster_kills = {}
		        self.rebirth_count = 0
		        self.best_rebirth_level = 0
		        self.best_tier = 0
		        self.highest_level = 1
		        self.landmark_claimed = {}
		        self.unlocked_areas = {}
		        self.monster_slot_count = startingSlotCount
		        self.bosses_cleared = {}
		        self.key_order = ""
		        self.selected_trait = "balance"
		        self.inventory = {}
		        self.equipped = {}
		        self.roguelite_schema_version = 2
		        self.roguelite_discovered_monsters = {}
		        self.roguelite_discovered_abilities = {}
		        self.roguelite_area_clears = {}
		        self.roguelite_optional_encounters = {}
		        self.roguelite_settings = {}
		        self.roguelite_permanent_skills = {}
		        self.roguelite_monster_loadouts = {}
	end

	method boolean HasAny(any t)
		        -- 빈 테이블인가.
		        --
		        -- 왜 필요한가 (T8 실측): _HttpService:JSONEncode는 **중첩된 빈 테이블**을
		        -- 만나면 [LEA-3001] NotSupported 'LuaTableToJsonType.UnknownType'으로 죽는다.
		        --   JSONEncode({ Perm = { lv = 1 } })            -> {"Perm":{"lv":1}}
		        --   JSONEncode({ Perm = { lv = 1, own = {} } })  -> LEA-3001
		        -- 최상위 빈 테이블은 조용히 빈 문자열을 돌려줘서 더 헷갈린다.
		        -- Deserialize가 없는 필드를 기본값으로 채우므로 빼도 잃는 게 없다.
		        if type(t) ~= "table" then return false end
		        return next(t) ~= nil
	end

	method boolean Serialize(table out)
		        -- 저장 페이로드로 직렬화. "Perm" 네임스페이스 아래로 넣는다.
		        -- 비어 있는 테이블 필드는 아예 넣지 않는다 (HasAny 주석 참고).
		        local body = {}
		        out["Perm"] = body
		        body["schema_version"] = self.schema_version
		        body["rebirth_count"] = self.rebirth_count
		        body["best_rebirth_level"] = self.best_rebirth_level
		        body["best_tier"] = self.best_tier
		        body["highest_level"] = self.highest_level
		        body["monster_slot_count"] = self.monster_slot_count
		
		        if self:HasAny(self.owned_skills) then body["owned_skills"] = self.owned_skills end
		        if self:HasAny(self.tamed_monsters) then body["tamed_monsters"] = self.tamed_monsters end
		        if self.selected_companion_monster_id ~= "" then
		            body["selected_companion_monster_id"] = self.selected_companion_monster_id
		        end
		        if self:HasAny(self.species_kills) then body["species_kills"] = self.species_kills end
		        if self:HasAny(self.total_monster_kills) then body["total_monster_kills"] = self.total_monster_kills end
		        if self:HasAny(self.landmark_claimed) then body["landmark_claimed"] = self.landmark_claimed end
		        if self:HasAny(self.unlocked_areas) then body["unlocked_areas"] = self.unlocked_areas end
		        if self:HasAny(self.bosses_cleared) then body["bosses_cleared"] = self.bosses_cleared end
		        -- 기본값을 쓰는 계정은 아예 넣지 않는다. 바이트를 아끼기도 하지만,
		        -- 더 중요한 건 "설정을 건드린 적 있는가"가 값의 유무로 남는다는 것이다.
		        if self.key_order ~= "" then body["key_order"] = self.key_order end
		        body["selected_trait"] = self.selected_trait
		        if self:HasAny(self.inventory) then body["inventory"] = self.inventory end
		        if self:HasAny(self.equipped) then body["equipped"] = self.equipped end
		
		        local rogue = {}
		        out["RoguelitePermanent"] = rogue
		        rogue["schema_version"] = self.roguelite_schema_version
		        if self:HasAny(self.roguelite_discovered_monsters) then
		            rogue["discovered_monsters"] = self.roguelite_discovered_monsters
		        end
		        if self:HasAny(self.roguelite_discovered_abilities) then
		            rogue["discovered_abilities"] = self.roguelite_discovered_abilities
		        end
		        if self:HasAny(self.roguelite_area_clears) then
		            rogue["area_clears"] = self.roguelite_area_clears
		        end
		        if self:HasAny(self.roguelite_optional_encounters) then
		            rogue["optional_encounters"] = self.roguelite_optional_encounters
		        end
		        if self:HasAny(self.roguelite_settings) then rogue["settings"] = self.roguelite_settings end
		        if self:HasAny(self.roguelite_permanent_skills) then
		            rogue["permanent_skills"] = self.roguelite_permanent_skills
		        end
		        if self:HasAny(self.roguelite_monster_loadouts) then
		            rogue["monster_loadouts"] = self.roguelite_monster_loadouts
		        end
		        return true
	end

	method boolean Deserialize(table src)
		        -- 역직렬화. 없는 필드는 Init() 기본값 유지 (구버전 세이브 호환).
		        local body = src["Perm"]
		        if body ~= nil then
		            self.schema_version = body["schema_version"] or 1
		            self.owned_skills = body["owned_skills"] or {}
		            self.tamed_monsters = body["tamed_monsters"] or {}
		            self.selected_companion_monster_id = body["selected_companion_monster_id"] or ""
		            self.species_kills = body["species_kills"] or {}
		            self.total_monster_kills = body["total_monster_kills"] or {}
		            self.rebirth_count = body["rebirth_count"] or 0
		            -- 옛 저장에는 없다. 0이면 보너스도 0이라 기존 플레이어는 그대로 시작한다.
		            self.best_rebirth_level = body["best_rebirth_level"] or 0
		            self.best_tier = body["best_tier"] or 0
		            self.highest_level = body["highest_level"] or 1
		            self.landmark_claimed = body["landmark_claimed"] or {}
		            self.unlocked_areas = body["unlocked_areas"] or {}
		            self.monster_slot_count = body["monster_slot_count"] or self.monster_slot_count
		            self.bosses_cleared = body["bosses_cleared"] or {}
		            self.key_order = body["key_order"] or ""
		            self.selected_trait = body["selected_trait"] or "balance"
		            self.inventory = body["inventory"] or {}
		            self.equipped = body["equipped"] or {}
		        end
		
		        local rogue = src["RoguelitePermanent"]
		        if type(rogue) == "table" then
		            self.roguelite_schema_version = rogue["schema_version"] or 1
		            if type(rogue["discovered_monsters"]) == "table" then self.roguelite_discovered_monsters = rogue["discovered_monsters"] else self.roguelite_discovered_monsters = {} end
		            if type(rogue["discovered_abilities"]) == "table" then self.roguelite_discovered_abilities = rogue["discovered_abilities"] else self.roguelite_discovered_abilities = {} end
		            if type(rogue["area_clears"]) == "table" then self.roguelite_area_clears = rogue["area_clears"] else self.roguelite_area_clears = {} end
		            if type(rogue["optional_encounters"]) == "table" then self.roguelite_optional_encounters = rogue["optional_encounters"] else self.roguelite_optional_encounters = {} end
		            if type(rogue["settings"]) == "table" then self.roguelite_settings = rogue["settings"] else self.roguelite_settings = {} end
		            if type(rogue["permanent_skills"]) == "table" then
		                self.roguelite_permanent_skills = rogue["permanent_skills"]
		            else self.roguelite_permanent_skills = {} end
		            if type(rogue["monster_loadouts"]) == "table" then
		                self.roguelite_monster_loadouts = rogue["monster_loadouts"]
		            else self.roguelite_monster_loadouts = {} end
		        end
		        return true
	end

end