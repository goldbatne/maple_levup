@Component
script PlayerDBManager extends Component

	property string KeyPerm = "Perm"

	property string KeyRun = "Run"

	property string KeyRogue = "RoguelitePermanentV1"

	property boolean RogueStorageMode = false

	property boolean StorageWriteBlocked = false

	property table RogueSavedPayload = {}

	property boolean RogueWriteBusy = false

	@TargetUserSync
	property boolean IsLoadSuccess = false

	property boolean permDirty = false

	property boolean runDirty = false

	property integer permGen = 0

	property integer runGen = 0

	property number lastSaveAt = -9999

	property any pendingTimer = nil

	property string pendingReason = ""

	property integer pendingCount = 0

	property table LandmarkClaimed = {}

	property integer HighestLevel = 1

	property table RogueAreaClears = {}

	property table RogueOptionalEncounters = {}

	property table RogueSettings = {}

	@TargetUserSync
	property integer RogueHighestUnlockedFloor = 1

	@TargetUserSync
	property string RogueMonsterSkillDailyView = ""

	property string CurrentRoom = ""

	property boolean roomRestored = false

	property any restoreTimer = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		        -- 저장 모드를 세션 시작에 고정한다. Maker는 실계정 진행 키를 쓰지 않는다.
		        self.RogueStorageMode = _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5
		        if self.RogueStorageMode and Environment:IsMakerPlay() then
		            self.KeyRogue = "MakerTest_RoguelitePermanentV1"
		        end
		        -- 외부 파일 병합 직후 Maker가 새 table 프로퍼티의 기본값을 nil로 보존한
		        -- 세션에서도 별도 RoguelitePermanent 원장을 안전하게 초기화한다.
		        if type(self.RogueAreaClears) ~= "table" then self.RogueAreaClears = {} end
		        if type(self.RogueOptionalEncounters) ~= "table" then self.RogueOptionalEncounters = {} end
		        if type(self.RogueSettings) ~= "table" then self.RogueSettings = {} end
		        -- 로그인 로드. BatchGet은 블로킹이지만 여기서는 블로킹이 맞다 —
		        -- 로드가 끝나기 전에 플레이가 시작되면 어차피 빈 값으로 논다.
		        log("[PlayerDB] 로드 시작")
		        self:LoadFromDB()
		
		        if self.IsLoadSuccess == false then
		            log_error("[PlayerDB] 로드 실패 — 이 세션은 저장하지 않는다 (세이브 보호)")
		            return
		        end
		
		        -- 진행 로깅의 세션 카운터를 연다 (작업지시서 T8). 로드가 끝난 뒤에 여는
		        -- 이유: 로드 실패 세션은 어차피 저장도 로깅도 의미가 없다.
		        _ProgressLog:Begin(self.Entity.PlayerComponent.UserId)
		
		        if _GameData.RogueRunActive then _GameData:RegisterRunParticipant(self.Entity) end
		
		        -- 최종 로그라이트 모드는 매 Run을 서버가 확정한 시작 맵에서 시작한다.
		        -- 레거시 RPG Run.current_room을 복원하면 새 InstanceRoom 입장 직후 지난
		        -- 사냥방으로 다시 이동해 Seed 그래프의 시작점과 클라이언트가 갈라진다.
		        -- 저장 필드는 호환을 위해 그대로 읽되, 신규 모드에서는 이동·기록에 쓰지 않는다.
		        if _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5 then
		            self.CurrentRoom = ""
		            self.roomRestored = true
		            log("[PlayerDB] Roguelite 모드 — 레거시 방 복원 생략")
		            return
		        end
		
		        -- 방 복원은 조금 뒤에 한다. OnBeginPlay 시점에는 플레이어가 아직 맵에
		        -- 자리잡기 전이라 곧바로 텔레포트하면 출발 맵과 도착 맵이 엉킨다.
		        self.restoreTimer = _TimerService:SetTimerOnce(function()
		            self.restoreTimer = nil
		            self:RestoreRoom()
		        end, 0.5)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		        -- 타이머 정리. 남겨두면 사라진 엔티티를 붙잡고 돈다.
		        if self.pendingTimer ~= nil then
		            _TimerService:ClearTimer(self.pendingTimer)
		            self.pendingTimer = nil
		        end
		        if self.restoreTimer ~= nil then
		            _TimerService:ClearTimer(self.restoreTimer)
		            self.restoreTimer = nil
		        end
	end

	@ExecSpace("ServerOnly")
	method void OnMapEnter(Entity enterEntity)
		        -- 방 전환 = 저장 트리거 (작업지시서 T8).
		        if _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5 then return end
		        if self.roomRestored == false then return end
		
		        local map = self.Entity.CurrentMap
		        if map == nil then return end
		
		        local room = _GameData:GetRoomByMapName(map.Name)
		        if room == nil then return end
		        if room.id == self.CurrentRoom then return end
		
		        log("[PlayerDB] 방 전환 " .. tostring(self.CurrentRoom) .. " → " .. room.id)
		        self.CurrentRoom = room.id
		        self:MarkRunDirty("방 전환")
	end

	@ExecSpace("ServerOnly")
	method void LoadFromDB()
		        -- 테이블 미등록/부분 로드 상태에서 기본값으로 기존 저장을 덮지 않는다.
		        if self:ValidateStorageData() == false then return end
		        if self.RogueStorageMode then
		            self:LoadRogueliteRecords()
		            return
		        end
		        local profileCode = self.Entity.PlayerComponent.ProfileCode
		        local loadKeys = { self.KeyPerm, self.KeyRun }
		
		        local loaded = {}
		        if self:BatchGetAndWait(profileCode, loadKeys, loaded) == false then
		            return
		        end
		
		        local perm = SavePermanentData()
		        perm:Init(math.floor(_GameData:GetBalance("monster_slot_start")))
		        local permItem = loaded[self.KeyPerm]
		        if permItem ~= nil and _UtilLogic:IsNilorEmptyString(permItem.Value) == false then
		            perm:Deserialize(_HttpService:JSONDecode(permItem.Value))
		            log("[PlayerDB] Perm 로드  환생=" .. tostring(perm.rebirth_count)
		                .. " 최고Lv=" .. tostring(perm.highest_level)
		                .. " 슬롯=" .. tostring(perm.monster_slot_count))
		        else
		            log("[PlayerDB] Perm 없음 — 신규 계정 기본값")
		            self.permDirty = true
		            self.permGen += 1
		        end
		
		        local run = SaveRunData()
		        run:Init()
		        local runItem = loaded[self.KeyRun]
		        if runItem ~= nil and _UtilLogic:IsNilorEmptyString(runItem.Value) == false then
		            run:Deserialize(_HttpService:JSONDecode(runItem.Value))
		            log("[PlayerDB] Run 로드  Lv=" .. tostring(run.level)
		                .. " EXP=" .. tostring(run.exp)
		                .. " 방=" .. (run.current_room == "" and "(없음)" or run.current_room))
		        else
		            log("[PlayerDB] Run 없음 — 새 회차 기본값")
		            self.runDirty = true
		            self.runGen += 1
		        end
		
		        self:ApplyPerm(perm)
		        self:ApplyRun(run)
		
		        -- 슬롯 수는 저장값을 쓰지 않고 **차수에서 다시 계산한다** (계산이 진실이다).
		        -- 반드시 ApplyRun **뒤**여야 한다 — 차수가 레벨에서 나오므로 레벨이 복원되기
		        -- 전에 부르면 항상 0차로 읽힌다 (ApplyPerm 주석 참고).
		        ---@type PlayerSkillSlots
		        local slotsAfterLoad = self.Entity:GetComponent("script.PlayerSkillSlots")
		        if slotsAfterLoad ~= nil then
		            slotsAfterLoad:RecomputeSlotCount()
		            -- OnBeginPlay 시점에는 OwnedSkills 복원이 끝나지 않았을 수 있다. 저장 적용 뒤
		            -- 다시 초기화해야 보유 종수와 무관한 랜덤 5칸 재고가 실제 세이브와 일치한다.
		            slotsAfterLoad:InitializeRuntimeSkills()
		
		            -- **안 받은 랜드마크를 소급 지급한다** (2026-08-29).
		            --
		            -- 이게 없으면 **기존 세이브가 영영 안 고쳐진다.** 랜드마크는 지금까지
		            -- 환생할 때만, 그것도 정확히 그 레벨의 줄만 줬다 — 이미 Lv10·Lv20을
		            -- 지나온 사람은 다시 그 레벨이 될 일이 없으니 못 받는다.
		            -- 랜드마크 표를 나중에 고쳐도(엘리니아 Lv20 → Lv10) 마찬가지다.
		            --
		            -- 실측으로 확인한 증상: Lv37인데 해금된 지역이 `area_02` 하나뿐이라
		            -- **엘리니아가 지역 선택 창에 안 떴다** (대표: "페리온에서 엘리니아로 안 이동하는데?").
		            --
		            -- ⚠ 반드시 `ApplyRun` **뒤**여야 한다 — 레벨이 복원되기 전에 부르면
		            -- Lv1로 읽혀 아무것도 안 준다 (슬롯 계산과 같은 함정).
		            ---@type PlayerStats
		            local statsAfterLoad = self.Entity:GetComponent("script.PlayerStats")
		            if statsAfterLoad ~= nil
		                and _GameData:GetBalance("phase3_simplified_growth_enabled") < 0.5 then
		                _Rebirth:GrantLandmarksUpTo(statsAfterLoad.Level, self, slotsAfterLoad)
		            end
		        end
		
		        -- 모든 적용이 끝난 뒤에만 게이트를 연다.
		        self.IsLoadSuccess = true
		        log("[PlayerDB] 로드 완료")
	end

	@ExecSpace("ServerOnly")
	method boolean BatchGetAndWait(string profileCode, table loadKeys, table outLoaded)
		        -- 페이지를 끝까지 훑는다. 한 페이지만 읽으면 뒤쪽 키가 조용히 사라진다
		        -- (datastorage §4.6). 키가 2개뿐이라 지금은 한 페이지지만,
		        -- 키가 늘어났을 때 조용히 깨지는 자리라 처음부터 제대로 돌린다.
		        local ds = _DataStorageService:GetUserDataStorage(profileCode)
		        local code, pages = ds:BatchGetAndWait(loadKeys)
		        if code ~= 0 then
		            log_error("[PlayerDB] BatchGetAndWait 실패  ErrorCode=" .. tostring(code))
		            return false
		        end
		
		        while true do
		            local datas = pages:GetCurrentPageDatas()
		            if datas == nil then break end
		
		            for i = 1, #datas do
		                outLoaded[datas[i].KeyInfo.Key] = datas[i]
		            end
		
		            if pages.IsLastPage then break end
		
		            local loadErr = pages:LoadNextPageAndWait()
		            if loadErr ~= 0 then
		                log_error("[PlayerDB] LoadNextPageAndWait 실패  ErrorCode=" .. tostring(loadErr))
		                return false
		            end
		            pages:MoveToNextPageAndWait()
		        end
		
		        return true
	end

	@ExecSpace("ServerOnly")
	method void ApplyPerm(SavePermanentData perm)
		        -- 영구 데이터를 각 컴포넌트에 붓는다.
		        self.HighestLevel = perm.highest_level
		        self.LandmarkClaimed = perm.landmark_claimed
		
		        ---@type PlayerCollection
		        local collection = self.Entity:GetComponent("script.PlayerCollection")
		        if collection ~= nil then
		            local stackMax = math.floor(_GameData:GetBalance("skill_stack_max"))
		            if stackMax < 1 then stackMax = 1 end
		
		            -- 복구/재로드 경로에서도 이전 런타임 값이 남지 않게 알려진 키 공간을 비운다.
		            for _, id in ipairs(_GameData:GetAllSkillIds()) do collection.OwnedSkills[id] = nil end
		            for _, monsterId in ipairs(_GameData:GetTameableMonsterIds()) do
		                -- 로드 초기화도 동일한 단일 쓰기 창구를 사용한다. 이 호출이 대응
		                -- OwnedSkills 미러까지 함께 비워 두 원장이 갈라지지 않게 한다.
		                collection:SetTamedCount(monsterId, 0)
		            end
		
		            -- 스키마 v5부터 TamedMonsters가 신규 모드의 유일한 원장이다.
		            -- v4 이하는 현재 MonsterTable의 명시적 101개 관계만 한 번 변환한다.
		            -- 매핑이 없는 레거시 s_mon_snail은 OwnedSkills 호환 기록으로만 보존된다.
		            local migrated = 0
		            for id, count in pairs(perm.owned_skills) do
		                local skill = _GameData:GetSkill(id)
		                if skill ~= nil and skill.source == "monster" then
		                    local owned = math.floor(count)
		                    if owned > stackMax then
		                        log_warning("[PlayerDB] 테이밍 중복 상한 초과를 " .. tostring(stackMax)
		                            .. "장으로 보정한다: " .. tostring(id) .. " " .. tostring(owned))
		                        owned = stackMax
		                    end
		                    if owned > 0 then
		                        local monsterId = _GameData:GetMonsterIdByDropSkillId(id)
		                        if perm.schema_version < 5 and monsterId ~= "" then
		                            collection:SetTamedCount(monsterId, owned)
		                            migrated += 1
		                        elseif monsterId == "" then
		                            -- 현재 몬스터와 대응하지 않는 과거 스킬은 자동 테이밍 변환 금지.
		                            collection.OwnedSkills[id] = owned
		                        end
		                    end
		                else
		                    log_warning("[PlayerDB] 포획 스킬이 아닌 옛 보유 기록을 버린다: " .. tostring(id))
		                end
		            end
		
		            if perm.schema_version >= 5 then
		                for monsterId, count in pairs(perm.tamed_monsters) do
		                    if _GameData:IsTameableMonster(monsterId) then
		                        collection:SetTamedCount(monsterId, math.floor(count))
		                    else
		                        log_warning("[PlayerDB] 테이밍 대상이 아닌 v5 기록을 보류한다: "
		                            .. tostring(monsterId))
		                    end
		                end
		            else
		                self.permDirty = true
		                self.permGen += 1
		                log("[PlayerDB] schema v" .. tostring(perm.schema_version)
		                    .. " → v5 테이밍 마이그레이션 " .. tostring(migrated) .. "종")
		            end
		
		            local companionId = perm.selected_companion_monster_id
		            if companionId ~= "" and collection:GetTamedCount(companionId) > 0 then
		                collection.SelectedCompanionMonsterId = companionId
		            else
		                collection.SelectedCompanionMonsterId = ""
		            end
		
		            for id, kills in pairs(perm.species_kills) do
		                collection.SpeciesKills[id] = math.floor(kills)
		            end
		            -- 새 schema 필드는 기존 .codeblock 메타가 갱신되기 전에도 구세이브를
		            -- 안전하게 읽도록 동적 별칭으로 접근한다. 런타임 타입은 각각 동일하다.
		            ---@type any
		            local permV4 = perm
		            ---@type any
		            local collectionV4 = collection
		            -- 같은 엔티티에 데이터를 다시 적용하는 복구/재로드 경로에서도 옛 값이
		            -- 남지 않게 먼저 비운다. 구 schema에는 표가 없으므로 이 단계가 곧 0 이관이다.
		            for id, _ in pairs(collectionV4.TotalMonsterKills) do
		                collectionV4.TotalMonsterKills[id] = nil
		            end
		            local savedTotalKills = permV4.total_monster_kills
		            if type(savedTotalKills) ~= "table" then savedTotalKills = {} end
		            for id, kills in pairs(savedTotalKills) do
		                collectionV4.TotalMonsterKills[id] = math.floor(kills)
		            end
		            for _, monsterId in ipairs(_GameData:GetAllMonsterIds()) do
		                collection.RogueDiscoveredMonsters[monsterId] = nil
		            end
		            for _, skillId in ipairs(_GameData:GetAllSkillIds()) do
		                collection.RogueDiscoveredAbilities[skillId] = nil
		            end
		            local savedDiscoveredMonsters = perm.roguelite_discovered_monsters
		            if type(savedDiscoveredMonsters) ~= "table" then savedDiscoveredMonsters = {} end
		            for monsterId, discovered in pairs(savedDiscoveredMonsters) do
		                if _GameData:GetMonster(monsterId) ~= nil and discovered then
		                    collection.RogueDiscoveredMonsters[monsterId] = 1
		                end
		            end
		            local savedDiscoveredAbilities = perm.roguelite_discovered_abilities
		            if type(savedDiscoveredAbilities) ~= "table" then savedDiscoveredAbilities = {} end
		            for skillId, discovered in pairs(savedDiscoveredAbilities) do
		                if _GameData:GetSkill(skillId) ~= nil and discovered then
		                    collection.RogueDiscoveredAbilities[skillId] = 1
		                end
		            end
		
		            for _, skillId in ipairs(_GameData:GetAllSkillIds()) do
		                collection.PermanentSkillCollection[skillId] = nil
		            end
		            local permanentSkills = perm.roguelite_permanent_skills
		            if type(permanentSkills) ~= "table" then permanentSkills = {} end
		            for skillId, owned in pairs(permanentSkills) do
		                local skill = _GameData:GetSkill(skillId)
		                if owned and skill ~= nil and skill.source == "monster"
		                    and skill.slot_type == "monster" and skill.skill_kind ~= "passive" then
		                    collection.PermanentSkillCollection[skillId] = 1
		                end
		            end
		            for _, monsterId in ipairs(_GameData:GetTameableMonsterIds()) do
		                for slot = 1, 3 do
		                    collection.MonsterSkillLoadouts[monsterId .. ":" .. tostring(slot)] = nil
		                end
		            end
		            local savedLoadouts = perm.roguelite_monster_loadouts
		            if type(savedLoadouts) ~= "table" then savedLoadouts = {} end
		            for key, skillId in pairs(savedLoadouts) do
		                local monsterId = string.match(key, "^(.+):[123]$")
		                if monsterId ~= nil and collection:GetTamedCount(monsterId) > 0
		                    and collection.PermanentSkillCollection[skillId] ~= nil then
		                    collection.MonsterSkillLoadouts[key] = skillId
		                end
		            end
		        end
		
		        if type(perm.roguelite_area_clears) == "table" then self.RogueAreaClears = perm.roguelite_area_clears else self.RogueAreaClears = {} end
		        if type(perm.roguelite_optional_encounters) == "table" then self.RogueOptionalEncounters = perm.roguelite_optional_encounters else self.RogueOptionalEncounters = {} end
		        if type(perm.roguelite_settings) == "table" then self.RogueSettings = perm.roguelite_settings else self.RogueSettings = {} end
		        self:RefreshRogueFloorProgress()
		
		        ---@type PlayerSkillSlots
		        local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
		        if slots ~= nil then
		            slots.RebirthCount = perm.rebirth_count
		            slots.BestRebirthLevel = perm.best_rebirth_level
		            slots.BestTier = perm.best_tier
		            for roomId, run in pairs(perm.bosses_cleared) do
		                -- 값은 플래그가 아니라 **마지막으로 깬 회차 번호**다. 그대로 복원해야
		                -- "이번 회차에 깼는가"가 맞는다 (안 그러면 보스가 영영 안 선다).
		                -- 옛 저장은 전부 1이라 1회차 클리어로 읽히고, 그게 실제로 맞다.
		                slots.BossRoomsCleared[roomId] = math.floor(run)
		            end
		            for areaId, _ in pairs(perm.unlocked_areas) do
		                slots.UnlockedAreas[areaId] = 1
		            end
		            -- 보스 개수는 원장에서 다시 센다. 개수를 따로 저장하면 원장과 어긋날 수 있고,
		            -- 어긋나면 슬롯 수가 틀어진다 — 원장 하나만 진실로 둔다.
		            local cleared = 0
		            for _, _ in pairs(perm.bosses_cleared) do
		                cleared += 1
		            end
		            slots.BossesCleared = cleared
		            -- 키 배치 (T14-2). 빈 문자열이면 SkillBar가 자기 기본값을 쓴다.
		            slots.KeyOrder = perm.key_order
		            -- schema v1 이하에는 값이 없다. SavePermanentData가 balance로 이관한다.
		            slots.SelectedTrait = slots:NormalizeTraitId(perm.selected_trait)
		            -- ⚠ 슬롯 계산은 **여기서 하지 않는다.** 차수가 레벨에서 나오게 되면서
		            -- (2026-08-21) 슬롯이 레벨에 의존하는데, 레벨은 ApplyRun이 복원한다.
		            -- 여기서 부르면 Level이 아직 1이라 **차수 0 · 슬롯 1칸**으로 계산되고,
		            -- 다시 접속할 때까지 그대로 남는다 (실측: Lv20인데 슬롯이 1칸이었다).
		            -- 두 Apply가 다 끝난 뒤 Load에서 한 번 부른다.
		            --
		            -- 표에서 사라진 스킬이 장착된 채로 로드되는 것을 막는다 (T17-1).
		            -- RecomputeSlotCount는 **슬롯 수가 바뀔 때만** TrimOverflow를 부르므로,
		            -- 수가 그대로인 로드에서는 걸러지지 않는다. 여기서 한 번 더 확인한다.
		            slots:DropUnknownSkills()
		        end
		
		        ---@type PlayerInventory
		        local inventory = self.Entity:GetComponent("script.PlayerInventory")
		        if inventory ~= nil then
		            for id, count in pairs(perm.inventory) do
		                -- ItemTable에서 사라진 아이템은 버린다. 그대로 부으면 창(T13-5)이
		                -- 이름 없는 칸을 그리고, 스탯 합산(T13-4)이 nil을 만난다.
		                if _GameData:GetItem(id) == nil then
		                    log_warning("[PlayerDB] ItemTable에 없는 아이템을 버린다: " .. tostring(id))
		                else
		                    inventory.Items[id] = math.floor(count)
		                end
		            end
		            for slot, id in pairs(perm.equipped) do
		                -- 장착도 같은 이유로 검사한다. 다만 여기서는 슬롯 정합까지 본다 —
		                -- CSV에서 아이템의 slot을 바꿨으면 옛 장착이 엉뚱한 칸에 남는다.
		                local record = _GameData:GetItem(id)
		                if record == nil then
		                    log_warning("[PlayerDB] 없는 아이템의 장착을 버린다: " .. tostring(id))
		                elseif record.item_type ~= "equip" then
		                    -- 소비 아이템 같은 비장비 ID가 잘못 저장돼 있어도 장착으로 복원하지 않는다.
		                    log_warning("[PlayerDB] 장비가 아닌 아이템의 옛 장착을 버린다: "
		                        .. tostring(id) .. " (" .. record.item_type .. ")")
		                elseif record.slot ~= slot then
		                    log_warning("[PlayerDB] 슬롯이 바뀐 장착을 버린다: " .. tostring(id)
		                        .. " (저장=" .. tostring(slot) .. " 현재=" .. record.slot .. ")")
		                else
		                    inventory.Equipped[slot] = id
		                end
		            end
		            -- 저장된 논리 장착을 캐릭터 CostumeManager에도 복원한다.
		            -- 이 호출이 없으면 가방에는 "착용 중"으로 보이지만 외형은 기본 복장으로 남는다.
		            inventory:RefreshAvatarEquipment()
		        end
	end

	@ExecSpace("ServerOnly")
	method void ApplyRun(SaveRunData run)
		        -- 회차 데이터를 각 컴포넌트에 붓는다.
		        self.CurrentRoom = run.current_room
		
		        ---@type PlayerStats
		        local stats = self.Entity:GetComponent("script.PlayerStats")
		        if stats ~= nil then
		            stats.Level = run.level
		            stats.Exp = run.exp
		            stats.StatStr = run.stat_str
		            stats.StatInt = run.stat_int
		            stats.StatDex = run.stat_dex
		            stats.StatLuk = run.stat_luk
		            stats.UnspentPoints = run.unspent_points
		            -- 캡 플래그는 저장하지 않고 레벨에서 다시 판정한다.
		            -- 저장해두면 캡 수치를 조정했을 때 옛 플래그가 남아 어긋난다.
		            if _GameData:GetBalance("phase3_simplified_growth_enabled") >= 0.5 then
		                stats.CanRebirth = false
		            else
		                stats.CanRebirth = _LevelCurve:IsAtCap(run.level)
		            end
		
		            -- 최대 HP도 STR에서 다시 판정한다 (T27-1). 저장하지 않는 이유는 캡
		            -- 플래그와 같다 — 계수(`str_hp_per_point`)를 조정했을 때 옛 값이 남으면
		            -- 세이브가 있는 계정만 다른 HP로 논다.
		            stats:ApplyMaxHp()
		            stats:ApplySpeeds()
		        end
		
		        ---@type PlayerSkillSlots
		        local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
		        if slots ~= nil then
		            for idx, skillId in pairs(run.equipped_monster_skills) do
		                -- 저장할 때 문자열 키로 넣었으므로("1") 여기서 되돌린다.
		                local slotIndex = tonumber(idx)
		                if slotIndex ~= nil then
		                    slots.MonsterSlots[math.floor(slotIndex)] = skillId
		                end
		            end
		            -- 슬롯 수가 줄어든 뒤 저장된 장착이 남아 있을 수 있다.
		            slots:TrimOverflow()
		        end
	end

	@ExecSpace("ServerOnly")
	method void RestoreRoom()
		        -- 로그아웃한 방으로 되돌린다. 여기서부터 OnMapEnter가 방을 기록하기 시작한다.
		        self.roomRestored = true
		
		        -- 저장된 방이 없으면(=신규 계정) **시작방으로 보낸다.**
		        --
		        -- 왜 필요한가: is_start(현재 r_town 마을)는 사망 복귀·환생 복귀·보스방 귀환
		        -- 세 경로만 쓰고 있었다. 최초 스폰은 Maker의 월드 시작 맵(map01)을 따르므로
		        -- **신규 플레이어는 마을을 한 번도 못 보고 사냥방에서 시작**했다.
		        -- 마을을 만든 이유(환생·귀환·재출발이 모이는 자리)와 첫 출발이 어긋나 있었다.
		        local targetId = self.CurrentRoom
		        local firstStart = false
		        if targetId == "" then
		            local startRoom = _GameData:GetStartRoom()
		            if startRoom == nil then
		                log_warning("[PlayerDB] RoomTable에 is_start 방이 없다 — 기본 스폰 유지")
		                return
		            end
		            targetId = startRoom.id
		            firstStart = true
		        end
		
		        local room = _GameData:GetRoom(targetId)
		        if room == nil or room.map_name == "" then
		            log_warning("[PlayerDB] 갈 방을 찾을 수 없다: " .. targetId)
		            return
		        end
		
		        local map = self.Entity.CurrentMap
		        if map ~= nil and map.Name == room.map_name then
		            -- 이미 그 맵에 있으면 옮기지 않는다. 단 신규 계정은 CurrentRoom이 비어 있어
		            -- 여기서 채워야 한다 — OnMapEnter가 안 불리므로 방이 기록되지 않는다.
		            if firstStart then self.CurrentRoom = targetId end
		            log("[PlayerDB] 이미 " .. targetId .. " 에 있다 — 이동 없음")
		            return
		        end
		
		        -- 도착점은 방 한가운데(0,0,0)다. 포탈은 방 가장자리에 있으므로
		        -- 가운데로 떨어지면 어떤 포탈 트리거에도 걸리지 않는다.
		        log("[PlayerDB] " .. (firstStart and "신규 시작방으로" or "방 복원 →") .. " "
		            .. targetId .. "(" .. room.map_name .. ")")
		        _TeleportService:TeleportToMapPosition(self.Entity, Vector3(0, 0, 0), room.map_name)
	end

	@ExecSpace("ServerOnly")
	method void MarkPermDirty(string reason)
		        -- 영구 데이터가 바뀌었다. 부르는 쪽: 포획 / 보스 클리어 / 환생.
		        self.permDirty = true
		        self.permGen += 1
		        self:RequestSave(reason)
	end

	@ExecSpace("ServerOnly")
	method void RecordRogueliteAreaClear(string areaId)
		        if areaId == nil or areaId == "" or _GameData:GetRogueFloorIndex(areaId) < 1 then return end
		        self.RogueAreaClears[areaId] = (self.RogueAreaClears[areaId] or 0) + 1
		        self:RefreshRogueFloorProgress()
		        self:MarkPermDirty("Roguelite Area 클리어")
	end

	@ExecSpace("ServerOnly")
	method void RefreshRogueFloorProgress()
		        -- 랭크 도입 이전 저장은 이미 열어 둔 층을 보존한다. 이후 새 해금은
		        -- 최고 S랭크 기록으로만 진행하고, 단순 클리어 횟수로는 열리지 않는다.
		        if type(self.RogueSettings) ~= "table" then self.RogueSettings = {} end
		        if type(self.RogueSettings.best_ranks) ~= "table" then self.RogueSettings.best_ranks = {} end
		        if self.RogueSettings.rank_gate_initialized ~= true then
		            self.RogueSettings.legacy_unlocked_floor =
		                _GameData:GetRogueUnlockedFloorFromClears(self.RogueAreaClears)
		            self.RogueSettings.rank_gate_initialized = true
		        end
		        -- 5층 저장을 10층 체계로 한 번만 승격한다. 옛 Mega Area 클리어는
		        -- 같은 테마를 공유하는 두 층의 진행으로 읽어 기존 계정이 후퇴하지 않는다.
		        if self.RogueSettings.floor_count_version ~= 10 then
		            self.RogueSettings.legacy_unlocked_floor =
		                _GameData:GetRogueUnlockedFloorFromClears(self.RogueAreaClears)
		            self.RogueSettings.floor_count_version = 10
		        end
		        local before = self.RogueHighestUnlockedFloor
		        local legacy = math.max(1, math.min(#_GameData:GetRogueFloorIds(),
		            math.floor(self.RogueSettings.legacy_unlocked_floor or 1)))
		        self.RogueHighestUnlockedFloor = math.max(legacy,
		            _GameData:GetRogueUnlockedFloorFromRanks(self.RogueSettings.best_ranks))
		        self:RefreshRogueMonsterSkillDailyView()
		        if before ~= self.RogueHighestUnlockedFloor then
		            log("[RogueFloor] 도전 층 갱신 user=" .. tostring(self.Entity.PlayerComponent.UserId)
		                .. " floor=" .. tostring(self.RogueHighestUnlockedFloor))
		        end
	end

	@ExecSpace("ServerOnly")
	method string GetRogueRewardUtcDay()
		        -- 상점 DAILY와 같은 UTC 일자 경계를 사용한다.
		        local now = DateTime.UtcNow
		        return string.format("%04d%02d%02d", now.Year, now.Month, now.Day)
	end

	@ExecSpace("ServerOnly")
	method integer GetRogueMonsterSkillDailyCount(string areaId)
		        -- 층별 하나의 일자와 횟수만 보관하여 저장 레코드가 무한 증가하지 않는다.
		        if type(self.RogueSettings) ~= "table" then return 0 end
		        local records = self.RogueSettings.monster_skill_daily_rewards
		        if type(records) ~= "table" then return 0 end
		        local record = records[areaId]
		        if record == nil then
		            local floor = _GameData:GetRogueFloorIndex(areaId)
		            if floor > 0 then record = records[_GameData:GetMegaAreaIdForFloor(floor)] end
		        end
		        if type(record) ~= "table" or record.day ~= self:GetRogueRewardUtcDay() then return 0 end
		        return math.max(0, math.min(3, math.floor(record.count or 0)))
	end

	@ExecSpace("ServerOnly")
	method boolean TryConsumeRogueMonsterSkillDailyReward(string areaId)
		        -- 클리어가 서버에서 확정된 뒤에만 호출한다. 3회 이후에도 Run은 클리어할 수 있다.
		        local count = self:GetRogueMonsterSkillDailyCount(areaId)
		        if count >= 3 then return false end
		        if type(self.RogueSettings.monster_skill_daily_rewards) ~= "table" then
		            self.RogueSettings.monster_skill_daily_rewards = {}
		        end
		        self.RogueSettings.monster_skill_daily_rewards[areaId] = {
		            day = self:GetRogueRewardUtcDay(), count = count + 1
		        }
		        self:RefreshRogueMonsterSkillDailyView()
		        return true
	end

	@ExecSpace("ServerOnly")
	method void RecordRogueBestRank(string areaId, string rank)
		        -- 낮은 랭크의 재도전이 기존 최고 랭크를 덮어쓰지 않는다.
		        local order = {B = 1, A = 2, S = 3, SS = 4, SSS = 5}
		        if order[rank] == nil then return end
		        if type(self.RogueSettings.best_ranks) ~= "table" then self.RogueSettings.best_ranks = {} end
		        local old = self.RogueSettings.best_ranks[areaId]
		        if (order[old] or 0) < order[rank] then self.RogueSettings.best_ranks[areaId] = rank end
	end

	@ExecSpace("ServerOnly")
	method void RefreshRogueMonsterSkillDailyView()
		        -- UI에는 오늘의 층별 사용 횟수만 동기화한다. 원장은 서버 저장값이다.
		        local counts = {}
		        for _, areaId in ipairs(_GameData:GetRogueFloorIds()) do
		            counts[#counts + 1] = tostring(self:GetRogueMonsterSkillDailyCount(areaId))
		        end
		        self.RogueMonsterSkillDailyView = self:GetRogueRewardUtcDay()
		            .. ";" .. table.concat(counts, ",")
	end

	@ExecSpace("ServerOnly")
	method void MarkRunDirty(string reason)
		        -- 회차 데이터가 바뀌었다. 부르는 쪽: 레벨업 / 분배 / 장착 / 방 전환.
		        if self.RogueStorageMode then return end
		        self.runDirty = true
		        self.runGen += 1
		        self:RequestSave(reason)
	end

	@ExecSpace("ServerOnly")
	method void RequestSave(string reason)
		        -- 이벤트 저장의 유일한 입구. 최소 간격 안이면 예약만 하고 돌아간다.
		        if self.IsLoadSuccess == false then return end
		
		        local minInterval = _GameData:GetBalance("save_min_interval")
		        local now = _UtilLogic.ElapsedSeconds
		        local since = now - self.lastSaveAt
		
		        if since >= minInterval then
		            self:SaveToDB(false, reason)
		            return
		        end
		
		        -- 이미 예약이 걸려 있으면 새로 걸지 않는다. 예약은 "그때 한 번 쓴다"는
		        -- 뜻이고, 그 사이 쌓인 변경은 그 한 번에 전부 실린다.
		        --
		        -- 사유는 첫 것만 남기고 나머지는 세기만 한다. 이어붙이면 슬라임 40마리를
		        -- 잡는 동안 사유가 47개까지 늘어나 로그 한 줄이 화면을 덮는다 (실측).
		        if self.pendingTimer ~= nil then
		            self.pendingCount = self.pendingCount + 1
		            return
		        end
		
		        self.pendingReason = reason
		        self.pendingCount = 1
		        self.pendingTimer = _TimerService:SetTimerOnce(function()
		            self.pendingTimer = nil
		            local label = self.pendingReason
		            if self.pendingCount > 1 then
		                label = label .. " 외 " .. tostring(self.pendingCount - 1) .. "건"
		            end
		            self.pendingReason = ""
		            self.pendingCount = 0
		            self:SaveToDB(false, label)
		        end, minInterval - since)
	end

	@ExecSpace("ServerOnly")
	method void NoteLevel(integer level)
		        -- 최고 도달 레벨을 **오를 때** 기록한다.
		        --
		        -- 왜 저장 시점에 유도하면 안 되는가 (T7 실측): GatherPerm에서
		        -- max(현재 레벨, 기록)으로 계산했더니 환생이 레벨을 1로 되돌린 뒤
		        -- 저장이 돌아 30이 기록될 창이 없었다 — 최고레벨이 13에 머물렀다.
		        -- 레벨업 구간 내내 Run만 더티라 Perm이 아예 모아지지 않은 것도 겹쳤다.
		        if level <= self.HighestLevel then return end
		        self.HighestLevel = level
		        self:MarkPermDirty("최고 레벨 갱신")
	end

	@ExecSpace("ServerOnly")
	method void SaveNow(string reason)
		        -- 스로틀을 건너뛰고 지금 당장, 블로킹으로 쓴다. 환생이 이걸 부른다.
		        --
		        -- 왜 스로틀을 쓰지 않는가 (작업지시서 T7 요청 1 — 원자적 처리):
		        -- 환생은 Perm(환생 횟수·구역)과 Run(레벨 초기화)을 **동시에** 바꾼다.
		        -- 스로틀에 맡기면 그 사이에 앱이 죽었을 때 회차만 초기화되고 영구는
		        -- 안 써진 반쪽 상태가 남는다.
		        --
		        -- 두 키를 다 더티로 올리는 이유: BatchSet은 payload에 담긴 키만 쓴다.
		        -- 한쪽이 깨끗하면 그 키는 이번 쓰기에서 빠져 같은 반쪽 문제가 생긴다.
		        -- 둘을 한 번의 BatchSetAndWait에 실어야 한쪽만 반영되는 창이 닫힌다.
		        if self.IsLoadSuccess == false then
		            log_error("[PlayerDB] 로드 실패 세션 — " .. reason .. " 저장을 건너뛴다")
		            return
		        end
		
		        if self.pendingTimer ~= nil then
		            _TimerService:ClearTimer(self.pendingTimer)
		            self.pendingTimer = nil
		            self.pendingReason = ""
		            self.pendingCount = 0
		        end
		
		        self.permDirty = true
		        self.permGen = self.permGen + 1
		        self.runDirty = true
		        self.runGen = self.runGen + 1
		
		        self:SaveToDB(true, reason)
	end

	@ExecSpace("ServerOnly")
	method void SaveToDB(boolean isLeaving, string reason)
		        if self.IsLoadSuccess == false then return end
		        if self.StorageWriteBlocked or self:ValidateStorageData() == false then return end
		        if self.RogueStorageMode and self.RogueWriteBusy then return end
		
		        -- saveData / savedGenerations는 **지역 변수**다. 저장 두 개가 동시에
		        -- 떠 있어도(퇴장 저장이 진행 중인 비동기 저장과 겹칠 때) 각자 자기
		        -- 스냅샷을 들고 돌아오므로 서로의 결과를 덮어쓰지 않는다 (datastorage §8).
		        local saveData = {}
		        local savedGens = {}
		
		        if self.RogueStorageMode then
		            if self.permDirty then
		                local encodedOk, encoded = pcall(function()
		                    return _HttpService:JSONEncode(self:GatherRogueliteRecords())
		                end)
		                if encodedOk == false then
		                    log_error("[PlayerDB] 로그라이트 직렬화 실패 — 기존 저장 보존, dirty 유지")
		                    return
		                end
		                saveData[self.KeyRogue] = encoded
		                savedGens[self.KeyRogue] = self.permGen
		            end
		        elseif self.permDirty then
		            saveData[self.KeyPerm] = _HttpService:JSONEncode(self:GatherPerm())
		            savedGens[self.KeyPerm] = self.permGen
		        end
		        if self.runDirty and self.RogueStorageMode == false then
		            saveData[self.KeyRun] = _HttpService:JSONEncode(self:GatherRun())
		            savedGens[self.KeyRun] = self.runGen
		        end
		
		        if next(saveData) == nil then return end
		
		        self.lastSaveAt = _UtilLogic.ElapsedSeconds
		        local profileCode = self.Entity.PlayerComponent.ProfileCode
		        local ds = _DataStorageService:GetUserDataStorage(profileCode)
		
		        if self.RogueStorageMode then
		            -- 영구 경제 원장은 하나의 키에 순서대로 저장한다. 구매/코어 사용과
		            -- 과거 비동기 스냅샷이 경쟁해 지급 내역을 되돌리는 일을 막는다.
		            self.RogueWriteBusy = true
		            local code, successKeys = ds:BatchSetAndWait(saveData)
		            self.RogueWriteBusy = false
		            self:OnSavedToDB(successKeys, savedGens)
		            if code ~= 0 then
		                log_error("[PlayerDB] Rogue 영구 저장 실패 ErrorCode=" .. tostring(code))
		            elseif self.permDirty then
		                self:RequestSave("Rogue 저장 중 변경 재시도")
		            end
		        elseif isLeaving then
		            local code, successKeys = ds:BatchSetAndWait(saveData)
		            self:OnSavedToDB(successKeys, savedGens)
		            if code ~= 0 then
		                log_error("[PlayerDB] 퇴장 저장 실패  ErrorCode=" .. tostring(code)
		                    .. "  성공 키=" .. tostring(#successKeys))
		            else
		                log("[PlayerDB] 저장 완료 (" .. reason .. ")  키=" .. tostring(#successKeys) .. "개")
		            end
		        else
		            ds:BatchSetAsync(saveData, function(code, successKeys)
		                self:OnSavedToDB(successKeys, savedGens)
		                if code ~= 0 then
		                    log_warning("[PlayerDB] 저장 부분 실패  ErrorCode=" .. tostring(code)
		                        .. "  성공 키=" .. tostring(#successKeys))
		                else
		                    log("[PlayerDB] 저장 완료 (" .. reason .. ")  키=" .. tostring(#successKeys) .. "개")
		                end
		            end)
		        end
	end

	@ExecSpace("ServerOnly")
	method boolean IsRogueEconomyReady()
		        return self.RogueStorageMode and self.IsLoadSuccess
		            and self.StorageWriteBlocked == false and self.RogueWriteBusy == false
	end

	@ExecSpace("ServerOnly")
	method table PrepareRogueEconomyPayload()
		        -- 경제 변경 전 현재 영구 상태를 독립된 후보 원장으로 만든다.
		        if self:IsRogueEconomyReady() == false or self:ValidateStorageData() == false then return nil end
		        return self:GatherRogueliteRecords()
	end

	@ExecSpace("ServerOnly")
	method boolean CommitRogueEconomyPayload(table candidate, string reason)
		        -- 성장/구매 후보를 한 키로 먼저 저장한 뒤에만 현재 원장으로 확정한다.
		        if candidate == nil or self:IsRogueEconomyReady() == false
		            or self:ValidateRogueliteRecord(candidate) == false then return false end
		        self.RogueWriteBusy = true
		        local ok, encoded = pcall(function()
		            return _HttpService:JSONEncode(self:MakeSerializableRoguePayload(candidate))
		        end)
		        if ok == false then
		            self.RogueWriteBusy = false
		            log_error("[PlayerDB] 경제 후보 직렬화 실패: " .. reason)
		            return false
		        end
		        if #encoded > 300000 then
		            self.RogueWriteBusy = false
		            log_error("[PlayerDB] 경제 후보 저장 한도 초과: " .. reason)
		            return false
		        end
		        local gen = self.permGen
		        local saveOk, code = pcall(function()
		            local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		            return ds:SetAndWait(self.KeyRogue, encoded)
		        end)
		        if saveOk == false or code ~= 0 then
		            self.RogueWriteBusy = false
		            log_error("[PlayerDB] 경제 후보 저장 실패 ErrorCode=" .. tostring(code) .. " reason=" .. reason)
		            return false
		        end
		        self.RogueSavedPayload = candidate
		        if gen == self.permGen then self.permDirty = false end
		        self.lastSaveAt = _UtilLogic.ElapsedSeconds
		        self.RogueWriteBusy = false
		        if self.permDirty then self:RequestSave("경제 후보 저장 중 변경 재시도") end
		        log("[PlayerDB] 경제 원장 확정: " .. reason)
		        return true
	end

	@ExecSpace("ServerOnly")
	method boolean SaveRogueEconomyNow(string reason)
		        if self:IsRogueEconomyReady() == false or self:ValidateStorageData() == false then return false end
		        self.RogueWriteBusy = true
		        local ok, encoded = pcall(function()
		            return _HttpService:JSONEncode(self:GatherRogueliteRecords())
		        end)
		        if ok == false then
		            self.RogueWriteBusy = false
		            log_error("[PlayerDB] 경제 직렬화 실패: " .. reason)
		            return false
		        end
		        local gen = self.permGen
		        local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		        local code = ds:SetAndWait(self.KeyRogue, encoded)
		        self.RogueWriteBusy = false
		        if code ~= 0 then
		            log_error("[PlayerDB] 경제 저장 실패 ErrorCode=" .. tostring(code) .. " reason=" .. reason)
		            return false
		        end
		        if gen == self.permGen then self.permDirty = false end
		        self.lastSaveAt = _UtilLogic.ElapsedSeconds
		        if self.permDirty then self:RequestSave("경제 저장 중 변경 재시도") end
		        log("[PlayerDB] 경제 저장 완료: " .. reason)
		        return true
	end

	@ExecSpace("ServerOnly")
	method void OnSavedToDB(any successKeys, table savedGens)
		        -- 스토리지가 확인해준 키만 더티를 내린다.
		        --
		        -- 세대를 비교하는 이유: 비동기 저장이 오가는 사이에 값이 또 바뀔 수 있다.
		        -- 성공했다고 무조건 더티를 내리면 그 사이 변경이 조용히 사라진다.
		        for i = 1, #successKeys do
		            local key = successKeys[i]
		            if key == self.KeyPerm or key == self.KeyRogue then
		                if savedGens[key] ~= nil and savedGens[key] == self.permGen then
		                    self.permDirty = false
		                end
		            elseif key == self.KeyRun then
		                if savedGens[key] ~= nil and savedGens[key] == self.runGen then
		                    self.runDirty = false
		                end
		            end
		        end
	end

	@ExecSpace("ServerOnly")
	method boolean ValidateStorageData()
		        -- 필수 데이터가 없으면 해당 세션 저장을 잠근다. 재접속 전 자동 해제하지 않는다.
		        if self.StorageWriteBlocked then return false end
		        for _, name in ipairs({"GameBalance", "SkillTable", "MonsterTable", "RoomTable", "AreaTable", "ItemTable", "LandmarkTable"}) do
		            local data = _DataService:GetTable(name)
		            if data == nil or data:GetRowCount() <= 0 then
		                self.StorageWriteBlocked = true
		                log_error("[PlayerDB] 저장 보호: 필수 테이블 미로드 " .. name)
		                return false
		            end
		        end
		        if #_GameData:GetAllSkillIds() == 0 or #_GameData:GetAllMonsterIds() == 0
		            or #_GameData:GetAllItemIds() == 0 or #_GameData:GetAllAreaIds() == 0 then
		            self.StorageWriteBlocked = true
		            log_error("[PlayerDB] 저장 보호: 데이터 캐시 불완전")
		            return false
		        end
		        return true
	end

	@ExecSpace("ServerOnly")
	method table DecodeRogueliteRecord(string raw, boolean legacyEnvelope)
		        -- 순수 역직렬화: 테스트 가능한 입력만 받고 실제 저장/플레이어 상태는 변경하지 않는다.
		        local ok, decoded = pcall(function() return _HttpService:JSONDecode(raw) end)
		        if not ok or type(decoded) ~= "table" then return nil end
		        if legacyEnvelope then
		            if decoded.RoguelitePermanent == nil then return {} end
		            if type(decoded.RoguelitePermanent) ~= "table" then return nil end
		            decoded = decoded.RoguelitePermanent
		            if decoded.schema_version ~= nil and decoded.schema_version ~= 1
		                and decoded.schema_version ~= 2 and decoded.schema_version ~= 3
		                and decoded.schema_version ~= 4 then return nil end
		        elseif decoded.schema_version ~= 1 and decoded.schema_version ~= 2
		            and decoded.schema_version ~= 3 and decoded.schema_version ~= 4 then
		            return nil
		        end
		        local migrate = (decoded.schema_version or 1) < 4
		        if self:ValidateRogueliteRecord(decoded) == false then return nil end
		        if migrate then decoded._needs_migration_save = true end
		        return decoded
	end

	@ExecSpace("ServerOnly")
	method boolean ValidateRogueliteRecord(table payload)
		        -- 누락 필드만 기본값으로 채운다. 잘못된 타입/미래 schema는 자동 덮어쓰지 않는다.
		        local oldSchema = payload.schema_version or 1
		        for _, field in ipairs({"discovered_monsters", "discovered_abilities", "area_clears", "optional_encounters", "settings", "tamed_monsters", "permanent_skills", "monster_loadouts", "monster_levels", "monster_enhances", "equipped_companions", "purchase_receipts", "purchase_limits", "purchase_receipt_order"}) do
		            if payload[field] ~= nil and type(payload[field]) ~= "table" then return false end
		            if payload[field] == nil then payload[field] = {} end
		        end
		        for _, field in ipairs({"discovered_monsters", "discovered_abilities"}) do
		            for id, value in pairs(payload[field]) do
		                if type(id) ~= "string" then return false end
		                if value ~= true and value ~= false and value ~= 0 and value ~= 1 then return false end
		            end
		        end
		        for id, count in pairs(payload.area_clears) do
		            if type(id) ~= "string" or type(count) ~= "number" then return false end
		            if count ~= count or count < 0 or count >= math.huge or count ~= math.floor(count) then return false end
		        end
		        for id, count in pairs(payload.tamed_monsters) do
		            if type(id) ~= "string" or type(count) ~= "number"
		                or count ~= count or count < 0 or count > 5 or count ~= math.floor(count) then return false end
		        end
		        for id, owned in pairs(payload.permanent_skills) do
		            if type(id) ~= "string" or (owned ~= 1 and owned ~= true) then return false end
		        end
		        for key, skillId in pairs(payload.monster_loadouts) do
		            if type(key) ~= "string" or type(skillId) ~= "string" then return false end
		        end
		        for id, level in pairs(payload.monster_levels) do
		            if type(id) ~= "string" or type(level) ~= "number" or level ~= math.floor(level)
		                or level < 0 or level >= math.huge then return false end
		        end
		        for id, stage in pairs(payload.monster_enhances) do
		            if type(id) ~= "string" or type(stage) ~= "number" or stage ~= math.floor(stage)
		                or stage < 0 or stage >= math.huge then return false end
		        end
		        for id, count in pairs(payload.tamed_monsters) do
		            if count > 0 and (payload.monster_levels[id] == nil
		                or payload.monster_levels[id] == 0) then payload.monster_levels[id] = count end
		        end
		        if payload.monster_growth_currency ~= nil and (type(payload.monster_growth_currency) ~= "number"
		            or payload.monster_growth_currency < 0 or payload.monster_growth_currency ~= math.floor(payload.monster_growth_currency)) then return false end
		        payload.monster_growth_currency = payload.monster_growth_currency or 0
		        for _, field in ipairs({"growth_core", "monster_selection_tickets"}) do
		            local value = payload[field]
		            if value ~= nil and (type(value) ~= "number" or value ~= math.floor(value)
		                or value < 0 or value >= math.huge) then return false end
		            payload[field] = value or 0
		        end
		        for purchaseId, marker in pairs(payload.purchase_receipts) do
		            if type(purchaseId) ~= "string" or type(marker) ~= "string" then return false end
		        end
		        for key, count in pairs(payload.purchase_limits) do
		            if type(key) ~= "string" or type(count) ~= "number" or count < 0
		                or count ~= math.floor(count) then return false end
		        end
		        if #payload.purchase_receipt_order > 256 then return false end
		        for _, purchaseId in ipairs(payload.purchase_receipt_order) do
		            if type(purchaseId) ~= "string" then return false end
		        end
		        local chosen = {}
		        for slot, id in pairs(payload.equipped_companions) do
		            if (slot ~= "1" and slot ~= "2" and slot ~= "3") or type(id) ~= "string"
		                or chosen[id] then return false end
		            chosen[id] = true
		        end
		        if payload.selected_companion ~= nil and type(payload.selected_companion) ~= "string" then return false end
		        if payload.selected_companion == nil then payload.selected_companion = "" end
		        if payload.settings.key_order ~= nil and type(payload.settings.key_order) ~= "string" then return false end
		        if payload.settings.rank_gate_initialized ~= nil
		            and type(payload.settings.rank_gate_initialized) ~= "boolean" then return false end
		        local legacyFloor = payload.settings.legacy_unlocked_floor
		        if legacyFloor ~= nil and (type(legacyFloor) ~= "number" or legacyFloor ~= math.floor(legacyFloor)
		            or legacyFloor < 1 or legacyFloor > #_GameData:GetRogueFloorIds()) then return false end
		        local bestRanks = payload.settings.best_ranks
		        if bestRanks ~= nil then
		            if type(bestRanks) ~= "table" then return false end
		            for areaId, rank in pairs(bestRanks) do
		                if type(areaId) ~= "string" or (rank ~= "S" and rank ~= "SS"
		                    and rank ~= "SSS" and rank ~= "A" and rank ~= "B") then return false end
		            end
		        end
		        local dailyRewards = payload.settings.monster_skill_daily_rewards
		        if dailyRewards ~= nil then
		            if type(dailyRewards) ~= "table" then return false end
		            for areaId, record in pairs(dailyRewards) do
		                if type(areaId) ~= "string" or type(record) ~= "table"
		                    or type(record.day) ~= "string" or type(record.count) ~= "number"
		                    or record.count ~= math.floor(record.count)
		                    or record.count < 0 or record.count > 3 then return false end
		            end
		        end
		        if oldSchema < 3 then
		            if payload.selected_companion ~= ""
		                and payload.equipped_companions["1"] == nil
		                and payload.equipped_companions["2"] ~= payload.selected_companion
		                and payload.equipped_companions["3"] ~= payload.selected_companion then
		                payload.equipped_companions["1"] = payload.selected_companion
		            end
		        end
		        payload.schema_version = 4
		        return true
	end

	@ExecSpace("ServerOnly")
	method void LoadRogueliteRecords()
		        -- 신규 모드에서는 RPG/M2 필드를 적용하거나 저장하지 않는다.
		        local keys = {self.KeyRogue}
		        if Environment:IsMakerPlay() == false then keys[#keys + 1] = self.KeyPerm end
		        local loaded = {}
		        if self:BatchGetAndWait(self.Entity.PlayerComponent.ProfileCode, keys, loaded) == false then return end
		        local payload = {}
		        local item = loaded[self.KeyRogue]
		        if item ~= nil and item.Value ~= nil and item.Value ~= "" then
		            payload = self:DecodeRogueliteRecord(item.Value, false)
		            if payload == nil then
		                self.StorageWriteBlocked = true
		                log_error("[PlayerDB] 로그라이트 저장 형식 불일치 — 원본 보존")
		                return
		            end
		        elseif loaded[self.KeyPerm] ~= nil and loaded[self.KeyPerm].Value ~= nil and loaded[self.KeyPerm].Value ~= "" then
		            -- 이전 Perm 내부의 신규 모드 기록만 단방향 이관. Perm 자체는 쓰지 않는다.
		            local legacy = self:DecodeRogueliteRecord(loaded[self.KeyPerm].Value, true)
		            if legacy == nil then
		                self.StorageWriteBlocked = true
		                log_error("[PlayerDB] 레거시 로그라이트 기록 읽기 실패 — 원본 보존")
		                return
		            end
		            if legacy.schema_version == 4 then
		                payload = legacy
		                self.permDirty = true
		                self.permGen += 1
		            end
		        end
		        if self:ValidateRogueliteRecord(payload) == false then
		            self.StorageWriteBlocked = true
		            log_error("[PlayerDB] 로그라이트 저장 필드 불일치 — 원본 보존")
		            return
		        end
		        if payload._needs_migration_save then
		            payload._needs_migration_save = nil
		            self.permDirty = true
		            self.permGen += 1
		        end
		        payload.schema_version = 4
		        self.RogueSavedPayload = payload
		        self.RogueAreaClears = payload.area_clears
		        self.RogueOptionalEncounters = payload.optional_encounters
		        self.RogueSettings = payload.settings
		        self:RefreshRogueFloorProgress()
		        ---@type PlayerSkillSlots
		        local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
		        if slots ~= nil and type(payload.settings.key_order) == "string" then
		            slots.KeyOrder = payload.settings.key_order
		        end
		        ---@type PlayerCollection
		        local collection = self.Entity:GetComponent("script.PlayerCollection")
		        if collection == nil then return end
		        for id, value in pairs(payload.discovered_monsters) do
		            if (value == true or value == 1) and _GameData:GetMonster(id) ~= nil then collection.RogueDiscoveredMonsters[id] = 1 end
		        end
		        for id, value in pairs(payload.discovered_abilities) do
		            if (value == true or value == 1) and _GameData:GetSkill(id) ~= nil then collection.RogueDiscoveredAbilities[id] = 1 end
		        end
		        for _, monsterId in ipairs(_GameData:GetTameableMonsterIds()) do
		            collection:SetTamedCount(monsterId, 0)
		        end
		        for monsterId, count in pairs(payload.tamed_monsters) do
		            if _GameData:IsTameableMonster(monsterId) then collection:SetTamedCount(monsterId, count) end
		        end
		        collection.MonsterGrowthCurrency = payload.monster_growth_currency
		        collection.MonsterGrowthCore = payload.growth_core
		        collection.MonsterSelectionTickets = payload.monster_selection_tickets
		        for _, monsterId in ipairs(_GameData:GetTameableMonsterIds()) do
		            collection.MonsterLevels[monsterId] = nil
		            collection.MonsterEnhances[monsterId] = nil
		        end
		        for monsterId, level in pairs(payload.monster_levels) do
		            if collection:GetTamedCount(monsterId) > 0 then
		                collection.MonsterLevels[monsterId] = level
		            end
		        end
		        for monsterId, stage in pairs(payload.monster_enhances) do
		            if collection:GetTamedCount(monsterId) > 0 then
		                collection.MonsterEnhances[monsterId] = stage
		            end
		        end
		        for _, skillId in ipairs(_GameData:GetAllSkillIds()) do
		            collection.PermanentSkillCollection[skillId] = nil
		        end
		        for skillId, owned in pairs(payload.permanent_skills) do
		            local skill = _GameData:GetSkill(skillId)
		            if (owned == true or owned == 1) and skill ~= nil and skill.source == "monster"
		                and skill.slot_type == "monster" and skill.skill_kind ~= "passive" then
		                collection.PermanentSkillCollection[skillId] = 1
		            end
		        end
		        for _, monsterId in ipairs(_GameData:GetTameableMonsterIds()) do
		            for slot = 1, 3 do collection.MonsterSkillLoadouts[monsterId .. ":" .. tostring(slot)] = nil end
		        end
		        for key, skillId in pairs(payload.monster_loadouts) do
		            local monsterId = string.match(key, "^(.+):[123]$")
		            if monsterId ~= nil and collection:GetTamedCount(monsterId) > 0
		                and collection.PermanentSkillCollection[skillId] ~= nil then
		                collection.MonsterSkillLoadouts[key] = skillId
		            end
		        end
		        for slot = 1, 3 do
		            local key = tostring(slot)
		            local id = payload.equipped_companions[key] or ""
		            collection.EquippedCompanions[key] = id ~= "" and collection:GetMonsterLevel(id) > 0
		                and id or nil
		        end
		        collection.SelectedCompanionMonsterId = collection:GetEquippedCompanion(1)
		        self.IsLoadSuccess = true
		        self.roomRestored = true
		        log("[PlayerDB] 로그라이트 전용 로드 완료 key=" .. self.KeyRogue .. " legacyWrites=false")
	end

	@ExecSpace("ServerOnly")
	method table MakeSerializableRoguePayload(table source)
		        -- Maker JSONEncode가 빈 중첩 table을 거부하므로 직렬화 사본에서만 생략한다.
		        local function serializableCopy(value)
		            local out = {}
		            for key, item in pairs(value) do
		                if type(item) == "table" then
		                    local child = serializableCopy(item)
		                    if next(child) ~= nil then out[key] = child end
		                else
		                    out[key] = item
		                end
		            end
		            return out
		        end
		        return serializableCopy(source)
	end

	@ExecSpace("ServerOnly")
	method table GatherRogueliteRecords()
		        -- 미등록/미래 식별자도 기존 payload에 보존하고 발견 기록만 추가한다.
		        local payload = self.RogueSavedPayload
		        ---@type PlayerCollection
		        local collection = self.Entity:GetComponent("script.PlayerCollection")
		        for _, id in ipairs(_GameData:GetAllMonsterIds()) do
		            if collection ~= nil and collection.RogueDiscoveredMonsters[id] ~= nil then payload.discovered_monsters[id] = 1 end
		        end
		        for _, id in ipairs(_GameData:GetAllSkillIds()) do
		            if collection ~= nil and collection.RogueDiscoveredAbilities[id] ~= nil then payload.discovered_abilities[id] = 1 end
		        end
		        if collection ~= nil then
		            for _, monsterId in ipairs(_GameData:GetTameableMonsterIds()) do
		                local count = collection:GetTamedCount(monsterId)
		                if count > 0 then payload.tamed_monsters[monsterId] = count end
		                local level = collection.MonsterLevels[monsterId] or count
		                if level > 0 then payload.monster_levels[monsterId] = level end
		                local enhance = collection.MonsterEnhances[monsterId] or 0
		                if enhance > 0 then payload.monster_enhances[monsterId] = enhance end
		                for slot = 1, 3 do
		                    local key = monsterId .. ":" .. tostring(slot)
		                    local skillId = collection:GetMonsterLoadoutSkill(monsterId, slot)
		                    if skillId ~= "" then payload.monster_loadouts[key] = skillId end
		                end
		            end
		            for _, skillId in ipairs(_GameData:GetAllSkillIds()) do
		                if collection.PermanentSkillCollection[skillId] ~= nil then payload.permanent_skills[skillId] = 1 end
		            end
		            payload.monster_growth_currency = collection.MonsterGrowthCurrency
		            payload.growth_core = collection.MonsterGrowthCore
		            payload.monster_selection_tickets = collection.MonsterSelectionTickets
		            for slot = 1, 3 do
		                local id = collection:GetEquippedCompanion(slot)
		                payload.equipped_companions[tostring(slot)] = id ~= "" and id or nil
		            end
		            -- 과거 selected_companion/monster_loadouts는 payload 그대로 보존하지만
		            -- 신규 로직에서 다시 쓰거나 성장에 연결하지 않는다.
		        end
		        payload.area_clears = self.RogueAreaClears
		        payload.optional_encounters = self.RogueOptionalEncounters
		        payload.settings = self.RogueSettings
		        ---@type PlayerSkillSlots
		        local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
		        if slots ~= nil then payload.settings.key_order = slots.KeyOrder end
		        return self:MakeSerializableRoguePayload(payload)
	end

	@ExecSpace("ServerOnly")
	method table GatherPerm()
		        local perm = SavePermanentData()
		        perm:Init(math.floor(_GameData:GetBalance("monster_slot_start")))
		
		        -- NoteLevel이 오를 때마다 갱신하므로 여기서는 들고 있는 값을 그대로 쓴다.
		        -- 현재 레벨에서 다시 유도하지 않는다 — 환생 직후에는 그 값이 1이다.
		        perm.highest_level = self.HighestLevel
		        perm.landmark_claimed = self.LandmarkClaimed
		
		        ---@type PlayerCollection
		        local collection = self.Entity:GetComponent("script.PlayerCollection")
		        if collection ~= nil then
		            local owned = {}
		            for _, id in ipairs(_GameData:GetAllSkillIds()) do
		                local skill = _GameData:GetSkill(id)
		                local n = collection:GetOwnedCount(id)
		                if skill ~= nil and skill.source == "monster" and n ~= nil and n > 0 then owned[id] = n end
		            end
		            perm.owned_skills = owned
		
		            -- v5 신규 원장. 101개 명시적 몬스터 키만 저장하며 0개는 생략한다.
		            local tamed = {}
		            for _, monsterId in ipairs(_GameData:GetTameableMonsterIds()) do
		                local n = collection:GetTamedCount(monsterId)
		                if n > 0 then tamed[monsterId] = n end
		            end
		            perm.tamed_monsters = tamed
		            if collection.SelectedCompanionMonsterId ~= ""
		                and collection:GetTamedCount(collection.SelectedCompanionMonsterId) > 0 then
		                perm.selected_companion_monster_id = collection.SelectedCompanionMonsterId
		            else
		                perm.selected_companion_monster_id = ""
		            end
		
		            local kills = {}
		            for _, id in ipairs(_GameData:GetAllMonsterIds()) do
		                local n = collection.SpeciesKills[id]
		                if n ~= nil and n > 0 then kills[id] = n end
		            end
		            perm.species_kills = kills
		
		            local totalKills = {}
		            for _, id in ipairs(_GameData:GetAllMonsterIds()) do
		                ---@type any
		                local collectionV4 = collection
		                local n = collectionV4.TotalMonsterKills[id]
		                if n ~= nil and n > 0 then totalKills[id] = n end
		            end
		            ---@type any
		            local permV4 = perm
		            permV4.total_monster_kills = totalKills
		
		            local discoveredMonsters = {}
		            for _, monsterId in ipairs(_GameData:GetAllMonsterIds()) do
		                if collection.RogueDiscoveredMonsters[monsterId] ~= nil then
		                    discoveredMonsters[monsterId] = 1
		                end
		            end
		            perm.roguelite_discovered_monsters = discoveredMonsters
		
		            local discoveredAbilities = {}
		            for _, skillId in ipairs(_GameData:GetAllSkillIds()) do
		                if collection.RogueDiscoveredAbilities[skillId] ~= nil then
		                    discoveredAbilities[skillId] = 1
		                end
		            end
		            perm.roguelite_discovered_abilities = discoveredAbilities
		
		            local permanentSkills = {}
		            for _, skillId in ipairs(_GameData:GetAllSkillIds()) do
		                if collection.PermanentSkillCollection[skillId] ~= nil then
		                    permanentSkills[skillId] = 1
		                end
		            end
		            perm.roguelite_permanent_skills = permanentSkills
		
		            local loadouts = {}
		            for _, monsterId in ipairs(_GameData:GetTameableMonsterIds()) do
		                if collection:GetTamedCount(monsterId) > 0 then
		                    for slot = 1, 3 do
		                        local key = monsterId .. ":" .. tostring(slot)
		                        local skillId = collection.MonsterSkillLoadouts[key]
		                        if skillId ~= nil and collection.PermanentSkillCollection[skillId] ~= nil then
		                            loadouts[key] = skillId
		                        end
		                    end
		                end
		            end
		            perm.roguelite_monster_loadouts = loadouts
		        end
		
		        perm.roguelite_area_clears = self.RogueAreaClears
		        perm.roguelite_optional_encounters = self.RogueOptionalEncounters
		        perm.roguelite_settings = self.RogueSettings
		
		        ---@type PlayerSkillSlots
		        local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
		        if slots ~= nil then
		            perm.rebirth_count = slots.RebirthCount
		            perm.best_rebirth_level = slots.BestRebirthLevel
		            perm.best_tier = slots.BestTier
		            perm.monster_slot_count = slots.MonsterSlotCount
		            perm.key_order = slots.KeyOrder
		            perm.selected_trait = slots:NormalizeTraitId(slots.SelectedTrait)
		
		            local bosses = {}
		            for _, roomId in ipairs(_GameData:GetAllRoomIds()) do
		                local run = slots.BossRoomsCleared[roomId]
		                if run ~= nil then bosses[roomId] = run end
		            end
		            perm.bosses_cleared = bosses
		
		            local areas = {}
		            for _, areaId in ipairs(_GameData:GetAllAreaIds()) do
		                if slots.UnlockedAreas[areaId] ~= nil then areas[areaId] = 1 end
		            end
		            perm.unlocked_areas = areas
		        end
		
		        ---@type PlayerInventory
		        local inventory = self.Entity:GetComponent("script.PlayerInventory")
		        if inventory ~= nil then
		            -- SyncTable을 순회할 수 없으므로 ItemTable의 키 공간 전체를 훑는다
		            -- (이 파일 상단 주석 참고). 0개는 담지 않는다.
		            local bag = {}
		            for _, id in ipairs(_GameData:GetAllItemIds()) do
		                local n = inventory:GetCount(id)
		                if n > 0 then bag[id] = n end
		            end
		            perm.inventory = bag
		
		            -- 장착은 슬롯 이름 목록을 훑는다. 슬롯 수가 한 자릿수라 이쪽이 싸다.
		            local worn = {}
		            local slotNames = inventory:GetEquipSlotNames()
		            for i = 1, #slotNames do
		                local id = inventory:GetEquipped(slotNames[i])
		                if id ~= "" then worn[slotNames[i]] = id end
		            end
		            perm.equipped = worn
		        end
		
		        local out = {}
		        perm:Serialize(out)
		        return out
	end

	@ExecSpace("ServerOnly")
	method table GatherRun()
		        local run = SaveRunData()
		        run:Init()
		        run.current_room = self.CurrentRoom
		
		        ---@type PlayerStats
		        local stats = self.Entity:GetComponent("script.PlayerStats")
		        if stats ~= nil then
		            run.level = stats.Level
		            run.exp = stats.Exp
		            run.stat_str = stats.StatStr
		            run.stat_int = stats.StatInt
		            run.stat_dex = stats.StatDex
		            run.stat_luk = stats.StatLuk
		            run.unspent_points = stats.UnspentPoints
		        end
		
		        ---@type PlayerSkillSlots
		        local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
		        if slots ~= nil then
		            local maxSlot = math.floor(_GameData:GetBalance("monster_slot_max"))
		            local equipped = {}
		            for i = 1, maxSlot do
		                local id = slots.MonsterSlots[i]
		                -- JSON 객체 키는 문자열이라야 한다. 숫자 인덱스를 그대로 넣으면
		                -- 디코드했을 때 키 타입이 달라져 장착이 복원되지 않는다.
		                if id ~= nil then equipped[tostring(i)] = id end
		            end
		            run.equipped_monster_skills = equipped
		        end
		
		        local out = {}
		        run:Serialize(out)
		        return out
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserLeaveEvent(UserLeaveEvent event)
		        -- 접속 종료 시점 저장 보장 (작업지시서 T8 질문 3).
		        -- 스로틀을 무시하고 즉시, 그리고 AndWait으로 — 세션이 끝나기 전에
		        -- 스토리지가 확인해줄 때까지 기다려야 한다. 마지막 기회다.
		        if event.UserId ~= self.Entity.PlayerComponent.UserId then return end
		
		        if self.pendingTimer ~= nil then
		            _TimerService:ClearTimer(self.pendingTimer)
		            self.pendingTimer = nil
		        end
		
		        -- 세션 요약을 저장보다 먼저 남긴다. 저장은 블로킹이고 실패할 수도 있는데,
		        -- 그때 세션 기록까지 같이 사라지면 무슨 일이 있었는지 볼 수가 없다.
		        ---@type PlayerStats
		        local stats = self.Entity:GetComponent("script.PlayerStats")
		        local finalLevel = 0
		        if stats ~= nil then finalLevel = stats.Level end
		        _ProgressLog:SessionEnd(self.Entity.PlayerComponent.UserId, finalLevel)
		
		        log("[PlayerDB] 접속 종료 — 마지막 저장")
		        self:SaveToDB(true, "접속 종료")
	end

end
