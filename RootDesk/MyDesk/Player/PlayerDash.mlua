@Logic
script PlayerDash extends Logic

	property boolean dashing = false

	property number dashLeft = 0

	property Vector2 dashDir = Vector2(0, 0)

	property number savedSpeed = 0

	property boolean savedControllerEnabled = true

	property boolean controlled = false

	property string controlKind = ""

	property number controlLeft = 0

	property Vector2 controlDir = Vector2(0, 0)

	property number controlSpeed = 0

	property number controlSavedSpeed = 0

	property boolean controlSavedControllerEnabled = true

	@ExecSpace("Client")
	method void Begin(number dirX, number dirY, number seconds, number speed)
		        -- 서버가 스킬을 승인하면 그 사람의 클라만 부른다.
		        if seconds <= 0 then return end
		
		        local player = _UserService.LocalPlayer
		        if player == nil then return end
		        local movement = player.MovementComponent
		        if not isvalid(movement) then return end
		        local controller = player.PlayerControllerComponent
		        if self.controlled then self:FinishControl() end
		
		        -- 이미 돌진 중이면 속도를 겹쳐 저장하지 않는다. 겹치면 원래 속도를 잃는다.
		        if not self.dashing then
		            self.savedSpeed = movement.InputSpeed
		            if isvalid(controller) then self.savedControllerEnabled = controller.Enable end
		        end
		
		        self.dashDir = Vector2(dirX, dirY)
		        self.dashLeft = seconds
		        self.dashing = true
		        movement.InputSpeed = speed
		        -- Logic의 OnUpdate는 PlayerController보다 먼저 실행된다. 컨트롤러를 잠시
		        -- 중지하지 않으면 같은 프레임의 일반 입력이 돌진 속도를 0으로 덮어쓴다.
		        if isvalid(controller) then controller.Enable = false end
		        log("[PlayerDash] begin dir=" .. tostring(dirX) .. "," .. tostring(dirY)
		            .. " seconds=" .. tostring(seconds) .. " speed=" .. tostring(speed))
	end

	@ExecSpace("Client")
	method void ApplyEnemyControl(string kind, number value, number seconds, number dirX, number dirY)
		        if seconds <= 0 then return end
		        local player = _UserService.LocalPlayer
		        if player == nil then return end
		        local movement = player.MovementComponent
		        if not isvalid(movement) then return end
		        if self.dashing then self:Finish() end
		        local controller = player.PlayerControllerComponent
		        if not self.controlled then
		            self.controlSavedSpeed = movement.InputSpeed
		            if isvalid(controller) then self.controlSavedControllerEnabled = controller.Enable end
		        end
		        self.controlled = true
		        self.controlKind = kind
		        self.controlLeft = seconds
		        self.controlDir = Vector2(dirX, dirY)
		        self.controlSpeed = value
		        log("[PlayerControl] " .. kind .. " value=" .. tostring(value)
		            .. " seconds=" .. tostring(seconds))
		        if kind == "SLOW" then
		            local ratio = math.min(0.75, math.max(0, value))
		            movement.InputSpeed = self.controlSavedSpeed * (1 - ratio)
		            if isvalid(controller) then controller.Enable = self.controlSavedControllerEnabled end
		        elseif kind == "STUN" then
		            if isvalid(controller) then controller.Enable = false end
		            movement:Stop()
		        else
		            if isvalid(controller) then controller.Enable = false end
		            movement.InputSpeed = math.max(self.controlSavedSpeed, value / seconds * 1.2)
		        end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		if self.controlled then
			self.controlLeft = self.controlLeft - delta
			if self.controlLeft <= 0 then
				self:FinishControl()
			elseif self.controlKind == "STUN" then
				local player = _UserService.LocalPlayer
				if player ~= nil and isvalid(player.MovementComponent) then player.MovementComponent:Stop() end
			elseif self.controlKind == "KNOCKBACK" or self.controlKind == "PULL" then
				local player = _UserService.LocalPlayer
				if player ~= nil and isvalid(player.MovementComponent) then
					player.MovementComponent:MoveToDirection(self.controlDir, delta)
				end
			end
			return
		end
		        if not self.dashing then return end
		
		        self.dashLeft = self.dashLeft - delta
		        if self.dashLeft <= 0 then
		            self:Finish()
		            return
		        end
		
		        local player = _UserService.LocalPlayer
		        if player == nil then self:Finish() return end
		        local movement = player.MovementComponent
		        if not isvalid(movement) then self:Finish() return end
		
		        -- 매 프레임 다시 밀어야 한다. 한 번만 부르면 다음 프레임에 입력이 덮어쓴다.
		        movement:MoveToDirection(self.dashDir, delta)
	end

	@ExecSpace("ClientOnly")
	method void FinishControl()
		        self.controlled = false
		        self.controlLeft = 0
		        self.controlKind = ""
		        local player = _UserService.LocalPlayer
		        if player == nil then return end
		        local movement = player.MovementComponent
		        if not isvalid(movement) then return end
		        ---@type PlayerStats
		        local stats = player:GetComponent("script.PlayerStats")
		        if stats ~= nil then movement.InputSpeed = stats:GetMoveSpeed()
		        elseif self.controlSavedSpeed > 0 then movement.InputSpeed = self.controlSavedSpeed end
		        local controller = player.PlayerControllerComponent
		        if isvalid(controller) then controller.Enable = self.controlSavedControllerEnabled end
		        movement:Stop()
	end

	@ExecSpace("ClientOnly")
	method void Finish()
		        -- 속도를 되돌리고 멈춘다. 안 멈추면 돌진 방향으로 계속 미끄러진다.
		        self.dashing = false
		        self.dashLeft = 0
		
		        local player = _UserService.LocalPlayer
		        if player == nil then return end
		        local movement = player.MovementComponent
		        if not isvalid(movement) then return end
		
		        -- 스냅샷이 아니라 **지금 맞는 속도**로 되돌린다 (T27-3).
		        -- 이동 속도가 LUK에서 나오게 되면서 스냅샷이 낡을 수 있다 — 돌진 도중에
		        -- 레벨업으로 LUK이 오르면 옛 속도로 되돌아가고, 그 뒤로는 아무도 안 고쳐 준다
		        -- (ApplySpeeds는 스탯이 바뀔 때만 돈다). 계산식이 한 곳에만 있으면 안 낡는다.
		        ---@type PlayerStats
		        local stats = player:GetComponent("script.PlayerStats")
		        if stats ~= nil then
		            movement.InputSpeed = stats:GetMoveSpeed()
		        elseif self.savedSpeed > 0 then
		            movement.InputSpeed = self.savedSpeed
		        end
		        local controller = player.PlayerControllerComponent
		        if isvalid(controller) then controller.Enable = self.savedControllerEnabled end
		        movement:Stop()
		        log("[PlayerDash] finish controller=" .. tostring(self.savedControllerEnabled))
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		        -- 돌진 중에 세션이 끝나도 속도는 되돌려 둔다.
		        if self.dashing then self:Finish() end
		        if self.controlled then self:FinishControl() end
	end

end