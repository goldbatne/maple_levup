-- @서버 (스탯 분배·검증은 반드시 서버. 클라는 요청과 표시만 — 개발 규칙 2)
--
-- 회차 데이터의 소유자. 필드는 SaveRunData 스키마와 1:1 대응하며, T8에서 저장에 연결한다.
-- 수치는 전부 GameBalance에서 읽는다 (하드코딩 금지 — 개발 규칙 3).
--
-- @TargetUserSync를 쓰는 이유: 스탯은 본인만 봐야 하는 개인 데이터다.
-- @Sync는 전체 클라에 뿌려지므로 남의 스탯까지 새어 나간다.

@Component
script PlayerStats extends Component

    -- ── 회차 데이터 (환생 시 초기화. SaveRunData와 대응) ──
    @TargetUserSync property integer Level = 1
    @TargetUserSync property number Exp = 0

    -- 분배하는 스탯 4종. **이름은 곧 STR/DEX/INT/LUK이다** (T31, 2026-08-27).
    -- 담는 값은 "분배한 포인트 수"이고, 그 포인트가 만드는 **수치**(물리 공격력 등)는
    -- GetTotalX / GetStatWithoutEquip 쪽이다 — 둘을 헷갈리지 말 것.
    @TargetUserSync property integer StatStr = 0
    @TargetUserSync property integer StatInt = 0
    @TargetUserSync property integer StatDex = 0
    @TargetUserSync property integer StatLuk = 0
    @TargetUserSync property integer UnspentPoints = 0

    -- 레벨 캡에 닿았는가. 캡에서는 EXP를 더 받지 않고 "환생 가능"으로 표시한다.
    -- 클라가 표시에 쓰므로 동기화한다.
    @TargetUserSync property boolean CanRebirth = false

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 시트 공식: 분배 가능 P 누적 = (Lv - 1) x stat_points_per_level.
        -- 따라서 Lv1의 시작 포인트는 0이다 — 프로퍼티 기본값이 이미 그 값이다.
        --
        -- 여기서 ResetRun()을 부르지 않는 이유(T8): 컴포넌트의 OnBeginPlay 순서는
        -- 정해져 있지 않다. PlayerDBManager가 먼저 로드해 Lv15를 채워 넣은 뒤
        -- 이 줄이 돌면 세이브가 통째로 Lv1로 지워진다.
        -- 기본값 = ResetRun()의 결과와 같으므로 부를 필요도 없다.
        log("[PlayerStats] 초기화  Lv=" .. tostring(self.Level)
            .. "  미분배P=" .. tostring(self.UnspentPoints)
            .. "  ATK총합=" .. tostring(self:GetTotalAtk()))

        -- 기본값(STR 0)으로 한 번 맞춰 둔다. 세이브가 있으면 PlayerDBManager가
        -- 복원 직후 다시 부른다 — 여기서 부르는 것은 신규 계정과 순서 사고 대비다.
        self:ApplyMaxHp()
        self:ApplySpeeds()
    end

    ---------------------------------------------------------------
    -- 분배 (서버 권한)
    ---------------------------------------------------------------

    @ExecSpace("Server")
    method void RequestAllocate(string statName, integer amount)
        -- 클라이언트 → 서버 요청. 여기서만 분배가 일어난다.
        -- senderUserId는 서버가 채우는 값이라 클라가 위조할 수 없다.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then
            log_warning("[PlayerStats] 남의 스탯 분배 시도 차단: " .. tostring(senderUserId))
            return
        end
        self:Allocate(statName, amount)
    end

    @ExecSpace("ServerOnly")
    method boolean Allocate(string statName, integer amount)
        -- 실제 분배. 검증에 실패하면 아무것도 바꾸지 않고 false.
        if amount <= 0 then
            log_warning("[PlayerStats] 분배량이 0 이하: " .. tostring(amount))
            return false
        end
        if amount > self.UnspentPoints then
            log_warning("[PlayerStats] 포인트 부족  요청=" .. tostring(amount)
                .. "  보유=" .. tostring(self.UnspentPoints))
            return false
        end

        -- statName은 **분배하는 스탯 이름**이다: STR / DEX / INT / LUK.
        -- ⚠ `GetStatWithoutEquip("ATK")`의 "ATK"와 다른 체계다 — 그쪽은 **수치 이름**
        --   (물리 공격력)이고 여러 스탯이 거기로 모인다. T31에서 이 둘을 갈랐다.
        if statName == "STR" then
            self.StatStr = self.StatStr + amount
        elseif statName == "INT" then
            self.StatInt = self.StatInt + amount
        elseif statName == "DEX" then
            self.StatDex = self.StatDex + amount
        elseif statName == "LUK" then
            self.StatLuk = self.StatLuk + amount
        else
            log_warning("[PlayerStats] 알 수 없는 스탯: " .. tostring(statName))
            return false
        end

        self.UnspentPoints = self.UnspentPoints - amount

        log("[PlayerStats] 분배 " .. statName .. " +" .. tostring(amount)
            .. "  → STR=" .. tostring(self.StatStr) .. " DEX=" .. tostring(self.StatDex)
            .. " INT=" .. tostring(self.StatInt) .. " LUK=" .. tostring(self.StatLuk)
            .. "  남은P=" .. tostring(self.UnspentPoints)
            .. "  ATK총합=" .. tostring(self:GetTotalAtk()))

        -- STR을 찍었으면 최대 HP가, LUK을 찍었으면 공속·이속이 바뀐다.
        -- 분배 직후 바로 반영해야 "찍었는데 그대로"로 보이지 않는다.
        self:ApplyMaxHp()
        self:ApplySpeeds()

        self:MarkSave("분배 확정")
        return true
    end

    @ExecSpace("ServerOnly")
    method void MarkSave(string reason)
        -- 회차 데이터가 바뀌었음을 저장 담당에게 알린다 (작업지시서 T8 저장 트리거).
        -- 여기서 직접 DataStorage를 부르지 않는다 — 컴포넌트마다 쓰기를 하면
        -- 저장 1회가 컴포넌트 수만큼 늘어난다.
        ---@type PlayerDBManager
        local db = self.Entity:GetComponent("script.PlayerDBManager")
        if db == nil then return end
        db:MarkRunDirty(reason)
    end

    @ExecSpace("ServerOnly")
    method void NoteHighestLevel()
        -- 최고 도달 레벨(영구)을 갱신한다. 레벨이 실제로 오른 자리에서만 부른다.
        --
        -- MarkSave와 따로 두는 이유: MarkSave는 회차 데이터가 바뀌었다는 신호이고,
        -- 최고 레벨은 영구 데이터다. 한 메서드에 섞으면 분배(레벨 불변)에서도
        -- 영구 키가 더티가 되어 쓸데없는 저장이 나간다.
        ---@type PlayerDBManager
        local db = self.Entity:GetComponent("script.PlayerDBManager")
        if db == nil then return end
        db:NoteLevel(self.Level)
    end

    @ExecSpace("ServerOnly")
    method void AddExp(number amount)
        -- 몬스터 처치 EXP. 누적 → 레벨업 판정까지 여기서 끝낸다.
        if amount <= 0 then return end

        -- 캡 도달 시 EXP 획득 정지 (작업지시서 T4).
        -- 판정 위치를 여기로 둔 이유: EXP가 들어오는 문이 하나뿐이라,
        -- 나중에 퀘스트·이벤트로 EXP를 주더라도 전부 이 문을 지난다.
        if self.CanRebirth then
            log("[PlayerStats] 레벨 캡(" .. tostring(_LevelCurve:LevelCap())
                .. ") 도달 상태라 EXP를 받지 않는다: +" .. tostring(amount))
            return
        end

        self.Exp = self.Exp + amount
        log("[PlayerStats] EXP +" .. tostring(amount) .. "  → 누적 " .. tostring(self.Exp))
        self:CheckLevelUp()
    end

    @ExecSpace("ServerOnly")
    method void CheckLevelUp()
        -- 한 번에 여러 레벨이 오를 수 있다(보스 EXP가 큰 경우). while로 소진한다.
        while true do
            if _LevelCurve:IsAtCap(self.Level) then
                -- 캡에서는 남은 EXP를 버리고 정지한다. 이월하면 환생 후
                -- 시작하자마자 레벨이 튀어 회차 설계가 깨진다.
                self.Exp = 0
                if self.CanRebirth == false then
                    self.CanRebirth = true
                    log("[PlayerStats] 레벨 캡 도달 Lv" .. tostring(self.Level) .. " — 환생 가능")
                    self:OnReachedCap(self.Entity.PlayerComponent.UserId)
                    self:MarkSave("레벨 캡 도달")
                end
                return
            end

            local need = _LevelCurve:RequiredExp(self.Level)
            if self.Exp < need then return end

            self.Exp = self.Exp - need
            self.Level = self.Level + 1
            self:GrantLevelPoints(1)

            log("[PlayerStats] 레벨업 → Lv" .. tostring(self.Level)
                .. "  (필요EXP " .. tostring(need) .. " 소모, 잔여 " .. tostring(self.Exp) .. ")"
                .. "  미분배P=" .. tostring(self.UnspentPoints))

            self:OnLevelUp(self.Level, self.Entity.PlayerComponent.UserId)
            self:MarkSave("레벨업")
            self:NoteHighestLevel()
            -- 차수가 **레벨로** 오르므로(2026-08-21) 전직 레벨을 밟는 순간 슬롯이 열린다.
            -- 여기서 안 부르면 다시 접속할 때까지 칸이 안 늘어난다 — 에러 없이 늦게 열려서
            -- "전직했는데 아무 일도 없다"로 보인다.
            self:RefreshTierRewards()
            _ProgressLog:LevelUp(self.Entity.PlayerComponent.UserId, self.Level)
        end
    end

    @ExecSpace("Client")
    method void OnLevelUp(integer newLevel)
        -- 레벨업 연출 (작업지시서 T4 요청 2). 판정은 서버, 연출은 클라 —
        -- 여기서 갈라진다.
        --
        -- BasicParticle을 쓰는 이유: RUID 없이 enum만으로 재생된다.
        -- 스킬 이펙트처럼 특정 그림이 필요한 게 아니라 "올랐다"는 신호만 필요하다.
        -- isLoop=false라 알아서 사라진다 — RemoveParticle로 치울 대상이 아니다.
        _ParticleService:PlayBasicParticleAttached(
            BasicParticleType.Buff, self.Entity,
            Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false)

        log("[PlayerStats] (클라) 레벨업 연출 Lv" .. tostring(newLevel))
        -- TODO(사운드): 레벨업 효과음 RUID가 정해지면 여기에
        -- _SoundService:PlaySound(ruid, volume)을 넣는다.
        -- 리소스 검색 결과에 이름이 비어 있어 어떤 소리인지 확인할 수 없었다.
    end

    @ExecSpace("Client")
    method void OnReachedCap()
        -- 캡 도달 연출. 레벨업보다 크게 한 번 터뜨려서 "여기가 끝"임을 알린다.
        -- 환생(T7) 진입점이 붙을 자리이기도 하다.
        _ParticleService:PlayBasicParticleAttached(
            BasicParticleType.PillarBurst, self.Entity,
            Vector3(0, 0, 0), 0, Vector3(1.5, 1.5, 1.5), false)

        log("[PlayerStats] (클라) 레벨 캡 도달 — 환생 가능 표시")
    end

    @ExecSpace("ServerOnly")
    method void RefreshTierRewards()
        -- 전직 차수가 레벨에서 나오므로(2026-08-21), 레벨이 오를 때마다 차수에 딸린
        -- 것들을 다시 계산한다. 지금은 슬롯 하나뿐이지만 창구를 하나로 두어
        -- 나중에 붙는 것(전직 연출·해금 알림)이 흩어지지 않게 한다.
        --
        -- PlayerStats가 PlayerSkillSlots를 부르는 방향인 이유: 레벨을 아는 쪽이
        -- 여기다. 반대로 슬롯이 매 프레임 레벨을 폴링하면 언제 갱신되는지가 흐려진다.
        ---@type PlayerSkillSlots
        local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
        if slots == nil then return end
        slots:RecomputeSlotCount()

        -- **랜드마크도 여기서 준다** (2026-08-29). 지역 개방은 "레벨에 도달하면 열린다"가
        -- 설계인데(2026-08-04 기획서 4.5 · 2026-08-29 "지역은 대역이 시작되기 직전 레벨에
        -- 열린다"), 지금까지 `Rebirth.Execute` 한 곳에서만 줘서 **그 레벨에서 환생해야만**
        -- 열렸다. 대표 신고: *"페리온에서 엘리니아로 안 이동하는데?"* — Lv37인데
        -- 엘리니아가 안 열려 있어 지역 선택 창에 안 떴다.
        --
        -- `GrantLandmarksUpTo`는 원장으로 중복을 막으므로 매 레벨업마다 불러도 안전하다.
        ---@type PlayerDBManager
        local db = self.Entity:GetComponent("script.PlayerDBManager")
        if db ~= nil then
            _Rebirth:GrantLandmarksUpTo(self.Level, db, slots)
        end
    end

    method integer PointsPerLevel()
        -- 레벨업 한 번에 받는 스탯 포인트. **기본 5 + 환생 보너스** (설계 변경 2026-08-21).
        -- Lv10에서 환생했으면 6, Lv20이면 7 … 10레벨당 +1 (2026-08-23에 5 → 10).
        --
        -- 실행공간을 비워 두는 이유: 서버는 지급에, 클라는 환생 창의 안내 문구에 쓴다.
        -- 두 곳이 각자 계산하면 창이 거짓말을 하게 된다.
        local base = _GameData:GetBalance("stat_points_per_level")
        ---@type PlayerSkillSlots
        local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
        local bonus = 0
        if slots ~= nil then bonus = slots:RebirthBonus() end
        return math.floor(base) + bonus
    end

    @ExecSpace("ServerOnly")
    method void GrantLevelPoints(integer levels)
        -- 레벨업 시 포인트 지급 (T4에서 호출한다).
        if levels <= 0 then return end
        self.UnspentPoints = self.UnspentPoints + levels * self:PointsPerLevel()
    end

    @ExecSpace("ServerOnly")
    method void ResetRun()
        -- 회차 초기화. 환생(T7)이 이걸 부른다. 영구 데이터는 건드리지 않는다.
        self.Level = 1
        self.Exp = 0
        self.StatStr = 0
        self.StatInt = 0
        self.StatDex = 0
        self.StatLuk = 0
        self.UnspentPoints = 0
        -- 환생하면 다시 Lv1이므로 캡 플래그도 내린다. 안 내리면 새 회차에서
        -- EXP가 한 톨도 안 들어온다.
        self.CanRebirth = false

        -- STR이 0으로 돌아갔으니 최대 HP도 기본치로 내린다. 안 내리면 환생 후에도
        -- 예전 STR로 부풀린 HP가 남는다 — 회차 초기화의 의미가 사라진다.
        -- 공속·이속도 같은 이유로 되돌린다 (LUK도 0이 됐다).
        self:ApplyMaxHp()
        self:ApplySpeeds()
    end

    ---------------------------------------------------------------
    -- 분배한 포인트를 읽는 창구 (T31에서 이름 변경 완료)
    ---------------------------------------------------------------
    --
    --   STR (물리 공격력 + 최대 HP)
    --   DEX (방어력 + 물리 공격력)
    --   INT (마법 공격력)
    --   LUK (물리 공격력 + 공속 + 이속 + 포획률 + 드랍률)
    --
    -- ⚠⚠ **두 이름 체계가 있다. 헷갈리면 조용히 틀린 값을 읽는다.**
    --   1) 여기 넷 = **분배하는 스탯** (STR/DEX/INT/LUK). 포인트 수다.
    --   2) `GetStatWithoutEquip(stat)` / `GetEquipBonus(stat)` / `ItemTable`의 스탯 컬럼 /
    --      `SkillTable.scaling_stat` = **파생 수치 이름** (ATK=물리 공격력, INT=마법 공격력,
    --      DEF=방어력, LUK=포인트). 여러 스탯이 한 수치로 모이므로 1:1이 아니다.
    --   T31 이전에는 1)이 2)의 이름을 쓰고 있어서 "ATK"가 두 가지를 뜻했다.

    method integer GetStr()
        -- 분배한 STR 포인트.
        return self.StatStr
    end

    method integer GetDex()
        -- 분배한 DEX 포인트.
        return self.StatDex
    end

    method integer GetIntStat()
        -- 분배한 INT 포인트. `GetTotalInt`(파생 수치)와 이름이 겹치지 않게 Stat을 붙였다.
        return self.StatInt
    end

    method integer GetLukStat()
        -- 분배한 LUK 포인트.
        return self.StatLuk
    end

    method number GetFinalStatPoints(string statName)
        -- 일반 스탯 창에 표시할 최종 STR/DEX/INT/LUK.
        -- 분배 포인트 + 포획 컬렉션 포인트에 히든 보스 장비의 정액 주스탯을 더한다.
        -- 일반 장비는 ATK/마력/DEF 같은 파생 수치를 올리므로 여기에는 섞지 않고
        -- 상세 스탯의 물리 공격력·마법 공격력·방어력에서 보여 준다.
        local points = 0
        if statName == "STR" then
            points = self:GetStr() + self:GetCollectionPoints("STR")
        elseif statName == "DEX" then
            points = self:GetDex() + self:GetCollectionPoints("DEX")
        elseif statName == "INT" then
            points = self:GetIntStat() + self:GetCollectionPoints("INT")
        elseif statName == "LUK" then
            points = self:GetLukStat() + self:GetCollectionPoints("LUK")
        else
            return 0
        end
        return points + self:GetPassiveItemStatBonus(statName)
    end

    ---------------------------------------------------------------
    -- 최대 HP (T27-1)
    ---------------------------------------------------------------

    method number GetMaxHp()
        -- 최대 HP = 기본 + STR x STR당 HP.
        --
        -- **이것이 T26-6에서 막힌 벽을 푸는 자리다.** 지금까지 플레이어 HP는
        -- DefaultPlayer.model의 1000 고정이었고 레벨로 자라지 않았다. 몬스터 ATK는
        -- `24 x 1.08^(lv-1)`로 자라는데 받는 쪽이 그대로라, Lv34 이상 보스는
        -- `boss_atk_multiplier=3`에서 **무조건 한 방**이었다.
        --
        -- 실행공간을 비워 둔다: 서버는 실제 적용에, 클라는 스탯 창 표시에 쓴다.
        -- 읽는 값이 @TargetUserSync라 양쪽 결과가 같다.
        -- 포획 패시브의 STR도 여기 얹힌다 (설계 변경 2026-08-29) — 분배 STR과 같은
        -- 계수를 쓴다. 환생 직후 HP가 1200에서 1380이 되는 것이 이 한 줄이다.
        local base = _GameData:GetBalance("player_base_hp")
        local perPoint = _GameData:GetBalance("str_hp_per_point")
        return base + self:GetFinalStatPoints("STR") * perPoint
    end

    @ExecSpace("ServerOnly")
    method void ApplyMaxHp()
        -- 계산한 최대 HP를 PlayerComponent에 실제로 적용한다.
        --
        -- **늘어난 만큼 현재 HP도 같이 올린다.** 안 올리면 STR을 찍은 순간
        -- 최대치만 늘고 체력 비율이 떨어져 "찍었는데 더 위험해졌다"가 된다.
        -- 포인트는 유한하고 되돌릴 수 없으므로 회복 악용이 되지 않는다.
        --
        -- 줄어드는 경우(환생으로 STR이 0이 될 때)는 현재 HP를 상한에 맞춰 자른다.
        -- 안 자르면 최대치를 넘는 HP가 남아 HUD 게이지가 100%를 넘어 그려진다.
        local pc = self.Entity.PlayerComponent
        if not isvalid(pc) then return end

        local newMax = math.floor(self:GetMaxHp() + 0.5)
        if newMax < 1 then newMax = 1 end

        local oldMax = pc.MaxHp
        if newMax == oldMax then return end

        pc.MaxHp = newMax

        if newMax > oldMax then
            -- 죽어 있는 동안에는 올리지 않는다. Respawn()이 알아서 채운다.
            if not pc:IsDead() then
                pc.Hp = pc.Hp + (newMax - oldMax)
            end
        elseif pc.Hp > newMax then
            pc.Hp = newMax
        end

        log("[PlayerStats] 최대 HP " .. tostring(oldMax) .. " → " .. tostring(newMax)
            .. "  (STR " .. tostring(self:GetStr() + self:GetCollectionPoints("STR"))
            .. " + 패시브 " .. tostring(self:GetPassiveItemStatBonus("STR")) .. ") x "
            .. tostring(_GameData:GetBalance("str_hp_per_point"))
            .. "  현재 HP=" .. tostring(pc.Hp))
    end

    ---------------------------------------------------------------
    -- 공격 속도 · 이동 속도 (T27-3)
    ---------------------------------------------------------------

    method number GetAttackInterval()
        -- 자동 공격 주기(초) = 기본 - LUK x LUK당 단축.
        --
        -- **상한(= 주기 하한)이 반드시 필요하다.** 단축이 선형이라 LUK 500이면
        -- 주기가 0이 되고, 그 아래로 가면 음수라 타이머가 무한 루프처럼 돈다.
        -- 실드 감쇄 0.9 상한 · 회피 0.6 상한과 같은 이유다.
        --
        -- 실행공간을 비워 둔다: 서버는 타이머에, 클라는 스탯 창 표시에 쓴다.
        local base = _GameData:GetBalance("player_attack_interval")
        local perPoint = _GameData:GetBalance("luk_attack_speed_per_point")
        local floorValue = _GameData:GetBalance("player_attack_interval_min")
        local interval = base - self:GetTotalLuk() * perPoint
        if interval < floorValue then interval = floorValue end
        return interval
    end

    method number GetMoveSpeed()
        -- 이동 속도 = 기본 x (1 + LUK x LUK당 증가).
        --
        -- **배수인 이유**: `MovementComponent.InputSpeed`가 월드 유닛/초가 아니라
        -- 맵 종류마다 환산이 다른 계수다(RectTile은 1.2로 나눈다 — platform.md 10).
        -- 정액으로 더하면 맵마다 체감이 달라진다.
        --
        -- 상한을 안 두는 이유: 주기·회피와 달리 빨라져도 규칙이 깨지지 않는다.
        -- LUK 1000이어도 2배일 뿐이다.
        local base = _GameData:GetBalance("player_base_move_speed")
        local perPoint = _GameData:GetBalance("luk_move_speed_per_point")
        return base * (1 + self:GetTotalLuk() * perPoint)
    end

    -- 회피(GetEvadeRate)는 **폐기됐다** (2026-08-27 대표 지시). T28이 세운
    -- "동레벨 3대에 잡고 12대 맞으면 죽는다"는 읽히는 숫자에 난수를 꽂기 때문이다.
    -- 되살리려면 PlayerHit.IsHitTarget 주석을 먼저 읽을 것.

    @ExecSpace("ServerOnly")
    method void ApplySpeeds()
        -- 계산한 속도를 실제로 먹인다. `ApplyMaxHp`와 같은 자리에서 불린다 —
        -- 셋 다 "스탯에서 매번 다시 계산하고 저장하지 않는" 값이다.
        --
        -- ⚠ **공속은 타이머를 다시 걸어야 바뀐다.** `SetTimerRepeat`은 걸 때의
        --   주기를 그대로 들고 있어서, 값만 고쳐 놓으면 그 회차 내내 옛 주기로 돈다.
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if attack ~= nil then
            ---@type PlayerAttack
            local atk = attack
            atk:RestartAutoAttack()
        end

        local movement = self.Entity.MovementComponent
        if isvalid(movement) then
            movement.InputSpeed = self:GetMoveSpeed()
        end
    end

    ---------------------------------------------------------------
    -- 파생 스탯 (양쪽에서 계산 가능 — 표시용)
    ---------------------------------------------------------------

    method number GetEquipBonus(string stat)
        -- 장착한 장비가 이 스탯에 얹는 값 (T13-4). stat은 "ATK"/"INT"/"DEF"/"LUK".
        --
        -- 실행공간을 비워 두는 이유: GetTotalX가 양쪽에서 불린다 —
        -- 서버는 데미지 계산에, 클라는 스탯 창 표시에 쓴다. 인벤토리의
        -- Items/Equipped가 @TargetUserSync라 주인 클라에도 같은 값이 있다.
        --
        -- 올스탯(stat_all)은 _GameData:GetItemStatBonus가 이미 합쳐서 준다.
        -- 여기서 다시 더하면 두 번 들어간다.
        --
        -- ## 중복 보유가 그대로 쌓인다 (T15-1, 대표 지시 2026-08-13)
        --
        -- 같은 장비를 5개까지 모을 수 있고, **보너스는 보유 개수만큼 곱해진다**
        -- (무쇠 검 3개 = ATK+15). 그래서 "장착했는가"가 아니라 "몇 개 가졌는가"가
        -- 수치를 정한다 — 5개를 모아도 장착은 한 슬롯이다.
        --
        -- 왜 장착 개수가 아니라 보유 개수인가: 슬롯이 3개뿐이라 5개를 동시에
        -- 낄 자리가 없다. 개수를 세지 않으면 2개째부터 아무 의미가 없어
        -- 중복 드랍이 그냥 낭비가 된다.
        local inventory = self.Entity:GetComponent("script.PlayerInventory")
        if inventory == nil then return 0 end

        ---@type PlayerInventory
        local inv = inventory
        local total = 0
        local slots = inv:GetEquipSlotNames()
        for i = 1, #slots do
            local itemId = inv:GetEquipped(slots[i])
            if itemId ~= "" then
                total = total + _GameData:GetItemStackedStatBonus(itemId, stat, inv:GetCount(itemId))
            end
        end
        return total
    end

    method number GetCollectionPoints(string statName)
        -- 포획 패시브가 주는 **분배 스탯 포인트** (설계 변경 2026-08-29, 대표 지시).
        -- statName은 **분배 스탯 이름** — "STR" / "DEX" / "INT" / "LUK".
        --
        -- ## 왜 있나
        --
        -- 환생하면 컬렉션·슬롯·차수·장비는 남는데 **몸은 신규 계정과 정확히 같다**
        -- (둘 다 물공 70 / HP 1200). 환생 보상 둘이 **다 Lv1에서 안 나오기** 때문이다 —
        -- 레벨업당 스탯은 레벨이 올라야 받고, 사냥방 몬스터는 4에서 7마리가 될 뿐이다.
        -- 거기에 T34로 `exp_base`가 60이 되어 Lv1→2에 12마리를 잡아야 한다.
        -- 직전까지 Lv30~40이던 사람이 달팽이를 4대씩 12마리 잡는 구간을 이게 메운다.
        --
        -- ## 중복을 센다
        --
        -- 대표 판단: 중복은 **"다음 지역에 대한 완화제"**다 — 막히면 지금 지역을 갈아서
        -- 넘는 길이 열린다. 대안이던 "환생당 포인트 증가"는 그냥 숫자가 커지는 것이라
        -- 버렸다(*"얻는 재미와 성장의 경험"*).
        --
        -- 첫 장 `collection_passive_first`(1) + 추가 장마다 `collection_passive_extra`(0.25).
        -- ⚠ 추가 장을 1로 두면 85종 만작(425장)이 **+425P**가 되어 Lv1인데 물공 1345 —
        --   Lv50 STR 몰빵(1295)과 같아진다(실측). 0.25면 만작 1종이 2P라
        --   T15-2의 계수 강화(1.0 → 1.8)와 **같은 모양**이 된다.
        --
        -- 실행공간을 비워 둔다 — 서버는 실제 적용에, 클라는 스탯 창 표시에 쓴다.
        if statName == "" then return 0 end
        ---@type PlayerCollection
        local collection = self.Entity:GetComponent("script.PlayerCollection")
        if collection == nil then return 0 end

        local first = _GameData:GetBalance("collection_passive_first")
        local extra = _GameData:GetBalance("collection_passive_extra")
        local total = 0
        local ids = _GameData:GetAllSkillIds()
        for i = 1, #ids do
            local skill = _GameData:GetSkill(ids[i])
            if skill ~= nil and skill.skill_kind == "passive" and skill.passive_stat == statName then
                local count = collection:GetOwnedCount(ids[i])
                if count > 0 then
                    -- 줄에 값이 있으면 그것이 첫 장 값을 대신한다 (비면 기본).
                    local per = skill.passive_value
                    if per <= 0 then per = first end
                    total = total + per + extra * (count - 1)
                end
            end
        end
        return total
    end

    method number GetCollectionBonus(string stat)
        -- 컬렉션 패시브가 만드는 **파생 수치**. 인자는 GetStatWithoutEquip과 같은
        -- 수치 이름("ATK"/"INT"/"DEF"/"LUK")이고, 계수도 **같은 것을 쓴다** —
        -- 분배 1P와 패시브 1P가 같은 값이어야 "1P 상당"이라는 말이 참이 된다.
        --
        -- ⚠⚠ **게이트에는 안 센다.** `RoomGate`의 STAT_TOTAL은 `GetAllocatedTotal()`
        -- (= StatStr+StatDex+StatInt+StatLuk)만 보고, gate_key가 ATK/DEF 등일 때는
        -- `GetStatWithoutEquip`을 본다. 이 함수는 **둘 중 어느 쪽에도 안 들어간다** —
        -- 장비와 똑같이 `GetTotalX`에만 얹힌다. 게이트가 재는 것은 성장이어야 하고
        -- (2026-08-12), 컬렉션으로 문이 열리면 그게 무너진다.
        if stat == "ATK" then
            return self:GetCollectionPoints("STR") * _GameData:GetBalance("str_atk_per_point")
                + self:GetCollectionPoints("DEX") * _GameData:GetBalance("dex_atk_per_point")
                + self:GetCollectionPoints("LUK") * _GameData:GetBalance("luk_atk_per_point")
        end
        if stat == "INT" then
            return self:GetCollectionPoints("INT") * _GameData:GetBalance("int_matk_per_point")
        end
        if stat == "DEF" then
            return self:GetCollectionPoints("DEX") * _GameData:GetBalance("dex_def_per_point")
        end
        if stat == "LUK" then
            -- LUK만 수치가 아니라 포인트 그대로다 (GetStatWithoutEquip과 같은 이유).
            return self:GetCollectionPoints("LUK")
        end
        return 0
    end

    method number GetPassiveItemStatBonus(string statName)
        -- 인벤토리에 **보유만 해도** 적용되는 패시브 아이템의 주스탯 정액 합계 (T57-2).
        -- 장착 슬롯과 무관하며 종류별 stack_max가 자연스럽게 상한이다.
        ---@type PlayerInventory
        local inventory = self.Entity:GetComponent("script.PlayerInventory")
        if inventory == nil then return 0 end

        local total = 0
        local ids = _GameData:GetAllItemIds()
        for i = 1, #ids do
            local item = _GameData:GetItem(ids[i])
            if item ~= nil and item.item_type == "passive" and item.passive_stat == statName then
                total = total + inventory:GetCount(item.id) * item.passive_value
            end
        end
        return total
    end

    method number GetPassiveItemBonus(string stat)
        -- 패시브 아이템이 만드는 파생 수치. 수치 게이트에는 넣지 않고 실제 전투에만 얹는다.
        -- 각 직업 보상의 정액 주스탯을 기존 스탯 계수로 파생 수치에 반영한다.
        --
        -- 한 스탯이 여러 파생 수치로 이어지는 규칙도 그대로 따른다. 보우마스터의 활
        -- DEX는 물리 공격력뿐 아니라 방어력에도 들어가야 "DEX +10" 설명과 실제 수치가 일치한다.
        if stat == "ATK" then
            return self:GetPassiveItemStatBonus("STR") * _GameData:GetBalance("str_atk_per_point")
                + self:GetPassiveItemStatBonus("DEX") * _GameData:GetBalance("dex_atk_per_point")
                + self:GetPassiveItemStatBonus("LUK") * _GameData:GetBalance("luk_atk_per_point")
        end
        if stat == "INT" then
            return self:GetPassiveItemStatBonus("INT") * _GameData:GetBalance("int_matk_per_point")
        end
        if stat == "DEF" then
            return self:GetPassiveItemStatBonus("DEX") * _GameData:GetBalance("dex_def_per_point")
        end
        if stat == "LUK" then
            return self:GetPassiveItemStatBonus("LUK")
        end
        return 0
    end

    method number GetStatWithoutEquip(string stat)
        -- 장비를 빼고 본 **전투 수치** (기본값 + 분배분). **수치 게이트가 이걸 쓴다.**
        --
        -- 왜 나눠 두는가 (대표 지시 2026-08-12): 게이트는 "성장했는가"를 묻는
        -- 문이다. 장비를 세면 좋은 장비 하나로 문이 열려, 문이 재는 것이
        -- 성장이 아니라 운이 된다. 반대로 전투는 장비를 세는 게 당연하다.
        -- 그래서 전투용(GetTotalX)과 게이트용(이 함수)을 물리적으로 갈라 둔다.
        --
        -- ## T27-2: 한 스탯 = 한 수치가 아니게 됐다
        --
        -- 예전에는 네 스탯이 `atk_per_stat_point`(=1) 하나를 공유해서 "ATK 스탯 = ATK 수치"였다.
        -- 이제는 **여러 스탯이 한 수치에 모인다**:
        --
        --   물리 공격력 = STR x 5 + DEX x 2 + LUK x 2
        --   마법 공격력 = INT x 5
        --   방어력      = DEX x 10
        --
        -- 그래서 인자 `stat`은 이제 **스탯 이름이 아니라 수치 이름**이다
        -- ("ATK" = 물리 공격력, "INT" = 마법 공격력, "DEF" = 방어력).
        -- 문자열을 그대로 둔 이유는 `ItemTable.stat_type` · `SkillTable.scaling_stat` ·
        -- `RoomGate.gate_key`가 전부 이 값을 쓰기 때문이다 — 이름 변경은 별도 단계다.
        if stat == "ATK" then
            return _GameData:GetBalance("player_base_atk")
                + self:GetStr() * _GameData:GetBalance("str_atk_per_point")
                + self:GetDex() * _GameData:GetBalance("dex_atk_per_point")
                + self:GetLukStat() * _GameData:GetBalance("luk_atk_per_point")
        end
        if stat == "INT" then
            return _GameData:GetBalance("player_base_int")
                + self:GetIntStat() * _GameData:GetBalance("int_matk_per_point")
        end
        if stat == "DEF" then
            return _GameData:GetBalance("player_base_def")
                + self:GetDex() * _GameData:GetBalance("dex_def_per_point")
        end
        if stat == "LUK" then
            -- LUK만 **수치가 아니라 분배한 포인트 그대로**다. 포획률(기획서 4.8)과
            -- 드랍률(T13-6)이 "LUK 몇 P인가"를 묻기 때문이다.
            -- LUK이 전투에 기여하는 몫은 위 "ATK"에 이미 들어가 있다 — 여기서 또 세면
            -- 두 번 들어간다.
            return _GameData:GetBalance("player_base_luk") + self:GetLukStat()
        end
        return 0
    end

    method number GetTotalAtk()
        -- **물리 공격력.** 데미지 공식(T3)이 쓰는 값 = 기본 + STR·DEX·LUK 기여 + 장비(T13-4).
        --
        -- T27-2: 세 스탯이 여기로 모인다. STR(5)이 주축이고 DEX(2)·LUK(2)이 얹힌다 —
        -- **어느 스탯을 찍어도 딜이 0이 되지 않게** 하려는 것이다. 예전에는 DEF나 LUK에
        -- 몰빵하면 딜이 1~3이라 게임이 멈췄다.
        return self:GetStatWithoutEquip("ATK") + self:GetEquipBonus("ATK")
            + self:GetCollectionBonus("ATK") + self:GetPassiveItemBonus("ATK")
    end

    method number GetTotalInt()
        -- **마법 공격력.** T27-2에서 의미가 바뀌었다 — 예전에는 "INT 스탯 수치"였고
        -- 지금은 INT 포인트가 만드는 마법 공격력이다 (INT x 5).
        --
        -- 물리(STR x 5)와 계수가 같다. 물리/마법이 대칭이라 첫 1P부터 계열 선택이
        -- 성립한다 — T10-1b에서 기본값을 10으로 맞춘 것과 같은 이유다.
        --
        -- 메서드 이름을 GetTotalMatk로 안 바꾼 이유: 부르는 곳이 PlayerAttack ·
        -- 스탯 창 · EquipPanel에 걸쳐 있고, 이름 정리는 저장 마이그레이션과 함께
        -- 별도 단계로 묶여 있다.
        return self:GetStatWithoutEquip("INT") + self:GetEquipBonus("INT")
            + self:GetCollectionBonus("INT") + self:GetPassiveItemBonus("INT")
    end

    method number GetTotalDef()
        -- **방어력.** DEX가 만든다 (DEX x 10). 피격 감쇄는 MonsterAttack이 이 값을 읽는다.
        return self:GetStatWithoutEquip("DEF") + self:GetEquipBonus("DEF")
            + self:GetCollectionBonus("DEF") + self:GetPassiveItemBonus("DEF")
    end

    method number GetTotalLuk()
        -- **LUK 포인트.** 다른 셋과 달리 이것만 전투 수치가 아니라 분배량 그대로다.
        --
        -- 포획률(기획서 4.8 "3% + LUK x 0.1%p")과 드랍률(T13-6)이 포인트 수를 묻는다.
        -- LUK이 전투에 기여하는 몫(+2 물리 공격력)은 GetTotalAtk에 이미 들어 있으므로
        -- 여기서 또 세면 두 번 들어간다.
        --
        -- 기본값이 0인 이유는 그대로다: 10을 주면 포획률 하한이 3%가 아니라 4%가 되어
        -- 기획서 4.8과 어긋난다.
        --
        -- 장비 LUK은 여기 포함되므로 **포획률에도 얹힌다** (기획서 4.7).
        return self:GetStatWithoutEquip("LUK") + self:GetEquipBonus("LUK")
            + self:GetCollectionBonus("LUK") + self:GetPassiveItemBonus("LUK")
    end

    method number GetAllocatedTotal()
        -- 지금까지 **분배한** 포인트의 총합. 기본값(10/10/10/0)은 포함하지 않는다.
        --
        -- 수치 게이트가 쓴다 (RoomGate, gate_key = STAT_TOTAL). 어디에 넣었는지를
        -- 묻지 않으므로 어떤 빌드든 같은 시점에 문이 열린다 — 2·3스탯 빌드나
        -- 올스탯 빌드가 불리해지지 않게 하려는 결정이다 (대표 지시 2026-08-12).
        --
        -- ⚠ 이 값은 사실상 레벨이다: 레벨당 5P이므로
        --      총합 = 5 x (레벨 - 1) - 미분배 포인트
        --   레벨 게이트와 다른 점은 **미분배로 쌓아 둔 포인트는 쳐주지 않는다**는 것
        --   하나뿐이다. 즉 "레벨을 올렸는가"가 아니라 "올리고 실제로 찍었는가"를 묻는다.
        return self.StatStr + self.StatDex + self.StatInt + self.StatLuk
    end

    method number GetCaptureRate()
        -- 포획 확률 = 기본 + LUK x LUK당 보정 (기획서 4.8).
        local base = _GameData:GetBalance("capture_base_rate")
        local perLuk = _GameData:GetBalance("capture_luk_bonus")
        return base + self:GetTotalLuk() * perLuk
    end

end
