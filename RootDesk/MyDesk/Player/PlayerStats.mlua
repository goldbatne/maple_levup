-- @서버 (스탯 분배·검증은 반드시 서버. 클라는 요청과 표시만 — 개발 규칙 2)
--
-- 회차 데이터의 소유자. 필드는 SaveRunData 스키마와 1:1 대응하며, T8에서 저장에 연결한다.
-- 수치는 전부 GameBalance에서 읽는다 (하드코딩 금지 — 개발 규칙 3).
--
-- @TargetUserSync를 쓰는 이유: 스탯은 본인만 봐야 하는 개인 데이터다.
-- @Sync는 전체 클라에 뿌려지므로 남의 스탯까지 새어 나간다.

@Component
script PlayerStats extends Component

    -- ── 회차 데이터 (환생 시 초기화. SaveRunData와 대응) ──
    @TargetUserSync property integer Level = 1
    @TargetUserSync property number Exp = 0

    @TargetUserSync property integer StatAtk = 0
    @TargetUserSync property integer StatInt = 0
    @TargetUserSync property integer StatDef = 0
    @TargetUserSync property integer StatLuk = 0
    @TargetUserSync property integer UnspentPoints = 0

    -- 레벨 캡에 닿았는가. 캡에서는 EXP를 더 받지 않고 "환생 가능"으로 표시한다.
    -- 클라가 표시에 쓰므로 동기화한다.
    @TargetUserSync property boolean CanRebirth = false

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 시트 공식: 분배 가능 P 누적 = (Lv - 1) x stat_points_per_level.
        -- 따라서 Lv1의 시작 포인트는 0이다 — 프로퍼티 기본값이 이미 그 값이다.
        --
        -- 여기서 ResetRun()을 부르지 않는 이유(T8): 컴포넌트의 OnBeginPlay 순서는
        -- 정해져 있지 않다. PlayerDBManager가 먼저 로드해 Lv15를 채워 넣은 뒤
        -- 이 줄이 돌면 세이브가 통째로 Lv1로 지워진다.
        -- 기본값 = ResetRun()의 결과와 같으므로 부를 필요도 없다.
        log("[PlayerStats] 초기화  Lv=" .. tostring(self.Level)
            .. "  미분배P=" .. tostring(self.UnspentPoints)
            .. "  ATK총합=" .. tostring(self:GetTotalAtk()))
    end

    ---------------------------------------------------------------
    -- 분배 (서버 권한)
    ---------------------------------------------------------------

    @ExecSpace("Server")
    method void RequestAllocate(string statName, integer amount)
        -- 클라이언트 → 서버 요청. 여기서만 분배가 일어난다.
        -- senderUserId는 서버가 채우는 값이라 클라가 위조할 수 없다.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then
            log_warning("[PlayerStats] 남의 스탯 분배 시도 차단: " .. tostring(senderUserId))
            return
        end
        self:Allocate(statName, amount)
    end

    @ExecSpace("ServerOnly")
    method boolean Allocate(string statName, integer amount)
        -- 실제 분배. 검증에 실패하면 아무것도 바꾸지 않고 false.
        if amount <= 0 then
            log_warning("[PlayerStats] 분배량이 0 이하: " .. tostring(amount))
            return false
        end
        if amount > self.UnspentPoints then
            log_warning("[PlayerStats] 포인트 부족  요청=" .. tostring(amount)
                .. "  보유=" .. tostring(self.UnspentPoints))
            return false
        end

        if statName == "ATK" then
            self.StatAtk = self.StatAtk + amount
        elseif statName == "INT" then
            self.StatInt = self.StatInt + amount
        elseif statName == "DEF" then
            self.StatDef = self.StatDef + amount
        elseif statName == "LUK" then
            self.StatLuk = self.StatLuk + amount
        else
            log_warning("[PlayerStats] 알 수 없는 스탯: " .. tostring(statName))
            return false
        end

        self.UnspentPoints = self.UnspentPoints - amount

        log("[PlayerStats] 분배 " .. statName .. " +" .. tostring(amount)
            .. "  → ATK=" .. tostring(self.StatAtk) .. " INT=" .. tostring(self.StatInt)
            .. " DEF=" .. tostring(self.StatDef) .. " LUK=" .. tostring(self.StatLuk)
            .. "  남은P=" .. tostring(self.UnspentPoints)
            .. "  ATK총합=" .. tostring(self:GetTotalAtk()))

        self:MarkSave("분배 확정")
        return true
    end

    @ExecSpace("ServerOnly")
    method void MarkSave(string reason)
        -- 회차 데이터가 바뀌었음을 저장 담당에게 알린다 (작업지시서 T8 저장 트리거).
        -- 여기서 직접 DataStorage를 부르지 않는다 — 컴포넌트마다 쓰기를 하면
        -- 저장 1회가 컴포넌트 수만큼 늘어난다.
        ---@type PlayerDBManager
        local db = self.Entity:GetComponent("script.PlayerDBManager")
        if db == nil then return end
        db:MarkRunDirty(reason)
    end

    @ExecSpace("ServerOnly")
    method void NoteHighestLevel()
        -- 최고 도달 레벨(영구)을 갱신한다. 레벨이 실제로 오른 자리에서만 부른다.
        --
        -- MarkSave와 따로 두는 이유: MarkSave는 회차 데이터가 바뀌었다는 신호이고,
        -- 최고 레벨은 영구 데이터다. 한 메서드에 섞으면 분배(레벨 불변)에서도
        -- 영구 키가 더티가 되어 쓸데없는 저장이 나간다.
        ---@type PlayerDBManager
        local db = self.Entity:GetComponent("script.PlayerDBManager")
        if db == nil then return end
        db:NoteLevel(self.Level)
    end

    @ExecSpace("ServerOnly")
    method void AddExp(number amount)
        -- 몬스터 처치 EXP. 누적 → 레벨업 판정까지 여기서 끝낸다.
        if amount <= 0 then return end

        -- 캡 도달 시 EXP 획득 정지 (작업지시서 T4).
        -- 판정 위치를 여기로 둔 이유: EXP가 들어오는 문이 하나뿐이라,
        -- 나중에 퀘스트·이벤트로 EXP를 주더라도 전부 이 문을 지난다.
        if self.CanRebirth then
            log("[PlayerStats] 레벨 캡(" .. tostring(_LevelCurve:LevelCap())
                .. ") 도달 상태라 EXP를 받지 않는다: +" .. tostring(amount))
            return
        end

        self.Exp = self.Exp + amount
        log("[PlayerStats] EXP +" .. tostring(amount) .. "  → 누적 " .. tostring(self.Exp))
        self:CheckLevelUp()
    end

    @ExecSpace("ServerOnly")
    method void CheckLevelUp()
        -- 한 번에 여러 레벨이 오를 수 있다(보스 EXP가 큰 경우). while로 소진한다.
        while true do
            if _LevelCurve:IsAtCap(self.Level) then
                -- 캡에서는 남은 EXP를 버리고 정지한다. 이월하면 환생 후
                -- 시작하자마자 레벨이 튀어 회차 설계가 깨진다.
                self.Exp = 0
                if self.CanRebirth == false then
                    self.CanRebirth = true
                    log("[PlayerStats] 레벨 캡 도달 Lv" .. tostring(self.Level) .. " — 환생 가능")
                    self:OnReachedCap(self.Entity.PlayerComponent.UserId)
                    self:MarkSave("레벨 캡 도달")
                end
                return
            end

            local need = _LevelCurve:RequiredExp(self.Level)
            if self.Exp < need then return end

            self.Exp = self.Exp - need
            self.Level = self.Level + 1
            self:GrantLevelPoints(1)

            log("[PlayerStats] 레벨업 → Lv" .. tostring(self.Level)
                .. "  (필요EXP " .. tostring(need) .. " 소모, 잔여 " .. tostring(self.Exp) .. ")"
                .. "  미분배P=" .. tostring(self.UnspentPoints))

            self:OnLevelUp(self.Level, self.Entity.PlayerComponent.UserId)
            self:MarkSave("레벨업")
            self:NoteHighestLevel()
            -- 차수가 **레벨로** 오르므로(2026-08-21) 전직 레벨을 밟는 순간 슬롯이 열린다.
            -- 여기서 안 부르면 다시 접속할 때까지 칸이 안 늘어난다 — 에러 없이 늦게 열려서
            -- "전직했는데 아무 일도 없다"로 보인다.
            self:RefreshTierRewards()
            _ProgressLog:LevelUp(self.Entity.PlayerComponent.UserId, self.Level)
        end
    end

    @ExecSpace("Client")
    method void OnLevelUp(integer newLevel)
        -- 레벨업 연출 (작업지시서 T4 요청 2). 판정은 서버, 연출은 클라 —
        -- 여기서 갈라진다.
        --
        -- BasicParticle을 쓰는 이유: RUID 없이 enum만으로 재생된다.
        -- 스킬 이펙트처럼 특정 그림이 필요한 게 아니라 "올랐다"는 신호만 필요하다.
        -- isLoop=false라 알아서 사라진다 — RemoveParticle로 치울 대상이 아니다.
        _ParticleService:PlayBasicParticleAttached(
            BasicParticleType.Buff, self.Entity,
            Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false)

        log("[PlayerStats] (클라) 레벨업 연출 Lv" .. tostring(newLevel))
        -- TODO(사운드): 레벨업 효과음 RUID가 정해지면 여기에
        -- _SoundService:PlaySound(ruid, volume)을 넣는다.
        -- 리소스 검색 결과에 이름이 비어 있어 어떤 소리인지 확인할 수 없었다.
    end

    @ExecSpace("Client")
    method void OnReachedCap()
        -- 캡 도달 연출. 레벨업보다 크게 한 번 터뜨려서 "여기가 끝"임을 알린다.
        -- 환생(T7) 진입점이 붙을 자리이기도 하다.
        _ParticleService:PlayBasicParticleAttached(
            BasicParticleType.PillarBurst, self.Entity,
            Vector3(0, 0, 0), 0, Vector3(1.5, 1.5, 1.5), false)

        log("[PlayerStats] (클라) 레벨 캡 도달 — 환생 가능 표시")
    end

    @ExecSpace("ServerOnly")
    method void RefreshTierRewards()
        -- 전직 차수가 레벨에서 나오므로(2026-08-21), 레벨이 오를 때마다 차수에 딸린
        -- 것들을 다시 계산한다. 지금은 슬롯 하나뿐이지만 창구를 하나로 두어
        -- 나중에 붙는 것(전직 연출·해금 알림)이 흩어지지 않게 한다.
        --
        -- PlayerStats가 PlayerSkillSlots를 부르는 방향인 이유: 레벨을 아는 쪽이
        -- 여기다. 반대로 슬롯이 매 프레임 레벨을 폴링하면 언제 갱신되는지가 흐려진다.
        ---@type PlayerSkillSlots
        local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
        if slots == nil then return end
        slots:RecomputeSlotCount()
    end

    method integer PointsPerLevel()
        -- 레벨업 한 번에 받는 스탯 포인트. **기본 5 + 환생 보너스** (설계 변경 2026-08-21).
        -- Lv5에서 환생했으면 6, Lv10이면 7 … 5레벨당 +1.
        --
        -- 실행공간을 비워 두는 이유: 서버는 지급에, 클라는 환생 창의 안내 문구에 쓴다.
        -- 두 곳이 각자 계산하면 창이 거짓말을 하게 된다.
        local base = _GameData:GetBalance("stat_points_per_level")
        ---@type PlayerSkillSlots
        local slots = self.Entity:GetComponent("script.PlayerSkillSlots")
        local bonus = 0
        if slots ~= nil then bonus = slots:RebirthBonus() end
        return math.floor(base) + bonus
    end

    @ExecSpace("ServerOnly")
    method void GrantLevelPoints(integer levels)
        -- 레벨업 시 포인트 지급 (T4에서 호출한다).
        if levels <= 0 then return end
        self.UnspentPoints = self.UnspentPoints + levels * self:PointsPerLevel()
    end

    @ExecSpace("ServerOnly")
    method void ResetRun()
        -- 회차 초기화. 환생(T7)이 이걸 부른다. 영구 데이터는 건드리지 않는다.
        self.Level = 1
        self.Exp = 0
        self.StatAtk = 0
        self.StatInt = 0
        self.StatDef = 0
        self.StatLuk = 0
        self.UnspentPoints = 0
        -- 환생하면 다시 Lv1이므로 캡 플래그도 내린다. 안 내리면 새 회차에서
        -- EXP가 한 톨도 안 들어온다.
        self.CanRebirth = false
    end

    ---------------------------------------------------------------
    -- 파생 스탯 (양쪽에서 계산 가능 — 표시용)
    ---------------------------------------------------------------

    method number GetEquipBonus(string stat)
        -- 장착한 장비가 이 스탯에 얹는 값 (T13-4). stat은 "ATK"/"INT"/"DEF"/"LUK".
        --
        -- 실행공간을 비워 두는 이유: GetTotalX가 양쪽에서 불린다 —
        -- 서버는 데미지 계산에, 클라는 스탯 창 표시에 쓴다. 인벤토리의
        -- Items/Equipped가 @TargetUserSync라 주인 클라에도 같은 값이 있다.
        --
        -- 올스탯(stat_all)은 _GameData:GetItemStatBonus가 이미 합쳐서 준다.
        -- 여기서 다시 더하면 두 번 들어간다.
        --
        -- ## 중복 보유가 그대로 쌓인다 (T15-1, 대표 지시 2026-08-13)
        --
        -- 같은 장비를 5개까지 모을 수 있고, **보너스는 보유 개수만큼 곱해진다**
        -- (무쇠 검 3개 = ATK+15). 그래서 "장착했는가"가 아니라 "몇 개 가졌는가"가
        -- 수치를 정한다 — 5개를 모아도 장착은 한 슬롯이다.
        --
        -- 왜 장착 개수가 아니라 보유 개수인가: 슬롯이 3개뿐이라 5개를 동시에
        -- 낄 자리가 없다. 개수를 세지 않으면 2개째부터 아무 의미가 없어
        -- 중복 드랍이 그냥 낭비가 된다.
        local inventory = self.Entity:GetComponent("script.PlayerInventory")
        if inventory == nil then return 0 end

        ---@type PlayerInventory
        local inv = inventory
        local total = 0
        local slots = inv:GetEquipSlotNames()
        for i = 1, #slots do
            local itemId = inv:GetEquipped(slots[i])
            if itemId ~= "" then
                total = total + _GameData:GetItemStackedStatBonus(itemId, stat, inv:GetCount(itemId))
            end
        end
        return total
    end

    method number GetStatWithoutEquip(string stat)
        -- 장비를 빼고 본 스탯 (기본값 + 분배분). **수치 게이트가 이걸 쓴다.**
        --
        -- 왜 나눠 두는가 (대표 지시 2026-08-12): 게이트는 "성장했는가"를 묻는
        -- 문이다. 장비를 세면 좋은 장비 하나로 문이 열려, 문이 재는 것이
        -- 성장이 아니라 운이 된다. 반대로 전투는 장비를 세는 게 당연하다.
        -- 그래서 전투용(GetTotalX)과 게이트용(이 함수)을 물리적으로 갈라 둔다.
        local perPoint = _GameData:GetBalance("atk_per_stat_point")
        if stat == "ATK" then
            return _GameData:GetBalance("player_base_atk") + self.StatAtk * perPoint
        end
        if stat == "INT" then
            return _GameData:GetBalance("player_base_int") + self.StatInt * perPoint
        end
        if stat == "DEF" then
            return _GameData:GetBalance("player_base_def") + self.StatDef * perPoint
        end
        if stat == "LUK" then
            return _GameData:GetBalance("player_base_luk") + self.StatLuk * perPoint
        end
        return 0
    end

    method number GetTotalAtk()
        -- 데미지 공식(T3)이 쓰는 값. 기본 ATK + 분배 P x P당 상승분 + 장비(T13-4).
        return self:GetStatWithoutEquip("ATK") + self:GetEquipBonus("ATK")
    end

    method number GetTotalInt()
        -- ATK와 대칭으로 기본값을 준다 (T10-1b). 기본 ATK만 10이던 시절에는
        -- INT를 11P 넘게 찍어야 비로소 기본 공격을 가져갔다 — INT 빌드의 첫
        -- 두세 레벨이 죽어 있었다. 둘이 같은 출발선에 서야 첫 1P부터 선택이 된다.
        return self:GetStatWithoutEquip("INT") + self:GetEquipBonus("INT")
    end

    method number GetTotalDef()
        -- 마찬가지로 ATK와 대칭. 피격 감쇄는 MonsterAttack이 이 값을 읽는다 (T10-3).
        return self:GetStatWithoutEquip("DEF") + self:GetEquipBonus("DEF")
    end

    method number GetTotalLuk()
        -- LUK만 기본값 0이다. 10을 주면 GetCaptureRate의 하한이 3%가 아니라 4%가 되어
        -- 기획서 4.8("확률 = 3% + LUK x 0.1%p")과 어긋난다. 바꾸려면 시트의
        -- capture_base_rate와 함께 정해야 한다 — 그래서 키만 만들어 두고 0으로 뒀다.
        --
        -- 장비 LUK은 여기 포함되므로 **포획률에도 얹힌다.** 의도한 것이다 —
        -- 기획서 4.7이 LUK을 포획·드랍·일부 스킬 계수의 스탯으로 정의한다.
        return self:GetStatWithoutEquip("LUK") + self:GetEquipBonus("LUK")
    end

    method number GetAllocatedTotal()
        -- 지금까지 **분배한** 포인트의 총합. 기본값(10/10/10/0)은 포함하지 않는다.
        --
        -- 수치 게이트가 쓴다 (RoomGate, gate_key = STAT_TOTAL). 어디에 넣었는지를
        -- 묻지 않으므로 어떤 빌드든 같은 시점에 문이 열린다 — 2·3스탯 빌드나
        -- 올스탯 빌드가 불리해지지 않게 하려는 결정이다 (대표 지시 2026-08-12).
        --
        -- ⚠ 이 값은 사실상 레벨이다: 레벨당 5P이므로
        --      총합 = 5 x (레벨 - 1) - 미분배 포인트
        --   레벨 게이트와 다른 점은 **미분배로 쌓아 둔 포인트는 쳐주지 않는다**는 것
        --   하나뿐이다. 즉 "레벨을 올렸는가"가 아니라 "올리고 실제로 찍었는가"를 묻는다.
        return self.StatAtk + self.StatInt + self.StatDef + self.StatLuk
    end

    method number GetCaptureRate()
        -- 포획 확률 = 기본 + LUK x LUK당 보정 (기획서 4.8).
        local base = _GameData:GetBalance("capture_base_rate")
        local perLuk = _GameData:GetBalance("capture_luk_bonus")
        return base + self:GetTotalLuk() * perLuk
    end

end
