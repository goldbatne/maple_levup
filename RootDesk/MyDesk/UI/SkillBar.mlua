-- @클라이언트 (UI는 클라 전용. 모든 메서드에 개별로 @ExecSpace를 붙인다)
--
-- 액티브 스킬 사용 버튼. 기획서: "액티브 스킬은 버튼 탭(2~3개 상한)".
-- 직업 슬롯과 몬스터 슬롯을 구분하지 않고 한 줄로 보여준다
-- (작업지시서 T5 요청 3: 사용 인터페이스는 통일).
--
-- StatPanel과 같은 이유로 @Logic이다 — UI 엔티티에 붙은 @Component는
-- Server 메서드를 가질 수 없어 RPC가 조용히 죽는다.
--
-- 판정은 서버가 한다. 버튼은 PlayerAttack의 Server RPC를 부르기만 한다.

@Logic
script SkillBar extends Logic

    -- 버튼 5개 = **스킬 슬롯 상한 5** (T16-4b). 남는 칸은 숨긴다.
    -- 몬스터 스킬과 NPC 스킬이 **합쳐서** 이 5칸을 놓고 경쟁하므로 바는 한 줄이다
    -- (설계 이력 2026-08-20 — 버튼을 둘로 가르자는 안은 철회됐다).
    -- 예전 주석의 "직업 최대 2 + 몬스터 3"은 직업 선택이 폐기되면서 사라진 셈법이다.
    property ButtonComponent btn1 = "0a63288a-f25e-4500-84e1-c0536f0f1a4c"
    property ButtonComponent btn2 = "23d5cbc8-509f-4c29-a48f-1dba39bc5fc6"
    property ButtonComponent btn3 = "5812a82b-6c76-49b2-a525-4c7c8b072d5a"
    property ButtonComponent btn4 = "859b8d35-9ca4-4021-8fee-b811c2f070f7"
    property ButtonComponent btn5 = "40a98c07-d9f0-4eea-9c79-f2201613b0da"

    property any handler1 = nil
    property any handler2 = nil
    property any handler3 = nil
    property any handler4 = nil
    property any handler5 = nil
    property any refreshTimer = nil

    property number refreshInterval = 0.3

    ---------------------------------------------------------------
    -- 키보드 입력 (T14-1)
    ---------------------------------------------------------------

    -- 맨 왼쪽 슬롯부터 순서대로 붙는 키. 쉼표로 구분한다 (대표 지시 2026-08-13).
    --
    -- 왜 문자열 한 줄인가: 나중에 키 재설정(T14-2)이 들어오면 저장된 설정으로
    -- **이 값만 덮어쓰면** 된다. 분기로 흩어 놓으면 재설정할 자리가 없어진다.
    -- 슬롯 상한이 5라 Z~B까지 쓰이고, N·M은 상한이 더 늘면 이어 붙는다.
    property string keyOrder = "Z,X,C,V,B,N,M"

    -- 저장된 배치(PlayerSkillSlots.KeyOrder)가 있으면 그걸 쓴다. 지금 적용돼 있는 값을
    -- 들고 있다가 달라질 때만 다시 만든다 — 세이브 로드가 비동기라서 OnBeginPlay
    -- 시점엔 아직 비어 있을 수 있다. 폴링이 이벤트보다 타이밍에 안전하다.
    @HideFromInspector property string appliedKeyOrder = ""

    -- 인스펙터에 적힌 기본 배치를 시작할 때 따로 보관한다.
    -- keyOrder는 저장값으로 덮어써지므로, 저장값이 ""로 되돌아왔을 때
    -- 돌아갈 곳이 필요하다 (T14-2b의 "기본값으로 되돌리기").
    @HideFromInspector property string defaultKeyOrder = ""

    -- keyOrder를 파싱한 결과. **슬롯 번호로 색인한다** (빈 슬롯은 구멍이다).
    -- 구멍이 있으므로 #keyCodes를 쓰면 안 된다 — keySlotCount를 본다.
    @HideFromInspector property table keyCodes = {}
    @HideFromInspector property table keyNames = {}
    @HideFromInspector property integer keySlotCount = 0
    property any keyDownHandler = nil

    -- 스킬에 걸 수 없는 키 (대표 지시 2026-08-13: "모든 키를 설정할 수 있도록").
    -- 전부 열어 주되 **다른 조작이 이미 쓰는 것**만 막는다:
    --   방향키·Escape  이동과 취소. 막지 않으면 스킬을 쏘면서 캐릭터가 같이
    --                  움직이거나, 창을 닫을 방법이 사라진다.
    --   Alpha1·Alpha2  아이템 퀵슬롯 (T13-5b). 막지 않으면 1을 눌렀을 때
    --                  스킬과 물약이 **동시에** 나간다.
    --
    -- 프로퍼티로 둔 이유: WASD도 이동에 쓰이는지가 아직 확인되지 않았다.
    -- 그렇다는 게 드러나면 여기에 이름만 더 적으면 된다.
    -- 퀵슬롯 키를 재설정할 수 있게 되면(T13-5c) 이 목록도 그 값을 따라가야 한다.
    property string reservedKeys = "UpArrow,DownArrow,LeftArrow,RightArrow,Escape,Alpha1,Alpha2"

    -- 설정 창이 키를 받고 있는 동안은 스킬을 쓰지 않는다 (T14-2b-2).
    -- 안 막으면 키를 고르는 순간 그 키에 걸린 스킬이 같이 나간다.
    @HideFromInspector property boolean captureMode = false

    -- 버튼 라벨에 키를 함께 보여줄지. 모바일에는 키보드가 없어 자동으로 숨긴다.
    property boolean showKeyHint = true

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        log("[SkillBar] OnBeginPlay")

        -- 클로저로 순번을 잡아둔다. 버튼마다 다른 index를 넘겨야 한다.
        self.handler1 = self.btn1.Entity:ConnectEvent(ButtonClickEvent, function() self:Use(1) end)
        self.handler2 = self.btn2.Entity:ConnectEvent(ButtonClickEvent, function() self:Use(2) end)
        self.handler3 = self.btn3.Entity:ConnectEvent(ButtonClickEvent, function() self:Use(3) end)
        self.handler4 = self.btn4.Entity:ConnectEvent(ButtonClickEvent, function() self:Use(4) end)
        self.handler5 = self.btn5.Entity:ConnectEvent(ButtonClickEvent, function() self:Use(5) end)

        -- 키보드도 같은 Use()로 보낸다. 버튼과 키가 서로 다른 경로를 타면
        -- 한쪽만 고쳐지는 버그가 난다.
        self.defaultKeyOrder = self.keyOrder
        self.appliedKeyOrder = self.keyOrder
        self:RebuildKeyMap()
        self.keyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)

        self.refreshTimer = _TimerService:SetTimerRepeat(function()
            self:Refresh()
        end, self.refreshInterval)

        self:Refresh()
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 연결한 것은 전부 해제한다 (스크립트 리로드 시 누수 방지).
        if self.handler1 ~= nil then self.btn1.Entity:DisconnectEvent(ButtonClickEvent, self.handler1) end
        if self.handler2 ~= nil then self.btn2.Entity:DisconnectEvent(ButtonClickEvent, self.handler2) end
        if self.handler3 ~= nil then self.btn3.Entity:DisconnectEvent(ButtonClickEvent, self.handler3) end
        if self.handler4 ~= nil then self.btn4.Entity:DisconnectEvent(ButtonClickEvent, self.handler4) end
        if self.handler5 ~= nil then self.btn5.Entity:DisconnectEvent(ButtonClickEvent, self.handler5) end
        if self.refreshTimer ~= nil then _TimerService:ClearTimer(self.refreshTimer) end
        if self.keyDownHandler ~= nil then
            _InputService:DisconnectEvent(KeyDownEvent, self.keyDownHandler)
            self.keyDownHandler = nil
        end
    end

    @ExecSpace("ClientOnly")
    method void SyncKeyOrderFromSave()
        -- 저장된 배치를 따라간다 (T14-2). Refresh가 0.3초마다 부른다.
        --
        -- 빈 문자열이면 저장된 설정이 없다는 뜻이라 **기본 배치로 돌아간다.**
        -- 여기서 기본값을 세이브에 써넣지 않는다 — 그러면 기본값을 바꿔도
        -- 옛 계정이 옛 배치를 영구히 들고 있게 된다.
        --
        -- ""도 목표값으로 취급해야 "기본값으로 되돌리기"가 재접속 없이 먹는다.
        -- 처음엔 ""를 그냥 무시했는데, 그러면 되돌려도 바뀐 배치가 그대로 남았다.
        ---@type PlayerSkillSlots
        local slots = self:GetSlots()
        if slots == nil then return end

        local saved = slots.KeyOrder
        local target = self.defaultKeyOrder
        if saved ~= nil and saved ~= "" then target = saved end

        if target == self.appliedKeyOrder then return end

        if saved == nil or saved == "" then
            log("[SkillBar] 기본 키 배치로 되돌린다 — '" .. target .. "'")
        else
            log("[SkillBar] 저장된 키 배치 적용 — '" .. target .. "'")
        end
        self.keyOrder = target
        self.appliedKeyOrder = target
        self:RebuildKeyMap()
    end

    @ExecSpace("ClientOnly")
    method void RequestSetKeyOrder(string order)
        -- 키 배치를 바꿔 달라고 서버에 요청한다. 판정·저장은 서버가 한다.
        -- 설정 창(T14-2b)이 여기를 부른다.
        local me = _UserService.LocalPlayer
        if me == nil then return end
        ---@type PlayerSkillSlots
        local slots = me:GetComponent("script.PlayerSkillSlots")
        if slots == nil then return end
        slots:RequestSetKeyOrder(order)
    end

    @ExecSpace("ClientOnly")
    method table SplitOrder(string raw)
        -- 쉼표 분해. **위치를 보존한다** — 빈 칸("Z,,C")은 "키 없는 슬롯"이다.
        -- gmatch("[^,]+")를 쓰면 빈 칸이 사라져 그 뒤 슬롯 번호가 하나씩 밀린다.
        -- 밀어내기(대표 지시)로 빈 슬롯이 생길 수 있어서 이게 필요해졌다.
        -- 끝에 쉼표를 붙이고 "([^,]*)," 로 훑는다. `*`라서 빈 칸도 잡히고,
        -- 붙인 쉼표 덕에 마지막 칸까지 하나로 처리된다.
        local out = {}
        if raw == nil then return out end
        for field in string.gmatch(raw .. ",", "([^,]*),") do
            table.insert(out, field)
        end
        return out
    end

    @ExecSpace("ClientOnly")
    method string Trim(string s)
        -- 사람이 적은 배치("Z, X")도 받아들인다.
        if s == nil then return "" end
        return string.match(s, "^%s*(.-)%s*$")
    end

    @ExecSpace("ClientOnly")
    method void RebuildKeyMap()
        -- keyOrder("Z,X,C,V,B,N,M")를 슬롯번호 → KeyboardKey 표로 만든다.
        -- 키 재설정은 keyOrder를 갈아끼운 뒤 이걸 다시 부르면 된다.
        self.keyCodes = {}
        self.keyNames = {}

        local tokens = self:SplitOrder(self.keyOrder)
        self.keySlotCount = #tokens

        local bound = 0
        for i = 1, #tokens do
            local name = self:Trim(tokens[i])
            if name ~= "" then
                local code = self:KeyCodeOf(name)
                if code == nil then
                    -- 조용히 건너뛰면 "그 키만 안 먹는다"가 되어 원인을 찾기 어렵다.
                    log_warning("[SkillBar] 모르는 키 이름은 건너뛴다: '" .. name .. "'")
                elseif self:IsReserved(name) then
                    log_warning("[SkillBar] 예약된 키는 걸 수 없다: '" .. name .. "'")
                else
                    self.keyCodes[i] = code
                    self.keyNames[i] = name
                    bound += 1
                end
            end
        end
        log("[SkillBar] 키 매핑 " .. tostring(bound) .. "/" .. tostring(self.keySlotCount)
            .. "칸 — " .. self.keyOrder)
    end

    @ExecSpace("ClientOnly")
    method any KeyCodeOf(string name)
        -- 이름 → KeyboardKey. `KeyboardKey.CastFrom(string)`이 열거형에 문서화돼 있다.
        --
        -- 실측 (2026-08-13): **대소문자를 구분하고, 모르는 이름은 [LEA-3021]을 던진다**
        -- (None을 돌려주지 않는다). 그래서 pcall로 감싸 nil로 바꿔 돌려준다.
        --   CastFrom("Z")        → Z
        --   CastFrom("z")        → 던짐
        --   CastFrom("Alpha1")   → Alpha1
        --   CastFrom("Nonsense") → 던짐
        --
        -- 이 덕에 분기를 늘리지 않고 **키보드 전체**를 지원한다 (대표 지시).
        -- 이름은 열거형 멤버명 그대로다: A~Z / Alpha0~9 / F1~F15 / Keypad0~9 /
        -- Space / Tab / Semicolon / LeftShift ...
        if name == nil or name == "" then return nil end
        -- pcall의 반환값을 하나만 받는다. 둘을 받으면 LSP가
        -- "'2' values are assigned to '1' variables"로 경고한다 (동작은 같다).
        local code = nil
        local ok = pcall(function() code = KeyboardKey.CastFrom(name) end)
        if not ok then return nil end
        return code
    end

    @ExecSpace("ClientOnly")
    method boolean IsReserved(string name)
        -- 이동·취소에 쓰이는 키인가. reservedKeys 프로퍼티가 목록이다.
        for token in string.gmatch(self.reservedKeys, "([^,]+)") do
            if self:Trim(token) == name then return true end
        end
        return false
    end

    @ExecSpace("ClientOnly")
    method string BuildOrderWithKey(integer index, string keyName)
        -- 슬롯 index에 keyName을 걸었을 때의 새 배치 문자열을 만든다.
        --
        -- **밀어내기** (대표 지시 2026-08-13): 그 키를 이미 쓰던 다른 슬롯은 **비운다.**
        -- 교환이 아니라 비우는 쪽이라, 옮긴 자리는 키 없이 버튼만 남는다.
        -- 설정 창(T14-2b)이 이 결과를 RequestSetKeyOrder로 보낸다.
        --
        -- keyName이 ""이면 그 슬롯만 비운다.
        local tokens = self:SplitOrder(self.keyOrder)

        -- 슬롯이 배치보다 뒤에 있으면 빈 칸으로 늘린다.
        while #tokens < index do
            table.insert(tokens, "")
        end

        local wanted = self:Trim(keyName)
        if wanted ~= "" then
            for i = 1, #tokens do
                if i ~= index and self:Trim(tokens[i]) == wanted then
                    tokens[i] = ""   -- 밀어냈다
                end
            end
        end
        tokens[index] = wanted

        -- 끝쪽 빈 칸은 떼어낸다. 안 떼면 "Z,,,,,,"처럼 계속 길어진다.
        while #tokens > 0 and self:Trim(tokens[#tokens]) == "" do
            table.remove(tokens)
        end

        local out = ""
        for i = 1, #tokens do
            if i > 1 then out = out .. "," end
            out = out .. self:Trim(tokens[i])
        end
        return out
    end

    @ExecSpace("ClientOnly")
    method void SetCaptureMode(boolean on)
        -- 설정 창(KeyConfigPanel)이 키를 받는 동안 켠다.
        self.captureMode = on
    end

    @ExecSpace("ClientOnly")
    method void OnKeyDown(KeyDownEvent event)
        -- 설정 창이 키를 받고 있으면 스킬을 쓰지 않는다.
        if self.captureMode then return end

        -- 눌린 키가 몇 번째 슬롯인지 찾아 버튼과 같은 창구로 보낸다.
        -- keyCodes에 구멍이 있을 수 있어 #가 아니라 keySlotCount로 돈다.
        for i = 1, self.keySlotCount do
            if self.keyCodes[i] == event.key then
                self:Use(i)
                return
            end
        end
    end

    @ExecSpace("ClientOnly")
    method string KeyNameFor(integer index)
        -- 버튼 라벨에 붙일 키 이름. 걸린 키가 없으면 빈 문자열.
        local name = self.keyNames[index]
        if name == nil then return "" end
        return name
    end

    @ExecSpace("ClientOnly")
    method any GetButton(integer index)
        -- 프로퍼티를 배열처럼 쓰기 위한 창구. 5개뿐이라 분기로 충분하다.
        if index == 1 then return self.btn1 end
        if index == 2 then return self.btn2 end
        if index == 3 then return self.btn3 end
        if index == 4 then return self.btn4 end
        if index == 5 then return self.btn5 end
        return nil
    end

    @ExecSpace("ClientOnly")
    method any GetSlots()
        local me = _UserService.LocalPlayer
        if me == nil then return nil end
        return me:GetComponent("script.PlayerSkillSlots")
    end

    @ExecSpace("ClientOnly")
    method number GetCooldownRemain(string skillId)
        -- 남은 쿨다운. PlayerAttack이 들고 있는 값을 그대로 읽는다 —
        -- 여기서 따로 세면 서버 판정과 어긋난다.
        local me = _UserService.LocalPlayer
        if me == nil then return 0 end
        ---@type PlayerAttack
        local atk = me:GetComponent("script.PlayerAttack")
        if atk == nil then return 0 end
        return atk:GetCooldownRemain(skillId)
    end

    @ExecSpace("ClientOnly")
    method void Use(integer activeIndex)
        -- 검증은 서버가 한다. 여기서는 요청만 보낸다 (개발 규칙 2).
        local me = _UserService.LocalPlayer
        if me == nil then return end
        ---@type PlayerAttack
        local atk = me:GetComponent("script.PlayerAttack")
        if atk == nil then return end
        atk:RequestUseSkill(activeIndex)
    end

    @ExecSpace("ClientOnly")
    method void Refresh()
        -- 서버와 같은 GetActiveSkills를 부른다. 목록 규칙이 한 곳에만 있게 하려는 것이다.
        ---@type PlayerSkillSlots
        local slots = self:GetSlots()
        if slots == nil then return end

        -- 저장된 키 배치가 도착했는지 본다 (T14-2). 달라졌을 때만 다시 만든다.
        self:SyncKeyOrderFromSave()

        local active = slots:GetActiveSkills()
        for i = 1, 5 do
            local btn = self:GetButton(i)
            if btn ~= nil then
                local skillId = active[i]
                if skillId == nil then
                    -- 빈 칸은 숨긴다. 회색으로 남겨두면 "왜 안 눌리지"가 된다.
                    btn.Entity:SetVisible(false)
                else
                    btn.Entity:SetVisible(true)
                    local skill = _GameData:GetSkill(skillId)
                    local label = skillId
                    if skill ~= nil then label = skill.name end

                    -- 어떤 키인지 보여준다. 수동 조작이라 키를 모르면 슬롯이 있어도
                    -- 쓸 방법을 알 수 없다. 모바일에는 키보드가 없어 붙이지 않는다.
                    if self.showKeyHint and Environment:IsPCPlatform() then
                        local keyName = self:KeyNameFor(i)
                        if keyName ~= "" then label = label .. " [" .. keyName .. "]" end
                    end

                    -- 쿨다운 중이면 남은 초를 함께 보여준다. 판정은 서버가 하고
                    -- 여기서는 "왜 안 나가는지"만 알린다 (개발 규칙 2).
                    local remain = self:GetCooldownRemain(skillId)
                    if remain > 0 then
                        label = label .. "\n" .. tostring(math.ceil(remain)) .. "초"
                    end
                    btn.Entity.TextGUIRendererComponent.Text = label
                end
            end
        end
    end

end
