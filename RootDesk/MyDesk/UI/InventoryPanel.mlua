-- @클라이언트 (창은 보여주고 고르는 것까지만. 장착 판정은 서버가 다시 한다)
--
-- 가방 창 (T13-5a). 가진 것을 보여주고, 장비를 눌러 장착·해제한다.
--
-- @Logic인 이유: UI 엔티티에 붙은 @Component는 Server 계열 메서드를 가질 수 없다.
-- 이 프로젝트의 UI 컨트롤러는 전부 @Logic으로 통일돼 있다.
--
-- 판정을 여기서 하지 않는다. 줄을 누르면 PlayerInventory.RequestSetEquip을 부르고,
-- 장비인가·슬롯이 맞는가·가지고 있는가는 전부 서버가 다시 본다 —
-- 창이 보내는 값은 클라가 조작할 수 있으므로 여기의 검사는 표시용일 뿐이다.
--
-- 가진 아이템은 ScrollLayout 아래 29줄에 그린다. 현재 전체 아이템 29종을
-- 한 번에 담고, 화면에 넘치는 부분은 스크롤한다. 종류를 더 늘릴 때는
-- itemRow 프로퍼티와 UIBuilder의 행 수를 함께 늘려야 한다.

@Logic
script InventoryPanel extends Logic

    -- .ui 엔티티 UUID는 UIBuilder가 write 시점에 주입한다.
    property Entity panel = "d6a4ea42-d70f-4746-84e0-6aa4eb914e0b"
    property ButtonComponent openBtn = "f21aca9a-6277-48a9-89f9-f6342d2570a9"
    property ButtonComponent closeBtn = "4219e969-e664-4b1e-821f-f136c65c939f"
    property TextGUIRendererComponent hintText = "5b833216-1485-4747-82c1-31cd62b9a1b8"
    property TextGUIRendererComponent detailTitle = "688bd506-9ce9-4828-980b-db4faf24811f"
    property TextGUIRendererComponent detailBody = "f0109592-7a1f-4f2b-b6e1-30052c53947b"
    property ButtonComponent equipRow0 = "85cb4aaa-f735-4510-a4b9-a1c3e7487f1d"
    property ButtonComponent equipRow1 = "919ea6ea-150d-41d0-90d9-6c2644d7243d"
    property ButtonComponent equipRow2 = "e99a2da9-e57a-4a6e-8b83-0f471ef082e0"
    property ButtonComponent itemRow0 = "eef446f2-c318-4897-b664-80f7f0a87cc1"
    property ButtonComponent itemRow1 = "bb715c79-7f26-4460-812b-af0bb38800b2"
    property ButtonComponent itemRow2 = "3f22ba67-86b7-44d6-843a-50d4caf6f910"
    property ButtonComponent itemRow3 = "f574d1f9-7929-428b-ad06-7711820497b5"
    property ButtonComponent itemRow4 = "446372d5-114f-4b1c-a68f-9af6fa147806"
    property ButtonComponent itemRow5 = "1f625391-aa5f-4e2e-b127-8a105a15cfb4"
    property ButtonComponent itemRow6 = "c49b346b-6a7a-4927-985f-51c0700cdb7d"
    property ButtonComponent itemRow7 = "106d103e-a1d8-4a45-9f8b-90eb760cef55"
    property ButtonComponent itemRow8 = "b1b2f0c7-0bb2-4e84-ae5a-9941bec1061a"
    property ButtonComponent itemRow9 = "18b9ce0e-8ba9-4561-9fd3-3b6af7ba878c"
    property ButtonComponent itemRow10 = "0002480b-0655-4047-b848-21ea2ecca786"
    property ButtonComponent itemRow11 = "d6e619b0-467c-4c8c-8c68-5f17bf8e1c4b"
    property ButtonComponent itemRow12 = "7ed9b876-e586-47c9-81f3-1c97086ca51a"
    property ButtonComponent itemRow13 = "a14b555c-2171-4117-897e-96f838d4667b"
    property ButtonComponent itemRow14 = "d836d011-4b65-41ae-9332-6c0dd1aa23ca"
    property ButtonComponent itemRow15 = "91b4a172-2e73-452c-87c6-498a9c67f402"
    property ButtonComponent itemRow16 = "b10bbe8d-a3f8-41d7-97c2-0d0e7a7d0c23"
    property ButtonComponent itemRow17 = "71003d99-4d90-49a6-ac87-97964a89dc89"
    property ButtonComponent itemRow18 = "2a18ef88-ceba-4793-bf36-65b3ecebf862"
    property ButtonComponent itemRow19 = "8b18caa7-2698-47fc-b90e-1a45acbce68f"
    property ButtonComponent itemRow20 = "71840906-6e48-43c2-a39a-a71565aad9d4"
    property ButtonComponent itemRow21 = "a0548e56-8e75-4f98-82c6-ed720940ce80"
    property ButtonComponent itemRow22 = "28c3de11-ffc1-4039-9836-cd19091e51b8"
    property ButtonComponent itemRow23 = "cd9b6ccf-809f-4e66-a558-42b41f1ffdb4"
    property ButtonComponent itemRow24 = "209f3f65-160c-483d-b480-7bf80da30ca2"
    property ButtonComponent itemRow25 = "bb67f078-702e-42b1-88ba-b71cd3ced34a"
    property ButtonComponent itemRow26 = "e2eb832d-5a18-4eb5-8214-2a1ee0c8fe76"
    property ButtonComponent itemRow27 = "b23a3cff-4879-4ef3-8297-87867f4b5fbd"
    property ButtonComponent itemRow28 = "44465311-b826-4e9f-92b4-96138ea186e3"
    property ButtonComponent itemRow29 = "38edbc40-015e-4612-be45-59eafbafa7bf"

    -- (엔티티, 핸들러) 병렬 배열. `handler`는 mlua 예약어라 키로 쓸 수 없다.
    property table handlerEntities = {}
    property table handlerIds = {}
    property any refreshTimer = nil
    property number refreshInterval = 0.3

    -- 지금 각 줄이 무엇을 들고 있는가. 줄을 눌렀을 때 무엇을 장착할지 여기서 찾는다.
    -- 클릭 핸들러에 아이템 id를 캡처하지 않는 이유: 목록이 갱신되면 줄의 내용이
    -- 바뀌는데 핸들러는 그대로라, 캡처했다면 옛 아이템을 장착하게 된다.
    property table rowItemIds = {}
    -- 행별로 마지막에 지정한 아이콘 RUID. 같은 thumbnail://을 0.3초마다 다시 넣으면
    -- 로딩이 끝나기 전에 재요청되어 기본 아이콘이 계속 남을 수 있으므로 변경 시에만 갱신한다.
    property table rowIconRuids = {}
    property string selectedItemId = ""

    property integer equipRowCount = 3
    property integer itemRowCount = 30

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self:Hide()
        log("[Inventory창] OnBeginPlay — 닫힌 채로 시작")

        self:Bind(self.openBtn, function() self:Open() end)
        self:Bind(self.closeBtn, function() self:Hide() end)

        for i = 1, self.equipRowCount do
            local captured = i
            self:Bind(self:GetEquipRow(i), function() self:OnEquipRowClick(captured) end)
        end
        for i = 1, self.itemRowCount do
            local captured = i
            self:Bind(self:GetItemRow(i), function() self:OnItemRowClick(captured) end)
        end

        self.refreshTimer = _TimerService:SetTimerRepeat(function()
            self:Refresh()
        end, self.refreshInterval)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 붙인 것은 전부 뗀다. 남기면 스크립트를 다시 읽을 때 중복으로 붙는다.
        for i = 1, #self.handlerEntities do
            local ent = self.handlerEntities[i]
            if isvalid(ent) then
                ent:DisconnectEvent(ButtonClickEvent, self.handlerIds[i])
            end
        end
        self.handlerEntities = {}
        self.handlerIds = {}

        if self.refreshTimer ~= nil then
            _TimerService:ClearTimer(self.refreshTimer)
            self.refreshTimer = nil
        end
    end

    @ExecSpace("ClientOnly")
    method void Bind(ButtonComponent btn, any fn)
        -- 버튼 하나에 클릭 핸들러를 붙이고 나중에 뗄 수 있게 기억한다.
        if not isvalid(btn) then return end
        local ent = btn.Entity
        local h = ent:ConnectEvent(ButtonClickEvent, fn)
        table.insert(self.handlerEntities, ent)
        table.insert(self.handlerIds, h)
    end

    @ExecSpace("ClientOnly")
    method any GetEquipRow(integer index)
        -- 프로퍼티를 배열처럼 쓰기 위한 창구. 3개뿐이라 분기로 충분하다.
        if index == 1 then return self.equipRow0 end
        if index == 2 then return self.equipRow1 end
        if index == 3 then return self.equipRow2 end
        return nil
    end

    @ExecSpace("ClientOnly")
    method any GetItemRow(integer index)
        if index == 1 then return self.itemRow0 end
        if index == 2 then return self.itemRow1 end
        if index == 3 then return self.itemRow2 end
        if index == 4 then return self.itemRow3 end
        if index == 5 then return self.itemRow4 end
        if index == 6 then return self.itemRow5 end
        if index == 7 then return self.itemRow6 end
        if index == 8 then return self.itemRow7 end
        if index == 9 then return self.itemRow8 end
        if index == 10 then return self.itemRow9 end
        if index == 11 then return self.itemRow10 end
        if index == 12 then return self.itemRow11 end
        if index == 13 then return self.itemRow12 end
        if index == 14 then return self.itemRow13 end
        if index == 15 then return self.itemRow14 end
        if index == 16 then return self.itemRow15 end
        if index == 17 then return self.itemRow16 end
        if index == 18 then return self.itemRow17 end
        if index == 19 then return self.itemRow18 end
        if index == 20 then return self.itemRow19 end
        if index == 21 then return self.itemRow20 end
        if index == 22 then return self.itemRow21 end
        if index == 23 then return self.itemRow22 end
        if index == 24 then return self.itemRow23 end
        if index == 25 then return self.itemRow24 end
        if index == 26 then return self.itemRow25 end
        if index == 27 then return self.itemRow26 end
        if index == 28 then return self.itemRow27 end
        if index == 29 then return self.itemRow28 end
        if index == 30 then return self.itemRow29 end
        return nil
    end

    ---------------------------------------------------------------
    -- 열고 닫기
    ---------------------------------------------------------------

    @ExecSpace("ClientOnly")
    method void Open()
        if isvalid(self.panel) then self.panel.Enable = true end
        self:Refresh()
        log("[Inventory창] 열림")
    end

    @ExecSpace("ClientOnly")
    method void Hide()
        -- Enable로 끈다. Visible=false는 클릭이 살아 있다 (ui-hierarchy 5).
        if isvalid(self.panel) then self.panel.Enable = false end
    end

    ---------------------------------------------------------------
    -- 조회
    ---------------------------------------------------------------

    @ExecSpace("ClientOnly")
    method any GetInventory()
        local me = _UserService.LocalPlayer
        if me == nil then return nil end
        return me:GetComponent("script.PlayerInventory")
    end

    @ExecSpace("ClientOnly")
    method string SlotLabel(string slot)
        -- 화면에 보일 슬롯 이름. 모르는 슬롯은 이름 그대로 — 데이터가 늘어나도 깨지지 않는다.
        if slot == "weapon" then return "무기" end
        if slot == "armor" then return "방어구" end
        if slot == "accessory" then return "장신구" end
        return slot
    end

    @ExecSpace("ClientOnly")
    method string StatSummary(table item, integer count)
        -- "ATK+5" / "올스탯+3" 꼴. 0인 스탯은 적지 않는다.
        --
        -- count는 보유 개수다. 중복 장비는 개당 수치가 그대로 더해지므로(T15-1)
        -- 여기도 **합산값**을 보여준다 — 개당 수치를 띄우면 스탯 창의 숫자와
        -- 어긋나서 "장비가 안 먹는다"로 읽힌다.
        --
        -- 회복량(heal_hp)은 곱하지 않는다. 한 번에 하나씩 마시므로 개당이 맞다.
        -- ⚠ **표의 숫자를 그대로 쓰면 안 된다** (T30). `ItemTable`의 스탯 컬럼은 이제
        --   **스탯 포인트 상당**이고 실제로 얹히는 값은 계수를 곱한 것이다
        --   (무쇠 검 5 → 물리 공격력 +25). 표의 5를 그대로 띄우면 가방은 "+25"라고
        --   하는데 스탯 창은 +125로 늘어 "장비가 이상하다"로 읽힌다.
        --   그래서 **스탯 창과 같은 창구**(`GetItemStackedStatBonus`)에서 값을 받는다.
        if count < 1 then count = 1 end
        if item.item_type == "passive" then
            return "보유 효과 " .. item.passive_stat .. " +"
                .. tostring(item.passive_value * count)
        end
        -- 올스탯만 포인트로 적는다. 수치가 넷 다 달라(물공 +15 / 방어 +30 …) 한 줄에
        -- 다 쓰면 줄을 넘고, 이 아이템의 값어치는 "모든 스탯 몇 P"가 가장 잘 나른다.
        if item.stat_all > 0 then return "올스탯+" .. tostring(item.stat_all * count) .. "P" end
        local out = ""
        if item.stat_atk > 0 then out = out .. " 물리공격력+" .. tostring(math.floor(_GameData:GetItemStackedStatBonus(item.id, "ATK", count) + 0.5)) end
        if item.stat_int > 0 then out = out .. " 마법공격력+" .. tostring(math.floor(_GameData:GetItemStackedStatBonus(item.id, "INT", count) + 0.5)) end
        if item.stat_def > 0 then out = out .. " 방어력+" .. tostring(math.floor(_GameData:GetItemStackedStatBonus(item.id, "DEF", count) + 0.5)) end
        if item.stat_luk > 0 then out = out .. " LUK+" .. tostring(math.floor(_GameData:GetItemStackedStatBonus(item.id, "LUK", count) + 0.5)) end
        if item.heal_hp > 0 then out = out .. " HP회복 " .. tostring(item.heal_hp) end
        if out == "" then return "" end
        return string.sub(out, 2)
    end

    @ExecSpace("ClientOnly")
    method string CountLabel(table item, integer count)
        -- "x3/5" 꼴. 장비만 상한을 같이 보여준다 — 5가 목표 숫자라서
        -- 몇 개가 남았는지가 바로 읽혀야 한다. 포션은 상한이 99라 "/99"가
        -- 잡음이 될 뿐이라 개수만 적는다.
        if item.item_type == "equip" or item.item_type == "passive" then
            return "x" .. tostring(count) .. "/" .. tostring(_GameData:GetItemStackCap(item.id))
        end
        return "x" .. tostring(count)
    end

    ---------------------------------------------------------------
    -- 표시
    ---------------------------------------------------------------

    @ExecSpace("ClientOnly")
    method void SetRow(any btn, string label, string iconRuid)
        -- 줄 하나를 채운다. iconRuid가 빈 문자열이면 아이콘을 숨긴다 —
        -- 빈 RUID를 넣으면 아이콘이 "안 보이는 것"이 아니라 깨진 자리로 남는다.
        if btn == nil or not isvalid(btn) then return end
        local rowEntity = btn.Entity
        rowEntity.Enable = true

        local text = rowEntity.TextGUIRendererComponent
        local nameEntity = rowEntity:GetChildByName("Name", false)
        if isvalid(nameEntity) then
            if isvalid(text) then text.Text = "" end
            nameEntity.TextGUIRendererComponent.Text = label
        elseif isvalid(text) then
            text.Text = label
        end

        local icon = rowEntity:GetChildByName("Icon", false)
        if icon ~= nil and isvalid(icon) then
            if iconRuid == "" then
                icon.Enable = false
            else
                icon.Enable = true
                icon.SpriteGUIRendererComponent.ImageRUID = DataRef(iconRuid)
                icon.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void HideRow(any btn)
        if btn == nil or not isvalid(btn) then return end
        btn.Entity.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void SetItemCell(any btn, table item, integer count, boolean selected, integer rowIndex)
        if btn == nil or not isvalid(btn) then return end
        local entity = btn.Entity
        entity.Enable = true
        local text = entity.TextGUIRendererComponent
        if isvalid(text) then text.Text = "" end

        local iconEntity = entity:GetChildByName("Icon", false)
        if isvalid(iconEntity) then
            iconEntity.Enable = item.icon_ruid ~= ""
            if item.icon_ruid ~= "" then
                local icon = iconEntity.SpriteGUIRendererComponent
                if self.rowIconRuids[rowIndex] ~= item.icon_ruid then
                    icon.ImageRUID = DataRef(item.icon_ruid)
                    self.rowIconRuids[rowIndex] = item.icon_ruid
                end
                -- 보유 아이템은 상태 표현 때문에 흐리게 만들지 않는다. 선택 여부는 슬롯 테두리로만 가른다.
                icon.Color = Color(1, 1, 1, 1)
                iconEntity.UITransformComponent.anchoredPosition = Vector2(0, -2)
                iconEntity.UITransformComponent.RectSize = Vector2(62, 62)
            end
        end

        local countEntity = entity:GetChildByName("Count", false)
        if isvalid(countEntity) then
            countEntity.TextGUIRendererComponent.Text = tostring(count)
        end

        local sprite = entity.SpriteGUIRendererComponent
        if isvalid(sprite) then
            if selected then
                sprite.Color = Color(0.55, 0.76, 0.95, 1)
            elseif item.item_type == "passive" then
                sprite.Color = Color(0.90, 0.84, 0.97, 1)
            elseif item.item_type == "equip" then
                sprite.Color = Color(0.94, 0.90, 0.76, 1)
            else
                sprite.Color = Color(0.90, 0.92, 0.95, 1)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void RenderItemDetail(PlayerInventory inv)
        if not isvalid(self.detailTitle) or not isvalid(self.detailBody) then return end
        if self.selectedItemId == "" then
            self.detailTitle.Text = "아이템을 선택해 주세요"
            self.detailBody.Text = "장비는 한 번 눌러 장착 · 포션은 선택 후 다시 눌러 사용"
            return
        end
        local item = _GameData:GetItem(self.selectedItemId)
        if item == nil then
            self.selectedItemId = ""
            self.detailTitle.Text = "아이템을 선택해 주세요"
            self.detailBody.Text = "장비는 한 번 눌러 장착 · 포션은 선택 후 다시 눌러 사용"
            return
        end
        local count = inv:GetCount(item.id)
        self.detailTitle.Text = item.name .. "   x" .. tostring(count)
        local action = "한 번 더 누르면 사용"
        if item.item_type == "equip" then
            action = self:SlotLabel(item.slot) .. "에 장착됨"
        elseif item.item_type == "passive" then
            action = "인벤토리 보유 중 자동 적용"
        end
        self.detailBody.Text = self:StatSummary(item, count) .. "   ·   " .. action
    end

    @ExecSpace("ClientOnly")
    method void Refresh()
        -- 창이 닫혀 있으면 그릴 필요가 없다.
        if not isvalid(self.panel) then return end
        if not self.panel.Enable then return end

        ---@type PlayerInventory
        local inv = self:GetInventory()
        if inv == nil then return end

        -- 착용 중 3줄. 슬롯 이름과 순서는 PlayerInventory가 정본이다.
        local slots = inv:GetEquipSlotNames()
        for i = 1, self.equipRowCount do
            local btn = self:GetEquipRow(i)
            local slot = slots[i]
            if slot == nil then
                self:HideRow(btn)
            else
                local itemId = inv:GetEquipped(slot)
                if itemId == "" then
                    self:SetRow(btn, self:SlotLabel(slot) .. "\n비어 있음", "")
                else
                    local item = _GameData:GetItem(itemId)
                    if item == nil then
                        self:SetRow(btn, self:SlotLabel(slot) .. "\n" .. itemId, "")
                    else
                        -- 착용 줄에도 개수를 적는다. 장착은 한 슬롯이지만 수치는
                        -- 보유 개수만큼 붙으므로(T15-1) 개수가 안 보이면
                        -- "왜 +5가 아니라 +15지"의 답이 화면에 없다.
                        local held = inv:GetCount(itemId)
                        self:SetRow(btn, self:SlotLabel(slot) .. "\n" .. item.name
                            .. " x" .. tostring(held) .. "\n눌러서 해제", item.icon_ruid)
                    end
                end
            end
        end

        -- 가진 것. 0개는 건너뛰고, 남는 줄은 숨긴다.
        self.rowItemIds = {}
        local ids = _GameData:GetAllItemIds()
        local row = 0
        for i = 1, #ids do
            local id = ids[i]
            local count = inv:GetCount(id)
            if count > 0 and row < self.itemRowCount then
                row = row + 1
                self.rowItemIds[row] = id
                local item = _GameData:GetItem(id)
                if item ~= nil then
                    self:SetItemCell(self:GetItemRow(row), item, count, id == self.selectedItemId, row)
                else
                    self:HideRow(self:GetItemRow(row))
                end
            end
        end
        for i = row + 1, self.itemRowCount do
            self:HideRow(self:GetItemRow(i))
        end

        if row == 0 then
            self.selectedItemId = ""
        elseif self.selectedItemId ~= "" and inv:GetCount(self.selectedItemId) <= 0 then
            self.selectedItemId = ""
        end
        self:RenderItemDetail(inv)

        if isvalid(self.hintText) then
            if row == 0 then
                self.hintText.Text = "가방이 비어 있다. 몬스터를 잡으면 바닥에 떨어진다 — 밟으면 줍는다."
            else
                -- 한 줄로 둔다. 두 줄이면 마지막 아이템 줄과 겹친다 (ui_lint L023).
                self.hintText.Text = "장비는 한 번 눌러 장착 · 포션은 선택 후 다시 눌러 사용 · 착용 칸은 눌러서 해제"
            end
        end
    end

    ---------------------------------------------------------------
    -- 클릭
    ---------------------------------------------------------------

    @ExecSpace("ClientOnly")
    method void OnEquipRowClick(integer index)
        -- 착용 중인 줄을 누르면 해제한다.
        ---@type PlayerInventory
        local inv = self:GetInventory()
        if inv == nil then return end

        local slots = inv:GetEquipSlotNames()
        local slot = slots[index]
        if slot == nil then return end
        if inv:GetEquipped(slot) == "" then return end

        log("[Inventory창] 해제 요청 " .. slot)
        inv:RequestSetEquip(slot, "")
        self:Refresh()
    end

    @ExecSpace("ClientOnly")
    method void OnItemRowClick(integer index)
        -- 가진 것 줄을 누르면 장착한다. 소비 아이템은 여기서 쓰지 않는다 —
        -- 퀵슬롯(T13-5b)과 사용(T13-7)이 붙을 자리다.
        local itemId = self.rowItemIds[index]
        if itemId == nil then return end

        local item = _GameData:GetItem(itemId)
        if item == nil then return end

        -- 장비는 첫 클릭에 바로 장착한다. 이전에는 첫 클릭이 선택만 해서 파란 칸으로
        -- 바뀌고 아무 일도 안 일어난 것처럼 보였다. 소비만 오사용 방지를 위해 재클릭한다.
        local wasSelected = self.selectedItemId == itemId
        self.selectedItemId = itemId

        ---@type PlayerInventory
        local inv = self:GetInventory()
        if inv == nil then return end

        -- 소비 아이템은 여기서 바로 쓴다 (T13-7). 퀵슬롯(T13-5b)이 붙으면
        -- 손이 빠른 길이 하나 더 생기는 것이고, 창에서 쓰는 길은 그대로 남는다.
        if item.item_type == "consume" then
            if wasSelected == false then
                self:Refresh()
                return
            end
            log("[Inventory창] 사용 요청 " .. itemId)
            inv:RequestUseItem(itemId)
            self:Refresh()
            return
        end

        -- 패시브 아이템은 선택해서 설명만 본다. 재클릭해도 장착/사용 요청을 보내지 않는다.
        if item.item_type == "passive" then
            log("[Inventory창] 패시브 확인 " .. itemId .. " — 보유 중 자동 적용")
            self:Refresh()
            return
        end

        log("[Inventory창] 장착 요청 " .. item.slot .. " = " .. itemId)
        inv:RequestSetEquip(item.slot, itemId)
        self:Refresh()
    end

end
