-- @클라이언트 (선택 창은 보여주고 고르는 것까지만. 실제 이동은 서버가 다시 판정한다)
--
-- 마을 게이트의 지역 선택 창. 갈 수 있는 곳이 둘 이상일 때만 뜬다.
--
-- @Logic인 이유: UI 엔티티에 붙은 @Component는 Server 계열 메서드를 가질 수 없다.
-- 이 프로젝트의 UI 컨트롤러는 전부 @Logic으로 통일돼 있다.

@Logic
script AreaSelectPanel extends Logic

    -- .ui 엔티티 UUID는 UIBuilder가 write 시점에 주입한다.
    property Entity panel = "3da012e3-68a0-4de7-85d6-03dbe0df862e"
    property ButtonComponent slot0 = "80d65707-3ccb-41f6-8da8-2839515dcd68"
    property ButtonComponent slot1 = "9d877a28-94b3-48ab-8929-a7a131600db2"
    property ButtonComponent slot2 = "0377f494-c577-4fb6-822e-6ba56bc312c0"
    property ButtonComponent slot3 = "cabd154d-7842-49b8-a562-f9858a2d6b4a"
    property ButtonComponent btnClose = "dfd6298d-ba0d-4ab2-9100-02f088866951"

    -- 슬롯에 실린 지역 id. 버튼을 누르면 여기서 꺼내 서버에 보낸다.
    @HideFromInspector property string id0 = ""
    @HideFromInspector property string id1 = ""
    @HideFromInspector property string id2 = ""
    @HideFromInspector property string id3 = ""

    -- 붙인 클릭 핸들러. 엔티티와 핸들러를 **병렬 배열 두 개**로 들고 있는다 —
    -- `{ entity = e, handler = h }` 형태의 다중 키 테이블 생성자는 mlua 파서가
    -- 두번째 키에서 끊는다 (실측).
    property table handlerEntities = {}
    property table handlerIds = {}

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 닫힌 채로 시작한다. 루트 그룹은 열어 두고 자식 Enable로 여닫는다 —
        -- 그룹을 DefaultShow=false로 두면 안의 스크립트가 아예 안 돈다.
        self:Hide()
        log("[AreaSelect] OnBeginPlay — 닫힌 채로 시작")

        -- ConnectEvent는 Entity/Logic/Service에만 있다. 버튼 컴포넌트가 아니라
        -- 버튼이 붙은 **엔티티**에 연결해야 한다.
        self:Bind(self.slot0, 0)
        self:Bind(self.slot1, 1)
        self:Bind(self.slot2, 2)
        self:Bind(self.slot3, 3)

        if isvalid(self.btnClose) then
            -- 엔티티를 먼저 지역 변수로 뽑는다. 테이블 생성자 안에서 `a.b.c`처럼
            -- 두 단계 이상 체이닝하면 mlua 파서가 끊는다 (실측: LSP 구문 에러 7개).
            local closeEntity = self.btnClose.Entity
            local h = closeEntity:ConnectEvent(ButtonClickEvent, function()
                self:Hide()
            end)
            self:Remember(closeEntity, h)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 붙인 핸들러는 전부 뗀다. 남기면 맵을 다시 열 때 중복으로 붙는다.
        for i = 1, #self.handlerEntities do
            local ent = self.handlerEntities[i]
            if isvalid(ent) then
                ent:DisconnectEvent(ButtonClickEvent, self.handlerIds[i])
            end
        end
        self.handlerEntities = {}
        self.handlerIds = {}
    end

    @ExecSpace("ClientOnly")
    method void Remember(Entity ent, any id)
        -- 나중에 뗄 수 있게 (엔티티, 핸들러) 짝을 같은 인덱스에 넣어 둔다.
        table.insert(self.handlerEntities, ent)
        table.insert(self.handlerIds, id)
    end

    @ExecSpace("ClientOnly")
    method void Bind(ButtonComponent btn, integer index)
        -- 버튼 하나를 슬롯 번호에 묶는다. 클로저로 번호를 잡아 둔다 —
        -- 루프 변수를 그대로 쓰면 마지막 값이 네 버튼에 다 걸린다.
        if not isvalid(btn) then return end
        local captured = index
        local ent = btn.Entity
        local h = ent:ConnectEvent(ButtonClickEvent, function()
            self:Choose(captured)
        end)
        self:Remember(ent, h)
    end

    @ExecSpace("ClientOnly")
    method void Show(string idsJoined, string namesJoined)
        -- 서버가 준 목록으로 창을 연다. 슬롯 수보다 많으면 앞에서부터 채운다.
        local ids = self:Split(idsJoined)
        local names = self:Split(namesJoined)

        self.id0 = "" self.id1 = "" self.id2 = "" self.id3 = ""
        self:FillSlot(self.slot0, 0, ids, names)
        self:FillSlot(self.slot1, 1, ids, names)
        self:FillSlot(self.slot2, 2, ids, names)
        self:FillSlot(self.slot3, 3, ids, names)

        if isvalid(self.panel) then self.panel.Enable = true end
        log("[AreaSelect] 열림 — " .. tostring(#ids) .. "곳")
    end

    @ExecSpace("ClientOnly")
    method void FillSlot(ButtonComponent btn, integer index, table ids, table names)
        -- 목록에 있는 만큼만 버튼을 켠다. 남는 슬롯은 끈다.
        --
        -- Visible이 아니라 Enable로 끄는 이유: Visible=false는 클릭이 살아 있어서
        -- 안 보이는 버튼을 누를 수 있다 (ui-hierarchy 5).
        if not isvalid(btn) then return end

        local n = index + 1
        if n > #ids then
            btn.Entity.Enable = false
            return
        end

        btn.Entity.Enable = true
        local label = btn.Entity.TextGUIRendererComponent
        if isvalid(label) then label.Text = names[n] or ids[n] end

        if index == 0 then self.id0 = ids[n]
        elseif index == 1 then self.id1 = ids[n]
        elseif index == 2 then self.id2 = ids[n]
        elseif index == 3 then self.id3 = ids[n] end
    end

    @ExecSpace("ClientOnly")
    method void Choose(integer index)
        -- 고른 지역을 서버에 요청한다. 서버가 갈 수 있는지 **다시** 판정한다 —
        -- 여기서 보낸 값을 서버가 그대로 믿으면 목록에 없던 지역도 뚫린다.
        local areaId = ""
        if index == 0 then areaId = self.id0
        elseif index == 1 then areaId = self.id1
        elseif index == 2 then areaId = self.id2
        elseif index == 3 then areaId = self.id3 end

        if areaId == "" then return end

        local gate = self:FindGate()
        if gate == nil then
            log_warning("[AreaSelect] 마을 문을 못 찾았다 — 이동 요청을 보내지 못한다")
            return
        end

        log("[AreaSelect] 선택 → " .. areaId)
        self:Hide()
        gate:RequestGo(areaId)
    end

    @ExecSpace("ClientOnly")
    method any FindGate()
        -- 내가 서 있는 맵의 마을 문을 찾는다.
        --
        -- 경로를 코드에 박지 않는 이유: 마을 맵 이름이 바뀌면 조용히 깨진다.
        -- 창이 떠 있다는 건 내가 그 문에 닿았다는 뜻이라 CurrentMap이 곧 마을이다.
        local me = _UserService.LocalPlayer
        if not isvalid(me) then return nil end
        local map = me.CurrentMap
        if not isvalid(map) then return nil end

        local gateEntity = map:GetChildByName("Portal_E", false)
        if not isvalid(gateEntity) then return nil end
        return gateEntity:GetComponent("script.TownGate")
    end

    @ExecSpace("ClientOnly")
    method void Hide()
        -- 창을 닫는다. Enable로 끈다 (Visible은 클릭이 살아 있다).
        if isvalid(self.panel) then self.panel.Enable = false end
    end

    method table Split(string raw)
        -- "a|b|c" → 배열. GameData.SplitIds와 같은 규칙이다.
        local out = {}
        if raw == nil or raw == "" then return out end
        for token in string.gmatch(raw, "([^|]+)") do
            table.insert(out, token)
        end
        return out
    end

end
