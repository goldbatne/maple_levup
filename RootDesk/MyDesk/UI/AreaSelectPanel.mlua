@Logic
script AreaSelectPanel extends Logic

	property Entity panel = "3da012e3-68a0-4de7-85d6-03dbe0df862e"

	property ButtonComponent btnClose = "dfd6298d-ba0d-4ab2-9100-02f088866951"

	property Entity listRoot = "665a3d7b-4b92-4f43-bcd8-91c1e56f8597"

	property integer slotCount = 20

	property integer megaCardCount = 5

	property table slotIds = {}

	property table slotNames = {}

	property table handlerEntities = {}

	property table handlerIds = {}

	property string selectedAreaId = ""

	property string selectedAreaName = ""

	property string selectedMode = "NORMAL"

	property boolean startingRogueliteRun = false

	@HideFromInspector
	property Entity selectedAreaText = nil

	@HideFromInspector
	property Entity normalButton = nil

	@HideFromInspector
	property Entity monsterSkillButton = nil

	@HideFromInspector
	property Entity partySummaryText = nil

	@HideFromInspector
	property Entity roleHintText = nil

	@HideFromInspector
	property Entity readyButton = nil

	@HideFromInspector
	property Entity startButton = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		        self:Hide()
		        self.slotIds = {}
		        self.slotNames = {}
		        self:ResolveOptionUi()

		        for i = 1, self.megaCardCount do
		            local index = i
		            local slot = self:GetSlot(index)
		            if slot ~= nil then
		                local h = slot:ConnectEvent(ButtonClickEvent, function()
		                    self:ChooseArea(index)
		                end)
		                self:Remember(slot, h)
		            end
		        end

		        if isvalid(self.btnClose) then
		            local closeEntity = self.btnClose.Entity
		            local h = closeEntity:ConnectEvent(ButtonClickEvent, function() self:Hide() end)
		            self:Remember(closeEntity, h)
		        end
		        self:BindPath("/ui/AreaSelect/Window/Box/OptionsPanel/NormalButton", function()
		            self:SelectMode("NORMAL")
		        end)
		        self:BindPath("/ui/AreaSelect/Window/Box/OptionsPanel/MonsterSkillButton", function()
		            self:SelectMode("MONSTER_SKILL")
		        end)
		        self:BindPath("/ui/AreaSelect/Window/Box/OptionsPanel/ReadyButton", function()
		            self:TogglePartyReady()
		        end)
		        self:BindPath("/ui/AreaSelect/Window/Box/OptionsPanel/StartButton", function()
		            self:StartSelectedRun()
		        end)


		        log("[AreaSelect] Mega Area 5장 + Run 옵션 분리 UI 준비")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		        for i = 1, #self.handlerEntities do
		            local ent = self.handlerEntities[i]
		            if isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.handlerIds[i]) end
		        end
		        self.handlerEntities = {}
		        self.handlerIds = {}
	end

	@ExecSpace("ClientOnly")
	method void Remember(Entity ent, any id)
		        table.insert(self.handlerEntities, ent)
		        table.insert(self.handlerIds, id)
	end

	@ExecSpace("ClientOnly")
	method void BindPath(string path, any fn)
		        local ent = _EntityService:GetEntityByPath(path)
		        if not isvalid(ent) then
		            log_warning("[AreaSelect] UI 경로 누락 " .. path)
		            return
		        end
		        local h = ent:ConnectEvent(ButtonClickEvent, fn)
		        self:Remember(ent, h)
	end

	@ExecSpace("ClientOnly")
	method void ResolveOptionUi()
		        self.selectedAreaText = _EntityService:GetEntityByPath(
		            "/ui/AreaSelect/Window/Box/OptionsPanel/SelectedAreaText")
		        self.normalButton = _EntityService:GetEntityByPath(
		            "/ui/AreaSelect/Window/Box/OptionsPanel/NormalButton")
		        self.monsterSkillButton = _EntityService:GetEntityByPath(
		            "/ui/AreaSelect/Window/Box/OptionsPanel/MonsterSkillButton")
		        self.partySummaryText = _EntityService:GetEntityByPath(
		            "/ui/AreaSelect/Window/Box/OptionsPanel/PartySummaryText")
		        self.roleHintText = _EntityService:GetEntityByPath(
		            "/ui/AreaSelect/Window/Box/OptionsPanel/RoleHintText")
		        self.readyButton = _EntityService:GetEntityByPath(
		            "/ui/AreaSelect/Window/Box/OptionsPanel/ReadyButton")
		        self.startButton = _EntityService:GetEntityByPath(
		            "/ui/AreaSelect/Window/Box/OptionsPanel/StartButton")
	end

	@ExecSpace("ClientOnly")
	method any GetSlot(integer index)
		        if not isvalid(self.listRoot) then return nil end
		        return self.listRoot:GetChildByName("Slot" .. tostring(index), false)
	end

	@ExecSpace("ClientOnly")
	method void Show(string idsJoined, string namesJoined)
		        local ids = self:Split(idsJoined)
		        local names = self:Split(namesJoined)
		        self.slotIds = {}
		        self.slotNames = {}
		        for i = 1, self.slotCount do self:FillSlot(i, ids, names) end

		        if self.selectedAreaId == "" and #ids > 0 then
		            self.selectedAreaId = ids[1]
		            self.selectedAreaName = names[1] or ids[1]
		        end
		        if _GameData.RoguePartyViewId ~= "" then
		            self.selectedAreaId = _GameData.RoguePartyViewAreaId
		            self.selectedMode = _GameData.RoguePartyViewMode
		            self:ResolveSelectedAreaName()
		        end

		        if isvalid(self.panel) then self.panel.Enable = true end
		        self:ResetScroll()
		        self:RefreshOptions()
		        _GameData:RequestRoguePartyView()
		        log("[AreaSelect] 열림 — Mega Area " .. tostring(math.min(#ids, self.megaCardCount)) .. "곳")
	end

	@ExecSpace("ClientOnly")
	method void FillSlot(integer index, table ids, table names)
		        local slot = self:GetSlot(index)
		        if slot == nil then return end
		        if index > self.megaCardCount or index > #ids then
		            slot.Enable = false
		            return
		        end
		        slot.Enable = true
		        self.slotIds[index] = ids[index]
		        self.slotNames[index] = names[index] or ids[index]
		        self:PaintAreaSlot(index)
	end

	@ExecSpace("ClientOnly")
	method void PaintAreaSlot(integer index)
		        local slot = self:GetSlot(index)
		        if slot == nil then return end
		        local active = self.slotIds[index] == self.selectedAreaId
		        if isvalid(slot.TextGUIRendererComponent) then
		            local prefix = active and "▶  " or "    "
		            slot.TextGUIRendererComponent.Text = prefix .. (self.slotNames[index] or self.slotIds[index] or "")
		        end
		        if isvalid(slot.SpriteGUIRendererComponent) then
		            slot.SpriteGUIRendererComponent.Color = active
		                and Color(0.72, 0.83, 0.95, 1) or Color(0.91, 0.90, 0.88, 1)
		        end
	end

	@ExecSpace("ClientOnly")
	method void ResolveSelectedAreaName()
		        for i = 1, self.megaCardCount do
		            if self.slotIds[i] == self.selectedAreaId then
		                self.selectedAreaName = self.slotNames[i]
		                return
		            end
		        end
		        self.selectedAreaName = self.selectedAreaId
	end

	@ExecSpace("ClientOnly")
	method void ResetScroll()
		        if not isvalid(self.listRoot) then return end
		        local list = self.listRoot.ScrollLayoutGroupComponent
		        if isvalid(list) then list:SetScrollNormalizedPosition(UITransformAxis.Vertical, 0) end
	end

	@ExecSpace("ClientOnly")
	method void ChooseArea(integer index)
		        local areaId = self.slotIds[index]
		        if areaId == nil or areaId == "" then return end
		        if _GameData.RoguePartyViewId ~= "" and _GameData:IsLocalRoguePartyLeader() == false then
		            _GateNotice:ShowNotice("파티 RUN", "Area 선택은 파티장이 변경합니다.")
		            return
		        end
		        self.selectedAreaId = areaId
		        self.selectedAreaName = self.slotNames[index] or areaId
		        if _GameData.RoguePartyViewId ~= "" then _GameData:RequestSetRoguePartyArea(areaId) end
		        self:RefreshOptions()
	end

	@ExecSpace("ClientOnly")
	method void SelectMode(string mode)
		        if mode ~= "MONSTER_SKILL" then mode = "NORMAL" end
		        if _GameData.RoguePartyViewId ~= "" and _GameData:IsLocalRoguePartyLeader() == false then
		            _GateNotice:ShowNotice("파티 RUN", "전투 모드는 파티장이 변경합니다.")
		            return
		        end
		        self.selectedMode = mode
		        if _GameData.RoguePartyViewId ~= "" then _GameData:RequestSetRoguePartyMode(mode) end
		        self:RefreshOptions()
	end

	@ExecSpace("ClientOnly")
	method void TogglePartyReady()
		        if _GameData.RoguePartyViewId == "" then return end
		        _GameData:RequestSetRoguePartyReady(not _GameData:GetLocalRoguePartyReady())
	end

	@ExecSpace("ClientOnly")
	method void StartSelectedRun()
		        if self.selectedAreaId == "" then return end
		        if _GameData.RoguePartyViewId == "" then
		            self.startingRogueliteRun = true
		            log("[AreaSelect] SOLO 시작 area=" .. self.selectedAreaId .. " mode=" .. self.selectedMode)
		            _GameData:RequestStartRogueliteArea(self.selectedAreaId, "", 0, self.selectedMode)
		            self:Hide()
		            return
		        end
		        if _GameData:IsLocalRoguePartyLeader() == false then
		            _GateNotice:ShowNotice("파티 RUN", "파티장이 RUN을 시작할 때까지 기다려 주세요.")
		            return
		        end
		        if _GameData:AreAllRoguePartyMembersReady() == false then
		            _GateNotice:ShowNotice("파티 RUN", "모든 파티원이 준비해야 합니다.")
		            return
		        end
		        self.startingRogueliteRun = true
		        log("[AreaSelect] PARTY 시작 요청 area=" .. self.selectedAreaId
		            .. " mode=" .. self.selectedMode .. " count=" .. tostring(_GameData.RoguePartyViewCount))
		        _GameData:RequestStartRoguePartyRun(0)
		        self:Hide()
	end

	@ExecSpace("ClientOnly")
	method void OnPartyViewUpdated()
		        if _GameData.RoguePartyViewId ~= "" then
		            self.selectedAreaId = _GameData.RoguePartyViewAreaId
		            self.selectedMode = _GameData.RoguePartyViewMode
		            self:ResolveSelectedAreaName()
		        end
		        self:RefreshOptions()
	end

	@ExecSpace("ClientOnly")
	method void RefreshOptions()
		        self:ResolveOptionUi()
		        for i = 1, self.megaCardCount do self:PaintAreaSlot(i) end
		        if isvalid(self.selectedAreaText) and isvalid(self.selectedAreaText.TextGUIRendererComponent) then
		            self.selectedAreaText.TextGUIRendererComponent.Text = "선택 Area  ·  " .. self.selectedAreaName
		        end

		        if isvalid(self.normalButton) and isvalid(self.normalButton.SpriteGUIRendererComponent) then
		            self.normalButton.SpriteGUIRendererComponent.Color = self.selectedMode == "NORMAL"
		                and Color(0.72, 0.84, 0.72, 1) or Color(0.88, 0.86, 0.82, 1)
		        end
		        if isvalid(self.monsterSkillButton) and isvalid(self.monsterSkillButton.SpriteGUIRendererComponent) then
		            self.monsterSkillButton.SpriteGUIRendererComponent.Color = self.selectedMode == "MONSTER_SKILL"
		                and Color(0.72, 0.83, 0.95, 1) or Color(0.88, 0.86, 0.82, 1)
		        end

		        local party = _GameData.RoguePartyViewId ~= ""
		        if isvalid(self.partySummaryText) and isvalid(self.partySummaryText.TextGUIRendererComponent) then
		            if party then
		                local readyLabel = _GameData:AreAllRoguePartyMembersReady() and " · 전원 준비" or " · 준비 대기"
		                self.partySummaryText.TextGUIRendererComponent.Text = "파티  ·  PARTY "
		                    .. tostring(_GameData.RoguePartyViewCount) .. "/4" .. readyLabel
		            else
		                self.partySummaryText.TextGUIRendererComponent.Text = "파티  ·  SOLO"
		            end
		        end

		        if isvalid(self.readyButton) then
		            self.readyButton.Enable = party
		            self.readyButton:SetVisible(party)
		            if party and isvalid(self.readyButton.TextGUIRendererComponent) then
		                self.readyButton.TextGUIRendererComponent.Text = _GameData:GetLocalRoguePartyReady()
		                    and "준비 해제" or "준비"
		            end
		        end

		        local canStart = true
		        local hint = "Solo는 별도 준비 없이 바로 시작합니다."
		        local startLabel = "RUN 시작"
		        if party then
		            local leader = _GameData:IsLocalRoguePartyLeader()
		            canStart = leader and _GameData:AreAllRoguePartyMembersReady()
		            if leader then
		                hint = "파티장 · Area/모드 선택 후 전원 준비 시 시작"
		                startLabel = canStart and "파티 RUN 시작" or "준비 대기"
		            else
		                hint = "파티원 · Area/모드는 읽기 전용, 준비만 선택"
		                startLabel = "파티장 대기"
		            end
		        end
		        if isvalid(self.roleHintText) and isvalid(self.roleHintText.TextGUIRendererComponent) then
		            self.roleHintText.TextGUIRendererComponent.Text = hint
		        end
		        if isvalid(self.startButton) then
		            if isvalid(self.startButton.TextGUIRendererComponent) then
		                self.startButton.TextGUIRendererComponent.Text = startLabel
		            end
		            if isvalid(self.startButton.ButtonComponent) then self.startButton.ButtonComponent.Enable = canStart end
		            if isvalid(self.startButton.SpriteGUIRendererComponent) then
		                self.startButton.SpriteGUIRendererComponent.Color = canStart
		                    and Color(0.72, 0.84, 0.72, 1) or Color(0.72, 0.72, 0.72, 1)
		            end
		        end
	end

	@ExecSpace("ClientOnly")
	method any FindGate()
		        local me = _UserService.LocalPlayer
		        if not isvalid(me) or not isvalid(me.CurrentMap) then return nil end
		        local gateEntity = me.CurrentMap:GetChildByName("Portal_E", false)
		        if not isvalid(gateEntity) then return nil end
		        return gateEntity:GetComponent("script.TownGate")
	end

	@ExecSpace("ClientOnly")
	method void Hide()
		        self.startingRogueliteRun = false
		        if isvalid(self.panel) then self.panel.Enable = false end
	end

	method table Split(string raw)
		        local out = {}
		        if raw == nil or raw == "" then return out end
		        for token in string.gmatch(raw, "([^|]+)") do table.insert(out, token) end
		        return out
	end

end
