@Logic
script GateNotice extends Logic

	property Entity banner = "d9ee8e50-183d-414d-8518-681bb0b7e2fb"

	property TextGUIRendererComponent titleText = "4d80359a-5d17-40ab-ac95-f99a45789880"

	property TextGUIRendererComponent reasonText = "ddfba646-e264-4bc9-80d5-1ec072692b8e"

	property number showSeconds = 2.5

	property any hideTimer = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		        -- 처음엔 숨긴다. 루트 그룹은 항상 표시여야 스크립트가 도는 대신,
		        -- 배너 자식을 껐다 켠다 (builder-protocol-ui §3.9 default_show 주의).
		        log("[GateNotice] OnBeginPlay")
		        self.banner:SetVisible(false)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		        -- 걸어둔 타이머는 반드시 해제한다.
		        self:ClearHideTimer()
	end

	@ExecSpace("ClientOnly")
	method void ClearHideTimer()
		        -- 돌고 있는 숨김 타이머를 정리한다.
		        if self.hideTimer ~= nil then
		            _TimerService:ClearTimer(self.hideTimer)
		            self.hideTimer = nil
		        end
	end

	@ExecSpace("Client")
	method void ShowGateBlocked(string roomId, string reason)
		        -- 포탈은 맵 전환 중 클라이언트에서 제거될 수 있다. 안내 RPC의 수신자는
		        -- 맵 엔티티가 아닌 이 세션 수명의 Logic이어야 한다.
		        log("[RoomGate] 통과 불가 (" .. roomId .. "): " .. reason)
		        self:Show(reason)
	end

	@ExecSpace("ClientOnly")
	method void Show(string reason)
		        -- 잠긴 문 사유. 제목은 항상 "잠겨 있다"다.
		        self:ShowNotice("잠겨 있다", reason)
	end

	@ExecSpace("ClientOnly")
	method void ShowNotice(string title, string message)
		        -- 제목 + 본문을 띄우고 잠시 뒤 스스로 사라진다.
		        --
		        -- 연달아 부르면 타이머를 다시 건다 — 먼저 걸린 타이머가 남아 있으면
		        -- 새로 띄운 배너를 예전 타이머가 지워버린다.
		        --
		        -- 서버에서 직접 부르지 않는다. 서버발 알림은 각자의 Client RPC를 거쳐
		        -- 클라에 도착한 뒤 여기를 부른다 (예: PlayerSkillSlots.OnSlotExpanded).
		        if message == nil or message == "" then return end
		
		        self.titleText.Text = title
		        self.reasonText.Text = message
		        self.banner:SetVisible(true)
		
		        self:ClearHideTimer()
		        self.hideTimer = _TimerService:SetTimerOnce(function()
		            self.banner:SetVisible(false)
		            self.hideTimer = nil
		        end, self.showSeconds)
	end

	@ExecSpace("ClientOnly")
	method void HideNotice()
		        self:ClearHideTimer()
		        if isvalid(self.banner) then self.banner:SetVisible(false) end
	end

end