@Logic
script EquipPanel extends Logic

	property Entity windowRoot = "fb2a4219-c785-4fa0-b5a7-d17a026e3e6e"

	property ButtonComponent btnOpen = "6d0ce3ae-bcc6-43d2-b059-8336dde0b286"

	property ButtonComponent btnClose = "7b4070ca-a338-4ba6-b233-19ba986ea884"

	property ButtonComponent slot1 = "109ed790-a0b5-4cb0-9222-c71224659efb"

	property ButtonComponent slot2 = "08c46b96-72e4-4c2c-a320-6005940c746f"

	property ButtonComponent slot3 = "409fe770-d1c2-4d95-a6ab-038468ae9f5d"

	property ButtonComponent slot4 = "4b882c17-27a4-4491-b657-9707b7c184a8"

	property ButtonComponent slot5 = "b78abcb6-04be-47f0-a5f7-63f911ee5efb"

	property Entity gridRoot = "c0d75b13-9346-440a-bb7e-2735a31b4779"

	property TextGUIRendererComponent lblDesc = "3bca6c15-07a1-4280-8c5e-01ea32fe6c65"

	property TextGUIRendererComponent lblOwned = "e37e5106-faea-4342-924b-6e130fcbad8e"

	property string currentSource = "monster"

	property any handlers = nil

	property any refreshTimer = nil

	property boolean isOpen = false

	property integer selectedSlot = 1

	property string selectedSkillId = ""

	property string selectedMonsterId = ""

	property boolean pickingMonsterSkill = false

	property boolean ticketSelectionMode = false

	property Entity ticketConfirm = nil

	property string ticketAwaitingMonsterId = ""

	property integer ticketPreviousLevel = 0

	property string ticketSummaryIconRuid = ""

	property string observedMonsterId = ""

	property integer observedLevel = 0

	property integer observedEnhance = 0

	property any rowSkillIds = nil

	property any rowMonsterIds = nil

	property any cellHandlers = nil

	property any monsterCellIconRuids = nil

	property integer cellCount = 101

	property number refreshInterval = 0.3

	property number iconBoxW = 50

	property number iconBoxH = 50

	property string appliedPilotVisualMode = ""

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		        -- 버튼을 연결하고 닫힌 상태로 시작한다.
		        log("[EquipPanel] OnBeginPlay")
		        self.handlers = {}
		        self.rowSkillIds = {}
		        self.rowMonsterIds = {}
		        self.monsterCellIconRuids = {}
		
		        self.handlers.open = self.btnOpen.Entity:ConnectEvent(ButtonClickEvent, function()
		            self:SetOpen(not self.isOpen)
		        end)
		        self.handlers.close = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, function()
		            self:SetOpen(false)
		        end)
		        self.ticketConfirm = self.windowRoot:GetChildByName("TicketConfirm", true)
		        if isvalid(self.ticketConfirm) then
		            self.ticketConfirm.Enable = false
		            self.ticketConfirm:SetVisible(false)
		            local dialog = self.ticketConfirm:GetChildByName("Dialog", false)
		            local cancel = dialog ~= nil and dialog:GetChildByName("Cancel", false) or nil
		            local confirm = dialog ~= nil and dialog:GetChildByName("Confirm", false) or nil
		            if isvalid(cancel) then
		                self.handlers.ticketCancel = cancel:ConnectEvent(ButtonClickEvent, function()
		                    self.ticketConfirm.Enable = false
		                    self.ticketConfirm:SetVisible(false)
		                end)
		            end
		            if isvalid(confirm) then
		                self.handlers.ticketConfirm = confirm:ConnectEvent(ButtonClickEvent, function()
		                    local collection = self:GetCollection()
		                    if collection ~= nil and self.ticketSelectionMode
		                        and self.selectedMonsterId ~= "" and collection.MonsterSelectionTickets > 0
		                        and self.ticketAwaitingMonsterId == ""
		                        and _GameData:IsTameableMonster(self.selectedMonsterId)
		                        and collection:GetTamedCount(self.selectedMonsterId) > 0
		                        and collection:GetMonsterLevel(self.selectedMonsterId)
		                            < math.max(1, math.floor(_GameData:GetBalance("monster_level_cap"))) then
		                        self.ticketAwaitingMonsterId = self.selectedMonsterId
		                        self.ticketPreviousLevel = collection:GetMonsterLevel(self.selectedMonsterId)
		                        _MonsterShop:RequestUseGrowthTicket(self.selectedMonsterId)
		                        local requestedId = self.selectedMonsterId
		                        _TimerService:SetTimerOnce(function()
		                            if self.ticketAwaitingMonsterId == requestedId then
		                                self.ticketAwaitingMonsterId = ""
		                                self:Refresh()
		                                _GateNotice:ShowNotice("사용 확인 필요",
		                                    "저장 상태를 확인한 뒤 다시 시도해 주세요.")
		                            end
		                        end, 8)
		                    end
		                    self.ticketConfirm.Enable = false
		                    self.ticketConfirm:SetVisible(false)
		                end)
		            end
		        end
		
		        -- 클로저로 번호를 잡아둔다. 버튼마다 다른 index를 넘겨야 한다.
		        self.handlers.s1 = self.slot1.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectSlot(1) end)
		        self.handlers.s2 = self.slot2.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectSlot(2) end)
		        self.handlers.s3 = self.slot3.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectSlot(3) end)
		        self.handlers.s4 = self.slot4.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectSlot(4) end)
		        self.handlers.s5 = self.slot5.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectSlot(5) end)
		
		        -- 격자 칸은 손으로 늘어놓지 않고 돈다. 번호는 지역 변수로 잡아
		        -- 클로저마다 다른 값을 갖게 한다 (안 잡으면 전부 마지막 값을 본다).
		        self.cellHandlers = {}
		        for i = 1, self.cellCount do
		            local index = i
		            local cell = self:GetCell(index)
		            if cell ~= nil then
		                self.cellHandlers[index] = cell:ConnectEvent(ButtonClickEvent, function()
		                    self:ClickRow(index)
		                end)
		            end
		        end
		
		        self:SetOpen(false)
		        self:RefreshModeVisibility()
		
		        self.refreshTimer = _TimerService:SetTimerRepeat(function()
		            self:RefreshModeVisibility()
		            if self.isOpen then
		                self:ApplyResponsiveScale()
		                self:Refresh()
		            end
		        end, self.refreshInterval)
	end

	@ExecSpace("ClientOnly")
	method void ApplyResponsiveScale()
		        if not isvalid(self.windowRoot) then return end
		        local width = _UILogic.ScreenWidth
		        local height = _UILogic.ScreenHeight
		        if width <= 0 or height <= 0 then return end
		        -- Keep the full collection and its bottom formation strip on narrow displays.
		        local designHeight = self:IsMonsterLobby() and 900 or 860
		        local scale = math.min(1, (width - 40) / 1360, (height - 36) / designHeight)
		        scale = math.max(0.25, scale)
		        self.windowRoot.UITransformComponent.UIScale = Vector3(scale, scale, 1)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		        -- 연결한 것은 전부 해제한다 (스크립트 리로드 시 누수 방지).
		        if self.handlers ~= nil then
		            if self.handlers.open ~= nil then self.btnOpen.Entity:DisconnectEvent(ButtonClickEvent, self.handlers.open) end
		            if self.handlers.close ~= nil then self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self.handlers.close) end
		            if isvalid(self.ticketConfirm) then
		                local dialog = self.ticketConfirm:GetChildByName("Dialog", false)
		                local cancel = dialog ~= nil and dialog:GetChildByName("Cancel", false) or nil
		                local confirm = dialog ~= nil and dialog:GetChildByName("Confirm", false) or nil
		                if isvalid(cancel) and self.handlers.ticketCancel ~= nil then
		                    cancel:DisconnectEvent(ButtonClickEvent, self.handlers.ticketCancel)
		                end
		                if isvalid(confirm) and self.handlers.ticketConfirm ~= nil then
		                    confirm:DisconnectEvent(ButtonClickEvent, self.handlers.ticketConfirm)
		                end
		            end
		            if self.handlers.s1 ~= nil then self.slot1.Entity:DisconnectEvent(ButtonClickEvent, self.handlers.s1) end
		            if self.handlers.s2 ~= nil then self.slot2.Entity:DisconnectEvent(ButtonClickEvent, self.handlers.s2) end
		            if self.handlers.s3 ~= nil then self.slot3.Entity:DisconnectEvent(ButtonClickEvent, self.handlers.s3) end
		            if self.handlers.s4 ~= nil then self.slot4.Entity:DisconnectEvent(ButtonClickEvent, self.handlers.s4) end
		            if self.handlers.s5 ~= nil then self.slot5.Entity:DisconnectEvent(ButtonClickEvent, self.handlers.s5) end
		            self.handlers = nil
		        end
		        if self.cellHandlers ~= nil then
		            for i = 1, self.cellCount do
		                local cell = self:GetCell(i)
		                if cell ~= nil and self.cellHandlers[i] ~= nil then
		                    cell:DisconnectEvent(ButtonClickEvent, self.cellHandlers[i])
		                end
		            end
		            self.cellHandlers = nil
		        end
		        if self.refreshTimer ~= nil then
		            _TimerService:ClearTimer(self.refreshTimer)
		            self.refreshTimer = nil
		        end
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		        if open and _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5 then
		            local slots = self:GetSlots()
		            if slots == nil or (not slots.RogueliteRunActive and not self:IsMonsterLobby()) then return end
		        end
		        if open and self:IsMonsterLobby() then
		            _AreaSelectPanel:Hide()
		            _GameData:SetPartyWindowOpen(false)
		            _MonsterShopUi:SetShopOpen(false)
		        end
		        -- 마을에서는 창이 열려도 메뉴 버튼을 유지한다. Run 스킬창은 기존 규칙을 따른다.
		        self.isOpen = open
		        -- Visible만 끄면 투명 Mask/입력 차단이 남는다. 창의 전체 트리를 비활성화한다.
		        self.windowRoot.Enable = open
		        self.windowRoot:SetVisible(open)
		        -- 컬렉션 창은 원래 중앙 위치를 유지한다.
		        self.windowRoot.UITransformComponent.anchoredPosition = Vector2(0, 0)
		        local dim = _EntityService:GetEntityByPath("/ui/EquipWindow/WindowDim")
		        if isvalid(dim) then dim.Enable = open; dim:SetVisible(open) end
		        if isvalid(self.ticketConfirm) then
		            self.ticketConfirm.Enable = false
		            self.ticketConfirm:SetVisible(false)
		        end
		        local showOpenButton = not open or self:IsMonsterLobby()
		        self.btnOpen.Entity.Enable = showOpenButton
		        self.btnOpen.Entity:SetVisible(showOpenButton)
		        if open then
		            -- 지난번에 스크롤해 둔 위치가 남아 있으면 빈 아래쪽이 보인다 (ScrollToTop 주석).
		            self:ScrollToTop()
		            self:Refresh()
		            local slots = self:GetSlots()
		            local owned = slots ~= nil and #slots:GetRunOwnedSkillIds() or 0
		            log("[RunSkillWindow] open owned=" .. tostring(owned))
		        else
		            -- 닫힌 창의 선택 상태도 지운다. Window 전체를 Disable하므로 투명 입력 차단도 남지 않는다.
		            self.selectedSkillId = ""
		            self.selectedMonsterId = ""
		            self.pickingMonsterSkill = false
		            self.ticketSelectionMode = false
		            self.ticketAwaitingMonsterId = ""
		            log("[RunSkillWindow] close input released")
		        end
	end

	@ExecSpace("ClientOnly")
	method void OpenGrowthTicketSelection()
		        if self:IsMonsterLobby() == false then return end
		        local collection = self:GetCollection()
		        if collection == nil or collection.MonsterSelectionTickets < 1 then return end
		        self:SetOpen(true)
		        self.ticketSelectionMode = true
		        -- 성장권은 탐험에서 이미 해금한 몬스터의 레벨만 올린다.
		        self.selectedMonsterId = ""
		        self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		        if event.key ~= KeyboardKey.Escape or not self.isOpen then return end
		        if isvalid(self.ticketConfirm) and self.ticketConfirm.Enable then
		            self.ticketConfirm.Enable = false
		            self.ticketConfirm:SetVisible(false)
		            return
		        end
		        self:SetOpen(false)
	end

	@ExecSpace("ClientOnly")
	method void RefreshModeVisibility()
		        if _GameData:GetBalance("roguelite_run_mode_enabled") >= 0.5 then
		            local slots = self:GetSlots()
		            if slots == nil or (not slots.RogueliteRunActive and not self:IsMonsterLobby()) then
		                if self.isOpen then self:SetOpen(false) end
		                self.btnOpen.Entity.Enable = false
		                self.btnOpen.Entity:SetVisible(false)
		                return
		            end
		            local areaPanel = _EntityService:GetEntityByPath("/ui/AreaSelect/Window")
		            local blockedByModal = _MonsterShopUi.ShopOpen or _GameData.RoguePartyWindowOpen
		                or (isvalid(areaPanel) and areaPanel.Enable)
		            if blockedByModal and not self.isOpen and not self:IsMonsterLobby() then
		                self.btnOpen.Entity.Enable = false
		                self.btnOpen.Entity:SetVisible(false)
		                return
		            end
		            local lobby = self:IsMonsterLobby()
		            if isvalid(self.btnOpen.Entity.TextGUIRendererComponent) then
		                self.btnOpen.Entity.TextGUIRendererComponent.Text = lobby and "몬스터" or "스킬"
		                self.btnOpen.Entity.TextGUIRendererComponent.FontColor = lobby
		                    and Color(0.19, 0.24, 0.28, 1) or Color(1, 1, 1, 1)
		            end
		            if isvalid(self.btnOpen.Entity.SpriteGUIRendererComponent) then
		                self.btnOpen.Entity.SpriteGUIRendererComponent.Color = lobby
		                    and Color(0.98, 0.99, 0.99, 1) or Color(0.20, 0.25, 0.29, 1)
		                self.btnOpen.Entity.SpriteGUIRendererComponent.OutlineColor = lobby
		                    and Color(0.77, 0.82, 0.85, 1) or Color(0.53, 0.58, 0.61, 1)
		                self.btnOpen.Entity.SpriteGUIRendererComponent.OutlineWidth = 1
		            end
		            for _, edgeName in ipairs({"MasterUpperEdge", "MasterLowerEdge"}) do
		                local edge = self.btnOpen.Entity:GetChildByName(edgeName, false)
		                if isvalid(edge) then
		                    edge.Enable = lobby
		                    edge:SetVisible(lobby)
		                end
		            end
		            local openTransform = self.btnOpen.Entity.UITransformComponent
		            if isvalid(openTransform) then
		                if lobby then
		                    openTransform.anchoredPosition = Vector2(-142, -146)
		                    openTransform.RectSize = Vector2(114, 50)
		                else
		                    openTransform.anchoredPosition = Vector2(-276, -146)
		                    openTransform.RectSize = Vector2(120, 50)
		                end
		            end
		        end
		        -- 로그라이트에서도 이번 Run 보유 능력을 확인할 수 있어야 한다. 창이 닫혀 있을 때만
		        -- 열기 버튼을 복구하며, 열린 창을 주기적으로 닫거나 전투 입력을 전역 차단하지 않는다.
		        if self.isOpen then return end
		        self.btnOpen.Entity.Enable = true
		        self.btnOpen.Entity:SetVisible(true)
	end

	@ExecSpace("ClientOnly")
	method any GetSlots()
		        -- 내 플레이어의 슬롯 컴포넌트. 아직 없으면 nil.
		        local me = _UserService.LocalPlayer
		        if not isvalid(me) then return nil end
		        return me:GetComponent("script.PlayerSkillSlots")
	end

	@ExecSpace("ClientOnly")
	method any GetCollection()
		        -- 내 플레이어의 컬렉션 컴포넌트. 아직 없으면 nil.
		        local me = _UserService.LocalPlayer
		        if not isvalid(me) then return nil end
		        return me:GetComponent("script.PlayerCollection")
	end

	@ExecSpace("ClientOnly")
	method boolean IsMonsterLobby()
		        if _GameData:GetBalance("roguelite_run_mode_enabled") < 0.5 then return false end
		        local me = _UserService.LocalPlayer
		        return isvalid(me) and isvalid(me.CurrentMap) and me.CurrentMap.Name == "maptown"
	end

	@ExecSpace("ClientOnly")
	method any GetSlotButton(integer index)
		        -- 프로퍼티를 배열처럼 쓰기 위한 창구. 5개뿐이라 분기로 충분하다.
		        if index == 1 then return self.slot1 end
		        if index == 2 then return self.slot2 end
		        if index == 3 then return self.slot3 end
		        if index == 4 then return self.slot4 end
		        if index == 5 then return self.slot5 end
		        return nil
	end

	@ExecSpace("ClientOnly")
	method any GetCell(integer index)
		        -- 격자의 index번 칸 엔티티. 없으면 nil.
		        --
		        -- .ui에 20칸을 미리 만들어 두고 스크립트가 켜고 끈다. 가상화(GridView)를
		        -- 안 쓰는 이유: 칸이 재사용되면 스크롤할 때마다 클릭 핸들러를 다시 걸어야 해서
		        -- 새기 쉽다. 스킬은 많아야 수십 개라 실제 엔티티로 두는 편이 싸고 안전하다.
		        if not isvalid(self.gridRoot) then return nil end
		        return self.gridRoot:GetChildByName("Cell" .. tostring(index), false)
	end

	@ExecSpace("ClientOnly")
	method void SelectSlot(integer index)
		        local slots = self:GetSlots()
		        if self:IsMonsterLobby() then
		            local collection = self:GetCollection()
		            if collection == nil or self.selectedMonsterId == "" then return end
		            if self.ticketSelectionMode then
		                if index == 4 and collection.MonsterSelectionTickets > 0 then
		                    local current = collection:GetMonsterLevel(self.selectedMonsterId)
		                    if collection:GetTamedCount(self.selectedMonsterId) <= 0 or current <= 0 then
		                        _GateNotice:ShowNotice("선택 불가", "미보유 몬스터는 탐험에서 해금해 주세요.")
		                        return
		                    end
		                    local cap = math.max(1, math.floor(_GameData:GetBalance("monster_level_cap")))
		                    if current >= cap then
		                        _GateNotice:ShowNotice("선택 불가", "이미 최대 레벨인 몬스터입니다.")
		                        return
		                    end
		                    if self.ticketAwaitingMonsterId ~= "" then return end
		                    if isvalid(self.ticketConfirm) then
		                        local dialog = self.ticketConfirm:GetChildByName("Dialog", false)
		                        local body = dialog ~= nil and dialog:GetChildByName("Body", false) or nil
		                        local monster = _GameData:GetMonster(self.selectedMonsterId)
		                        if isvalid(body) and isvalid(body.TextGUIRendererComponent) then
		                            body.TextGUIRendererComponent.Text =
		                                (monster ~= nil and monster.name or self.selectedMonsterId)
		                                .. ("\n성장권 1개를 사용하면 Lv." .. tostring(current)
		                                    .. "에서 Lv." .. tostring(current + 1) .. "로 올라갑니다.")
		                        end
		                        self.ticketConfirm.Enable = true
		                        self.ticketConfirm:SetVisible(true)
		                    end
		                end
		                self:Refresh()
		                return
		            end
		            if collection:GetTamedCount(self.selectedMonsterId) <= 0 then return end
		            if index >= 1 and index <= 3 then
		                local current = collection:GetEquippedCompanion(index)
		                if current ~= self.selectedMonsterId then
		                    for other = 1, 3 do
		                        if other ~= index
		                            and collection:GetEquippedCompanion(other) == self.selectedMonsterId then
		                            _GateNotice:ShowNotice("몬스터 편성", "같은 몬스터를 중복 편성할 수 없습니다.")
		                            return
		                        end
		                    end
		                end
		                collection:RequestEquipCompanion(index,
		                    current == self.selectedMonsterId and "" or self.selectedMonsterId)
		            elseif index == 4 then
		                local cost = collection:GetMonsterEnhanceCost(self.selectedMonsterId)
		                if collection.MonsterGrowthCurrency < cost then
		                    _GateNotice:ShowNotice("성장 점수 부족", "강화에 " .. tostring(cost)
		                        .. "점이 필요합니다. 현재 " .. tostring(collection.MonsterGrowthCurrency) .. "점이 있습니다.")
		                    return
		                end
		                collection:RequestEnhanceMonster(self.selectedMonsterId)
		            elseif index == 5 then
		                local cost = collection:GetMonsterCoreLevelCost(self.selectedMonsterId)
		                if collection.MonsterGrowthCore < cost then
		                    _GateNotice:ShowNotice("성장 코어 부족", "레벨업에 " .. tostring(cost)
		                        .. "개가 필요합니다. 현재 " .. tostring(collection.MonsterGrowthCore) .. "개가 있습니다.")
		                    return
		                end
		                collection:RequestSpendGrowthCore(self.selectedMonsterId)
		            end
		            self:Refresh()
		            return
		        end
		        if slots ~= nil and slots:IsRogueliteRunMode() then
		            return
		        end
		        if slots ~= nil and slots:IsPhase1CombatEnabled() then
		            if index ~= 1 then return end
		            local collection = self:GetCollection()
		            if collection == nil or self.selectedMonsterId == "" then
		                _GateNotice:ShowNotice("동행 몬스터", "컬렉션에서 테이밍한 몬스터를 먼저 선택해 주세요.")
		                return
		            end
		            if collection:GetTamedCount(self.selectedMonsterId) <= 0 then
		                _GateNotice:ShowNotice("동행할 수 없음", "아직 테이밍하지 않은 몬스터입니다.")
		                return
		            end
		            if collection.SelectedCompanionMonsterId == self.selectedMonsterId then
		                collection:RequestSetCompanion("")
		            else
		                collection:RequestSetCompanion(self.selectedMonsterId)
		            end
		            return
		        end
		        -- 잠긴 슬롯은 고를 수 없다. 서버도 같은 판정을 하지만
		        -- 여기서 막아야 "눌렀는데 아무 일도 안 난다"가 되지 않는다.
		        if slots == nil then return end
		        if index > slots.MonsterSlotCount then
		            log("[EquipPanel] " .. tostring(index) .. "번 슬롯은 아직 잠겨 있다")
		            return
		        end
		        self.selectedSlot = index
		        self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void SelectSource(string source)
		        -- T56 이후 플레이어가 보는 것은 포획한 몬스터 스킬뿐이다.
		        if source ~= "monster" then return end
		        --
		        -- 고른 스킬은 지운다. 안 지우면 안 보이는 탭의 스킬이 선택된 채로 남아,
		        -- 다른 탭에서 아무 줄이나 두 번 누르면 **엉뚱한 스킬이 끼워진다**
		        -- (두 번째 클릭이 "같은 줄인가"를 skillId로 판단하기 때문).
		        if self.currentSource == source then return end
		        self.currentSource = source
		        self.selectedSkillId = ""
		        self:ScrollToTop()
		        self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void ScrollToTop()
		        -- 격자를 맨 위로 되돌린다 (T20-3).
		        --
		        -- ⚠ 이게 없으면 **탭을 바꿨을 때 빈 화면이 뜬다** (실측). 아래까지 스크롤한
		        --   상태에서 항목이 적은 탭으로 옮기면 짧아진 목록의 빈 아래쪽을 계속 보게 된다.
		        --   창을 열 때도 되돌린다 — 지난번에 보던 위치가 남아 있으면 같은 일이 난다.
		        --
		        -- 이 그리드의 VerticalScrollBarDirection=BottomToTop(2)에서는
		        -- 0이 첫 행/스크롤바 상단, 1이 마지막 행/스크롤바 하단이다.
		        if not isvalid(self.gridRoot) then return end
		        local grid = self.gridRoot.ScrollLayoutGroupComponent
		        if not isvalid(grid) then return end
		        grid:SetScrollNormalizedPosition(UITransformAxis.Vertical, 0)
	end

	@ExecSpace("ClientOnly")
	method string SourceLabel(string source)
		        -- 화면에 보일 출처 이름. 데이터 값(monster/npc)을 그대로 쓰지 않는다 —
		        -- "npc"는 플레이어가 모르는 말이다.
		        if source == "monster" then return "몬스터" end
		        return source
	end

	@ExecSpace("ClientOnly")
	method table OwnedIdsOf(string source)
		        -- 그 출처에서 **보유한** 스킬 id 목록.
		        --
		        -- OwnedSkills(SyncTable)를 직접 순회하지 않고 후보를 훑는 이유는
		        -- GameData.GetMonsterSkillIds 주석 참고 (순서 안정성 + 확인된 API만 사용).
		        local out = {}
		        ---@type PlayerCollection
		        local collection = self:GetCollection()
		        if collection == nil then return out end
		        local runtimeSlots = self:GetSlots()
		        local hideLegacyPassive = runtimeSlots ~= nil and runtimeSlots:IsPhase1CombatEnabled()
		
		        local candidates = _GameData:GetMonsterSkillIds()
		        for i = 1, #candidates do
		            local id = candidates[i]
		            local skill = _GameData:GetSkill(id)
		            if skill ~= nil and skill.source == source and collection:GetOwnedCount(id) > 0
		                and (hideLegacyPassive == false or skill.skill_kind ~= "passive") then
		                out[#out + 1] = id
		            end
		        end
		        return out
	end

	@ExecSpace("ClientOnly")
	method void RenderTabs()
		        local slots = self:GetSlots()
		        local collection = self:GetCollection()
		        if self:IsMonsterLobby() then
		            local total = #_GameData:GetTameableMonsterIds()
		            local owned = 0
		            if collection ~= nil then
		                for _, monsterId in ipairs(_GameData:GetTameableMonsterIds()) do
		                    if collection:GetTamedCount(monsterId) > 0 then owned += 1 end
		                end
		            end
		            if isvalid(self.lblOwned) then
		                self.lblOwned.Text = self.pickingMonsterSkill
		                    and ("영구 스킬 컬렉션 · " .. tostring(#self.rowSkillIds) .. "종")
		                    or (self.ticketSelectionMode
		                        and ("보유 몬스터를 선택하세요 · 성장권 "
		                            .. tostring(collection.MonsterSelectionTickets))
		                        or ("몬스터 " .. tostring(owned) .. "/" .. tostring(total)
		                            .. " · 성장 점수 " .. tostring(collection.MonsterGrowthCurrency)
		                            .. " · 성장 코어 " .. tostring(collection.MonsterGrowthCore)))
		            end
		            return
		        end
		        if slots ~= nil and slots:IsRogueliteRunMode() then
		            local owned = #slots:GetRunOwnedSkillIds()
		            if isvalid(self.lblOwned) then
		                self.lblOwned.Text = "이번 Run 보유 능력  " .. tostring(owned) .. "종"
		            end
		            return
		        end
		        if slots ~= nil and slots:IsPhase1CombatEnabled() then
		            local total = #_GameData:GetTameableMonsterIds()
		            local owned = 0
		            if collection ~= nil then
		                for _, monsterId in ipairs(_GameData:GetTameableMonsterIds()) do
		                    if collection:GetTamedCount(monsterId) > 0 then owned += 1 end
		                end
		            end
		            if isvalid(self.lblOwned) then
		                self.lblOwned.Text = "몬스터 컬렉션  " .. tostring(owned) .. "/" .. tostring(total)
		            end
		            return
		        end
		
		        -- 레거시 비교 모드의 스킬 컬렉션 표시.
		        local monsterCount = #self:OwnedIdsOf("monster")
		        self.currentSource = "monster"
		        if isvalid(self.lblOwned) then
		            self.lblOwned.Text = "보유한 몬스터 스킬  " .. tostring(monsterCount)
		        end
	end

	@ExecSpace("ClientOnly")
	method void PaintTab(ButtonComponent tab, string label, integer count, boolean active)
		        -- 탭 한 칸을 그린다. 고른 쪽만 밝고, 나머지는 창 배경과 비슷하게 가라앉는다.
		        if not isvalid(tab) then return end
		
		        local text = tab.Entity.TextGUIRendererComponent
		        if isvalid(text) then
		            text.Text = label .. "  " .. tostring(count)
		        end
		
		        local sprite = tab.Entity.SpriteGUIRendererComponent
		        if isvalid(sprite) then
		            -- 창이 밝아지면서(T24-10) 색도 같이 뒤집혔다. 어두운 값을 그대로 두면
		            -- 밝은 판 위에 검은 탭이 남는다 — **런타임에 칠하는 색은 `.ui`를
		            -- 고쳐도 안 따라온다.**
		            if active then
		                sprite.Color = Color(0.72, 0.83, 0.95, 1)
		            else
		                sprite.Color = Color(0.88, 0.87, 0.85, 1)
		            end
		        end
	end

	@ExecSpace("ClientOnly")
	method void ClickRow(integer index)
		        -- 신규 전투에서는 설명 선택만 한다. 레거시 모드에서만 두 번째 클릭이 장착 요청이다.
		        local runtimeSlots = self:GetSlots()
		        if self:IsMonsterLobby() then
		            local monsterId = self.rowMonsterIds ~= nil and self.rowMonsterIds[index] or nil
		            if monsterId == nil then return end
		            if self.ticketSelectionMode then
		                local collection = self:GetCollection()
		                if collection == nil or _GameData:IsTameableMonster(monsterId) == false then return end
		                if collection:GetTamedCount(monsterId) <= 0 then
		                    _GateNotice:ShowNotice("선택 불가", "미보유 몬스터는 탐험에서 해금해 주세요.")
		                    return
		                end
		                if collection:GetMonsterLevel(monsterId)
		                    >= math.max(1, math.floor(_GameData:GetBalance("monster_level_cap"))) then
		                    _GateNotice:ShowNotice("선택 불가", "이미 최대 레벨인 몬스터입니다.")
		                    return
		                end
		            end
		            self.selectedMonsterId = monsterId
		            self:Refresh()
		            return
		        end
		        if runtimeSlots ~= nil and runtimeSlots:IsRogueliteRunMode() then
		            if self.rowSkillIds == nil then return end
		            local skillId = self.rowSkillIds[index]
		            if skillId == nil then return end
		            log("[RunSkillWindow] click index=" .. tostring(index) .. " skill=" .. tostring(skillId))
		            self.selectedSkillId = skillId
		            self.selectedMonsterId = ""
		            self:Refresh()
		            return
		        end
		        if runtimeSlots ~= nil and runtimeSlots:IsPhase1CombatEnabled() then
		            if self.rowMonsterIds == nil then return end
		            local monsterId = self.rowMonsterIds[index]
		            if monsterId == nil then return end
		            self.selectedMonsterId = monsterId
		            self:Refresh()
		            return
		        end
		
		        if self.rowSkillIds == nil then return end
		        local skillId = self.rowSkillIds[index]
		        if skillId == nil then return end
		
		        if self.selectedSkillId ~= skillId then
		            -- 다른 줄을 눌렀다 = 고르기만 한다. 여기서 장착하면 "확인하고 끼운다"가 사라진다.
		            self.selectedSkillId = skillId
		            local skill = _GameData:GetSkill(skillId)
		            log("[EquipPanel] 선택 " .. tostring(skillId)
		                .. (skill ~= nil and ("  \"" .. skill.description .. "\"") or ""))
		            self:Refresh()
		            return
		        end
		
		        ---@type PlayerSkillSlots
		        runtimeSlots = self:GetSlots()
		        if runtimeSlots ~= nil and runtimeSlots:IsPhase1CombatEnabled() then
		            local picked = _GameData:GetSkill(skillId)
		            _GateNotice:ShowNotice("보유 스킬",
		                "[" .. (picked ~= nil and picked.name or skillId)
		                .. "]은(는) 보유 중이다. 전투 재고에는 5초마다 자동으로 추첨된다.")
		            return
		        end
		
		        -- 패시브는 끼우는 것이 아니다 (2026-08-29). 같은 줄을 다시 눌러도 장착을
		        -- 요청하지 않고, **왜 안 끼워지는지**를 알려 준다 — 안 알려 주면 고장으로 읽힌다.
		        local picked = _GameData:GetSkill(skillId)
		        if picked ~= nil and picked.skill_kind == "passive" then
		            log("[EquipPanel] 패시브라 장착하지 않는다 " .. skillId)
		            _GateNotice:ShowNotice("끼우지 않는다",
		                "[" .. picked.name .. "]은(는) 패시브다. **가지고 있는 것만으로 항상 켜져 있다.**"
		                .. "  더 모을수록 세진다.")
		            return
		        end
		
		        ---@type PlayerSkillSlots
		        local slots = self:GetSlots()
		        if slots == nil then return end
		
		        -- 차수가 모자라면 요청하지 않는다 (T16-4a). 서버도 같은 판정을 하지만
		        -- 여기서 막아야 "눌렀는데 아무 일도 안 난다"가 되지 않는다 —
		        -- SelectSlot의 잠긴 슬롯 처리와 같은 어법이다.
		        if slots:CanUseTier(skillId) == false then
		            local skill = _GameData:GetSkill(skillId)
		            log("[EquipPanel] 차수 부족으로 장착 거절 " .. skillId)
		            local needLevel = slots:LevelForTier(math.floor(skill.tier))
		            _GateNotice:ShowNotice("아직 쓸 수 없다",
		                "[" .. skill.name .. "]은(는) " .. tostring(math.floor(skill.tier))
		                .. "차 스킬이다. 지금 내 차수는 " .. tostring(slots:GetTier()) .. "차다."
		                .. (needLevel > 0 and ("  Lv" .. tostring(needLevel) .. "에 전직하면 열린다.") or ""))
		            return
		        end
		
		        log("[EquipPanel] 장착 요청 슬롯 " .. tostring(self.selectedSlot) .. " = " .. skillId)
		        slots:RequestEquip(self.selectedSlot, skillId)
	end

	@ExecSpace("ClientOnly")
	method number GetMyStat(string statName)
		        -- 지금 내 스탯값 (장비 포함 — 전투가 쓰는 값과 같아야 한다).
		        --
		        -- 왜 UI가 이걸 읽는가 (대표 지시 2026-08-20): 데미지 공식이
		        -- `계수 x 스탯^2 / (스탯 + DEF)`라 **계수 스탯이 0이면 계수가 아무리 높아도
		        -- 피해가 0이다.** 뿔 들이받기(LUK 계수)를 LUK 0으로 끼우면 눌러도 아무 일도
		        -- 안 나는 것처럼 보이는데, 그 이유가 화면 어디에도 없었다.
		        --
		        -- GetTotalX는 실행공간이 비어 있어 클라에서도 부를 수 있다 (PlayerStats 주석 참고).
		        local me = _UserService.LocalPlayer
		        if me == nil then return 0 end
		        ---@type PlayerStats
		        local st = me:GetComponent("script.PlayerStats")
		        if st == nil then return 0 end
		        if statName == "ATK" then return st:GetTotalAtk() end
		        if statName == "INT" then return st:GetTotalInt() end
		        if statName == "DEF" then return st:GetTotalDef() end
		        if statName == "LUK" then return st:GetTotalLuk() end
		        return 0
	end

	@ExecSpace("ClientOnly")
	method integer OwnedCountOf(string skillId)
		        -- 그 스킬을 몇 장 갖고 있나. 패시브 설명이 "몇 장이라 얼마"를 적는 데 쓴다.
		        local me = _UserService.LocalPlayer
		        if me == nil then return 0 end
		        ---@type PlayerCollection
		        local col = me:GetComponent("script.PlayerCollection")
		        if col == nil then return 0 end
		        return col:GetOwnedCount(skillId)
	end

	@ExecSpace("ClientOnly")
	method number PassiveAmount(string skillId)
		        -- 이 패시브가 **지금** 주는 분배 스탯 포인트.
		        -- 계산을 여기서 다시 하지 않고 PlayerStats와 같은 식을 쓴다 — 두 곳에서
		        -- 따로 계산하면 화면과 실제가 언젠가 갈라진다.
		        local skill = _GameData:GetSkill(skillId)
		        if skill == nil or skill.skill_kind ~= "passive" then return 0 end
		        local count = self:OwnedCountOf(skillId)
		        if count <= 0 then return 0 end
		        local per = skill.passive_value
		        if per <= 0 then per = _GameData:GetBalance("collection_passive_first") end
		        return per + _GameData:GetBalance("collection_passive_extra") * (count - 1)
	end

	@ExecSpace("ClientOnly")
	method string KindLabel(table skill)
		        -- 화면에 보일 분류. 모르는 값은 그대로 — 데이터가 늘어나도 깨지지 않는다.
		        if skill.skill_kind == "attack" then
		            if skill.secondary_effect == "WEAKEN" then return "공격·약화" end
		            if skill.secondary_effect == "SLOW" or skill.secondary_effect == "STUN"
		                or skill.secondary_effect == "PULL" or skill.secondary_effect == "KNOCKBACK" then
		                return "공격·제어"
		            end
		            return "공격"
		        end
		        if skill.skill_kind == "defense" then return "방어" end
		        if skill.skill_kind == "buff" then return "강화" end
		        -- 패시브는 **끼우는 것이 아니라 가지고 있으면 켜지는 것**이다 (2026-08-29).
		        -- 그 사실이 태그에 드러나야 "왜 안 끼워지지"가 안 생긴다.
		        if skill.skill_kind == "passive" then return "패시브" end
		        return skill.skill_kind
	end

	@ExecSpace("ClientOnly")
	method void SetRunDetailIcons(table skill, table monster)
		        local skillIcon = self.windowRoot:GetChildByName("DetailSkillIcon", true)
		        local monsterIcon = self.windowRoot:GetChildByName("DetailMonsterIcon", true)
		        if isvalid(skillIcon) then
		            local visible = skill ~= nil and skill.icon_ruid ~= nil and skill.icon_ruid ~= ""
		            skillIcon.Enable = visible and not self:IsMonsterLobby()
		            skillIcon:SetVisible(visible and not self:IsMonsterLobby())
		            if visible and not self:IsMonsterLobby() then
		                skillIcon.SpriteGUIRendererComponent.ImageRUID = skill.icon_ruid
		                self:FitIcon(skillIcon.UITransformComponent, skill.icon_ratio or 1)
		            end
		        end
		        if isvalid(monsterIcon) then
		            local visible = monster ~= nil and monster.collection_icon_ruid ~= nil
		                and monster.collection_icon_ruid ~= ""
		            monsterIcon.Enable = visible
		            monsterIcon:SetVisible(visible)
		            if visible then
		                monsterIcon.SpriteGUIRendererComponent.ImageRUID = DataRef(
		                    "thumbnail://" .. monster.collection_icon_ruid)
		            end
		        end
	end

	@ExecSpace("ClientOnly")
	method void RenderRunSkillDesc()
		        if not isvalid(self.lblDesc) then return end
		        if self.selectedSkillId == "" then
		            self:SetRunDetailIcons(nil, nil)
		            if self.rowSkillIds ~= nil and #self.rowSkillIds <= 0 then
		                self.lblDesc.Text = "능력을 획득하면 상세 설명이 여기에 표시됩니다."
		            else
		                self.lblDesc.Text = "능력을 선택하면 실제 설명과 제공 몬스터를 확인할 수 있습니다."
		            end
		            return
		        end
		
		        local skill = _GameData:GetSkill(self.selectedSkillId)
		        if skill == nil then
		            self.selectedSkillId = ""
		            self:SetRunDetailIcons(nil, nil)
		            self.lblDesc.Text = "능력 정보를 불러오지 못했습니다."
		            return
		        end
		        local monsterId = _GameData:GetMonsterIdByDropSkillId(self.selectedSkillId)
		        local monster = monsterId ~= "" and _GameData:GetMonster(monsterId) or nil
		        self:SetRunDetailIcons(skill, monster)
		
		        local source = monster ~= nil and monster.name or "연결 몬스터 정보 없음"
		        local description = skill.description or ""
		        -- 844x475에서는 한 줄로 이어 붙인 설명이 작고 어두운 문자열로 뭉친다.
		        -- 제목/출처/유형/설명을 줄로 나눠 실제 기능을 읽을 수 있게 한다.
		        if string.len(description) > 84 then
		            description = string.sub(description, 1, 84) .. "..."
		        end
		        self.lblDesc.Text = skill.name
		            .. "\n몬스터: " .. source .. " · " .. self:KindLabel(skill)
		            .. "\n" .. description
	end

	@ExecSpace("ClientOnly")
	method void RenderMonsterDesc()
		        if not isvalid(self.lblDesc) then return end
		        if self.selectedMonsterId == "" then
		            self:SetLobbyHero("몬스터를 선택하세요", "")
		            self:SetCollectionPilotRows("", "")
		            self:SetRunDetailIcons(nil, nil)
		            self:SetV4SkillCard(nil, "고유 능력", self.ticketSelectionMode
		                and "보유 몬스터를 직접 선택해 주세요." or "몬스터를 수집하면 여기에서 확인합니다.")
		            self.lblDesc.Text = ""
		            return
		        end
		
		        local monster = _GameData:GetMonster(self.selectedMonsterId)
		        local collection = self:GetCollection()
		        if monster == nil or collection == nil then
		            self.selectedMonsterId = ""
		            self:SetCollectionPilotRows("", "")
		            self.lblDesc.Text = "몬스터 정보를 불러오지 못했습니다."
		            return
		        end
		
		        local slots = self:GetSlots()
		        if self:IsMonsterLobby() then
		            local count = collection:GetMonsterLevel(monster.id)
		            local kills = collection:GetTotalMonsterKills(monster.id)
		            local ownSkill = _GameData:GetSkill(monster.drop_skill_id)
		            self:SetRunDetailIcons(ownSkill, monster)
		            local kicker = self.windowRoot:GetChildByName("HeroKicker", false)
		            if isvalid(kicker) and isvalid(kicker.TextGUIRendererComponent) then
		                kicker.TextGUIRendererComponent.Text = "누적 처치 " .. tostring(kills)
		            end
		            if count <= 0 then
		                local activeSkill = ownSkill ~= nil and ownSkill.skill_kind ~= "passive"
		                self:SetLobbyHero(monster.name, "미획득")
		                self:SetCollectionPilotRows("미획득", activeSkill
		                    and ownSkill.name or "사용 가능한 액티브 능력 없음")
		                self:SetV4SkillCard(activeSkill and ownSkill or nil,
		                    activeSkill and ownSkill.name or "사용 가능한 액티브 능력 없음",
		                    "모험 중 테이밍 가능")
		                self.lblDesc.Text = "모험 중 테이밍 가능"
		                return
		            end
		            local maxStage = math.max(1, math.floor(_GameData:GetBalance("monster_level_cap")))
		            local enhance = collection:GetMonsterEnhance(monster.id)
		            local ownStats = collection:GetEffectiveCompanionStats(monster.id)
		            local skillGrowth = 1 + (count - 1) * _GameData:GetBalance("companion_growth_skill_per_stage")
		                + enhance * _GameData:GetBalance("monster_enhance_skill_per_stage")
		            local hasActive = ownSkill ~= nil and ownSkill.skill_kind ~= "passive"
		            local ownSkillName = hasActive and ownSkill.name or "사용 가능한 액티브 능력 없음"
		            local ownSkillDescription = hasActive and ownSkill.description or ""
		            local stageText = "Lv." .. tostring(count) .. " / "
		                .. tostring(maxStage) .. "     +" .. tostring(enhance)
		            local roleSlot = 0
		            for slot = 1, 3 do
		                if collection:GetEquippedCompanion(slot) == monster.id then
		                    roleSlot = slot
		                    break
		                end
		            end
		            stageText ..= roleSlot == 1 and " · 메인 편성"
		                or (roleSlot > 1 and " · 지원 편성" or " · 미편성")
		            if self.ticketSelectionMode then
		                stageText = count >= maxStage and "최대 레벨 · 선택 불가"
		                    or ("Lv." .. tostring(count) .. " → Lv." .. tostring(count + 1))
		            end
		            self:SetLobbyHero(monster.name, stageText)
		            local hpText = tostring(ownStats.maxHp)
		            local attackText = string.format("%.2f", ownStats.basicAttack)
		            local defenseText = string.format("%.2f", ownStats.defense)
		            if roleSlot == 1 then
		                local support = collection:GetCompanionSupportBonus()
		                -- 상세 패널의 HP/ATK/DEF를 한 줄에 놓으므로 역할 설명은 위의
		                -- "메인 편성" 표시에 맡기고 값은 기본 → 편성 합계로 압축한다.
		                hpText ..= " → " .. tostring(ownStats.maxHp + support.maxHp)
		                attackText ..= " → "
		                    .. string.format("%.2f", ownStats.basicAttack + support.basicAttack)
		                defenseText ..= " → "
		                    .. string.format("%.2f", ownStats.defense + support.defense)
		            elseif roleSlot > 1 then
		                local hpRate = math.max(0, _GameData:GetBalance("companion_support_hp_rate"))
		                local attackRate = math.max(0, _GameData:GetBalance("companion_support_attack_rate"))
		                local defenseRate = math.max(0, _GameData:GetBalance("companion_support_defense_rate"))
		                hpText ..= " (+" .. string.format("%.1f", ownStats.maxHp * hpRate) .. ")"
		                attackText ..= " (+"
		                    .. string.format("%.2f", ownStats.basicAttack * attackRate) .. ")"
		                defenseText ..= " (+"
		                    .. string.format("%.2f", ownStats.defense * defenseRate) .. ")"
		            end
		            self:SetCollectionPilotRows("HP " .. hpText .. "\n공격 " .. attackText
		                .. "\n방어 " .. defenseText,
		                ownSkillName .. "  ×" .. string.format("%.2f", skillGrowth))
		            local shortDescription = string.match(ownSkillDescription, "^[^\n%.!?]+")
		                or ownSkillDescription
		            self:SetV4SkillCard(hasActive and ownSkill or nil,
		                hasActive and (ownSkillName .. "  ×" .. string.format("%.2f", skillGrowth))
		                    or ownSkillName,
		                shortDescription ~= "" and shortDescription or "몬스터 수집·동행 가능")
		            self.lblDesc.Text = shortDescription
		            return
		        end
		        if slots ~= nil and slots:IsRogueliteRunMode() then
		            if collection.RogueDiscoveredMonsters[monster.id] == nil then
		                self.lblDesc.Text = "[미발견] " .. monster.name
		                    .. "   Run에서 만나 처치하면 발견 기록과 능력이 확인됩니다."
		                return
		            end
		            local runSkill = _GameData:GetSkill(monster.drop_skill_id)
		            if runSkill == nil or runSkill.skill_kind == "passive" then
		                self.lblDesc.Text = "[발견] " .. monster.name
		                    .. "   현재 Run에서 장착할 수 있는 액티브 능력 없음"
		                return
		            end
		            local cooldown = runSkill.cooldown
		            if cooldown <= 0 then cooldown = _GameData:GetBalance("run_skill_cooldown_fallback") end
		            self.lblDesc.Text = "[발견] " .. monster.name
		                .. "   획득 능력: " .. runSkill.name
		                .. "   " .. runSkill.description
		                .. "   재사용 " .. string.format("%.1f", cooldown) .. "초"
		            return
		        end
		
		        local count = collection:GetTamedCount(monster.id)
		        local kills = collection:GetTotalMonsterKills(monster.id)
		        if count <= 0 then
		            self.lblDesc.Text = "[미획득] " .. monster.name
		                .. "   누적 처치 " .. tostring(kills)
		                .. "   테이밍하면 컬렉션과 능력이 해금됩니다."
		            return
		        end
		
		        local skill = _GameData:GetSkill(monster.drop_skill_id)
		        local stars = "★" .. tostring(count)
		        if skill == nil or skill.skill_kind == "passive" then
		            self.lblDesc.Text = "[" .. stars .. "] " .. monster.name
		                .. "   사용 가능한 액티브 능력 없음"
		                .. "   누적 처치 " .. tostring(kills)
		            return
		        end
		
		        local multiplier = 1 + _GameData:GetBalance("skill_stack_bonus") * (count - 1)
		        self.lblDesc.Text = "[" .. stars .. "] " .. monster.name
		            .. "   고유 능력: " .. skill.name
		            .. "   " .. skill.description
		            .. "   강화 ×" .. string.format("%.1f", multiplier)
		            .. "   누적 처치 " .. tostring(kills)
	end

	@ExecSpace("ClientOnly")
	method void SetCollectionPilotRows(string stats, string ability)
		        local statRow = self.windowRoot:GetChildByName("DetailStats", false)
		        local abilityRow = self.windowRoot:GetChildByName("DetailAbility", false)
		        if isvalid(statRow) and isvalid(statRow.TextGUIRendererComponent) then
		            -- 실제 값은 정렬된 HP/ATK/DEF 칩에 표시한다. 뒤쪽 레거시 문구가 겹치지 않게 한다.
		            statRow.TextGUIRendererComponent.Text = ""
		        end
		        if isvalid(abilityRow) and isvalid(abilityRow.TextGUIRendererComponent) then
		            abilityRow.TextGUIRendererComponent.Text = ability
		        end
		        -- Keep the shared Run Skill text; V5 uses compact values in its place.
		        local hp = self.windowRoot:GetChildByName("V5HPValue", false)
		        local attack = self.windowRoot:GetChildByName("V5ATKValue", false)
		        local defense = self.windowRoot:GetChildByName("V5DEFValue", false)
		        if isvalid(hp) and isvalid(hp.TextGUIRendererComponent) then
		            hp.TextGUIRendererComponent.Text = string.match(stats, "HP ([^\n]+)") or "—"
		        end
		        if isvalid(attack) and isvalid(attack.TextGUIRendererComponent) then
		            attack.TextGUIRendererComponent.Text = string.match(stats, "공격 ([^\n]+)") or "—"
		        end
		        if isvalid(defense) and isvalid(defense.TextGUIRendererComponent) then
		            defense.TextGUIRendererComponent.Text = string.match(stats, "방어 ([^\n]+)") or "—"
		        end
	end

	@ExecSpace("ClientOnly")
	method void SetV4SkillCard(table skill, string name, string description)
		        local card = self.windowRoot:GetChildByName("V4SkillCard", false)
		        if not isvalid(card) then return end
		        local icon = card:GetChildByName("Icon", false)
		        local nameLabel = card:GetChildByName("Name", false)
		        local descLabel = card:GetChildByName("Desc", false)
		        if isvalid(nameLabel) and isvalid(nameLabel.TextGUIRendererComponent) then
		            nameLabel.TextGUIRendererComponent.Text = name
		        end
		        if isvalid(descLabel) and isvalid(descLabel.TextGUIRendererComponent) then
		            descLabel.TextGUIRendererComponent.Text = description
		        end
		        if isvalid(icon) then
		            local active = skill ~= nil and skill.skill_kind ~= "passive"
		                and skill.icon_ruid ~= nil and skill.icon_ruid ~= ""
		            icon.Enable = active
		            icon:SetVisible(active)
		            if active then
		                icon.SpriteGUIRendererComponent.ImageRUID = skill.icon_ruid
		            end
		        end
	end

	@ExecSpace("ClientOnly")
	method void SetLobbyHero(string name, string stage)
		        local heroName = self.windowRoot:GetChildByName("HeroName", true)
		        local heroStage = self.windowRoot:GetChildByName("HeroStage", true)
		        if isvalid(heroName) and isvalid(heroName.TextGUIRendererComponent) then
		            heroName.TextGUIRendererComponent.Text = name
		        end
		        if isvalid(heroStage) and isvalid(heroStage.TextGUIRendererComponent) then
		            heroStage.TextGUIRendererComponent.Text = stage
		        end
	end

	@ExecSpace("ClientOnly")
	method void RenderDesc()
		        -- 고른 스킬의 설명을 아래 줄에 그린다 (T17-4).
		        if not isvalid(self.lblDesc) then return end
		
		        local runtimeSlots = self:GetSlots()
		        local showHero = self:IsMonsterLobby() and not self.pickingMonsterSkill
		        for _, childName in ipairs({"HeroKicker", "HeroName", "HeroStage",
		            "DetailStats", "DetailAbility"}) do
		            local hero = self.windowRoot:GetChildByName(childName, true)
		            local visible = showHero and childName ~= "DetailAbility"
		                and childName ~= "DetailStats"
		            if isvalid(hero) then hero.Enable = visible; hero:SetVisible(visible) end
		        end
		        if self:IsMonsterLobby() then
		            if self.pickingMonsterSkill then self:RenderRunSkillDesc()
		            else self:RenderMonsterDesc() end
		            return
		        end
		        if runtimeSlots ~= nil and runtimeSlots:IsRogueliteRunMode() then
		            self:RenderRunSkillDesc()
		            return
		        end
		        if runtimeSlots ~= nil and runtimeSlots:IsPhase1CombatEnabled() then
		            self:RenderMonsterDesc()
		            return
		        end
		
		        if self.selectedSkillId == "" then
		            -- 빈 탭이면 줄이 하나도 안 보인다. 이유를 안 적으면 고장으로 읽힌다 (T20-2).
		            if self.rowSkillIds ~= nil and #self.rowSkillIds == 0 then
		                self.lblDesc.Text = self:SourceLabel(self.currentSource)
		                    .. " 스킬은 아직 하나도 없다. 다른 탭을 눌러 보라."
		                return
		            end
		            local slots = self:GetSlots()
		            if slots ~= nil and slots:IsPhase1CombatEnabled() then
		                self.lblDesc.Text = "보유 스킬을 누르면 설명이 나온다. 액티브는 전투 재고에 자동 추첨된다."
		            else
		                self.lblDesc.Text = "스킬을 누르면 설명이 나온다. 한 번 더 누르면 장착된다."
		            end
		            return
		        end
		
		        local skill = _GameData:GetSkill(self.selectedSkillId)
		        if skill == nil then
		            -- 표에서 사라진 스킬을 고른 상태로 남아 있을 수 있다 (몬스터 교체 등).
		            self.selectedSkillId = ""
		            self.lblDesc.Text = "스킬을 누르면 설명이 나온다."
		            return
		        end
		
		        -- 계수 스탯과 **지금 내 그 스탯값**을 적는다 (대표 지시 2026-08-20).
		        -- 공격 스킬만 — 방어 스킬은 계수가 0이라 스탯을 쓰지 않는다.
		        -- 0이면 경고를 붙인다: 그 상태로 끼우면 눌러도 피해가 안 나간다.
		        local statText = ""
		        if skill.skill_kind == "passive" then
		            -- 패시브는 계수 스탯이 아니라 **지금 몇 장이라 얼마를 주는지**를 적는다
		            -- (2026-08-29). 이게 안 보이면 중복을 모을 이유가 화면에 없다.
		            statText = "   " .. skill.passive_stat .. " +"
		                .. string.format("%.2f", self:PassiveAmount(self.selectedSkillId))
		                .. "  (" .. tostring(self:OwnedCountOf(self.selectedSkillId)) .. "장 · 항상 켜짐)"
		        elseif skill.skill_kind ~= "defense" and skill.skill_kind ~= "buff" then
		            local mine = self:GetMyStat(skill.scaling_stat)
		            statText = "   " .. skill.scaling_stat .. " " .. tostring(math.floor(mine))
		            if mine <= 0 then statText = statText .. " → 피해 없음" end
		        end
		
		        local extra = ""
		        if skill.skill_kind == "attack" then
		            -- 계수 1.20은 전투 공식에서 120% 피해로 쓰인다. 대상 수와 함께 한눈에
		            -- 보여 줘야 장착 전에 단일기/다수기를 구분할 수 있다.
		            local owned = self:OwnedCountOf(self.selectedSkillId)
		            local actualCoefficient = _CombatFormula:StackedCoefficient(skill.coefficient, owned)
		            extra = "   피해 " .. tostring(math.floor(actualCoefficient * 100 + 0.5)) .. "%"
		            if actualCoefficient ~= skill.coefficient then
		                extra = extra .. "(기본 " .. tostring(math.floor(skill.coefficient * 100 + 0.5)) .. "%)"
		            end
		            if skill.max_targets > 0 then
		                extra = extra .. "   최대 " .. tostring(math.floor(skill.max_targets)) .. "마리"
		            else
		                extra = extra .. "   범위 내 전체"
		            end
		            if skill.range > 0 then
		                extra = extra .. "   범위 " .. string.format("%.1f", skill.range)
		            end
		        elseif (skill.skill_kind == "defense" or skill.skill_kind == "buff")
		            and skill.effect_value > 0 then
		            extra = "   효과 " .. tostring(math.floor(skill.effect_value * 100 + 0.5)) .. "%"
		                .. "   지속 " .. string.format("%.0f", skill.duration) .. "초"
		        end
		        if skill.cooldown > 0 then
		            extra = extra .. "   쿨 " .. string.format("%.0f", skill.cooldown) .. "초"
		        end
		
		        -- 잠긴 스킬은 **무엇이 부족한지**를 설명 줄에 적는다 (T16-4a).
		        -- 목록의 `🔒 2차` 표시만으로는 "몇 번 더 환생해야 하나"가 안 나온다.
		        local lockText = ""
		        ---@type PlayerSkillSlots
		        local slots = self:GetSlots()
		        if slots ~= nil and slots:CanUseTier(self.selectedSkillId) == false then
		            -- 차수는 레벨로 오른다(2026-08-21). "환생 N회 더"가 아니라 **몇 레벨이 필요한지**를
		            -- 적어야 다음에 뭘 해야 하는지가 바로 읽힌다.
		            local needLevel = slots:LevelForTier(math.floor(skill.tier))
		            if needLevel > 0 then
		                lockText = "   잠김 — Lv" .. tostring(needLevel) .. " 전직 필요"
		            else
		                lockText = "   잠김 — 차수 부족"
		            end
		        end
		
		        self.lblDesc.Text = "[" .. self:KindLabel(skill) .. "] " .. skill.description
		            .. lockText .. statText .. extra
	end

	@ExecSpace("ClientOnly")
	method void FitIcon(any iconTransform, number ratio)
		        -- 그림의 가로/세로 비를 지킨 채 아이콘 상자에 채워 넣는다 (T20-4).
		        --
		        -- 왜 `PreserveSprite`를 안 쓰나: AspectOnly(1)가 바로 이 일을 하지만
		        -- **위치를 스프라이트 자신의 pivot으로 잡아** 칸 밖으로 밀어낸다
		        -- (T17-4c에서 아이템 아이콘이 같은 이유로 어긋났고, T20-4에서 다시 실측했다 —
		        -- 그림이 칸 위로 반쯤 튀어나오고, pivot을 가운데로 옮기면 아예 사라졌다).
		        -- 그래서 stretch(None)로 두고 **상자 쪽을 그림 비율에 맞춘다.**
		        --
		        -- 왜 `SetNativeSize()`로 재지 않나: 그 값은 **다음 프레임에** RectSize에 들어온다
		        -- (실측: 999x999를 심고 부른 직후 999x999, 0.1초 뒤 27x38). 늦게 재려고
		        -- 타이머를 걸었더니 자원이 아직 안 올라온 첫 회에 18x18을 물어 **캐시가 오염됐고**,
		        -- 그 뒤로 계속 정사각으로 그려졌다. 재는 값이 RectSize 하나라 입력과 출력이
		        -- 같은 칸을 쓰는 것이 원인이라, 아예 데이터로 옮겼다 (`SkillTable.icon_ratio`).
		        if ratio <= 0 then return end
		        local w = self.iconBoxH * ratio
		        local h = self.iconBoxH
		        if w > self.iconBoxW then
		            w = self.iconBoxW
		            h = self.iconBoxW / ratio
		        end
		        iconTransform.RectSize = Vector2(w, h)
	end

	@ExecSpace("ClientOnly")
	method void RenderMonsterCell(integer index, PlayerCollection collection)
		        local cell = self:GetCell(index)
		        if cell == nil then return end
		        local monsterId = self.rowMonsterIds[index]
		        if monsterId == nil then
		            cell.Enable = false
		            cell:SetVisible(false)
		            return
		        end
		        cell.Enable = true
		        cell:SetVisible(true)
		
		        local monster = _GameData:GetMonster(monsterId)
		        if monster == nil then
		            cell:SetVisible(false)
		            return
		        end
		        local slots = self:GetSlots()
		        local rogueMode = slots ~= nil and slots:IsRogueliteRunMode()
		        local count = collection:GetTamedCount(monsterId)
		        local discovered = collection.RogueDiscoveredMonsters[monsterId] ~= nil
		        local level = collection:GetMonsterLevel(monsterId)
		        local levelCap = math.max(1, math.floor(_GameData:GetBalance("monster_level_cap")))
		        local available = self.ticketSelectionMode and count > 0 and level > 0 and level < levelCap
		            or (not self.ticketSelectionMode
		                and ((rogueMode and not self:IsMonsterLobby()) and discovered or count > 0))
		
		        local iconEntity = cell:GetChildByName("Icon", false)
		        if iconEntity ~= nil then
		            local icon = iconEntity.SpriteGUIRendererComponent
		            if isvalid(icon) and monster.collection_icon_ruid ~= "" then
		                -- animationclip 자체를 재생하지 않고 정지 썸네일로 표시한다.
		                -- 0.3초 Refresh마다 같은 RUID를 다시 넣으면 선택권 화면에서 아이콘이
		                -- 짧게 빈 프레임으로 바뀐다. 셀 내용이 실제로 달라질 때만 교체한다.
		                if self.monsterCellIconRuids[index] ~= monster.collection_icon_ruid then
		                    self.monsterCellIconRuids[index] = monster.collection_icon_ruid
		                    icon.ImageRUID = DataRef("thumbnail://" .. monster.collection_icon_ruid)
		                end
		                if available then icon.Color = Color(1, 1, 1, 1)
		                else icon.Color = Color(0.28, 0.28, 0.30, 0.72) end
		                self:FitIcon(iconEntity.UITransformComponent, 1)
		            end
		        end
		
		        local nameEntity = cell:GetChildByName("Name", false)
		        if nameEntity ~= nil and isvalid(nameEntity.TextGUIRendererComponent) then
		            if self:IsMonsterLobby() then
		                -- Native anchor updates settle after the mode switch; keep the label
		                -- on the cell axis when the existing refresh paints its content.
		                nameEntity.UITransformComponent.anchoredPosition = Vector2(0, -36)
		                local mark = ""
		                for companionIndex = 1, 3 do
		                    if collection:GetEquippedCompanion(companionIndex) == monsterId then
		                        mark = tostring(companionIndex)
		                        break
		                    end
		                end
		                local badge = cell:GetChildByName("V5Badge", false)
		                if isvalid(badge) then
		                    local showBadge = mark ~= ""
		                    badge.Enable = showBadge
		                    badge:SetVisible(showBadge)
		                    local badgeNumber = badge:GetChildByName("Number", false)
		                    if isvalid(badgeNumber) and isvalid(badgeNumber.TextGUIRendererComponent) then
		                        badgeNumber.TextGUIRendererComponent.Text = mark
		                    end
		                end
		                if self.ticketSelectionMode and count > 0 then
		                    local cap = math.floor(_GameData:GetBalance("monster_level_cap"))
		                    nameEntity.TextGUIRendererComponent.Text = level >= cap and "MAX" or "Lv +1"
		                elseif count > 0 then
		                    local enhance = collection:GetMonsterEnhance(monsterId)
		                    nameEntity.TextGUIRendererComponent.Text = "Lv."
		                        .. tostring(collection:GetMonsterLevel(monsterId))
		                        .. (enhance > 0 and (" +" .. tostring(enhance)) or "")
		                elseif self.ticketSelectionMode then
		                    nameEntity.TextGUIRendererComponent.Text = "탐험 해금"
		                else
		                    nameEntity.TextGUIRendererComponent.Text = ""
		                end
		            elseif available then
		                if rogueMode and not self:IsMonsterLobby() then
		                    nameEntity.TextGUIRendererComponent.Text = monster.name
		                elseif self.ticketSelectionMode then
		                    local level = collection:GetMonsterLevel(monsterId)
		                    local cap = math.floor(_GameData:GetBalance("monster_level_cap"))
		                    nameEntity.TextGUIRendererComponent.Text = monster.name .. "\n"
		                        .. (level >= cap and "MAX" or "Lv +1")
		                else
		                    nameEntity.TextGUIRendererComponent.Text = monster.name .. "\nLv."
		                        .. tostring(collection:GetMonsterLevel(monsterId)) .. "  +"
		                        .. tostring(collection:GetMonsterEnhance(monsterId))
		                end
		            else
		                nameEntity.TextGUIRendererComponent.Text = "미획득\n" .. monster.name
		            end
		        end
		
		        local sprite = cell.SpriteGUIRendererComponent
		        if isvalid(sprite) then
		            if self:IsMonsterLobby() then
		                if monsterId == self.selectedMonsterId then
		                    sprite.Color = Color(0.92, 0.96, 0.98, 1)
		                    sprite.OutlineColor = Color(0.19, 0.61, 0.83, 1)
		                    sprite.OutlineWidth = 1
		                elseif available then
		                    sprite.Color = Color(0.96, 0.97, 0.97, 1)
		                    sprite.OutlineColor = Color(0.77, 0.82, 0.85, 1)
		                    sprite.OutlineWidth = 1
		                else
		                    sprite.Color = Color(0.85, 0.87, 0.88, 1)
		                    sprite.OutlineColor = Color(0.70, 0.75, 0.78, 1)
		                    sprite.OutlineWidth = 1
		                end
		            elseif monsterId == self.selectedMonsterId then
		                sprite.Color = Color(0.77, 0.88, 1, 1)
		            elseif available then
		                sprite.Color = Color(1, 1, 1, 1)
		            else
		                sprite.Color = Color(0.67, 0.69, 0.72, 1)
		            end
		        end
	end

	@ExecSpace("ClientOnly")
	method void RenderCell(integer index, PlayerCollection collection, PlayerSkillSlots slots)
		        -- 격자 한 칸을 그린다 (T20-3). 칸에는 **아이콘과 이름만** 둔다 —
		        -- 개수·계수·쿨·잠김 사유는 눌렀을 때 아래 상세로 간다
		        -- (대표 지시: "설명을 스킬 아이콘이랑 스킬 이름만 출력해주고 버튼을 클릭하면 상세를").
		        local cell = self:GetCell(index)
		        if cell == nil then return end
		
		        local skillId = self.rowSkillIds[index]
		        if skillId == nil then
		            -- 빈 칸은 숨긴다. 회색으로 남겨두면 "왜 안 눌리지"가 된다.
		            cell:SetVisible(false)
		            return
		        end
		        cell:SetVisible(true)
		
		        local skill = _GameData:GetSkill(skillId)
		        local name = skillId
		        if skill ~= nil then name = skill.name end
		
		        local iconEntity = cell:GetChildByName("Icon", false)
		        if iconEntity ~= nil then
		            local icon = iconEntity.SpriteGUIRendererComponent
		            if isvalid(icon) and skill ~= nil then
		                icon.ImageRUID = skill.icon_ruid
		                -- 못 끼우는 스킬은 아이콘을 어둡게 죽인다. 글자로만 알리면
		                -- 격자에서는 눈에 안 들어온다 (칸이 작아 글자가 짧다).
		                if slots ~= nil and slots:CanUseTier(skillId) == false then
		                    -- 밝은 칸에서는 **어둡게** 말고 **바래게** 해야 "못 쓴다"로 읽힌다
		                    -- (T24-10). 어둡게 하면 오히려 강조된 것처럼 보인다.
		                    icon.Color = Color(0.72, 0.72, 0.74, 1)
		                else
		                    icon.Color = Color(1, 1, 1, 1)
		                end
		
		                -- 그림마다 비율이 다르다 (T20-4). 몬스터 카드는 세로로 길고(28x40)
		                -- 원작 스킬 아이콘은 정사각(32x32)이라, 한 크기에 밀어 넣으면
		                -- 카드가 두 배로 뚱뚱해진다 — 대표가 "이상하게 나온다"고 한 것이 이것이다.
		                self:FitIcon(iconEntity.UITransformComponent, skill.icon_ratio)
		            end
		        end
		
		        local nameEntity = cell:GetChildByName("Name", false)
		        if nameEntity ~= nil then
		            local label = nameEntity.TextGUIRendererComponent
		            if isvalid(label) then
		                -- 중복 장수는 이름 옆에 작게 붙인다. 1장이면 안 적는다 —
		                -- 대부분 1장이라 매 칸에 "x1"이 붙으면 글자만 늘고 갈리지 않는다.
		                local owned = collection:GetOwnedCount(skillId)
		                local stackText = ""
		                if owned > 1 then stackText = " x" .. tostring(owned) end
		                label.Text = name .. stackText
		            end
		        end
		
		        -- 칸 바탕색이 **출처와 상태**를 나른다.
		        --   고른 칸    밝은 파랑
		        --   잠긴 스킬  거의 검정
		        --   몬스터     청록 기운
		        --   모험가     금빛 기운
		        -- 지금은 탭으로 갈라 놓았지만, 색을 칸에 두면 나중에 탭을 합쳐도 그대로 읽힌다.
		        local sprite = cell.SpriteGUIRendererComponent
		        if isvalid(sprite) then
		            -- 탭과 같은 이유로 밝은 쪽으로 뒤집었다 (T24-10). 네 상태가 서로
		            -- 구분돼야 하므로 밝기가 아니라 **색조**로 가른다 —
		            -- 고름=하늘 / 잠김=회색 / 모험가=크림 / 몬스터=연녹.
		            if skillId == self.selectedSkillId then
		                sprite.Color = Color(0.72, 0.83, 0.95, 1)
		            elseif slots ~= nil and slots:CanUseTier(skillId) == false then
		                sprite.Color = Color(0.84, 0.83, 0.82, 1)
		            else
		                sprite.Color = Color(0.88, 0.94, 0.91, 1)
		            end
		        end
	end

	@ExecSpace("ClientOnly")
	method void RenderRunSkillCell(integer index)
		        local cell = self:GetCell(index)
		        if cell == nil then return end
		        local skillId = self.rowSkillIds[index]
		        if skillId == nil then
		            -- Disabled cells do not reserve empty rows in the shared scroll layout.
		            cell.Enable = false
		            cell:SetVisible(false)
		            return
		        end
		        local skill = _GameData:GetSkill(skillId)
		        if skill == nil then
		            cell.Enable = false
		            cell:SetVisible(false)
		            return
		        end
		        cell.Enable = true
		        cell:SetVisible(true)
		
		        local iconEntity = cell:GetChildByName("Icon", false)
		        if isvalid(iconEntity) and isvalid(iconEntity.SpriteGUIRendererComponent) then
		            iconEntity.SpriteGUIRendererComponent.ImageRUID = skill.icon_ruid
		            iconEntity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
		            self:FitIcon(iconEntity.UITransformComponent, skill.icon_ratio)
		        end
		        local nameEntity = cell:GetChildByName("Name", false)
		        if isvalid(nameEntity) and isvalid(nameEntity.TextGUIRendererComponent) then
		            nameEntity.UITransformComponent.anchoredPosition = Vector2(83, 0)
		            nameEntity.TextGUIRendererComponent.Text = skill.name
		            -- Run 셀 배경은 밝은 슬롯이므로 이름은 어두운 고대비로 고정한다.
		            -- ApplyPilotVisualMode가 설정하는 흰색 전투 텍스트가 남으면
		            -- 아이콘 아래 이름이 배경에 묻혀 클릭 결과도 보이지 않는다.
		            nameEntity.TextGUIRendererComponent.FontColor = Color(0.12, 0.18, 0.22, 1)
		            nameEntity.TextGUIRendererComponent.FontSize = 24
		            nameEntity.TextGUIRendererComponent.BestFit = true
		            nameEntity.TextGUIRendererComponent.MinSize = 16
		            nameEntity.TextGUIRendererComponent.MaxSize = 24
		            nameEntity.TextGUIRendererComponent.HorizontalAlignment = TextHorizontalAlignmentOption.Left
		            nameEntity.TextGUIRendererComponent.VerticalAlignment = TextVerticalAlignmentOption.Middle
		        end
		        local sprite = cell.SpriteGUIRendererComponent
		        if isvalid(sprite) then
		            local selected = skillId == self.selectedSkillId
		            sprite.Color = selected
		                and Color(0.86, 0.95, 0.98, 1) or Color(0.98, 0.99, 0.99, 1)
		            sprite.OutlineColor = selected
		                and Color(0.19, 0.61, 0.83, 1) or Color(0.77, 0.82, 0.85, 1)
		            sprite.OutlineWidth = 1
		        end
	end

	@ExecSpace("ClientOnly")
	method void RefreshMonsterLobby()
		        local collection = self:GetCollection()
		        if collection == nil then return end
		        self:SetRunSkillWindowCompact(false)
		        -- Open on a meaningful monster instead of an empty half-window.
		        if self.selectedMonsterId == "" and not self.ticketSelectionMode then
		            local firstCompanion = collection:GetEquippedCompanion(1)
		            if firstCompanion ~= "" and collection:GetTamedCount(firstCompanion) > 0 then
		                self.selectedMonsterId = firstCompanion
		            else
		                for _, candidateId in ipairs(_GameData:GetTameableMonsterIds()) do
		                    if collection:GetTamedCount(candidateId) > 0 then
		                        self.selectedMonsterId = candidateId
		                        break
		                    end
		                end
		            end
		        end
		        local title = self.windowRoot:GetChildByName("Title", true)
		        if isvalid(title) and isvalid(title.TextGUIRendererComponent) then
		            title.TextGUIRendererComponent.Text = self.ticketSelectionMode
		                and "몬스터 성장권" or "몬스터 컬렉션"
		        end
		        local slotLabel = self.windowRoot:GetChildByName("LblSlots", true)
		        if isvalid(slotLabel) and isvalid(slotLabel.TextGUIRendererComponent) then
		            slotLabel.TextGUIRendererComponent.Text = self.ticketSelectionMode
		                and "몬스터 성장권" or "몬스터 편성 · 메인 1 / 지원 2"
		        end
		        local selected = self.selectedMonsterId
		        local ticketSummary = self.windowRoot:GetChildByName("TicketSummary", true)
		        if isvalid(ticketSummary) then
		            ticketSummary.Enable = self.ticketSelectionMode
		            ticketSummary:SetVisible(self.ticketSelectionMode)
		            if self.ticketSelectionMode then
		                local chosen = selected ~= "" and _GameData:GetMonster(selected) or nil
		                local summaryName = ticketSummary:GetChildByName("Name", false)
		                local summaryLevel = ticketSummary:GetChildByName("Level", false)
		                local summaryIcon = ticketSummary:GetChildByName("Monster", false)
		                if isvalid(summaryName) then
		                    summaryName.TextGUIRendererComponent.Text = chosen ~= nil
		                        and chosen.name or "몬스터를 선택하세요"
		                end
		                if isvalid(summaryLevel) then
		                    local level = chosen ~= nil and collection:GetMonsterLevel(selected) or 0
		                    summaryLevel.TextGUIRendererComponent.Text = chosen == nil
		                        and "성장시킬 보유 몬스터를 선택해 주세요"
		                        or (level >= math.max(1, math.floor(_GameData:GetBalance("monster_level_cap")))
		                            and "최대 레벨 · 선택 불가"
		                            or (level > 0 and ("Lv." .. tostring(level) .. " → Lv."
		                                .. tostring(level + 1)) or "탐험에서 해금 필요"))
		                end
		                if isvalid(summaryIcon) then
		                    local visible = chosen ~= nil and chosen.collection_icon_ruid ~= ""
		                    local nextRuid = visible and chosen.collection_icon_ruid or ""
		                    if self.ticketSummaryIconRuid ~= nextRuid then
		                        self.ticketSummaryIconRuid = nextRuid
		                        summaryIcon.Enable = visible
		                        summaryIcon:SetVisible(visible)
		                        if visible then
		                            summaryIcon.SpriteGUIRendererComponent.ImageRUID =
		                                DataRef("thumbnail://" .. chosen.collection_icon_ruid)
		                        end
		                    end
		                end
		            end
		        end
		        local owned = selected ~= "" and collection:GetTamedCount(selected) > 0
		        if selected == "" then
		            self.observedMonsterId = ""
		        elseif self.observedMonsterId ~= selected then
		            self.observedMonsterId = selected
		            self.observedLevel = collection:GetMonsterLevel(selected)
		            self.observedEnhance = collection:GetMonsterEnhance(selected)
		        else
		            local level = collection:GetMonsterLevel(selected)
		            local enhance = collection:GetMonsterEnhance(selected)
		            local monster = _GameData:GetMonster(selected)
		            local name = monster ~= nil and monster.name or selected
		            if level > self.observedLevel then
		                _SkillBar:ShowMetaToast(name .. " Lv." .. tostring(self.observedLevel)
		                    .. " → Lv." .. tostring(level))
		            elseif enhance > self.observedEnhance then
		                _SkillBar:ShowMetaToast(name .. " +" .. tostring(self.observedEnhance)
		                    .. " → +" .. tostring(enhance))
		            end
		            self.observedLevel = level
		            self.observedEnhance = enhance
		        end
		        if self.ticketAwaitingMonsterId ~= "" then
		            local actual = collection:GetMonsterLevel(self.ticketAwaitingMonsterId)
		            if actual > self.ticketPreviousLevel then
		                self.ticketSelectionMode = false
		                self.ticketAwaitingMonsterId = ""
		            end
		        end
		        for i = 1, 5 do
		            local btn = self:GetSlotButton(i)
		            if btn ~= nil then
		                if i == 4 then
		                    btn.Entity.UITransformComponent.anchoredPosition = self.ticketSelectionMode
		                        and Vector2(468, -714) or Vector2(145, -620)
		                end
		                btn.Entity:SetVisible(self.ticketSelectionMode and i == 4 or not self.ticketSelectionMode)
		                btn.Enable = owned
		                local label = "몬스터 선택"
		                if self.ticketSelectionMode then
		                    label = "성장권 확인\n"
		                        .. (selected ~= "" and (_GameData:GetMonster(selected).name or selected) or "몬스터 선택")
		                    btn.Enable = i == 4 and selected ~= ""
		                        and collection.MonsterSelectionTickets > 0
		                        and self.ticketAwaitingMonsterId == ""
		                        and collection:GetTamedCount(selected) > 0
		                        and collection:GetMonsterLevel(selected) > 0
		                        and collection:GetMonsterLevel(selected)
		                            < math.max(1, math.floor(_GameData:GetBalance("monster_level_cap")))
		                elseif i <= 3 then
		                    local companionId = collection:GetEquippedCompanion(i)
		                    local companion = _GameData:GetMonster(companionId)
		                    local role = i == 1 and "[메인] " or "[지원] "
		                    local name = companion ~= nil and companion.name or "+ 선택"
		                    local growth = companion ~= nil
		                        and (" Lv." .. tostring(collection:GetMonsterLevel(companionId))
		                            .. " +" .. tostring(collection:GetMonsterEnhance(companionId))) or ""
		                    local portraitLabel = btn.Entity:GetChildByName("V4Label", false)
		                    if isvalid(portraitLabel) and isvalid(portraitLabel.TextGUIRendererComponent) then
		                        portraitLabel.TextGUIRendererComponent.Text = role .. name
		                            .. (growth ~= "" and ("\n" .. growth) or "")
		                    end
		                    label = ""
		                    local sprite = btn.Entity.SpriteGUIRendererComponent
		                    if isvalid(sprite) then
		                        sprite.Color = selected ~= "" and selected == companionId
		                            and Color(0.88, 0.93, 0.96, 1) or Color(0.94, 0.96, 0.96, 1)
		                    end
		                    local iconEntity = btn.Entity:GetChildByName("Icon", false)
		                    if isvalid(iconEntity) then
		                        local visible = companion ~= nil and companion.collection_icon_ruid ~= ""
		                        iconEntity.Enable = visible
		                        iconEntity:SetVisible(visible)
		                        if visible and isvalid(iconEntity.SpriteGUIRendererComponent) then
		                            iconEntity.SpriteGUIRendererComponent.ImageRUID =
		                                DataRef("thumbnail://" .. companion.collection_icon_ruid)
		                        end
		                    end
		                elseif i == 4 then
		                    local nextEnhance = selected ~= ""
		                        and (collection:GetMonsterEnhance(selected) + 1) or 1
		                    label = "강화 +" .. tostring(nextEnhance)
		                    local costLabel = self.windowRoot:GetChildByName("V4EnhanceCost", false)
		                    if isvalid(costLabel) and isvalid(costLabel.TextGUIRendererComponent) then
		                        costLabel.TextGUIRendererComponent.Text = "점수 "
		                            .. tostring(collection:GetMonsterEnhanceCost(selected))
		                            .. " / " .. tostring(collection.MonsterGrowthCurrency)
		                        costLabel.Enable = not self.ticketSelectionMode
		                        costLabel:SetVisible(not self.ticketSelectionMode)
		                    end
		                    btn.Enable = owned and collection:GetMonsterEnhance(selected)
		                            < math.floor(_GameData:GetBalance("monster_enhance_cap"))
		                elseif i == 5 then
		                    label = "레벨업"
		                    local costLabel = self.windowRoot:GetChildByName("V4CoreCost", false)
		                    if isvalid(costLabel) and isvalid(costLabel.TextGUIRendererComponent) then
		                        costLabel.TextGUIRendererComponent.Text = "코어 "
		                            .. tostring(collection:GetMonsterCoreLevelCost(selected))
		                            .. " / " .. tostring(collection.MonsterGrowthCore)
		                        costLabel.Enable = not self.ticketSelectionMode
		                        costLabel:SetVisible(not self.ticketSelectionMode)
		                    end
		                    btn.Enable = owned and collection:GetMonsterLevel(selected)
		                            < math.floor(_GameData:GetBalance("monster_level_cap"))
		                end
		                btn.Entity.TextGUIRendererComponent.Text = label
		            end
		        end
		
		        self.rowMonsterIds = _GameData:GetTameableMonsterIds()
		        self.rowSkillIds = {}
		        self.pickingMonsterSkill = false
		        for i = 1, self.cellCount do self:RenderMonsterCell(i, collection) end
		        local emptyState = self.windowRoot:GetChildByName("EmptyState", true)
		        if isvalid(emptyState) then
		            emptyState.Enable = false
		            emptyState:SetVisible(false)
		        end
		        self:RenderTabs()
		        self:RenderDesc()
	end

	@ExecSpace("ClientOnly")
	method void SetRunSkillWindowCompact(boolean compact)
		        -- Keep the collection layout in town; in a Run use a smaller ability view.
		        if not isvalid(self.windowRoot) then return end
		        self:ApplyPilotVisualMode(self:IsMonsterLobby())
		        local runFilled = not compact and not self:IsMonsterLobby()
		        local shortRun = runFilled and self.rowSkillIds ~= nil and #self.rowSkillIds <= 5
		        self.windowRoot.UITransformComponent.RectSize = compact and Vector2(700, 270)
		            or (runFilled and Vector2(1160, shortRun and 560 or 690) or Vector2(1360, 900))
		        local collectionMatrixCenter = 0
		        local collectionGridCenter = 0
		        if self:IsMonsterLobby() then
		            local innerFrame = self.windowRoot:GetChildByName("V5InnerFrame", false)
		            local detailCard = self.windowRoot:GetChildByName("V4SkillCard", false)
		            local grid = self.windowRoot:GetChildByName("Grid", false)
		            if isvalid(innerFrame) and isvalid(detailCard) and isvalid(grid) then
		                local innerRect = innerFrame.UITransformComponent
		                local detailRect = detailCard.UITransformComponent
		                local layout = grid.ScrollLayoutGroupComponent
		                -- Center the four visible columns in the collection area itself.
		                -- The scrollbar is an accessory to the right, not part of the matrix.
		                local leftAreaLeft = innerRect.anchoredPosition.x - innerRect.RectSize.x / 2 + 20
		                local leftAreaRight = detailRect.anchoredPosition.x - detailRect.RectSize.x / 2 - 20
		                collectionMatrixCenter = (leftAreaLeft + leftAreaRight) / 2
		                collectionGridCenter = collectionMatrixCenter
		                    + (isvalid(layout) and layout.ScrollBarThickness / 2 or 0)
		            end
		        end
		        local title = self.windowRoot:GetChildByName("Title", false)
		        if isvalid(title) then
		            title.UITransformComponent.RectSize = compact and Vector2(660, 62)
		                or (runFilled and Vector2(1120, 62)
		                    or Vector2(1290, self:IsMonsterLobby() and 44 or 62))
		            title.UITransformComponent.anchoredPosition = self:IsMonsterLobby()
		                and Vector2(0, -18) or Vector2(0, -12)
		        end
		        local grid = self.windowRoot:GetChildByName("Grid", false)
		        if isvalid(grid) then
		            grid.Enable = not compact
		            grid:SetVisible(not compact)
		            grid.UITransformComponent.anchoredPosition = runFilled
		                and Vector2(-260, -144) or (self:IsMonsterLobby()
		                    and Vector2(collectionGridCenter, -134) or Vector2(-374, -124))
		            grid.UITransformComponent.RectSize = runFilled
		                and Vector2(600, shortRun and 230 or 360) or (self:IsMonsterLobby()
		                    and Vector2(574, 500) or Vector2(552, 508))
		            if self:IsMonsterLobby() then
		                local layout = grid.ScrollLayoutGroupComponent
		                if isvalid(layout) then
		                    local contentWidth = grid.UITransformComponent.RectSize.x - layout.ScrollBarThickness
		                    local slotsWidth = layout.CellSize.x * layout.ConstraintCount
		                        + layout.GridSpacing.x * (layout.ConstraintCount - 1)
		                    local inset = math.max(0, (contentWidth - slotsWidth) / 2)
		                    local oldPadding = layout.Padding
		                    layout.Padding = RectOffset(inset, inset, oldPadding.top, oldPadding.bottom)
		                end
		            end
		        end
		        local ownedLabel = self.windowRoot:GetChildByName("LblOwned", false)
		        if isvalid(ownedLabel) then
		            local collectionHeaderX = collectionMatrixCenter
		            local collectionHeaderWidth = ownedLabel.UITransformComponent.RectSize.x
		            if self:IsMonsterLobby() and isvalid(grid) then
		                local layout = grid.ScrollLayoutGroupComponent
		                if isvalid(layout) then
		                    collectionHeaderWidth = grid.UITransformComponent.RectSize.x
		                        - layout.ScrollBarThickness
		                    collectionHeaderX = collectionMatrixCenter
		                end
		            end
		            ownedLabel.UITransformComponent.anchoredPosition = runFilled
		                and Vector2(-260, -93) or (self:IsMonsterLobby()
		                    and Vector2(collectionHeaderX, -82) or Vector2(-374, -82))
		            ownedLabel.UITransformComponent.RectSize = runFilled
		                and Vector2(615, 42) or (self:IsMonsterLobby()
		                    and Vector2(collectionHeaderWidth, 38) or Vector2(552, 38))
		        end
		        local slotsLabel = self.windowRoot:GetChildByName("LblSlots", false)
		        if isvalid(slotsLabel) then
		            slotsLabel.UITransformComponent.anchoredPosition = runFilled
		                and Vector2(0, shortRun and -405 or -520) or Vector2(0, -706)
		            slotsLabel.UITransformComponent.RectSize = runFilled
		                and Vector2(1040, 40) or Vector2(1100, 32)
		        end
		        local description = self.windowRoot:GetChildByName("LblDesc", false)
		        if isvalid(description) then
		            description.UITransformComponent.anchoredPosition = runFilled
		                and Vector2(300, -270) or (self:IsMonsterLobby()
		                    and Vector2(380, -523) or Vector2(380, -436))
		            description.UITransformComponent.RectSize = runFilled
		                and Vector2(430, 120) or (self:IsMonsterLobby()
		                    and Vector2(545, 75) or Vector2(545, 140))
		        end
		        local skillIcon = self.windowRoot:GetChildByName("DetailSkillIcon", false)
		        if isvalid(skillIcon) then
		            skillIcon.UITransformComponent.anchoredPosition = runFilled
		                and Vector2(50, -153) or Vector2(35, -477)
		        end
		        for i = 1, 5 do
		            local btn = self:GetSlotButton(i)
		            if btn ~= nil then
		                local transform = btn.Entity.UITransformComponent
		                if runFilled then
		                    transform.anchoredPosition = Vector2(-436 + (i - 1) * 218,
		                        shortRun and -455 or -565)
		                    transform.RectSize = Vector2(200, 72)
		                    btn.Entity.TextGUIRendererComponent.Padding = RectOffset(9, 9, 0, 0)
		                elseif i <= 3 then
		                    transform.anchoredPosition = Vector2(-330 + (i - 1) * 330, -750)
		                    transform.RectSize = Vector2(190, 116)
		                elseif i == 4 then
		                    transform.anchoredPosition = Vector2(140, -620)
		                    transform.RectSize = Vector2(220, 46)
		                else
		                    transform.anchoredPosition = Vector2(440, -620)
		                    transform.RectSize = Vector2(220, 46)
		                end
		            end
		        end
		        local monsterIcon = self.windowRoot:GetChildByName("DetailMonsterIcon", false)
		        if isvalid(monsterIcon) then
		            monsterIcon.UITransformComponent.anchoredPosition = self:IsMonsterLobby()
		                and Vector2(290, -83) or Vector2(330, -144)
		            monsterIcon.UITransformComponent.RectSize = self:IsMonsterLobby()
		                and Vector2(255, 216) or Vector2(120, 108)
		            monsterIcon.UITransformComponent.Pivot = self:IsMonsterLobby()
		                and Vector2(0.5, 1) or Vector2(0.5, 1)
		        end
		        for _, childName in ipairs({"HeroKicker", "HeroName", "HeroStage", "DetailStats"}) do
		            local item = self.windowRoot:GetChildByName(childName, false)
		            if isvalid(item) and self:IsMonsterLobby() then
		                item.UITransformComponent.anchoredPosition = childName == "HeroKicker"
		                    and Vector2(440, -82) or (childName == "HeroName"
		                    and Vector2(290, -316) or (childName == "HeroStage"
		                    and Vector2(290, -365) or Vector2(290, -423)))
		                item.UITransformComponent.RectSize = childName == "HeroKicker"
		                    and Vector2(300, 38) or (childName == "DetailStats"
		                    and Vector2(600, 63) or Vector2(640, childName == "HeroName" and 50 or 38))
		                if childName == "HeroKicker" and isvalid(item.TextGUIRendererComponent) then
		                    -- Selected-monster kills share the existing collection meta baseline.
		                    item.TextGUIRendererComponent.FontSize = 20
		                    item.TextGUIRendererComponent.HorizontalAlignment = TextHorizontalAlignmentOption.Right
		                    item.TextGUIRendererComponent.VerticalAlignment = TextVerticalAlignmentOption.Middle
		                end
		            end
		        end
		        for _, childName in ipairs({"LblOwned", "LblSlots", "LblDesc", "HeroKicker",
		            "HeroName", "HeroStage", "DetailMonsterIcon", "DetailSkillIcon",
		            "Slot1", "Slot2", "Slot3", "Slot4", "Slot5"}) do
		            local child = self.windowRoot:GetChildByName(childName, false)
		            if isvalid(child) then
		                local visible = not compact and not (self:IsMonsterLobby()
		                    and (childName == "LblDesc" or childName == "DetailSkillIcon"))
		                child.Enable = visible
		                child:SetVisible(visible)
		            end
		        end
		        local emptyState = self.windowRoot:GetChildByName("EmptyState", false)
		        if isvalid(emptyState) then
		            emptyState.UITransformComponent.anchoredPosition = compact
		                and Vector2(0, -112) or Vector2(350, -250)
		            emptyState.TextGUIRendererComponent.Text = compact
		                and "아직 획득한 능력이 없습니다." or ""
		        end
	end

	@ExecSpace("ClientOnly")
	method void ApplyPilotVisualMode(boolean collectionMode)
		        -- Collection과 Run Skill은 동일 프레임/슬롯 문법의 밝은/어두운 변형이다.
		        local mode = collectionMode and "COLLECTION" or "RUN_SKILL"
		        if self.appliedPilotVisualMode == mode then return end
		        self.appliedPilotVisualMode = mode
		        if collectionMode then
		            -- Run Skill 화면이 같은 셀 Icon을 사용하므로 모드 복귀 때 한 번은
		            -- 몬스터 썸네일을 다시 심고, 이후 반복 Refresh에서는 캐시한다.
		            self.monsterCellIconRuids = {}
		        end
		        for _, childName in ipairs({"V4SkillCard", "V4EnhanceCost", "V4CoreCost",
		            "V5InnerFrame", "V5TitleRule", "V5TitleHighlight",
		            "V5HPChip", "V5ATKChip", "V5DEFChip",
		            "V5HPValue", "V5ATKValue", "V5DEFValue"}) do
		            local decoration = self.windowRoot:GetChildByName(childName, false)
		            if isvalid(decoration) then
		                decoration.Enable = collectionMode
		                decoration:SetVisible(collectionMode)
		            end
		        end
		        self.iconBoxW = collectionMode and 56 or 54
		        self.iconBoxH = collectionMode and 56 or 54
		        local window = self.windowRoot
		        local frame = window.SpriteGUIRendererComponent
		        if isvalid(frame) then
		            frame.Color = collectionMode and Color(0.93, 0.95, 0.96, 1)
		                or Color(0.16, 0.22, 0.27, 0.96)
		            frame.OutlineColor = collectionMode and Color(0.57, 0.63, 0.67, 1)
		                or Color(0.43, 0.53, 0.60, 1)
		            frame.OutlineWidth = 2
		        end
		        local title = window:GetChildByName("Title", false)
		        if isvalid(title) then
		            if isvalid(title.SpriteGUIRendererComponent) then
		                title.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		            end
		            if isvalid(title.TextGUIRendererComponent) then
		                title.TextGUIRendererComponent.FontColor = collectionMode
		                    and Color(0.19, 0.24, 0.28, 1) or Color(0.90, 0.94, 0.96, 1)
		                title.TextGUIRendererComponent.FontSize = collectionMode and 27 or 30
		                title.TextGUIRendererComponent.HorizontalAlignment = TextHorizontalAlignmentOption.Center
		            end
		        end
		        local grid = window:GetChildByName("Grid", false)
		        if isvalid(grid) then
		            local layout = grid.ScrollLayoutGroupComponent
		            if isvalid(layout) then
		                layout.CellSize = collectionMode and Vector2(111, 102) or Vector2(264, 100)
		                layout.ConstraintCount = collectionMode and 4 or 2
		                layout.GridSpacing = collectionMode and Vector2(18, 16) or Vector2(18, 18)
		                layout.Padding = collectionMode and RectOffset(32, 32, 20, 24)
		                    or RectOffset(21, 21, 9, 9)
		                -- Rebuild the native grid only when switching collection/run layouts.
		                -- CellSize alone leaves the previous native cell geometry cached.
		                layout.Type = LayoutGroupType.Vertical
		                layout.Type = LayoutGroupType.Grid
		            end
		            if isvalid(grid.SpriteGUIRendererComponent) then
		                grid.SpriteGUIRendererComponent.Color = collectionMode
		                    and Color(0.89, 0.92, 0.94, 1) or Color(0.20, 0.27, 0.32, 1)
		                grid.SpriteGUIRendererComponent.OutlineColor = collectionMode
		                    and Color(0.62, 0.67, 0.70, 1) or Color(0.43, 0.53, 0.60, 1)
		            end
		            for i = 1, self.cellCount do
		                local cell = grid:GetChildByName("Cell" .. tostring(i), false)
		                if isvalid(cell) then
		                    cell.UITransformComponent.RectSize = collectionMode
		                        and Vector2(111, 102) or Vector2(264, 100)
		                    if isvalid(cell.SpriteGUIRendererComponent) then
		                        cell.SpriteGUIRendererComponent.Color = collectionMode
		                            and Color(0.98, 0.99, 0.99, 1) or Color(0.27, 0.33, 0.37, 1)
		                        cell.SpriteGUIRendererComponent.OutlineColor = collectionMode
		                            and Color(0.72, 0.77, 0.80, 1) or Color(0.45, 0.55, 0.62, 1)
		                        cell.SpriteGUIRendererComponent.OutlineWidth = 1
		                    end
		                    local iconWell = cell:GetChildByName("V5IconWell", false)
		                    if isvalid(iconWell) then
		                        iconWell.Enable = collectionMode
		                        iconWell:SetVisible(collectionMode)
		                    end
		                    local badge = cell:GetChildByName("V5Badge", false)
		                    if isvalid(badge) then
		                        if collectionMode then
		                            badge.UITransformComponent.anchoredPosition = Vector2(-39, 40)
		                        else
		                            badge.Enable = false
		                            badge:SetVisible(false)
		                        end
		                    end
		                    local icon = cell:GetChildByName("Icon", false)
		                    if isvalid(icon) then
		                        local iconAnchor = collectionMode and Vector2(0.5, 0.5)
		                            or Vector2(0, 0.5)
		                        icon.UITransformComponent.AnchorsMin = iconAnchor
		                        icon.UITransformComponent.AnchorsMax = iconAnchor
		                        icon.UITransformComponent.anchoredPosition = collectionMode
		                            and Vector2(0, 10) or Vector2(40, 0)
		                        icon.UITransformComponent.Pivot = Vector2(0.5, 0.5)
		                    end
		                    local name = cell:GetChildByName("Name", false)
		                    if isvalid(name) then
		                        local nameAnchor = collectionMode and Vector2(0.5, 0.5)
		                            or Vector2(0, 0.5)
		                        name.UITransformComponent.AnchorsMin = nameAnchor
		                        name.UITransformComponent.AnchorsMax = nameAnchor
		                        name.UITransformComponent.anchoredPosition = collectionMode
		                            and Vector2(0, -36) or Vector2(83, 0)
		                        name.UITransformComponent.Pivot = collectionMode
		                            and Vector2(0.5, 0.5) or Vector2(0, 0.5)
		                        name.UITransformComponent.RectSize = collectionMode
		                            and Vector2(104, 24) or Vector2(172, 76)
		                        if isvalid(name.TextGUIRendererComponent) then
		                            name.TextGUIRendererComponent.FontSize = collectionMode and 17 or 21
		                            name.TextGUIRendererComponent.HorizontalAlignment = collectionMode and 2 or 1
		                            name.TextGUIRendererComponent.FontColor = collectionMode
		                                and Color(0.19, 0.24, 0.28, 1) or Color(0.89, 0.93, 0.95, 1)
		                        end
		                    end
		                end
		            end
		        end
		        local close = window:GetChildByName("BtnClose", false)
		        if isvalid(close) and isvalid(close.SpriteGUIRendererComponent) then
		            close.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		            local icon = close:GetChildByName("XIcon", false)
		            if isvalid(icon) and isvalid(icon.SpriteGUIRendererComponent) then
		                icon.SpriteGUIRendererComponent.Color = collectionMode
		                    and Color(0.31, 0.36, 0.39, 1) or Color(0.88, 0.93, 0.95, 1)
		            end
		        end
		        local ownedLabel = window:GetChildByName("LblOwned", false)
		        if isvalid(ownedLabel) and isvalid(ownedLabel.TextGUIRendererComponent) then
		            ownedLabel.TextGUIRendererComponent.FontSize = collectionMode and 20 or 22
		            ownedLabel.TextGUIRendererComponent.FontColor = collectionMode
		                and Color(0.19, 0.24, 0.28, 1) or Color(0.86, 0.91, 0.94, 1)
		        end
		        local slotsLabel = window:GetChildByName("LblSlots", false)
		        if isvalid(slotsLabel) and isvalid(slotsLabel.TextGUIRendererComponent) then
		            slotsLabel.TextGUIRendererComponent.FontColor = collectionMode
		                and Color(0.19, 0.24, 0.28, 1) or Color(0.87, 0.92, 0.95, 1)
		            slotsLabel.TextGUIRendererComponent.FontSize = collectionMode and 20 or 22
		        end
		        local description = window:GetChildByName("LblDesc", false)
		        if isvalid(description) and isvalid(description.TextGUIRendererComponent) then
		            description.TextGUIRendererComponent.FontColor = collectionMode
		                and Color(0.19, 0.24, 0.28, 1) or Color(0.88, 0.93, 0.96, 1)
		            description.TextGUIRendererComponent.FontSize = collectionMode and 22 or 24
		            description.TextGUIRendererComponent.BestFit = true
		            description.TextGUIRendererComponent.MinSize = 16
		            description.TextGUIRendererComponent.MaxSize = collectionMode and 26 or 28
		            description.TextGUIRendererComponent.VerticalAlignment = TextVerticalAlignmentOption.Middle
		        end
		        local empty = window:GetChildByName("EmptyState", false)
		        if isvalid(empty) and isvalid(empty.TextGUIRendererComponent) then
		            empty.TextGUIRendererComponent.FontColor = collectionMode
		                and Color(0.34, 0.39, 0.42, 1) or Color(0.82, 0.88, 0.91, 1)
		        end
		        local stats = window:GetChildByName("DetailStats", false)
		        if isvalid(stats) and isvalid(stats.TextGUIRendererComponent) then
		            stats.TextGUIRendererComponent.FontSize = collectionMode and 22 or 22
		            stats.TextGUIRendererComponent.HorizontalAlignment = collectionMode and 2 or 1
		            stats.Enable = not collectionMode
		            stats:SetVisible(not collectionMode)
		        end
		        local skillCard = window:GetChildByName("V4SkillCard", false)
		        if isvalid(skillCard) then
		            if isvalid(skillCard.SpriteGUIRendererComponent) then
		                skillCard.SpriteGUIRendererComponent.Color = Color(0.92, 0.95, 0.96, 1)
		                skillCard.SpriteGUIRendererComponent.OutlineColor = Color(0.72, 0.79, 0.83, 1)
		            end
		            local iconFrame = skillCard:GetChildByName("V5IconFrame", false)
		            if isvalid(iconFrame) then
		                iconFrame.Enable = collectionMode
		                iconFrame:SetVisible(collectionMode)
		            end
		        end
		        for i = 1, 3 do
		            local button = window:GetChildByName("Slot" .. tostring(i), false)
		            if isvalid(button) then
		                local portrait = button:GetChildByName("Icon", false)
		                if isvalid(portrait) then
		                    portrait.UITransformComponent.anchoredPosition = collectionMode
		                        and Vector2(0, 15) or Vector2(-104, 0)
		                    portrait.UITransformComponent.RectSize = collectionMode
		                        and Vector2(54, 54) or Vector2(54, 54)
		                end
		                local label = button:GetChildByName("V4Label", false)
		                if isvalid(label) then
		                    label.Enable = collectionMode
		                    label:SetVisible(collectionMode)
		                end
		                for _, decorationName in ipairs({"V5PortraitFrame", "V5Badge"}) do
		                    local decoration = button:GetChildByName(decorationName, false)
		                    if isvalid(decoration) then
		                        decoration.Enable = collectionMode
		                        decoration:SetVisible(collectionMode)
		                    end
		                end
		            end
		        end
		        for i = 4, 5 do
		            local button = window:GetChildByName("Slot" .. tostring(i), false)
		            if isvalid(button) and isvalid(button.SpriteGUIRendererComponent) then
		                button.SpriteGUIRendererComponent.Color = collectionMode
		                    and (i == 4 and Color(0.24, 0.55, 0.76, 1)
		                        or Color(0.39, 0.65, 0.43, 1))
		                    or (i == 4 and Color(0.16, 0.68, 0.78, 0.96)
		                        or Color(0.35, 0.41, 0.47, 0.96))
		                button.SpriteGUIRendererComponent.OutlineColor = collectionMode
		                    and Color(0.33, 0.42, 0.48, 1)
		                    or Color(0.65, 0.69, 0.72, 1)
		                button.TextGUIRendererComponent.FontSize = collectionMode and 22 or 20
		            end
		            if isvalid(button) then
		                for _, decorationName in ipairs({"V5UpperEdge", "V5LowerEdge"}) do
		                    local decoration = button:GetChildByName(decorationName, false)
		                    if isvalid(decoration) then
		                        decoration.Enable = collectionMode
		                        decoration:SetVisible(collectionMode)
		                    end
		                end
		            end
		        end
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		        -- 슬롯 3칸과 보유 목록을 지금 상태로 다시 그린다.
		        ---@type PlayerSkillSlots
		        local slots = self:GetSlots()
		        if slots == nil then return end
		        ---@type PlayerCollection
		        local collection = self:GetCollection()
		        if collection == nil then return end
		
		        local count = slots.MonsterSlotCount
		        local randomMode = slots:IsPhase1CombatEnabled()
		        local rogueMode = slots:IsRogueliteRunMode()
		        local emptyState = self.windowRoot:GetChildByName("EmptyState", true)
		        if self:IsMonsterLobby() then
		            self:RefreshMonsterLobby()
		            -- 상세 카드들이 매 Refresh에서 다시 켜진다. 활성 확인창은 그 뒤에
		            -- 형제 순서를 올려야 Dim/버튼 위로 배경 UI가 튀어나오지 않는다.
		            if isvalid(self.ticketConfirm) and self.ticketConfirm.Enable then
		                _UILogic:SetSiblingIndex(self.ticketConfirm.UITransformComponent, 1000000)
		            end
		            return
		        end
		
		        -- 같은 .ui를 두 모드가 공유하므로 제목도 런타임 역할에 맞춰 바꾼다.
		        -- 신규 모드에서 "장착"이 남아 있으면 숨긴 슬롯이 고장처럼 보인다.
		        local title = self.windowRoot:GetChildByName("Title", true)
		        if title ~= nil and title.TextGUIRendererComponent ~= nil then
		            title.TextGUIRendererComponent.Text = rogueMode and "이번 Run 보유 능력"
		                or (randomMode and "몬스터 컬렉션" or "스킬 장착")
		        end
		        local slotLabel = self.windowRoot:GetChildByName("LblSlots", true)
		        if slotLabel ~= nil and slotLabel.TextGUIRendererComponent ~= nil then
		            slotLabel.TextGUIRendererComponent.Text = rogueMode and "현재 전투 SkillBar · 읽기 전용"
		                or (randomMode and "동행 몬스터" or "몬스터 슬롯")
		        end
		
		        -- 슬롯이 줄어드는 경우(환생 등)에 선택이 범위 밖으로 남지 않게 되돌린다.
		        if self.selectedSlot > count then self.selectedSlot = 1 end
		
		        for i = 1, 5 do
		            local btn = self:GetSlotButton(i)
		            if btn ~= nil then
		                if rogueMode then
		                    btn.Entity:SetVisible(true)
		                    btn.Enable = false
		                    local skillId = slots.RandomSlots[i]
		                    local skill = skillId ~= nil and skillId ~= "" and _GameData:GetSkill(skillId) or nil
		                    local battleSlot = btn.Entity.SpriteGUIRendererComponent
		                    if isvalid(battleSlot) then
		                        battleSlot.Color = skill ~= nil
		                            and Color(0.29, 0.37, 0.42, 1) or Color(0.24, 0.31, 0.36, 1)
		                        battleSlot.OutlineColor = skill ~= nil
		                            and Color(0.43, 0.64, 0.76, 1) or Color(0.43, 0.53, 0.60, 1)
		                        battleSlot.OutlineWidth = 1
		                    end
		                    if isvalid(btn.Entity.TextGUIRendererComponent) then
		                        btn.Entity.TextGUIRendererComponent.FontColor = Color(0.87, 0.92, 0.95, 1)
		                    end
		                    btn.Entity.TextGUIRendererComponent.Text = tostring(i) .. " · "
		                        .. (skill ~= nil and skill.name or "빈 슬롯")
		                    continue
		                elseif randomMode then
		                    btn.Enable = true
		                    btn.Entity:SetVisible(i == 1)
		                    if i == 1 then
		                        local companionId = collection.SelectedCompanionMonsterId
		                        local companion = _GameData:GetMonster(companionId)
		                        local currentName = companion ~= nil and companion.name or "없음"
		                        if self.selectedMonsterId ~= ""
		                            and collection:GetTamedCount(self.selectedMonsterId) > 0 then
		                            local picked = _GameData:GetMonster(self.selectedMonsterId)
		                            if companionId == self.selectedMonsterId then
		                                btn.Entity.TextGUIRendererComponent.Text = "동행 해제\n" .. currentName
		                            else
		                                btn.Entity.TextGUIRendererComponent.Text = "동행 선택\n"
		                                    .. (picked ~= nil and picked.name or self.selectedMonsterId)
		                            end
		                        else
		                            btn.Entity.TextGUIRendererComponent.Text = "현재 동행\n" .. currentName
		                        end
		                    end
		                    continue
		                end
		
		                btn.Enable = true
		                btn.Entity:SetVisible(true)
		                local label = ""
		                if i > count then
		                    label = tostring(i) .. "번\n잠김"
		                else
		                    local skillId = slots.MonsterSlots[i]
		                    local name = "비어 있음"
		                    if skillId ~= nil then
		                        local skill = _GameData:GetSkill(skillId)
		                        if skill ~= nil then name = skill.name else name = skillId end
		                    end
		                    if i == self.selectedSlot then
		                        label = "[선택] " .. tostring(i) .. "번\n" .. name
		                    else
		                        label = tostring(i) .. "번\n" .. name
		                    end
		                end
		                btn.Entity.TextGUIRendererComponent.Text = label
		            end
		        end
		
		        if rogueMode then
		            self:RenderTabs()
		            self.rowMonsterIds = {}
		            self.rowSkillIds = slots:GetRunOwnedSkillIds()
		            self:SetRunSkillWindowCompact(#self.rowSkillIds <= 0)
		            if isvalid(emptyState) then
		                local empty = #self.rowSkillIds <= 0
		                emptyState.Enable = empty
		                emptyState:SetVisible(empty)
		            end
		            if #self.rowSkillIds > self.cellCount then
		                log_warning("[EquipPanel] 이번 Run 고유 능력이 " .. tostring(#self.rowSkillIds)
		                    .. "종인데 칸은 " .. tostring(self.cellCount) .. "개다")
		            end
		            if self.selectedSkillId ~= "" and slots.OwnedSkillPool[self.selectedSkillId] == nil then
		                self.selectedSkillId = ""
		            end
		            for i = 1, self.cellCount do self:RenderRunSkillCell(i) end
		            self:RenderDesc()
		            return
		        elseif randomMode then
		            if isvalid(emptyState) then emptyState.Enable = false end
		            self:RenderTabs()
		            self.rowMonsterIds = _GameData:GetTameableMonsterIds()
		            if #self.rowMonsterIds > self.cellCount then
		                log_warning("[EquipPanel] 테이밍 몬스터가 " .. tostring(#self.rowMonsterIds)
		                    .. "종인데 칸은 " .. tostring(self.cellCount) .. "개다")
		            end
		            for i = 1, self.cellCount do self:RenderMonsterCell(i, collection) end
		            self:RenderDesc()
		            return
		        end
		
		        if isvalid(emptyState) then emptyState.Enable = false end
		
		        -- 지금 고른 탭의 스킬만 격자에 깐다 (T20-2 탭 + T20-3 격자).
		        --
		        -- 예전에는 출처를 안 가리고 글자 5줄에 전부 넣었다. 보유가 9~10개라
		        -- **뒤쪽이 조용히 잘려 나갔고**, 하필 id 순서상 히어로가 앞이라 몬스터 스킬이
		        -- 한 줄도 안 나왔다. 이제 탭으로 가르고, 넘치면 격자가 스크롤된다.
		        self:RenderTabs()
		        self.rowSkillIds = self:OwnedIdsOf(self.currentSource)
		
		        if #self.rowSkillIds > self.cellCount then
		            log_warning("[EquipPanel] " .. self:SourceLabel(self.currentSource) .. " 스킬이 "
		                .. tostring(#self.rowSkillIds) .. "개인데 칸은 " .. tostring(self.cellCount)
		                .. "개다 — 뒤가 잘린다")
		        end
		
		        for i = 1, self.cellCount do
		            self:RenderCell(i, collection, slots)
		        end
		
		        self:RenderDesc()
	end

end
