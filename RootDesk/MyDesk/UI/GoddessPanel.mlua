@Logic
script GoddessPanel extends Logic

	property Entity root = "3d601637-f0d7-4bff-871d-ed1aa67ba846"

	property TextGUIRendererComponent tierText = "6e05c5e2-8451-414a-abb4-596f70715e72"

	property TextGUIRendererComponent slotText = "8f0bb102-c7f2-4c51-b41f-09bff641caab"

	property TextGUIRendererComponent nextText = "15a953c3-f5c8-4b7e-848f-fe8d73c3d814"

	property ButtonComponent btnClose = "0c20e331-1653-4943-818b-839dd514602f"

	property any closeHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		        -- 창은 닫힌 채로 시작한다. 루트 그룹은 켜 두고 **안쪽(root)만** 끈다 —
		        -- 그룹을 끄면 이 스크립트의 OnBeginPlay가 아예 안 돈다 (builder-protocol-ui §3.9).
		        self:Hide()
		        log("[GoddessPanel] OnBeginPlay — 닫힌 채로 시작")
		
		        if isvalid(self.btnClose) then
		            self.closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, function()
		                self:Hide()
		            end)
		        end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		        if self.closeHandler ~= nil and isvalid(self.btnClose) then
		            self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self.closeHandler)
		            self.closeHandler = nil
		        end
	end

	@ExecSpace("ClientOnly")
	method void Hide()
		        -- ⚠ 암막이 딸린 창이라 **반드시 닫아 두어야 한다.** 켜진 채로 남으면 최상단
		        --   그룹의 전체 화면 레이캐스트가 화면 전체의 클릭을 먹는다 (T23-8에서 겪었다).
		        if isvalid(self.root) then self.root.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void Open()
		        if _GameData.RogueRunActive then return end
		        -- 지금 값을 읽어 채우고 연다. 창이 떠 있는 동안 값이 변할 일은 없다
		        -- (레벨업은 창을 닫고 사냥해야 일어난다) — 그래서 폴링하지 않는다.
		        local me = _UserService.LocalPlayer
		        if me == nil then return end
		
		        ---@type PlayerSkillSlots
		        local slots = me:GetComponent("script.PlayerSkillSlots")
		        ---@type PlayerStats
		        local stats = me:GetComponent("script.PlayerStats")
		        if slots == nil or stats == nil then return end
		
		        local tier = slots:GetTier()
		        if isvalid(self.tierText) then
		            if tier <= 0 then
		                self.tierText.Text = "아직 전직 전"
		            else
		                self.tierText.Text = tostring(tier) .. "차"
		            end
		        end
		
		        if isvalid(self.slotText) then
		            self.slotText.Text = tostring(slots.MonsterSlotCount) .. "칸"
		        end
		
		        if isvalid(self.nextText) then
		            local needLevel = slots:NextTierLevel()
		            if needLevel <= 0 then
		                -- 최고 차수. 더 오를 데가 없다는 것을 분명히 말해 준다 —
		                -- 안 그러면 "다음이 언제지"를 계속 찾게 된다.
		                self.nextText.Text = "마지막 차수까지 왔다"
		            else
		                local remain = needLevel - stats.Level
		                if remain < 0 then remain = 0 end
		                local line = "Lv" .. tostring(needLevel)
		                if remain > 0 then line = line .. "  (" .. tostring(remain) .. " 남음)" end
		                self.nextText.Text = line
		            end
		        end
		
		        if isvalid(self.root) then self.root.Enable = true end
		        log("[GoddessPanel] 열림 — " .. tostring(tier) .. "차 / 슬롯 "
		            .. tostring(slots.MonsterSlotCount))
	end

end