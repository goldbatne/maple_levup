-- @서버 (공격 판정·상태 전환 전부 서버. 클라는 동기화된 상태로 애니메이션만 재생한다)
--
-- 몬스터가 플레이어를 때리는 쪽. 데미지는 T10-3에서, 공격 **모션**은 T11-1에서 붙였다.

@Component
script MonsterAttack extends AttackComponent

	@MinValue(0)
	property number AttackInterval = 0.03

	-- 공격 자세를 유지하는 시간(초). 이 시간이 지나면 IDLE로 돌려보내
	-- AIChase가 다시 IDLE↔MOVE를 굴리게 둔다.
	@MinValue(0)
	property number AttackPoseSeconds = 0.4

	-- 아바타 몬스터가 때릴 때 쓸 **그림 이름** (T25-4). 스프라이트 몬스터의
	-- ActionSheet "ATTACK" 자리에 해당한다 — 종별로 `.model`에서 갈아 끼운다.
	--
	-- 무기에 따라 이름이 다르다: 한손검 `swingO1/O2/O3`·`stabO1/O2`,
	-- 두손검 `swingT1/T2/T3`, 활 `shoot1`. 히어로는 **모험가 히어로 소드(한손)**라 swingO1이다.
	-- 무기 없는 몸에는 공격 클립 자체가 없어 `alert` 말고는 나올 것이 없다.
	property string AvatarAttackAction = "swingO1"

	-- 공격이 끝나면 되돌아갈 동작. `Onetime`은 마지막 프레임에서 멈추므로
	-- 안 되돌리면 검을 뻗은 채로 굳는다.
	property string AvatarWalkAction = "walk1"
	property string AvatarIdleAction = "stand1"

	@MinValue(0)
	property number AvatarAttackPlayRate = 1.33

	@HideFromInspector
	property any Shape = nil

	@HideFromInspector
	property integer attackTimerId = 0

	-- 상태 전환이 실제로 먹는지 확인하려고 처음 몇 번만 로그를 남긴다.
	-- AIChase가 매 프레임 IDLE↔MOVE를 덮어쓰므로 ATTACK이 살아남는지가 관건이었다.
	@HideFromInspector
	property integer poseLogLeft = 4

	-- 공격 자세가 도는 중인지. 0.5초 주기 공격이 자세 시간(0.4초)과 겹쳐
	-- 되돌리기 타이머가 중첩되는 걸 막는다.
	@HideFromInspector
	property integer poseUntil = 0

	-- 때렸을 때 나는 소리. 종별로 .model에서 지정한다 (스프라이트와 같은 취급 —
	-- 자산 id는 CSV가 아니라 모델이 소유한다).
	--
	-- 기본값은 스켈레톤 팩의 CharDam1이다. 이건 "몬스터가 내는 소리"가 아니라
	-- **캐릭터가 맞는 소리**라 종을 안 가린다. 슬라임·버섯·골렘 팩에는 공격 사운드가
	-- 아예 없고 Damage(자기가 맞는 소리)뿐이라 그걸 쓰면 의미가 반대가 된다.
	property string AttackSfxRuid = "8f98d393b90e4fa99ad44984ea372489"

	@MinValue(0)
	property number AttackSfxVolume = 0.6

	@HideFromInspector
	property Vector2 SpriteSize = Vector2(0,0)

	@HideFromInspector
	property Vector2 PositionOffset = Vector2(0,0)

	-- 보스 스킬 (T19-1, 대표 지시 2026-08-23: "보스 몬스터들은 얻는 스킬을 사용하는게
	-- 좋을거 같아"). 이기면 뺏는 스킬을 상대가 먼저 보여 준다 — 무엇을 얻는지가
	-- 설명이 아니라 맞아 보는 것으로 전해진다.
	--
	-- 상태는 전부 `self._T`에 둔다(bossSkills / skillReadyAt / skillInterval /
	-- nextSkillAt / monster). 서버만 쓰고 클라가 볼 이유가 없어서다 —
	-- 플레이어 쪽 SkillReadyAt이 @TargetUserSync인 것은 HUD가 쿨다운을 그려야 하기 때문이다.

	-- 이번 한 방이 때릴 수 있는 대상 수. PlayerAttack과 같은 방식이다 —
	-- 엔진에 "최대 타격 수"가 없어 IsAttackTarget 훅에서 예산을 깎는 수밖에 없다.
	@HideFromInspector property boolean hitLimited = false
	@HideFromInspector property integer hitBudget = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Sprite size drives the attack box; load async, then start the repeat.
		--
		-- ⚠ 원래 여기서 self.Entity.Monster(샘플 script.Monster)를 찾고 없으면 return했다.
		--   우리 몬스터는 HP를 RoomMonster가 들고 있어서(수치를 MonsterTable에서 읽으려고
		--   샘플을 안 썼다 — RoomMonster 상단 주석) 이 가드에 걸려 **공격 타이머가
		--   아예 시작되지 않았다.** T10-3 실측: 4초간 붙어 있어도 HP가 1도 안 줄었고
		--   [MonsterAttack] 로그가 한 줄도 안 찍혔다.
		---@type RoomMonster
		local monster = self.Entity:GetComponent("script.RoomMonster")
		if monster == nil then
			log_warning("[MonsterAttack] RoomMonster가 없다 — 공격을 시작하지 않는다: "
				.. tostring(self.Entity.Name))
			return
		end

		self.Shape = BoxShape(Vector2.zero, Vector2.one, 0)

		-- 보스 스킬은 스프라이트 갈래보다 **앞에서** 건다. 아래 아바타 분기가 return으로
		-- 빠져나가기 때문에 뒤에 두면 히어로(아바타)만 스킬을 안 쓴다 — 정작 스킬을
		-- 가장 많이 가진 상대다.
		self:StartBossSkills(monster)

		-- ATTACK 상태는 등록하지 않는다. 등록해서 ChangeState로 가는 길을 먼저 만들었는데
		-- AIChase가 0.1초 만에 되돌려서 못 쓴다 (PlayAttackPose 주석 참고).
		-- 공격 모션은 SpriteRUID를 직접 갈아끼우는 쪽으로 처리한다.

		-- 아바타 몬스터(히어로 — T16-3b)는 SpriteRendererComponent가 없다.
		-- 여기서 갈라 두지 않으면 아래 PreloadAsync가 nil을 읽고 **콜백이 아예 안 돌아서
		-- 공격 타이머가 시작되지 않는다** — 붙어 있어도 데미지가 0인 상태가 된다.
		-- 에러도 안 나므로 T10-3의 "가드에 걸려 타이머가 안 돌던" 사고와 같은 모양이다.
		--
		-- 아바타는 클립에서 크기를 유도할 수 없으므로 사람 크기 상자를 그대로 쓴다
		-- (monster.md의 human-sized 캐노니컬과 같은 값).
		local sprite = self.Entity.SpriteRendererComponent
		if not isvalid(sprite) then
			self.SpriteSize = Vector2(0.67, 1.42)
			self.PositionOffset = Vector2(-0.005, 0.71)
			self.attackTimerId = _TimerService:SetTimerRepeat(function()
				if monster.IsDead == false then
					self:AttackNear()
				end
			end, self.AttackInterval)
			log("[MonsterAttack] 아바타 몬스터 — 고정 상자로 공격 시작 ("
				.. tostring(self.Entity.Name) .. ")")
			return
		end

		_ResourceService:PreloadAsync({self.Entity.SpriteRendererComponent.SpriteRUID}, function()
			local clip = _ResourceService:LoadAnimationClipAndWait(self.Entity.SpriteRendererComponent.SpriteRUID)
			local firstFrameSprite = clip.Frames[1].FrameSprite
			local firstSpriteSizeInPixel = Vector2(firstFrameSprite.Width, firstFrameSprite.Height)
			local ppu = firstFrameSprite.PixelPerUnit
		
			self.SpriteSize = firstSpriteSizeInPixel / ppu
			self.PositionOffset = (firstSpriteSizeInPixel / 2 - firstFrameSprite.PivotPixel:ToVector2()) / ppu
		
			self.attackTimerId = _TimerService:SetTimerRepeat(function()
				if monster.IsDead == false then
					self:AttackNear()
				end
			end, self.AttackInterval)
		end)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 타이머를 남기면 몬스터가 죽어 사라진 뒤에도 유령 공격이 계속 돈다.
		-- 원래 이 스크립트에는 정리가 없었다 (PlayerAttack은 처음부터 있었다).
		if self.attackTimerId ~= 0 then
			_TimerService:ClearTimer(self.attackTimerId)
			self.attackTimerId = 0
		end
		-- 보스 스킬은 별도 타이머가 없다 — 평타 타이머 위에서 돌기 때문에
		-- 위의 attackTimerId 하나를 지우면 같이 멎는다 (StartBossSkills 주석).
	end

	---------------------------------------------------------------
	-- 보스 스킬 (T19-1)
	---------------------------------------------------------------

	method table UsableSkillIds()
		-- 이 몬스터가 쓸 스킬 목록. **새 컬럼을 만들지 않고 "주는 것"에서 그대로 유도한다** —
		-- 대표 지시가 "얻는 스킬을 사용"이므로 둘이 같아야 하고, 칸을 따로 두면
		-- 언젠가 어긋나 "안 주는 스킬을 쓰는 보스"가 생긴다.
		--
		--   npc_skill_ids  격파 지급 (히어로 계보 5종)   → 있으면 이쪽
		--   drop_skill_id  포획 지급 (돌 정령 바위 던지기) → 없으면 이쪽
		--
		-- 팔라딘·다크나이트가 붙어도 CSV만 채우면 따라온다.
		local npcSkills = _GameData:GetNpcSkillIds(self:MonsterIdOf())
		if #npcSkills > 0 then return npcSkills end

		local record = _GameData:GetMonster(self:MonsterIdOf())
		if record == nil then return {} end
		if record.drop_skill_id == "" then return {} end
		return { record.drop_skill_id }
	end

	method string MonsterIdOf()
		-- 이 엔티티의 MonsterTable id. RoomMonster가 소유한 값이라 거기서 읽는다.
		---@type RoomMonster
		local monster = self.Entity:GetComponent("script.RoomMonster")
		if monster == nil then return "" end
		return monster.MonsterId
	end

	@ExecSpace("ServerOnly")
	method void StartBossSkills(RoomMonster monster)
		-- 보스방의 몬스터만 스킬을 쓴다 (대표 선택 2026-08-23: 히어로 + 돌 정령).
		--
		-- 왜 종이 아니라 **방**으로 가르나: 돌 정령을 나중에 일반 사냥방에 세울 수 있다.
		-- 종에 플래그를 달면 그때 초반 방이 조용히 어려워진다. 보스 배율(T16-1)이
		-- 방으로 갈리는 것과 같은 기준이다.
		if monster:IsBossRoom() == false then return end

		local skillIds = self:UsableSkillIds()
		if #skillIds == 0 then return end

		local interval = _GameData:GetBalance("boss_skill_interval")
		if interval <= 0 then return end

		-- ## 스킬은 별도 타이머가 아니라 **평타 타이머 위**에서 돈다
		--
		-- 처음에는 스킬 전용 타이머를 따로 돌렸다. 그랬더니 **6번 중 3번이 아무 데미지도
		-- 안 났다** (실측). 원인은 i-frame이다 — 플레이어 무적 시간이 1초인데 보스 평타는
		-- 0.5초마다 나가므로, 스킬이 자기 평타가 만들어 둔 무적 구간에 떨어져 씹힌다.
		-- 에러도 로그도 없이 "스킬을 썼는데 안 아픈" 상태가 된다.
		--
		-- 그래서 스킬을 평타와 **같은 틱**에 태우고, 스킬을 쓴 틱은 평타를 건너뛴다.
		-- 한 틱에 한 방만 나가므로 자기 평타와 겹칠 자리가 없어진다.
		-- 겸사겸사 DPS도 묶인다 — 스킬이 평타에 **더해지는** 게 아니라 **대신 나간다**.
		self._T.bossSkills = skillIds
		self._T.skillReadyAt = {}        -- skillId -> 다시 쓸 수 있는 시각
		self._T.skillInterval = interval
		self._T.nextSkillAt = 0
		self._T.monster = monster

		local names = ""
		for i = 1, #skillIds do
			local s = _GameData:GetSkill(skillIds[i])
			names = names .. (i > 1 and " / " or "") .. (s ~= nil and s.name or skillIds[i])
		end
		log("[보스스킬] " .. monster.DisplayName .. " 준비 — " .. tostring(#skillIds)
			.. "종 [" .. names .. "]  " .. string.format("%.1f", interval) .. "초마다 시도")
	end

	@ExecSpace("ServerOnly")
	method boolean TryUseSkill()
		-- 이번 평타 틱을 스킬로 바꿔 쓸지. 실제로 나갔으면 true(= 평타를 건너뛴다).
		if self._T.bossSkills == nil then return false end
		if _UtilLogic.ElapsedSeconds < self._T.nextSkillAt then return false end

		local monster = self._T.monster
		if monster == nil or monster.IsDead then return false end

		-- 방이 비어 있으면 시도하지 않는다.
		--
		-- ⚠ 이 가드가 없으면 **아무도 없는 방에서 보스가 혼자 실드를 두른다** (실측:
		--   플레이어가 마을로 돌아간 뒤에도 12초 간격으로 아이언 바디가 계속 걸렸다).
		--   공격 스킬은 맞은 사람이 0명이라 저절로 걸러지지만, 실드는 대상이 필요 없어
		--   그냥 성공한다. 그러면 돌아왔을 때 이미 방어막을 두른 보스를 만나고,
		--   쿨다운도 빈 방에서 헛돈다.
		local map = self.Entity.CurrentMap
		if map == nil then return false end
		local users = _UserService:GetUsersByMapName(map.Name)
		if users == nil or #users == 0 then return false end

		-- 쿨다운이 돌지 않은 것 중 하나를 무작위로 쓴다.
		--
		-- 순서대로 돌리지 않는 이유: 5종을 순환하면 패턴이 외워져 두 번째 판부터
		-- 사건이 아니게 된다. 무작위면 매번 다르게 맞는다.
		local ready = {}
		for _, id in ipairs(self._T.bossSkills) do
			local readyAt = self._T.skillReadyAt[id]
			if readyAt == nil or _UtilLogic.ElapsedSeconds >= readyAt then
				ready[#ready + 1] = id
			end
		end
		if #ready == 0 then return false end

		local skillId = ready[_UtilLogic:RandomIntegerRange(1, #ready)]
		local skill = _GameData:GetSkill(skillId)
		if skill == nil then
			log_warning("[보스스킬] SkillTable에 없는 스킬: " .. tostring(skillId))
			return false
		end

		if self:CastSkill(monster, skill) == false then return false end

		-- **뭔가 일어났을 때만** 대가를 치른다. 사거리 밖이면 쿨다운도 주기도 걸지 않고
		-- 다음 틱에 다시 시도한다 — 안 그러면 플레이어가 멀리 서 있는 동안 5종이
		-- 전부 헛돌아 붙었을 때 쓸 스킬이 없어진다.
		--
		-- ⚠ 던지는 스킬은 **던진 것만으로 성공**이다 (T19-4). 닿을지는 0.35초 뒤에
		--   정해지므로 여기서 알 수 없고, 빗나갔다고 공짜로 다시 던지게 두면
		--   비켜서는 것이 아무 의미가 없어진다.
		if skill.cooldown > 0 then
			self._T.skillReadyAt[skillId] = _UtilLogic.ElapsedSeconds + skill.cooldown
		end
		self._T.nextSkillAt = _UtilLogic.ElapsedSeconds + self._T.skillInterval
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean CastSkill(RoomMonster monster, table skill)
		-- 실제 발동. **실제로 뭔가 일어났을 때만** true.
		if skill.skill_kind == "defense" then
			if skill.effect_type ~= "shield" then
				-- 회복(heal)은 아직 몬스터 쪽에 없다. 조용히 넘기면 "쿨다운은 도는데
				-- 아무 일도 안 나는 스킬"이 되므로 한 줄 남긴다.
				log_warning("[보스스킬] 몬스터가 쓸 수 없는 방어 효과라 건너뛴다: ["
					.. skill.name .. "] " .. tostring(skill.effect_type))
				return false
			end
			monster:ApplyShield(skill.effect_value, skill.duration)
			-- 방어 스킬은 대상이 없다. 자기 몸에 걸리는 연출이라 방향을 안 뒤집는다.
			_SkillEffect:PlayCast(skill.id, self.Entity, false)
			log("[보스스킬] " .. monster.DisplayName .. " [" .. skill.name .. "] 실드 "
				.. tostring(math.floor(skill.effect_value * 100)) .. "% / "
				.. tostring(skill.duration) .. "초")
			return true
		end

		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then return false end
		local worldPosition = transform.WorldPosition

		-- range가 0이면 몸 크기 상자 대신 플레이어 기본 반경을 쓴다. 스킬은 평타보다
		-- 멀리 닿아야 "스킬을 맞았다"가 되고, 안 그러면 붙어 있을 때만 나가는 두 번째 평타다.
		local radius = skill.range
		if radius <= 0 then radius = _GameData:GetBalance("player_attack_range") end

		-- 보스가 쓸 때는 반경을 깎는다 (T25-3, 대표 지시 "범위 3분의 2").
		--
		-- **왜 여기서만 깎나**: `SkillTable`의 `range`는 플레이어와 보스가 **같이 쓴다.**
		-- CSV를 줄이면 대표가 뺏어서 쓸 히어로 스킬까지 같이 좁아진다.
		-- 깎아야 하는 쪽은 보스뿐이라 쓰는 자리에서 곱한다.
		--
		-- 왜 필요한가: 사냥방은 28x16 = 448칸인데 시험의 방(mapjob)은 **16x9 = 144칸**이다.
		-- 사냥방 기준으로 잡은 반경 6.0을 그대로 쓰면 판정이 방의 78%를 덮어 못 피한다.
		radius = radius * _GameData:GetBalance("boss_skill_range_multiplier")

		-- 던지는 스킬은 여기서 갈라진다 (T19-4, 대표 지시 2026-08-23:
		-- "돌만 던져서 캐릭터에 갈때 데미지 들어가는거로").
		-- **판정 시점이 다르다** — 바위가 닿을 때 아프다.
		if skill.projectile_ruid ~= "" then
			return self:ThrowSkill(monster, skill, worldPosition, radius)
		end

		local shape = CircleShape(Vector2(worldPosition.x, worldPosition.y + 0.5), radius)

		self.hitLimited = (skill.max_targets > 0)
		self.hitBudget = math.floor(skill.max_targets)

		-- ⚠ 평타는 AttackFast인데 여기만 Attack이다. **맞았는지 알아야 하기 때문**이다 —
		--   AttackFast는 판정 테이블을 만들지 않아 void를 돌려준다(성능용). 스킬은
		--   빗나갔을 때 쿨다운을 안 걸어야 하므로 맞은 대상 목록이 필요하다.
		--   보스는 방에 하나뿐이라 테이블을 만드는 비용은 문제가 되지 않는다.
		local hits = self:Attack(shape, skill.id, CollisionGroups.Player)

		-- 다음 평타가 예산에 걸리지 않게 바로 푼다. Attack은 동기적으로 후보를
		-- 다 훑고 돌아오므로 여기서 풀어도 이번 판정에는 영향이 없다.
		self.hitLimited = false

		if hits == nil or #hits == 0 then
			-- 사거리 밖이거나 플레이어가 무적 구간(i-frame)이다. 나간 것으로 치지 않는다.
			-- **이펙트도 안 띄운다** — 안 맞은 스킬이 화면에는 터지면 무적 구간이
			-- 버그처럼 읽힌다.
			return false
		end

		-- 원작 이펙트·소리 (T19-2). 맞은 게 확인된 뒤에만 띄운다.
		-- 방향은 **맞은 대상 쪽**으로 잡는다. 몬스터가 지금 어디를 보고 있는지는
		-- 아바타냐 스프라이트냐에 따라 읽는 곳이 달라지는데(아바타는 Scale.x를 안 뒤집는다),
		-- 맞은 대상의 좌표는 어느 쪽이든 같은 방법으로 안다.
		local flip = false
		local firstHit = hits[1]
		if isvalid(firstHit) and isvalid(firstHit.Entity) then
			flip = (firstHit.Entity.TransformComponent.WorldPosition.x < worldPosition.x)
		end
		_SkillEffect:PlayCast(skill.id, self.Entity, flip)

		log("[보스스킬] " .. monster.DisplayName .. " [" .. skill.name
			.. "] 계수=" .. tostring(skill.coefficient)
			.. " 반경=" .. string.format("%.2f", radius)
			.. " 대상=" .. (skill.max_targets > 0 and ("최대 " .. tostring(math.floor(skill.max_targets))) or "제한 없음")
			.. " → " .. tostring(#hits) .. "명 명중")
		return true
	end

	---------------------------------------------------------------
	-- 던지는 스킬 (T19-4)
	---------------------------------------------------------------

	@ExecSpace("ServerOnly")
	method boolean ThrowSkill(RoomMonster monster, table skill, Vector3 fromPos, number radius)
		-- 던져서 **닿을 때** 아프게 한다 (대표 지시 2026-08-23).
		--
		-- T19-3에서는 바위가 순수한 그림이었다 — 던지는 순간 데미지가 이미 들어가고
		-- 바위는 뒤늦게 날아갔다. 그러면 바위가 몸에 닿기 전에 숫자가 뜬다.
		--
		-- 이제 순서가 뒤집힌다:
		--   1) 지금 조준할 사람을 고른다 (없으면 던지지 않는다)
		--   2) 바위를 그 자리로 날린다
		--   3) 바위가 도착하는 시각에 맞춰 **그 자리에서** 판정한다
		--
		-- 파생: **비켜서면 빗나간다.** 조준한 자리로 떨어지므로 날아오는 동안 움직이면
		-- 안 맞는다. 보스가 원거리 견제를 갖게 된 대가로 플레이어에게 회피가 생긴다.
		local map = self.Entity.CurrentMap
		if map == nil then return false end
		local users = _UserService:GetUsersByMapName(map.Name)
		if users == nil then return false end

		-- 사거리 안에서 가장 가까운 사람. 허공에 던지면 쿨다운만 헛돈다.
		local target = nil
		local best = radius
		for i = 1, #users do
			local u = users[i]
			if isvalid(u) then
				local p = u.TransformComponent.WorldPosition
				local dx = p.x - fromPos.x
				local dy = p.y - fromPos.y
				local dist = math.sqrt(dx * dx + dy * dy)
				if dist <= best then
					best = dist
					target = u
				end
			end
		end
		if target == nil then return false end

		local toPos = target.TransformComponent.WorldPosition
		_SkillEffect:PlayCast(skill.id, self.Entity, toPos.x < fromPos.x)
		_SkillEffect:PlayProjectile(skill.id, self.Entity, toPos)

		-- 바위와 **같은 시간**을 쓴다. 두 값이 갈라지면 숫자와 그림이 어긋난다.
		local flight = _GameData:GetBalance("projectile_seconds")
		local skillId = skill.id
		local maxTargets = skill.max_targets
		_TimerService:SetTimerOnce(function()
			self:ResolveThrowHit(skillId, toPos, maxTargets)
		end, flight)

		log("[보스스킬] " .. monster.DisplayName .. " [" .. skill.name
			.. "] 던짐 → " .. string.format("%.1f,%.1f", toPos.x, toPos.y)
			.. "  " .. string.format("%.2f", flight) .. "초 뒤 착탄")
		return true
	end

	@ExecSpace("ServerOnly")
	method void ResolveThrowHit(string skillId, Vector3 pos, number maxTargets)
		-- 바위가 떨어지는 순간의 판정. 던진 자리가 아니라 **떨어진 자리**를 본다.
		--
		-- 날아가는 동안 몬스터가 죽거나 방이 내려갔을 수 있다. 그래도 바위는
		-- 떨어지는 게 맞지만, 판정 주체(self)가 사라졌으면 아무것도 못 한다.
		if not isvalid(self.Entity) then return end

		local skill = _GameData:GetSkill(skillId)
		if skill == nil then return end

		self.hitLimited = (maxTargets > 0)
		self.hitBudget = math.floor(maxTargets)

		local r = _GameData:GetBalance("projectile_hit_radius")
		local hits = self:Attack(
			CircleShape(Vector2(pos.x, pos.y + 0.5), r), skillId, CollisionGroups.Player)

		self.hitLimited = false

		local n = 0
		if hits ~= nil then n = #hits end
		log("[착탄] " .. skill.name .. "  " .. string.format("%.1f,%.1f", pos.x, pos.y)
			.. "  반경 " .. string.format("%.2f", r)
			.. " → " .. tostring(n) .. "명" .. (n == 0 and "  (비켜섰다)" or ""))
	end

	method string ClipForState(string stateName)
		-- 상태 이름 → ActionSheet 키 → 클립 RUID. 자세를 푼 뒤 되돌릴 그림을 찾는다.
		-- 매핑은 엔진의 StateStringToAnimationKey 기본값과 같다 (animation-state.md 6a).
		local anim = self.Entity.StateAnimationComponent
		if not isvalid(anim) then return "" end

		local key = "stand"
		if stateName == "MOVE" then key = "move"
		elseif stateName == "HIT" then key = "hit"
		elseif stateName == "DEAD" then key = "die"
		elseif stateName == "ATTACK" then key = "attack" end

		local ruid = anim.ActionSheet[key]
		if ruid == nil then return "" end
		return ruid
	end

	@ExecSpace("ServerOnly")
	method void PlayAttackPose()
		-- 공격 클립을 잠깐 보여 준다. 데미지와 무관한 연출 전용 경로다.
		--
		-- ⚠ 여기는 상태머신을 쓰지 않는다. 원래 ChangeState("ATTACK")로 만들었는데
		--   **AIChaseComponent가 0.1초 안에 되돌린다.** 실측:
		--       ATTACK 건 뒤 0.1초 간격 12회 → ATTACK IDLE IDLE IDLE ...
		--   AIChase는 매 프레임 자기 BT를 돌려 IDLE/MOVE를 다시 쓰기 때문에,
		--   상태로 건 공격 자세는 한두 프레임 만에 사라져 화면에 안 보인다.
		--   그래서 SpriteRUID를 직접 갈아끼우는 방식(animation-state.md 0의 Pattern A)으로
		--   우회한다. 상태를 안 건드리므로 AIChase와 싸우지 않는다.
		local sc = self.Entity.StateComponent
		if isvalid(sc) and sc.CurrentStateName == "DEAD" then return end

		-- 아바타 몬스터(히어로 — T16-3b)는 여기서 갈라진다. SpriteRendererComponent가
		-- 아예 없어서 위의 "그림을 갈아끼운다"가 성립하지 않는다 (T25-4).
		local sprite = self.Entity.SpriteRendererComponent
		if not isvalid(sprite) then
			if isvalid(self.Entity.AvatarRendererComponent) then
				self:PlayAvatarAttackPose()
			end
			return
		end

		local attackRuid = self:ClipForState("ATTACK")
		if attackRuid == "" then return end
		if self.poseUntil > 0 then return end   -- 이미 공격 자세 중이면 겹쳐 걸지 않는다

		self.poseUntil = 1
		sprite.SpriteRUID = attackRuid

		if self.poseLogLeft > 0 then
			self.poseLogLeft = self.poseLogLeft - 1
			log("[MonsterAttack] 공격 모션 재생 (" .. tostring(self.Entity.Name)
				.. ")  상태=" .. tostring(isvalid(sc) and sc.CurrentStateName or "?"))
		end

		_TimerService:SetTimerOnce(function()
			self.poseUntil = 0
			if not isvalid(self.Entity) then return end
			local sp = self.Entity.SpriteRendererComponent
			if not isvalid(sp) then return end
			-- 지금 상태에 맞는 그림으로 되돌린다. 자세 중에 죽었으면 die가 이긴다.
			local cur = isvalid(sc) and sc.CurrentStateName or "IDLE"
			local back = self:ClipForState(cur)
			if back ~= "" then sp.SpriteRUID = back end
		end, self.AttackPoseSeconds)
	end

	@ExecSpace("ServerOnly")
	method void PlayAvatarAttackPose()
		-- 아바타 몬스터의 공격 모션 (T25-4).
		--
		-- **왜 상태(ChangeState)로 안 하나**: 스프라이트 몬스터와 같은 이유다 —
		-- AIChase가 매 프레임 IDLE/MOVE를 다시 써서 ATTACK 자세가 한두 프레임에 사라진다.
		--
		-- **왜 `BodyActionStateChangeEvent`가 아니라 `ActionStateChangedEvent`인가**:
		-- 전자는 14개 내장 상태(Attack 등)를 거치는데, 그러면 `AvatarStateAnimationComponent`가
		-- 다시 개입해 무기별 클립을 고른다 — AIChase가 상태를 되돌릴 때 같이 지워진다.
		-- 후자는 **그림 이름을 몸에 직접** 보내므로 상태머신을 타지 않는다.
		-- (스프라이트 몬스터에서 SpriteRUID를 직접 갈아끼운 것과 같은 판단이다.)
		if self.poseUntil > 0 then return end   -- 이미 자세 중이면 겹쳐 걸지 않는다
		local sc = self.Entity.StateComponent
		if isvalid(sc) and sc.CurrentStateName == "DEAD" then return end

		self.poseUntil = 1
		self:SendAvatarAction(self.AvatarAttackAction, false)

		-- 끝나면 지금 상태에 맞는 동작으로 **되돌린다.**
		--
		-- ⚠ 안 되돌리면 마지막 프레임에서 굳는다. `Onetime`은 한 번 재생하고 **멈추기**
		--   때문이다. 스프라이트 몬스터 쪽이 자세 뒤에 `ClipForState`로 되돌리는 것과 같다.
		--
		-- ⚠⚠ **`AvatarStateAnimationComponent`가 대신 고쳐 주지 않는다.** 실측:
		--   공격이 도는 동안에도 셀렉터는 계속 `Walk|MOVE`였다 — 우리 이벤트가
		--   셀렉터를 거치지 않고 몸의 스프라이트로 바로 가기 때문이다. 상태가 안 바뀌니
		--   저쪽은 다시 보낼 일이 없고, 되돌리는 것은 우리 몫이다.
		_TimerService:SetTimerOnce(function()
			self.poseUntil = 0
			if not isvalid(self.Entity) then return end
			local s = self.Entity.StateComponent
			local cur = isvalid(s) and s.CurrentStateName or "IDLE"
			if cur == "DEAD" then return end
			local back = self.AvatarIdleAction
			if cur == "MOVE" then back = self.AvatarWalkAction end
			self:SendAvatarAction(back, true)
		end, self.AttackPoseSeconds)
	end

	@ExecSpace("ServerOnly")
	method void SendAvatarAction(string actionName, boolean loop)
		-- 그 방에 있는 사람에게만 보낸다 (SkillEffect.PlayCast와 같은 방식).
		-- Multicast를 쓰면 다른 맵 사람의 클라에는 이 엔티티가 없어 조용히 nil이 된다.
		if actionName == "" then return end
		local map = self.Entity.CurrentMap
		if map == nil then return end
		local users = _UserService:GetUsersByMapName(map.Name)
		if users == nil then return end

		if self.poseLogLeft > 0 then
			self.poseLogLeft = self.poseLogLeft - 1
			log("[MonsterAttack] 아바타 동작 [" .. actionName .. "] "
				.. (loop and "반복" or "1회") .. " (" .. tostring(self.Entity.Name)
				.. ")  받는 사람 " .. tostring(#users) .. "명")
		end

		for i = 1, #users do
			local pc = users[i].PlayerComponent
			if isvalid(pc) then
				self:ShowAvatarAction(actionName, loop, pc.UserId)
			end
		end
	end

	@ExecSpace("Client")
	method void ShowAvatarAction(string actionName, boolean loop)
		-- 실제 재생. 연출 전용이라 여기서 아무것도 못 그려도 데미지는 이미 들어갔다.
		--
		-- ⚠ `GetBodyEntity()`는 ClientOnly다 — 서버에서 부르면 nil이라 여기서만 부른다.
		-- ⚠ 이벤트는 **아바타 루트가 아니라 몸 엔티티**로 보내야 한다 (msw-avatar).
		-- ⚠ `PartsActionName`을 비우면 몸만 움직이고 **무기가 그 자리에 멈춘다.**
		local renderer = self.Entity.AvatarRendererComponent
		if not isvalid(renderer) then return end
		local body = renderer:GetBodyEntity()
		if not isvalid(body) then return end

		local event = ActionStateChangedEvent()
		event.CoreActionName = actionName
		event.PartsActionName = actionName
		event.PlayRate = self.AvatarAttackPlayRate
		if loop then
			event.PlayRate = 1
			event.PlayType = SpriteAnimClipPlayType.Loop
		else
			event.PlayType = SpriteAnimClipPlayType.Onetime
		end
		body:SendEvent(event)
	end

	method void AttackNear()
		-- 보스는 이번 틱을 스킬로 바꿔 쓸 수 있다 (T19-1). 스킬이 나갔으면 평타는 쉰다 —
		-- 한 틱에 두 방이 나가면 스킬이 자기 평타의 i-frame에 씹힌다 (StartBossSkills 주석).
		if self:TryUseSkill() then return end

		-- Recompute the rotated/scaled attack box each tick before AttackFast.
		local transformComponent = self.Entity.TransformComponent
		
		if isvalid(transformComponent) then
			local worldPosition = transformComponent.WorldPosition
			local scaleX = transformComponent.Scale.x
			local scaleY = transformComponent.Scale.y
			local radian = math.rad(transformComponent.ZRotation)
			local offsetX = math.cos(radian) * self.PositionOffset.x * scaleX - math.sin(radian) * self.PositionOffset.y * scaleY
			local offsetY = math.sin(radian) * self.PositionOffset.x * scaleX + math.cos(radian) * self.PositionOffset.y * scaleY
			self.Shape.Size = Vector2(self.SpriteSize.x * math.abs(scaleX), self.SpriteSize.y * math.abs(scaleY))
			self.Shape.Position = Vector2(worldPosition.x + offsetX, worldPosition.y + offsetY)
			self.Shape.Angle = transformComponent.ZRotation
		end
		
		self:AttackFast(self.Shape, nil, CollisionGroups.Player)
	end

	method void OnAttack(Entity defender)
		-- 실제로 뭔가를 맞혔을 때만 불린다. 공격 모션을 여기에 거는 이유다.
		--
		-- AttackNear 쪽에 걸었더니 몬스터가 **허공에 계속 공격 모션**을 했다.
		-- 이 스크립트의 타이머는 플레이어가 근처에 있든 없든 0.5초마다 AttackFast를
		-- 쏘기 때문이다 (사거리 판정은 Shape 겹침이 대신한다). 실측 로그에서
		-- 스폰 직후부터 슬라임 3마리가 쉬지 않고 ATTACK으로 전환됐다.
		--
		-- ⚠ 부모 AttackComponent.OnAttack에는 @ExecSpace가 없다. 붙이면 LEA-3014다.
		self:PlayAttackPose()
		self:PlayAttackSfx(defender)
	end

	@ExecSpace("ServerOnly")
	method void PlayAttackSfx(Entity defender)
		-- 맞은 사람에게만 소리를 들려준다.
		--
		-- _SoundService:PlaySound는 @ExecSpace("Client")다. 서버에서 부르면 클라로
		-- RPC가 가는데, 대상을 안 주면 어디로 갈지가 불분명하다. 맞은 당사자의
		-- UserId를 마지막 인자로 넘겨 그 사람 클라에서만 울리게 한다.
		-- (다른 방 사람에게까지 들리면 안 된다.)
		if self.AttackSfxRuid == "" then return end
		if not isvalid(defender) then return end

		local pc = defender.PlayerComponent
		if not isvalid(pc) then return end

		_SoundService:PlaySound(self.AttackSfxRuid, self.AttackSfxVolume, pc.UserId)
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		-- 몬스터 → 플레이어 데미지. 플레이어 → 몬스터와 **같은 공식**을 쓴다
		-- (계수 x ATK^2 / (ATK+DEF), CombatFormula 한 곳에만 둔다).
		-- 여기서 플레이어 DEF가 처음으로 쓰인다 — 기획서 4.7의 "DEF = 생존(통합 방어)".
		--
		-- ⚠ 부모 AttackComponent.CalcDamage에는 @ExecSpace가 없다.
		--   여기에 붙이면 LEA-3014 SignatureMismatch가 난다 (PlayerAttack과 같은 함정).
		--
		-- 오버라이드 전에는 부모 기본값 1이었는데, PlayerHit에 HP를 깎는 코드가
		-- 아예 없어서 실제로는 0이었다 (T10-3 실측: 4초간 맞아도 HP 1000 → 1000).
		local atk = 0
		---@type RoomMonster
		local mon = attacker:GetComponent("script.RoomMonster")
		if mon ~= nil then atk = mon.Atk end

		local def = 0
		---@type PlayerStats
		local stats = defender:GetComponent("script.PlayerStats")
		if stats ~= nil then def = stats:GetTotalDef() end

		-- attackInfo에 스킬 id가 실려 오면 그 계수를, 평타(nil)면 기준 계수를 쓴다 (T19-1).
		--
		-- ⚠ 몬스터에는 스탯이 Atk 하나뿐이라 **스킬의 scaling_stat은 무시된다.**
		--   지금 보스가 쓰는 스킬(히어로 계보 5종 · 바위 던지기)이 전부 ATK라 어긋나지
		--   않지만, INT/LUK 계수 스킬을 보스에게 주면 조용히 ATK로 계산된다.
		--   그때는 몬스터에도 계수 스탯을 만들어야 한다 — CSV만 고치면 안 된다.
		local damage = _CombatFormula:CalcSkillDamage(atk, def, attackInfo)

		-- 스킬로 때린 것이면 보스 배율을 깎는다 (T25-3, 대표 지시 "데미지 4분의 1").
		--
		-- 평타는 안 깎는다 — 여기서 줄여야 하는 것은 **스킬이 평타보다 훨씬 아픈 것**이지
		-- 보스의 기본 화력이 아니다. 보스 ATK는 이미 `boss_atk_multiplier`로 x3이라,
		-- 그 위에 스킬 계수(최대 2.3)까지 그대로 곱하면 두 대에 죽는다 —
		-- 스킬을 뺏으러 온 사람이 스킬을 못 얻는다.
		--
		-- ⚠ **플레이어가 같은 스킬을 쓸 때는 안 깎인다.** `SkillTable`은 양쪽이 공유하므로
		--   CSV 계수를 줄이면 플레이어 쪽 히어로 스킬이 자동 공격(1.2)보다 약해진다.
		if attackInfo ~= nil and attackInfo ~= "" and _GameData:GetSkill(attackInfo) ~= nil then
			local m = _GameData:GetBalance("boss_skill_damage_multiplier")
			if m > 0 and m < 1 then
				damage = math.floor(damage * m + 0.5)
				if damage < 1 then damage = 1 end
			end
		end

		-- 실드 감쇄 (T17-3b). **여기서** 깎는 이유: CalcDamage가 돌려주는 값이 곧
		-- 화면에 뜨는 데미지 숫자다. OnHit에서 깎으면 숫자는 그대로인데 HP만 덜 닳아
		-- "실드가 먹었는지"가 화면에서 안 읽힌다.
		local reduceText = ""
		---@type PlayerHit
		local hit = defender:GetComponent("script.PlayerHit")
		if hit ~= nil then
			local reduction = hit:GetDamageReduction()
			if reduction > 0 then
				local before = damage
				damage = math.floor(damage * (1 - reduction) + 0.5)
				-- CombatFormula와 같은 규칙으로 최소 1을 보장한다. 0이 뜨면
				-- "안 맞았다"로 보여서 실드가 무적처럼 읽힌다.
				if damage < 1 then damage = 1 end
				reduceText = "  [실드 " .. tostring(math.floor(reduction * 100)) .. "% : "
					.. tostring(before) .. " → " .. tostring(damage) .. "]"
			end
		end

		local skillText = "평타"
		if attackInfo ~= nil and attackInfo ~= "" then
			local sk = _GameData:GetSkill(attackInfo)
			skillText = "[" .. (sk ~= nil and sk.name or attackInfo) .. "]"
		end

		log("[MonsterAttack] " .. tostring(mon ~= nil and mon.DisplayName or "?")
			.. " " .. skillText
			.. " ATK=" .. tostring(atk) .. " vs 플레이어 DEF=" .. tostring(def)
			.. " → 데미지 " .. tostring(damage) .. reduceText)
		return damage
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		-- Restrict the attack to Player entities; delegate to base rules.
		--
		-- ⚠ 부모 AttackComponent.IsAttackTarget에는 @ExecSpace가 없다 — 붙이면 LEA-3014.
		if isvalid(defender.PlayerComponent) == false then
			return false
		end

		if __base:IsAttackTarget(defender, attackInfo) == false then return false end

		-- 대상 수 제한 (T19-1). 평타는 hitLimited=false라 그대로 통과한다.
		if self.hitLimited == false then return true end
		if self.hitBudget <= 0 then return false end

		self.hitBudget = self.hitBudget - 1
		return true
	end

end