-- @서버 (HP 차감·사망 판정은 전부 서버. 클라는 동기화된 값을 읽기만 한다)
--
-- 방에 배치되는 몬스터의 데이터 소유자.
-- 수치는 MonsterTable에서 읽는다 — .model에 HP를 박아두면 시트와 어긋난다 (개발 규칙 3).
--
-- 샘플 Monster.mlua를 쓰지 않고 따로 만든 이유:
--   샘플은 HP를 인스펙터 값으로 받고, 사망 전이를 .model의 StateSet(ConditionIsDead)에
--   맡긴다. 우리는 HP를 데이터 테이블에서 가져와야 하고 StateSet도 두지 않아서
--   ChangeState("DEAD")를 직접 호출한다 (monster.md §7a 정본과 같은 방식).
--
-- 슬라이스 범위(작업지시서 T3): 몬스터 AI는 '제자리 + 피격 반응'까지만.
-- 그래서 이동·추격 로직이 없고 AIChase/AIWander도 붙이지 않는다.

@Component
script RoomMonster extends Component

    -- MonsterTable의 id. 같은 모델로 여러 몬스터를 만들 때 이 값만 바꾼다.
    property string MonsterId = "m_slime"

    -- 죽은 뒤 다시 살아날지. 방 단위 리스폰은 T3-2b에서 스포너가 관리한다.
    property boolean RespawnOn = false
    property number RespawnDelay = 5
    -- 사망 연출(die 클립)이 보일 시간. 이 뒤에 숨기거나 파괴한다.
    property number DestroyDelay = 0.8

    -- 테이블에서 읽어온 확정 수치. 클라 표시(HP바 등)를 위해 동기화한다.
    @Sync property number MaxHp = 0
    @Sync property number Hp = 0
    @Sync property number Def = 0
    -- 플레이어를 때릴 때 쓰는 공격력. MonsterTable에 atk 컬럼이 없어 곡선에서 유도한다
    -- (LevelCurve.MonsterAtkAtLevel — 2026-08-13 실플레이로 확정, T10-3c).
    @Sync property number Atk = 0
    @Sync property number ExpReward = 0
    @Sync property string DisplayName = ""
    @Sync @HideFromInspector property boolean IsDead = false

    @ExecSpace("ServerOnly")
    method string MapName()
        -- 이 몬스터가 서 있는 맵 이름. 방 레코드를 역인덱스할 때 쓴다
        -- (RoomCamera / RoomSpawner와 같은 방식).
        -- 스포너가 맵 엔티티를 parent로 넘겨 스폰하므로 CurrentMap이 그 맵이다.
        local map = self.Entity.CurrentMap
        if map == nil then return "" end
        return map.Name
    end

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        local record = _GameData:GetMonster(self.MonsterId)
        if record == nil then
            -- 조용히 HP 0으로 두면 스폰하자마자 죽는 유령이 된다. 크게 남긴다.
            log_error("[RoomMonster] MonsterTable에 없는 id: " .. tostring(self.MonsterId))
            return
        end

        self.DisplayName = record.name
        self.MaxHp = record.hp
        self.Def = record.def
        self.ExpReward = record.exp
        local level = record.level
        self.Atk = _LevelCurve:MonsterAtkAtLevel(level)

        -- 방이 레벨을 덮어쓰면(RoomTable.monster_level) 수치를 곡선에서 다시 계산한다.
        -- MonsterTable의 확정값은 그 몬스터의 기본 레벨에서만 맞기 때문이다.
        --
        -- 왜 방이 레벨을 정하는가 (T9-2 실측 → T10-2): 상시 몬스터가 Lv5에서 멈춰
        -- ATK 45(Lv8)면 모든 방이 1타가 됐고, 그 위 22레벨이 사냥 속도에 아무 영향이
        -- 없었다. 방마다 계단을 두면 1타 상한이 뒤로 밀리고 후반 킬 수도 줄어든다.
        local room = _GameData:GetRoomByMapName(self:MapName())
        if room ~= nil and room.monster_level > 0 then
            level = math.floor(room.monster_level)
            self.MaxHp = _LevelCurve:MonsterHpAtLevel(level)
            self.Def = _LevelCurve:MonsterDefAtLevel(level)
            self.ExpReward = _LevelCurve:MonsterExpAtLevel(level)
            self.Atk = _LevelCurve:MonsterAtkAtLevel(level)
        end

        -- 보스는 같은 레벨의 일반 몬스터보다 훨씬 세다 (T16-1, 대표 지시 2026-08-14).
        --
        -- 왜 필요했나: 보스가 곡선값 그대로라 "레벨 높은 잡몹"이었다. 재입장마다
        -- 다시 서게 만들면서(RoomSpawner) 반복할 수 있게 됐으니, 반복할 값어치가
        -- 있으려면 한 판이 사건이어야 한다.
        --
        -- 배율을 스탯별로 나눠 둔 이유: **ATK만 따로 낮출 일이 온다.** ATK 3배는
        -- 플레이어 DEF 10 기준 피격 242 = 4대에 죽는 수치다(i-frame 1초라 약 4초).
        -- 세다고 느껴지면 boss_atk_multiplier부터 내린다 — HP·EXP는 그대로 두고.
        local isBoss = (room ~= nil and room.room_type == "boss")
        if isBoss then
            self.MaxHp = self.MaxHp * _GameData:GetBalance("boss_hp_multiplier")
            self.Def = self.Def * _GameData:GetBalance("boss_def_multiplier")
            self.Atk = self.Atk * _GameData:GetBalance("boss_atk_multiplier")
            self.ExpReward = self.ExpReward * _GameData:GetBalance("boss_exp_multiplier")
        end

        self.Hp = self.MaxHp
        self.IsDead = false

        log("[RoomMonster] 스폰 " .. record.name .. "(" .. self.MonsterId .. ")"
            .. " Lv" .. tostring(level)
            .. (level ~= record.level and " (방 지정)" or "")
            .. (isBoss and " [보스 배율]" or "")
            .. " HP=" .. tostring(self.MaxHp)
            .. " DEF=" .. tostring(self.Def)
            .. " ATK=" .. tostring(self.Atk)
            .. " EXP=" .. tostring(self.ExpReward))
    end

    ---------------------------------------------------------------
    -- 피격 → 사망
    ---------------------------------------------------------------

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandleHitEvent(HitEvent event)
        -- 데미지는 공격자(PlayerAttack)가 서버에서 이미 계산해 넣은 값이다.
        -- 여기서 다시 계산하지 않는다 — 계산 지점이 둘이면 반드시 어긋난다.
        local originalHp = self.Hp
        self.Hp = self.Hp - event.TotalDamage

        log("[RoomMonster] 피격 " .. self.DisplayName
            .. "  -" .. tostring(event.TotalDamage)
            .. "  HP " .. tostring(originalHp) .. " → " .. tostring(math.max(self.Hp, 0)))

        -- 이미 죽은 몬스터에 늦게 도착한 타격으로 Dead가 두 번 돌지 않게 막는다.
        if self.Hp > 0 or originalHp <= 0 then return end
        self:Dead(event.AttackerEntity)
    end

    @ExecSpace("ServerOnly")
    method void GrantBossReward(Entity killer)
        -- 보스방에서 죽었으면 막타 주체의 몬스터 슬롯을 늘린다 (기획서 T6).
        --
        -- 어느 몬스터가 보스인지는 몬스터가 아니라 **방**이 정한다
        -- (RoomTable.room_type == "boss"). 보스 전용 플래그를 몬스터에 두면
        -- 같은 종을 다른 방에 배치할 때 데이터가 두 곳으로 갈라진다.
        local map = self.Entity.CurrentMap
        if map == nil then return end

        local room = _GameData:GetRoomByMapName(map.Name)
        if room == nil then return end
        if room.room_type ~= "boss" then return end

        ---@type PlayerSkillSlots
        local slots = killer:GetComponent("script.PlayerSkillSlots")
        if slots == nil then return end
        slots:ClearBoss(room.id)
    end

    @ExecSpace("ServerOnly")
    method void Dead(Entity killer)
        self.IsDead = true
        self.Hp = 0

        local stateComp = self.Entity.StateComponent
        if isvalid(stateComp) then stateComp:ChangeState("DEAD") end

        -- EXP는 막타를 넣은 쪽에 준다. killer는 HitEvent.AttackerEntity라 nil일 수 있고
        -- (환경 피해 등) 이미 파괴된 엔티티일 수도 있어 isvalid로 먼저 거른다.
        if isvalid(killer) then
            ---@type PlayerStats
            local stats = killer:GetComponent("script.PlayerStats")
            if stats ~= nil then
                stats:AddExp(self.ExpReward)
                log("[RoomMonster] 사망 " .. self.DisplayName .. "  EXP " .. tostring(self.ExpReward) .. " 지급")

                -- 포획은 처치 시 자동 판정이다 (기획서 4.8). EXP와 같은 막타 주체에게 준다.
                ---@type PlayerCollection
                local collection = killer:GetComponent("script.PlayerCollection")
                if collection ~= nil then
                    collection:TryCapture(self.MonsterId)
                end

                -- 아이템 드랍 (T13-6). 판정과 스폰은 ItemDrop이 한다 —
                -- 몬스터 스크립트가 아이템 시스템을 알 필요는 없다.
                _ItemDrop:TrySpawnDrops(self.MonsterId,
                    self.Entity.TransformComponent.WorldPosition,
                    self.Entity.CurrentMap, killer)

                self:GrantBossReward(killer)
            else
                log_warning("[RoomMonster] 막타 엔티티에 PlayerStats가 없어 EXP 미지급: " .. tostring(killer.Name))
            end
        else
            log_warning("[RoomMonster] 막타 주체가 없어 EXP 미지급: " .. self.DisplayName)
        end

        local delayHide = function()
            self.Entity:SetVisible(false)
            self.Entity:SetEnable(false)
            if self.RespawnOn == false then self.Entity:Destroy() end
        end
        _TimerService:SetTimerOnce(delayHide, self.DestroyDelay)

        if self.RespawnOn then
            _TimerService:SetTimerOnce(function() self:Respawn() end, self.RespawnDelay)
        end
    end

    @ExecSpace("ServerOnly")
    method void Respawn()
        self.IsDead = false
        self.Entity:SetVisible(true)
        self.Entity:SetEnable(true)
        self.Hp = self.MaxHp

        local stateComp = self.Entity.StateComponent
        -- DEAD에서는 IDLE로만 나올 수 있다 (DEAD 락 — animation-state.md §4.5).
        if isvalid(stateComp) then stateComp:ChangeState("IDLE") end

        log("[RoomMonster] 리스폰 " .. self.DisplayName .. "  HP=" .. tostring(self.Hp))
    end

end
