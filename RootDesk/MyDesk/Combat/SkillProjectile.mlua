@Component
script SkillProjectile extends Component

	@HideFromInspector
	property Vector3 TargetPos = Vector3(0, 0, 0)

	@HideFromInspector
	property number FlightLeft = 0

	@HideFromInspector
	property number FlightTotal = 0

	@HideFromInspector
	property Vector3 StartPos = Vector3(0, 0, 0)

	@HideFromInspector
	property number SpinSeconds = 0

	@ExecSpace("ServerOnly")
	method void Launch(Vector3 fromPos, Vector3 toPos, number seconds, number spinSeconds)
		        -- 스폰한 쪽이 바로 부른다. 여기서부터 OnUpdate가 옮기기 시작한다.
		        if seconds <= 0 then seconds = 0.25 end
		        self.StartPos = fromPos
		        self.TargetPos = toPos
		        self.FlightTotal = seconds
		        self.FlightLeft = seconds
		        self.SpinSeconds = spinSeconds
		        self.Entity.TransformComponent.WorldPosition = fromPos
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		        -- 아직 Launch를 안 받았으면 가만히 있는다 (스폰 프레임에 한 번 걸린다).
		        if self.FlightTotal <= 0 then return end
		
		        self.FlightLeft = self.FlightLeft - delta
		        if self.FlightLeft <= 0 then
		            -- 도착. 남겨 두면 바위가 대상 위에 계속 얹혀 있다.
		            self.Entity:Destroy()
		            return
		        end
		
		        -- 지나온 비율로 위치를 정한다. 속도를 누적하지 않는 이유: 프레임이 튀어도
		        -- **도착 지점이 정확히 목적지**가 된다. 누적이면 조금씩 어긋난다.
		        local t = 1 - (self.FlightLeft / self.FlightTotal)
		        local transform = self.Entity.TransformComponent
		        if not isvalid(transform) then return end
		
		        local x = self.StartPos.x + (self.TargetPos.x - self.StartPos.x) * t
		        local y = self.StartPos.y + (self.TargetPos.y - self.StartPos.y) * t
		
		        -- 던진 것처럼 보이게 포물선을 얹는다. 직선으로만 가면 미끄러지는 느낌이라
		        -- "던졌다"가 아니라 "밀려갔다"로 읽힌다. 최고점은 중간(t=0.5)이다.
		        local arc = _GameData:GetBalance("projectile_arc_height")
		        y = y + arc * 4 * t * (1 - t)
		
		        transform.WorldPosition = Vector3(x, y, self.StartPos.z)
		
		        -- 돌면서 날아간다. 바위가 굴러가는 느낌을 준다.
		        if self.SpinSeconds > 0 then
		            transform.ZRotation = transform.ZRotation - (360 * delta / self.SpinSeconds)
		        end
	end

end