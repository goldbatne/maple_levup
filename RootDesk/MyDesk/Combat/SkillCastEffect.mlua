@Component
script SkillCastEffect extends Component

	@HideFromInspector
	property number Life = 0

	@HideFromInspector
	property number LifeTotal = 0

	@HideFromInspector
	property string Style = ""

	@HideFromInspector
	property Vector3 Drift = Vector3(0, 0, 0)

	@HideFromInspector
	property number BaseScale = 1

	@HideFromInspector
	property number BaseAlpha = 1

	@HideFromInspector
	property string DebugName = ""

	@HideFromInspector
	property Entity FollowTarget = nil

	@HideFromInspector
	property Vector3 FollowOffset = Vector3(0, 0, 0)

	@HideFromInspector
	property table FrameRUIDs = {}

	@HideFromInspector
	property number FrameSeconds = 0.1

	@HideFromInspector
	property integer CurrentFrame = 0

	@HideFromInspector
	property boolean Playing = false

	@ExecSpace("ServerOnly")
	method void Play(string style, number seconds, Vector3 drift)
		        -- 스폰한 쪽이 바로 부른다. 여기서부터 OnUpdate가 움직인다.
		        -- 초기화 중에는 OnUpdate가 수명을 소진하거나 엔티티를 파괴하지 않는다.
		        self.Playing = false
		        if seconds <= 0 then seconds = 0.4 end
		        self.Style = style
		        self.LifeTotal = seconds
		        self.Life = seconds
		        self.Drift = drift
		        -- 첫 프레임부터 제 크기로 보이게 미리 한 번 적용한다. 안 하면 스폰 프레임에
		        -- 원본 크기(1.0)로 한 번 번쩍인다.
		        self:Apply(0)
		        self.Playing = true
	end

	method void Apply(number t)
		        -- t = 0(막 나왔다) ~ 1(사라진다). 스타일마다 크기·투명도·회전이 다르다.
		        --
		        -- 수치를 GameBalance로 빼지 않은 이유: 이건 밸런스가 아니라 **그림의 정의**다.
		        -- 고리가 커지며 옅어지는 것은 "푸른 껍질이 어떻게 생겼나"의 일부고,
		        -- 그림을 다시 그리면 같이 바뀐다. 데이터로 빼면 둘이 따로 논다.
		        local transform = self.Entity.TransformComponent
		        if not isvalid(transform) then return end
		        local sprite = self.Entity.SpriteRendererComponent
		
		        local scale = 1.0
		        local alpha = 1.0
		        local spin = 0.0
		
		        -- ⚠ 크기는 **캐릭터(약 1.4 유닛)보다 커야 보인다.** 처음에 0.7~1.5로 뒀더니
		        --   그림 96px = 1유닛이라 사람만 해서 연출로 안 읽혔다 (실측).
		        --
		        -- ⚠ **투명도는 끝에서만 뺀다.** 처음에 `1 - t`나 `1 - t²`로 처음부터 옅어지게
		        --   했더니 뜨자마자 배경에 묻혀 "번쩍했나?" 수준이 됐다 (실측). 0.4초짜리
		        --   연출은 **보이는 시간이 짧아서** 대부분을 불투명하게 둬야 눈에 남는다.
		        local fadeFrom = 0.6
		        if self.Style == "burst" then
		            -- 부딪히는 충격: 확 커진다. 조금 돌려 같은 그림이 반복돼 보이지 않게 한다.
		            scale = 0.8 + 1.9 * t
		            spin = 90 * t
		        elseif self.Style == "ring" then
		            -- 감싸는 방어막: 천천히 커진다. 안 돈다 — 돌면 고리가 어지럽다.
		            scale = 1.0 + 1.3 * t
		            fadeFrom = 0.5
		        elseif self.Style == "cloud" then
		            -- 퍼지는 구름: 크게 부풀며 오래 남는다.
		            scale = 1.1 + 1.4 * t
		            fadeFrom = 0.55
		        elseif self.Style == "pierce" then
		            -- 꿰뚫는 획: 앞으로 나간다. 커지는 폭이 작아야 "찌른다"로 읽힌다.
		            scale = 1.4 + 0.6 * t
		            fadeFrom = 0.65
		        elseif self.Style == "rush" then
		            -- 달팽이 껍질·리본처럼 몸과 함께 굴러가는 물리 돌진.
		            -- 마법진처럼 부풀리지 않고 빠르게 회전하며 앞으로 이동한다.
		            scale = 1.05 + 0.15 * t
		            spin = 720 * t
		            fadeFrom = 0.72
		        elseif self.Style == "spin" then
		            -- 제자리 회전 공격. 투사체처럼 이동하지 않고 윤곽을 오래 보여 준다.
		            scale = 1.0 + 0.2 * t
		            spin = 540 * t
		            fadeFrom = 0.68
		        elseif self.Style == "scatter" then
		            -- 포자·뼈 조각처럼 여러 방향으로 흩어지는 작은 물체.
		            scale = 0.75 + 0.45 * t
		            spin = 180 * t
		            fadeFrom = 0.62
		        elseif self.Style == "slam" then
		            -- 지면 충격 뒤 튀어 오르는 큰 조각. 회전보다 무게감 있는 확대를 쓴다.
		            scale = 0.65 + 1.15 * math.min(t * 2, 1)
		            fadeFrom = 0.58
		        elseif self.Style == "guard" then
		            -- 방어 효과는 공격처럼 돌거나 날아가지 않고 짧게 맥동한다.
		            scale = 1.0 + 0.12 * math.sin(t * math.pi * 3)
		            fadeFrom = 0.7
		        elseif self.Style == "sequence" then
		            -- 프레임 원화가 크기와 알파 변화를 이미 포함하므로 추가 변형하지 않는다.
		            scale = 1.0
		            fadeFrom = 1.0
		        else
		            scale = 1.0
		        end
		
		        scale = scale * self.BaseScale
		
		        if t > fadeFrom then alpha = 1.0 - (t - fadeFrom) / (1.0 - fadeFrom) end
		        alpha = alpha * self.BaseAlpha
		
		        transform.Scale = Vector3(scale, scale, 1)
		        if spin ~= 0 then transform.ZRotation = spin end
		
		        if isvalid(sprite) then
		            local c = sprite.Color
		            sprite.Color = Color(c.r, c.g, c.b, alpha)
		        end
	end

	method void OnUpdate(number delta)
		        if self:IsClient() then
		            local sprite = self.Entity.SpriteRendererComponent
		            if isvalid(sprite) then
		                -- 서버의 Visible과 RUID 복제 순서에 의존하지 않는다.
		                -- 공용 모델의 초록 placeholder는 어떤 스킬에서도 표시하지 않는다.
		                sprite.Enable = sprite.SpriteRUID ~= "" and sprite.SpriteRUID ~= "7985d900fb03443899423346524299a7"
		            end
		            return
		        end
		        -- 아직 Play를 안 받았으면 가만히 있는다 (스폰 프레임에 한 번 걸린다).
		        if self.Playing == false or self.LifeTotal <= 0 then return end
		
		        self.Life = self.Life - delta
		        if self.Life <= 0 then
		            self.Playing = false
		            -- 남겨 두면 이펙트가 방에 쌓인다.
		            log("[이펙트 종료] " .. (self.DebugName ~= "" and self.DebugName or self.Style))
		            self.Entity:Destroy()
		            return
		        end
		
		        -- 지나온 비율로 정한다. 속도를 누적하지 않는 이유는 SkillProjectile과 같다 —
		        -- 프레임이 튀어도 끝나는 모습이 항상 같다.
		        local t = 1 - (self.Life / self.LifeTotal)
		
		        if isvalid(self.FollowTarget) then
		            local targetTransform = self.FollowTarget.TransformComponent
		            local transform = self.Entity.TransformComponent
		            if isvalid(targetTransform) and isvalid(transform) then
		                local p = targetTransform.WorldPosition
		                transform.WorldPosition = Vector3(
		                    p.x + self.FollowOffset.x,
		                    p.y + self.FollowOffset.y,
		                    p.z + self.FollowOffset.z)
		            end
		        end
		
		        if #self.FrameRUIDs > 0 and self.FrameSeconds > 0 then
		            local elapsed = self.LifeTotal - self.Life
		            local frame = math.floor(elapsed / self.FrameSeconds) + 1
		            if frame < 1 then frame = 1 end
		            if frame > #self.FrameRUIDs then frame = #self.FrameRUIDs end
		            if frame ~= self.CurrentFrame then
		                local sprite = self.Entity.SpriteRendererComponent
		                if isvalid(sprite) then sprite.SpriteRUID = self.FrameRUIDs[frame] end
		                self.CurrentFrame = frame
		            end
		        end
		        self:Apply(t)
		
		        if not isvalid(self.FollowTarget) and (self.Drift.x ~= 0 or self.Drift.y ~= 0) then
		            local transform = self.Entity.TransformComponent
		            if isvalid(transform) then
		                local p = transform.WorldPosition
		                transform.WorldPosition = Vector3(
		                    p.x + self.Drift.x * delta,
		                    p.y + self.Drift.y * delta,
		                    p.z)
		            end
		        end
	end

end
