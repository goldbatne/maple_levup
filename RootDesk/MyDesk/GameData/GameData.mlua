-- @서버 + @클라이언트 (양쪽에서 각자 캐시)
--
-- 정적 게임 데이터의 유일한 창구. 다른 스크립트는 _DataService를 직접 부르지 말고
-- 반드시 _GameData를 경유한다. 저장 방식(UserDataSet)을 바꿔도 이 파일만 고치면 된다.
--
-- 읽기 전용 조회만 제공한다. 데미지 계산/스탯 분배/포획 판정 등 모든 판정은
-- 이 데이터를 읽어가는 서버 스크립트 쪽 책임이다 (기획서 개발 규칙 2).

@Logic
script GameData extends Logic

    property boolean IsLoaded = false

    -- 캐시. CSV의 string 셀을 로드 시 1회만 변환해 담아둔다.
    property table balance = {}     -- key(string)   -> number
    property table skills = {}      -- id(string)    -> 스킬 레코드
    property table monsters = {}    -- id(string)    -> 몬스터 레코드
    property table rooms = {}       -- id(string)    -> 방 레코드
    property table landmarks = {}   -- level(number) -> 보상 레코드 배열
    property table roomsByMap = {}  -- mapName(string) -> roomId(string) 역인덱스
    property string startRoomId = ""  -- is_start가 켜진 방. 환생 복귀 지점 (T7)
    property table areas = {}       -- id(string)    -> 지역 레코드 (T12)
    property table areaOrder = {}   -- sort_order로 정렬된 지역 id 배열
    property table items = {}       -- id(string)    -> 아이템 레코드 (T13-2)
    property table itemsByDropper = {}  -- monsterId(string) -> 아이템 id 배열

    method void OnBeginPlay()
        -- 월드 세션 시작 시 데이터셋을 한 번만 읽어 캐시한다.
        self:LoadAll()
    end

    ---------------------------------------------------------------
    -- 변환 헬퍼 : CSV 셀은 전부 string이고 빈 칸은 "" 또는 nil로 온다
    ---------------------------------------------------------------

    method number ToNumber(string raw, number fallback)
        -- 숫자 변환. 빈 칸이거나 변환 실패면 fallback.
        if raw == nil or raw == "" then return fallback end
        local parsed = tonumber(raw)
        if parsed == nil then return fallback end
        return parsed
    end

    method boolean ToBoolean(string raw)
        -- "true"만 참으로 본다. 빈 칸은 거짓.
        return raw == "true"
    end

    method string ToText(string raw)
        -- 빈 칸이 nil로 오든 ""로 오든 ""로 통일한다.
        if raw == nil then return "" end
        return raw
    end

    method table SplitIds(string raw)
        -- "a|b|c" 파이프 구분 문자열을 배열로 나눈다 (CSV가 중첩을 못 담기 때문).
        local out = {}
        if raw == nil or raw == "" then return out end
        for token in string.gmatch(raw, "([^|]+)") do
            table.insert(out, token)
        end
        return out
    end

    method any GetDataSet(string setName)
        -- 데이터셋을 이름으로 가져온다. 없으면 에러 로그 후 nil.
        -- 반환 타입이 any인 이유: UserDataSet은 메서드 시그니처에 쓸 수 없다 (LSP 확인).
        local dataSet = _DataService:GetTable(setName)
        if dataSet == nil then
            log_error("[GameData] 데이터셋을 찾을 수 없음: " .. setName)
        end
        return dataSet
    end

    ---------------------------------------------------------------
    -- 로더
    ---------------------------------------------------------------

    method void LoadAll()
        -- 데이터셋을 캐시한다. 하나가 없어도 나머지는 계속 로드한다.
        self:LoadBalance()
        self:LoadSkills()
        self:LoadMonsters()
        self:LoadRooms()
        self:LoadLandmarks()
        self:LoadAreas()
        self:LoadItems()
        self.IsLoaded = true
    end

    method void LoadBalance()
        -- key/value 2컬럼을 key -> number 맵으로.
        local dataSet = self:GetDataSet("GameBalance")
        if dataSet == nil then return end
        local rows = dataSet:GetAllRow()
        for i = 1, #rows do
            local key = self:ToText(rows[i]:GetItem("key"))
            if key ~= "" then
                self.balance[key] = self:ToNumber(rows[i]:GetItem("value"), 0)
            end
        end
    end

    method void LoadSkills()
        -- 몬스터/NPC 스킬 공통 테이블 (source로 구분).
        local dataSet = self:GetDataSet("SkillTable")
        if dataSet == nil then return end
        local rows = dataSet:GetAllRow()
        for i = 1, #rows do
            local row = rows[i]
            local id = self:ToText(row:GetItem("id"))
            if id ~= "" then
                self.skills[id] = {
                    id = id,
                    name = self:ToText(row:GetItem("name")),
                    source = self:ToText(row:GetItem("source")),
                    scaling_stat = self:ToText(row:GetItem("scaling_stat")),
                    coefficient = self:ToNumber(row:GetItem("coefficient"), 0),
                    slot_type = self:ToText(row:GetItem("slot_type")),
                    effect_type = self:ToText(row:GetItem("effect_type")),
                    is_key_skill = self:ToBoolean(row:GetItem("is_key_skill")),
                    -- 재사용 대기시간(초). 밸런스시트에 없는 값이라 계수에 비례해
                    -- 시작값을 정했다(계수 x 4 반올림, 3~5초). CSV에서 바로 조정 가능.
                    cooldown = self:ToNumber(row:GetItem("cooldown"), 0),

                    -- ── 스킬 메타 (T17-2, 대표 지시 2026-08-16) ──
                    -- 지금까지 스킬은 "계수가 다른 단일 타격" 하나뿐이었다.
                    -- 무엇을 하는 스킬인지를 데이터가 들고 있어야 설명도 띄우고
                    -- 판정도 갈라 쓸 수 있다.
                    --
                    -- skill_kind   attack / defense — 방어도 **같은 슬롯**을 먹는다
                    --              (대표: "스킬이잖아?"). 분류는 표시와 판정 분기용이다.
                    -- target_mode  single / area / self
                    -- max_targets  multi·area에서 최대 몇을 때리나. 0 = 제한 없음
                    -- effect_value 실드 감쇄율(0.4 = 40%) · 회복량 등 효과의 크기
                    -- duration     효과 지속 시간(초). 즉발이면 0
                    -- description  스킬을 눌렀을 때 보여 줄 한 줄
                    skill_kind = self:ToText(row:GetItem("skill_kind")),
                    target_mode = self:ToText(row:GetItem("target_mode")),
                    max_targets = self:ToNumber(row:GetItem("max_targets"), 0),
                    effect_value = self:ToNumber(row:GetItem("effect_value"), 0),
                    duration = self:ToNumber(row:GetItem("duration"), 0),
                    -- 판정 반경(월드 유닛). 0이면 기본 근접 반경(player_attack_range)을 쓴다.
                    -- 0을 "반경 없음"이 아니라 "기본값"으로 읽는 이유: 대부분의 스킬이
                    -- 기본 반경이라, 매번 1.0을 적어 넣으면 나중에 기본값을 바꿀 때
                    -- CSV를 전부 고쳐야 한다.
                    range = self:ToNumber(row:GetItem("range"), 0),

                    -- ── 스킬 차수 (T16-4a, 설계 변경 2026-08-16) ──
                    -- **보유는 아무 때나 가능하지만, 내 차수가 이 값 이상이어야 장착·사용한다.**
                    -- 차수 = 환생 횟수 + 1 (1회차 = 1차). PlayerSkillSlots.GetTier가 유일한 창구다.
                    --
                    -- 왜 필요한가: 모험가 NPC가 직업군 스킬을 **한꺼번에** 준다(T16-3).
                    -- 잠금이 없으면 1회차 플레이어가 상위 차수 스킬을 그대로 끼워
                    -- 몬스터 계단도 보스 배율도 무의미해진다.
                    --
                    -- ⚠ **시작이 0차다** (대표 지시 2026-08-21). 전직은 Lv20/30/60/100/200에서
                    -- 1~5차로 오른다. 몬스터 스킬을 0차로 두지 않으면 Lv20 전에는 쓸 수 있는
                    -- 스킬이 하나도 없어 초반이 통째로 자동 공격만 남는다.
                    --
                    -- 기본값 0인 이유: 새 줄에서 tier를 빠뜨렸을 때 **잠기는 쪽이 아니라
                    -- 열리는 쪽**으로 틀리는 편이 안전하다 — 잠기면 "왜 안 끼워지지"가 되고
                    -- 원인이 화면에 안 남는다.
                    tier = self:ToNumber(row:GetItem("tier"), 0),

                    -- 원작 스킬 아이콘 RUID (T16-3a). 대표 지시: "UUID와 효과도 원작과 같아야 해".
                    -- 값은 `msw-search`의 **스킬 리소스 팩**에서 얻는다 — 팩 id가 원작 스킬 id
                    -- 그대로여서(예: 슬래시 블러스트 = skill/100.img/skill/1001005) 눈대중이 아니라
                    -- id로 맞출 수 있다. 팩 안의 `icon` 요소가 이 값이다.
                    --
                    -- ⚠ 아직 어디서도 그리지 않는다. 장착 창은 글자만 쓰고 있고, 아이콘을 붙이려면
                    -- `.ui`에 줄마다 Sprite를 넣어야 한다 — 그건 별도 태스크다. 지금은 **원작 UUID를
                    -- 데이터에 확정해 두는 것**이 목적이다. 몬스터 스킬은 원작 대응이 없어 비어 있다.
                    icon_ruid = self:ToText(row:GetItem("icon_ruid")),
                    description = self:ToText(row:GetItem("description")),
                }
            end
        end
    end

    method void LoadMonsters()
        -- 몬스터 레코드. hp/def/exp는 밸런스시트 공식으로 산출된 확정값이다.
        local dataSet = self:GetDataSet("MonsterTable")
        if dataSet == nil then return end
        local rows = dataSet:GetAllRow()
        for i = 1, #rows do
            local row = rows[i]
            local id = self:ToText(row:GetItem("id"))
            if id ~= "" then
                self.monsters[id] = {
                    id = id,
                    name = self:ToText(row:GetItem("name")),
                    level = self:ToNumber(row:GetItem("level"), 1),
                    hp = self:ToNumber(row:GetItem("hp"), 0),
                    def = self:ToNumber(row:GetItem("def"), 0),
                    exp = self:ToNumber(row:GetItem("exp"), 0),
                    drop_skill_id = self:ToText(row:GetItem("drop_skill_id")),
                    -- 스폰에 쓸 .model의 id. 데이터 id(m_slime)와 모델 id(slime)를
                    -- 이름 규칙으로 엮지 않고 여기서 명시한다.
                    -- 아직 모델을 안 만든 몬스터는 비어 있고, 스포너가 건너뛴다.
                    model_id = self:ToText(row:GetItem("model_id")),

                    -- 격파하면 **확실히** 넘어오는 스킬 목록 (T16-3, 대표 지시 2026-08-20).
                    -- 파이프 구분이라 한 상대가 여러 개를 준다 — "다 얻고 거기서 고른다".
                    --
                    -- ## drop_skill_id와 물리적으로 갈라 둔 이유
                    --
                    -- 획득 규칙이 정반대다:
                    --   drop_skill_id  = 포획. **확률**(3% + LUK)이고 5장까지 **중복 강화**된다.
                    --   npc_skill_ids  = 격파. **확정**이고 **1장 고정**(중복 강화 없음).
                    -- 한 칸에 섞으면 어느 규칙으로 굴릴지를 매번 다시 판단해야 하고,
                    -- 그 판단이 두 곳에 생기는 순간 어긋난다. 그래서 칸부터 나눈다
                    -- (전투는 GetTotalX / 게이트는 GetStatWithoutEquip과 같은 판단).
                    --
                    -- 시험 상대는 drop_skill_id가 비어 있어 `TryCapture`가 즉시 빠져나간다 —
                    -- 포획 판정도 천장 카운터도 타지 않는다.
                    npc_skill_ids = self:SplitIds(self:ToText(row:GetItem("npc_skill_ids"))),
                }
            end
        end
    end

    method void LoadRooms()
        -- conn_* 4컬럼을 connections 테이블로 접고, 게이트 조건을 묶는다.
        local dataSet = self:GetDataSet("RoomTable")
        if dataSet == nil then return end
        local rows = dataSet:GetAllRow()
        for i = 1, #rows do
            local row = rows[i]
            local id = self:ToText(row:GetItem("id"))
            if id ~= "" then
                self.rooms[id] = {
                    id = id,
                    name = self:ToText(row:GetItem("name")),
                    room_type = self:ToText(row:GetItem("room_type")),
                    connections = {
                        north = self:ToText(row:GetItem("conn_north")),
                        south = self:ToText(row:GetItem("conn_south")),
                        east = self:ToText(row:GetItem("conn_east")),
                        west = self:ToText(row:GetItem("conn_west")),
                    },
                    gate_type = self:ToText(row:GetItem("gate_type")),
                    gate_key = self:ToText(row:GetItem("gate_key")),
                    gate_value = self:ToNumber(row:GetItem("gate_value"), 0),
                    map_name = self:ToText(row:GetItem("map_name")),
                    -- 방에 어떤 몬스터가 몇 마리 사는지. 방 진입 시 스포너가 읽는다.
                    -- 몬스터가 없는 방은 monster_id를 비워두면 된다.
                    monster_id = self:ToText(row:GetItem("monster_id")),
                    monster_count = self:ToNumber(row:GetItem("monster_count"), 0),
                    -- 그 방에서 몬스터를 몇 레벨로 세울지 (T10-2 방별 계단).
                    -- 0이면 덮어쓰지 않고 MonsterTable의 기본 레벨을 쓴다.
                    -- 같은 종을 방마다 다른 레벨로 세우려면 이게 필요하다 —
                    -- 슬라임이 r_01에서 Lv1, r_02에서 Lv3인 식.
                    monster_level = self:ToNumber(row:GetItem("monster_level"), 0),
                    -- 시작방 표시. 환생하면 여기로 돌아온다 (기획서 4.5).
                    -- room_type을 "start"로 쓰지 않는 이유: 시작방도 사냥방일 수 있어
                    -- "어떤 방인가"와 "시작점인가"는 다른 축이다.
                    is_start = self:ToBoolean(row:GetItem("is_start")),
                    -- 이 방이 속한 지역 (T12-1). 마을처럼 어느 지역에도 안 속하는
                    -- 허브는 비워 둔다 — 마을은 지역 이동의 출발점이지 목적지가 아니다.
                    area_id = self:ToText(row:GetItem("area_id")),
                    -- 이 방 포탈의 x·y 절대값 (T13-1c). 다른 방에서 **이 방으로** 들어올 때
                    -- 도착 지점을 여기서 계산한다.
                    --
                    -- 왜 데이터로 옮겼는가: RoomPortal이 portalX=13을 상수로 갖고 있어
                    -- 모든 맵이 28칸 폭이라고 가정했다. 마을(maptown)은 14칸 폭이라
                    -- r_01에서 서쪽으로 들어오면 x=+10.5, 즉 **타일 밖**에 떨어졌다.
                    -- 0이면 RoomPortal의 기본값을 쓴다 (기존 맵 5개는 비워 두면 그대로).
                    portal_x = self:ToNumber(row:GetItem("portal_x"), 0),
                    portal_y = self:ToNumber(row:GetItem("portal_y"), 0),
                }
                -- 맵 이름 → 방 역인덱스. 플레이어가 어느 맵에 있는지로 방을 찾을 때 쓴다.
                local mapName = self:ToText(row:GetItem("map_name"))
                if mapName ~= "" then
                    self.roomsByMap[mapName] = id
                end

                if self.rooms[id].is_start then
                    -- 시작방이 둘이면 어느 쪽으로 환생 복귀할지 정해지지 않는다.
                    -- 조용히 덮어쓰면 CSV 순서에 따라 결과가 바뀌므로 경고하고 첫 번째를 지킨다.
                    if self.startRoomId ~= "" then
                        log_warning("[GameData] 시작방이 둘 이상이다: " .. self.startRoomId
                            .. " 를 유지하고 " .. id .. " 는 무시한다")
                    else
                        self.startRoomId = id
                    end
                end
            end
        end
    end

    method void LoadAreas()
        -- 지역 테이블 (T12). 마을 게이트가 "어디로 갈 수 있나"를 여기서 읽는다.
        --
        -- 방(RoomTable)과 따로 두는 이유: 지역은 방의 묶음이라 이름·진입점·순서가
        -- 방 단위 속성이 아니다. RoomTable에 area_name 컬럼을 넣으면 같은 이름이
        -- 방 개수만큼 중복되고, 한 곳만 고치면 조용히 어긋난다.
        local dataSet = self:GetDataSet("AreaTable")
        if dataSet == nil then return end
        local rows = dataSet:GetAllRow()
        for i = 1, #rows do
            local row = rows[i]
            local id = self:ToText(row:GetItem("id"))
            if id ~= "" then
                self.areas[id] = {
                    id = id,
                    name = self:ToText(row:GetItem("name")),
                    -- 그 지역에 들어갈 때 도착하는 방. 마을 게이트의 목적지다.
                    -- 아직 방을 안 만든 지역은 비어 있을 수 있다 — 그 경우 게이트가
                    -- 목록에서 건너뛴다 (조용히 빈 곳으로 보내는 것보다 낫다).
                    entry_room_id = self:ToText(row:GetItem("entry_room_id")),
                    -- 조건 없이 처음부터 열려 있는 지역. 시작 지역이 여기 해당한다.
                    -- 나머지는 랜드마크 area 보상으로 UnlockedAreas에 쌓인다.
                    default_unlocked = self:ToBoolean(row:GetItem("default_unlocked")),
                    sort_order = self:ToNumber(row:GetItem("sort_order"), 0),
                }
                -- sort_order 오름차순으로 꽂아 넣는다. 마을 게이트 목록이 CSV 행
                -- 순서에 휘둘리지 않게 하려는 것.
                --
                -- table.sort에 비교 함수를 넘기지 않는 이유: 이 워크스페이스의 다른
                -- 코드는 전부 인자 없는 table.sort(ids) 형태만 쓴다. 비교 함수를
                -- 넘겼더니 GameData Logic 자체가 등록되지 않아(_GameData가 nil)
                -- 게임 전체가 멈췄다. 지역 수는 한 자릿수라 삽입 정렬로 충분하다.
                local pos = #self.areaOrder + 1
                for k = 1, #self.areaOrder do
                    if self.areas[id].sort_order < self.areas[self.areaOrder[k]].sort_order then
                        pos = k
                        break
                    end
                end
                table.insert(self.areaOrder, pos, id)
            end
        end
    end

    method void LoadItems()
        -- 아이템 테이블 (T13-2). 장비와 소비를 한 테이블에 담고 item_type으로 갈린다.
        --
        -- 왜 한 테이블인가: 인벤토리는 둘을 같은 칸에 담고, 드랍도 같은 경로로 나온다.
        -- 테이블을 쪼개면 "이 id가 어느 표에 있는가"를 부르는 쪽마다 따져야 한다.
        --
        -- 스탯 컬럼이 5개인 이유: 특정 스탯 4종(atk/int/def/luk) + 올스탯(stat_all).
        -- 올스탯을 stat_atk~stat_luk에 5씩 적어 표현하지 않는 이유는, 올스탯 장비를
        -- **최종 목표로 따로 보여줘야** 하기 때문이다 (대표 지시). 컬럼이 따로 있으면
        -- UI가 "올스탯 +3"으로 한 줄에 쓸 수 있고, 밸런스도 한 값만 만지면 된다.
        local dataSet = self:GetDataSet("ItemTable")
        if dataSet == nil then return end
        local rows = dataSet:GetAllRow()
        for i = 1, #rows do
            local row = rows[i]
            local id = self:ToText(row:GetItem("id"))
            if id ~= "" then
                self.items[id] = {
                    id = id,
                    name = self:ToText(row:GetItem("name")),
                    -- "equip"(장착) / "consume"(소비). 빈 값은 없다고 본다.
                    item_type = self:ToText(row:GetItem("item_type")),
                    -- 장비가 들어가는 자리: weapon / armor / accessory. 소비는 빈 칸.
                    slot = self:ToText(row:GetItem("slot")),
                    stat_atk = self:ToNumber(row:GetItem("stat_atk"), 0),
                    stat_int = self:ToNumber(row:GetItem("stat_int"), 0),
                    stat_def = self:ToNumber(row:GetItem("stat_def"), 0),
                    stat_luk = self:ToNumber(row:GetItem("stat_luk"), 0),
                    -- 4스탯에 동시에 얹히는 값. 장비 스탯은 **게이트 계산에 넣지 않는다**
                    -- (수치 게이트는 분배한 포인트만 본다 — T13-1b).
                    stat_all = self:ToNumber(row:GetItem("stat_all"), 0),
                    -- 소비 아이템의 HP 회복량(정액).
                    heal_hp = self:ToNumber(row:GetItem("heal_hp"), 0),
                    -- 한 칸에 몇 개까지 겹치는가. 장비는 1.
                    stack_max = self:ToNumber(row:GetItem("stack_max"), 1),
                    -- 이 아이템을 떨어뜨리는 몬스터 id 하나와 확률.
                    -- 한 아이템이 여러 몬스터에서 나오게 하려면 별도 드랍 테이블이
                    -- 필요하다 — 슬라이스에는 1:1로 충분해서 컬럼으로 뒀다.
                    drop_from = self:ToText(row:GetItem("drop_from")),
                    drop_rate = self:ToNumber(row:GetItem("drop_rate"), 0),
                    icon_ruid = self:ToText(row:GetItem("icon_ruid")),
                }

                -- 몬스터 → 떨어뜨리는 아이템 역인덱스. 드랍 판정(T13-6)이 처치 시점에
                -- "이 몬스터가 뭘 떨구나"를 물어볼 곳이다.
                local dropper = self.items[id].drop_from
                if dropper ~= "" then
                    if self.itemsByDropper[dropper] == nil then
                        self.itemsByDropper[dropper] = {}
                    end
                    table.insert(self.itemsByDropper[dropper], id)
                end
            end
        end
    end


    method void LoadLandmarks()
        -- 같은 레벨에 여러 행이 올 수 있다 (슬라이스 Lv30은 3축 동시 지급).
        local dataSet = self:GetDataSet("LandmarkTable")
        if dataSet == nil then return end
        local rows = dataSet:GetAllRow()
        for i = 1, #rows do
            local row = rows[i]
            local level = self:ToNumber(row:GetItem("level"), 0)
            if level > 0 then
                if self.landmarks[level] == nil then
                    self.landmarks[level] = {}
                end
                table.insert(self.landmarks[level], {
                    level = level,
                    reward_type = self:ToText(row:GetItem("reward_type")),
                    reward_value = self:ToText(row:GetItem("reward_value")),
                })
            end
        end
    end

    ---------------------------------------------------------------
    -- 조회 API : 다른 스크립트는 여기만 쓴다
    ---------------------------------------------------------------

    method number GetBalance(string key)
        -- 밸런스 상수 조회. 키가 없으면 0 + 경고 — 조용히 넘어가면 하드코딩과 같아진다.
        local value = self.balance[key]
        if value == nil then
            log_warning("[GameData] 밸런스 키 없음: " .. key)
            return 0
        end
        return value
    end

    method table GetSkill(string id)
        -- 스킬 레코드. 없으면 nil.
        return self.skills[id]
    end

    method table GetMonsterSkillIds()
        -- 몬스터 슬롯에 끼울 수 있는 스킬 id 목록. 장착 UI가 후보를 훑을 때 쓴다.
        --
        -- id로 정렬하는 이유: pairs 순회는 순서를 보장하지 않아, 정렬하지 않으면
        -- 목록을 새로고침할 때마다 줄 순서가 뒤바뀌어 누르려던 항목이 움직인다.
        local ids = {}
        for id, skill in pairs(self.skills) do
            if skill.slot_type == "monster" then
                ids[#ids + 1] = id
            end
        end
        table.sort(ids)
        return ids
    end

    method table GetMonster(string id)
        -- 몬스터 레코드. 없으면 nil.
        return self.monsters[id]
    end

    method table GetNpcSkillIds(string monsterId)
        -- 이 상대를 격파하면 확정으로 넘어오는 스킬 목록 (T16-3). 없으면 빈 배열.
        -- 포획(drop_skill_id)과 섞이지 않게 창구를 따로 둔다 — LoadMonsters 주석 참고.
        local record = self.monsters[monsterId]
        if record == nil then return {} end
        return record.npc_skill_ids
    end

    method table GetRoom(string id)
        -- 방 레코드. 없으면 nil.
        return self.rooms[id]
    end


    method table GetArea(string id)
        -- 지역 레코드. 없으면 nil.
        return self.areas[id]
    end

    method table GetOrderedAreaIds()
        -- AreaTable의 지역 id를 sort_order 순서로. 마을 게이트가 목록을 그릴 때 쓴다.
        --
        -- ⚠ 아래쪽의 GetAllAreaIds와 헷갈리지 말 것. 그쪽은 T7 저장 시스템이
        --   rebirth 게이트와 랜드마크 보상에서 구역 키를 **긁어모으는** 함수고,
        --   이건 AreaTable이라는 정식 출처를 **순서대로 읽는** 함수다.
        --   처음에 같은 이름으로 만들었다가 멤버 중복으로 GameData Logic 자체가
        --   등록되지 않아(_GameData가 nil) 게임 전체가 멈췄다.
        --
        -- 사본을 준다 — 호출부가 정렬 결과를 흐트러뜨리면 다음 호출이 달라진다.
        local out = {}
        for i = 1, #self.areaOrder do
            table.insert(out, self.areaOrder[i])
        end
        return out
    end

    method table GetItem(string id)
        -- 아이템 레코드. 없으면 nil.
        return self.items[id]
    end

    method table GetItemDropsOf(string monsterId)
        -- 그 몬스터가 떨어뜨릴 수 있는 아이템 id 목록. 없으면 빈 배열.
        --
        -- 사본을 준다 — 호출부가 흐트러뜨리면 다음 처치의 드랍 판정이 달라진다.
        local list = self.itemsByDropper[monsterId]
        local out = {}
        if list == nil then return out end
        for i = 1, #list do
            table.insert(out, list[i])
        end
        return out
    end

    method number GetItemStatBonus(string id, string stat)
        -- 아이템 하나가 특정 스탯에 얹는 값. 올스탯은 4스탯 전부에 더해진다.
        -- stat은 "ATK"/"INT"/"DEF"/"LUK".
        --
        -- 여기서 합치는 이유: 부르는 쪽마다 "stat_all도 더해야 한다"를 기억해야 하면
        -- 언젠가 한 곳이 빠뜨린다. 올스탯이 조용히 안 먹는 버그는 찾기 어렵다.
        local item = self.items[id]
        if item == nil then return 0 end
        local own = 0
        if stat == "ATK" then own = item.stat_atk end
        if stat == "INT" then own = item.stat_int end
        if stat == "DEF" then own = item.stat_def end
        if stat == "LUK" then own = item.stat_luk end
        return own + item.stat_all
    end

    method integer GetItemStackCap(string id)
        -- 이 아이템을 몇 개까지 쌓을 수 있는가 (ItemTable.stack_max).
        --
        -- 없는 아이템에 1을 돌려주는 이유: 0을 주면 부르는 쪽이 "하나도 못 가진다"로
        -- 읽어서, 데이터에 없는 아이템이 획득 자체가 막히는 것처럼 보인다.
        -- 없는 아이템은 GetItem에서 이미 걸러지므로 여기서는 안전한 값만 준다.
        local item = self.items[id]
        if item == nil then return 1 end
        local cap = math.floor(item.stack_max)
        if cap < 1 then return 1 end
        return cap
    end

    method number GetItemStackedStatBonus(string id, string stat, integer count)
        -- 보유 개수만큼 합산한 스탯 보너스 (T15-1).
        --
        -- 중복 획득은 **개당 수치를 그대로 더한다** — +5 장비를 3개 가지면 +15다
        -- (대표 지시 2026-08-13). 스킬 중복은 규칙이 다르다(계수에 비례 20%씩) —
        -- 섞지 말 것. 장비만 배수인 이유는 스탯이 정수 5라서 비례 20%를 적용하면
        -- 5 → 6 → 7이 되어 체감이 없기 때문이다.
        --
        -- 상한을 여기서 한 번 더 자르는 이유: AddItem이 이미 stack_max에서 막지만,
        -- 상한을 나중에 낮추면 옛 세이브에 초과분이 남는다. 그때 조용히 초과
        -- 보너스가 나가면 "왜 스탯이 더 높지"의 원인을 찾을 곳이 없다.
        if count <= 0 then return 0 end
        local cap = self:GetItemStackCap(id)
        if count > cap then count = cap end
        return self:GetItemStatBonus(id, stat) * count
    end

    method table GetLandmarksAtLevel(number level)
        -- 해당 도달 레벨의 보상 목록. 없으면 빈 배열.
        local list = self.landmarks[level]
        if list == nil then return {} end
        return list
    end

    method table GetStartRoom()
        -- 시작방 레코드. 환생 복귀와 마을 귀환이 여기를 쓴다 (기획서 4.5).
        -- 없으면 nil — 부르는 쪽이 판단하게 둔다. 여기서 아무 방이나 고르면
        -- 데이터가 빠진 걸 아무도 모른 채 엉뚱한 방으로 보내게 된다.
        if self.startRoomId == "" then return nil end
        return self.rooms[self.startRoomId]
    end

    method table GetRoomByMapName(string mapName)
        -- 맵 이름으로 방 레코드를 찾는다. 플레이어가 어느 맵에 있는지로 방 정보를 얻을 때 쓴다.
        local roomId = self.roomsByMap[mapName]
        if roomId == nil then return nil end
        return self.rooms[roomId]
    end

    method string GetRoomConnection(string roomId, string direction)
        -- 방에서 특정 방향으로 이어지는 방 id. 연결이 없으면 "".
        local room = self.rooms[roomId]
        if room == nil then return "" end
        return self:ToText(room.connections[direction])
    end

    ---------------------------------------------------------------
    -- 키 공간 열거 (T8 저장이 쓴다)
    ---------------------------------------------------------------
    --
    -- 왜 필요한가: 플레이어 진행 데이터는 SyncTable에 담겨 있는데
    -- **SyncTable에는 순회 API가 없다** (Environment/NativeScripts에 .d.mlua 정의가
    -- 아예 없어 pairs가 되는지 확인할 방법이 없었다). 그래서 저장할 때
    -- "어떤 키가 들어 있는지"를 SyncTable에게 물어볼 수 없고,
    -- 데이터 테이블이 정의한 **키 공간 전체를 훑어** 값이 있는 것만 담는다.
    --
    -- 부수 효과 하나: CSV에서 사라진 id는 다음 저장에서 함께 사라진다.
    -- 콘텐츠를 지웠다가 되돌리면 그 사이 저장으로 값이 날아간다는 뜻이라,
    -- 운영 중에 행을 지울 때는 주의해야 한다.
    -- 정렬해 돌려주는 이유는 GetMonsterSkillIds와 같다 — 저장 페이로드의
    -- 키 순서가 매번 달라지면 diff로 무엇이 바뀌었는지 읽을 수 없다.

    method table GetAllSkillIds()
        -- SkillTable의 모든 스킬 id (직업 스킬 포함).
        local ids = {}
        for id, _ in pairs(self.skills) do
            ids[#ids + 1] = id
        end
        table.sort(ids)
        return ids
    end

    method table GetAllMonsterIds()
        -- MonsterTable의 모든 몬스터 id. 포획 천장 카운터의 키 공간이다.
        local ids = {}
        for id, _ in pairs(self.monsters) do
            ids[#ids + 1] = id
        end
        table.sort(ids)
        return ids
    end


    method table GetAllRoomIds()
        -- RoomTable의 모든 방 id. 보스 클리어 원장의 키 공간이다.
        local ids = {}
        for id, _ in pairs(self.rooms) do
            ids[#ids + 1] = id
        end
        table.sort(ids)
        return ids
    end

    method table GetAllItemIds()
        -- ItemTable의 모든 아이템 id. 인벤토리 저장(T13-3)의 키 공간이다.
        local ids = {}
        for id, _ in pairs(self.items) do
            ids[#ids + 1] = id
        end
        table.sort(ids)
        return ids
    end

    method table GetAllAreaIds()
        -- 개방 구역의 키 공간. 구역 테이블이 따로 없어서 두 곳에서 모은다:
        --
        --   1. rebirth 게이트의 gate_key  — 구역을 **요구하는** 쪽 (RoomTable)
        --   2. 랜드마크의 area 보상값     — 구역을 **주는** 쪽 (LandmarkTable)
        --
        -- 둘 다 봐야 하는 이유(T7 실측): 슬라이스의 Lv30 랜드마크가 area_02를 주는데
        -- 그 구역을 요구하는 rebirth 게이트는 아직 RoomTable에 없다.
        -- 요구하는 쪽만 훑으면 방금 개방한 구역이 저장에서 통째로 사라진다.
        local seen = {}
        local ids = {}

        for _, room in pairs(self.rooms) do
            if room.gate_type == "rebirth" and room.gate_key ~= "" then
                if seen[room.gate_key] == nil then
                    seen[room.gate_key] = true
                    ids[#ids + 1] = room.gate_key
                end
            end
        end

        for _, list in pairs(self.landmarks) do
            for i = 1, #list do
                local r = list[i]
                if r.reward_type == "area" and r.reward_value ~= "" then
                    if seen[r.reward_value] == nil then
                        seen[r.reward_value] = true
                        ids[#ids + 1] = r.reward_value
                    end
                end
            end
        end

        table.sort(ids)
        return ids
    end

end
