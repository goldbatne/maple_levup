-- @서버 (검증 로그는 서버 한쪽에서만 찍는다)
--
-- T0 완료 조건 검증용 개발 스크립트.
--   1) 테이블 데이터가 로그로 출력되는가
--   2) 방 5개의 연결 관계가 데이터에 있는가 (양방향 무결성까지 확인)
--   3) 몬스터 테이블 값이 밸런스시트 공식과 일치하는가
-- T1 착수 후에는 삭제하거나 비활성화해도 된다.

@Logic
script GameDataVerify extends Logic

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Logic 간 OnBeginPlay 순서는 보장되지 않으므로 한 박자 늦춰 실행한다.
        _TimerService:SetTimerOnce(function()
            self:RunAll()
        end, 1.0)
    end

    @ExecSpace("ServerOnly")
    method void RunAll()
        -- 검증 전체를 순서대로 돌린다.
        if not _GameData.IsLoaded then
            log_error("[검증] GameData가 로드되지 않았다. 데이터셋 등록을 확인할 것.")
            return
        end

        log("========== T0 데이터 검증 시작 ==========")
        self:VerifyBalance()
        self:VerifySkills()
        self:VerifyMonsters()
        self:VerifyRooms()
        self:VerifyLandmarks()
        self:VerifyAreas()
        self:VerifyItems()
        self:VerifySaveSchema()
        log("========== T0 데이터 검증 끝 ==========")
    end

    @ExecSpace("ServerOnly")
    method void VerifyBalance()
        -- 밸런스시트 '가정' 탭 핵심값이 그대로 들어왔는지 본다.
        log("[밸런스] 데미지 계수=" .. tostring(_GameData:GetBalance("skill_coefficient_base"))
            .. " / Lv1 필요EXP=" .. tostring(_GameData:GetBalance("exp_base"))
            .. " / EXP공비=" .. tostring(_GameData:GetBalance("exp_ratio"))
            .. " / 레벨캡=" .. tostring(_GameData:GetBalance("initial_level_cap")))
        log("[밸런스] 포획 기본=" .. tostring(_GameData:GetBalance("capture_base_rate"))
            .. " / LUK보정=" .. tostring(_GameData:GetBalance("capture_luk_bonus"))
            .. " / 천장=" .. tostring(_GameData:GetBalance("capture_pity_kills"))
            .. " / 슬롯 시작=" .. tostring(_GameData:GetBalance("monster_slot_start"))
            .. " / 슬롯 상한=" .. tostring(_GameData:GetBalance("monster_slot_max")))
    end

    @ExecSpace("ServerOnly")
    method void VerifySkills()
        -- 스킬 개수와 열쇠 스킬 표시를 확인한다.
        local total = 0
        local monsterCount = 0
        local npcCount = 0
        local keyCount = 0
        for id, skill in pairs(_GameData.skills) do
            total += 1
            if skill.source == "monster" then monsterCount += 1 end
            if skill.source == "npc" then npcCount += 1 end
            if skill.is_key_skill then
                keyCount += 1
                log("  [열쇠스킬] " .. id .. " " .. skill.name .. " (" .. skill.effect_type .. ")")
            end
        end
        log("[스킬] 총 " .. tostring(total) .. "개 (몬스터 " .. tostring(monsterCount) .. " / NPC " .. tostring(npcCount)
            .. " / 열쇠 " .. tostring(keyCount) .. ")")

        -- NPC 스킬(T16-3)은 원작 아이콘 RUID를 들고 있어야 한다. 대표 지시가
        -- "UUID와 효과도 원작과 같아야 해"라, 비어 있으면 그 약속이 깨진 것이다.
        -- 아이콘은 이제 **전 스킬**이 갖고 있어야 한다 (T20-1). 장착 창이 글자 목록에서
        -- 아이콘 격자로 바뀌면(T20-2) 비어 있는 스킬은 **빈 칸**으로 보인다 —
        -- 에러도 안 나고 그냥 허전한, 알아채기 어려운 실패다.
        --
        -- 몬스터 스킬 5종은 원작 대응이 없어 **원작 스킬 아이콘을 안 쓴다** (T20-4).
        -- **그 스킬이 실제로 쓰는 부위**를 입는다 (T20-5) — 껍질 / 파란 껍질 /
        -- 포자 / 뿔 / 바위. 전에는 비슷한 원작 스킬 아이콘을 빌렸는데, 격자로 바꾸자
        -- 아이콘이 칸의 주인공이 되면서 몬스터 스킬이 사람의 기술처럼 보였다 (대표 지적).
        local noIcon = ""
        for id, skill in pairs(_GameData.skills) do
            if skill.icon_ruid == "" then
                noIcon = noIcon .. (noIcon == "" and "" or ", ") .. id
            end
        end
        if noIcon ~= "" then
            log_warning("  [스킬아이콘] 아이콘 없음: " .. noIcon .. " — 장착 창에서 빈 칸이 된다")
        else
            log("[스킬아이콘] " .. tostring(total) .. "종 전부 아이콘이 있다")
        end

        -- 아이콘 비율 (T20-4). 아이콘만 갈고 `icon_ratio`를 안 고치면 그림이 늘어난다 —
        -- 에러가 아니라 **찌그러진 채 그려지는** 실패라 여기서 잡는다.
        local noRatio = ""
        for id, skill in pairs(_GameData.skills) do
            if skill.icon_ruid ~= "" and skill.icon_ratio <= 0 then
                noRatio = noRatio .. (noRatio == "" and "" or ", ") .. id
            end
        end
        if noRatio ~= "" then
            log_warning("  [스킬아이콘] 비율 없음: " .. noRatio .. " — 장착 창에서 늘어나 보인다")
        end

        -- 시전 이펙트 (T19-2). 없으면 스킬을 써도 화면에 아무 일도 안 일어난다 —
        -- 에러가 아니라 **조용히 밋밋해지는** 실패라 여기서 세어 둔다.
        local withEffect = 0
        local noEffect = ""
        for id, skill in pairs(_GameData.skills) do
            if skill.effect_ruid ~= "" then
                withEffect = withEffect + 1
            elseif skill.projectile_ruid ~= "" then
                -- 던지는 스킬은 시전 이펙트가 없어도 된다 — 날아가는 물건이 곧 연출이다
                -- (T19-4: 바위 던지기의 보라색 시전 이펙트를 일부러 뺐다).
                withEffect = withEffect + 1
            else
                noEffect = noEffect .. (noEffect == "" and "" or ", ") .. id
            end
        end
        log("[스킬이펙트] " .. tostring(withEffect) .. "/" .. tostring(total) .. "종에 시전 이펙트가 있다")
        if noEffect ~= "" then
            log_warning("  [스킬이펙트] 이펙트 없음: " .. noEffect)
        end

        -- 중복 강화 계수 (T15-2). 몬스터 스킬만 쌓이므로 그것만 적는다.
        -- 상한이나 보너스가 0으로 되돌아가도 에러가 나지 않아 로그로만 보인다.
        local stackMax = math.floor(_GameData:GetBalance("skill_stack_max"))
        local stackBonus = _GameData:GetBalance("skill_stack_bonus")
        log("[스킬] 중복 상한 " .. tostring(stackMax) .. "장 / 1장당 비례 +"
            .. tostring(stackBonus * 100) .. "% → 만작 "
            .. string.format("%.2f", 1 + stackBonus * (stackMax - 1)) .. "배")
        local monsterSkills = _GameData:GetMonsterSkillIds()
        for i = 1, #monsterSkills do
            local skill = _GameData:GetSkill(monsterSkills[i])
            -- **source가 monster인 것만** 쌓인다 (T15-2). GetMonsterSkillIds는 slot_type으로
            -- 고르므로 NPC 스킬(1장 고정)도 같이 걸린다 — 여기서 걸러내지 않으면
            -- 로그가 "NPC 스킬도 만작 3.42배"라고 거짓말을 한다. 런타임 판정
            -- (PlayerAttack.CalcDamage / TryCapture)은 이미 source로 갈라 두었다.
            if skill ~= nil and skill.source == "monster" then
                log("  [중복강화] " .. skill.name .. " (" .. skill.scaling_stat .. ")  계수 "
                    .. string.format("%.2f", skill.coefficient) .. " → 만작 "
                    .. string.format("%.2f", _CombatFormula:StackedCoefficient(skill.coefficient, stackMax)))
            end
        end

        -- 스킬 메타 (T17-2). 분류가 비어 있으면 스킬 바·설명 UI가 조용히 잘못 그린다.
        local attackCount = 0
        local defenseCount = 0
        for id, skill in pairs(_GameData.skills) do
            if skill.skill_kind == "attack" then attackCount += 1
            elseif skill.skill_kind == "defense" then defenseCount += 1
            else
                log_error("  [스킬메타] " .. id .. " 의 skill_kind가 비었거나 모르는 값: '"
                    .. tostring(skill.skill_kind) .. "'")
            end
            if skill.description == "" then
                log_warning("  [스킬메타] " .. id .. " 에 설명이 없다 — 설명 UI가 빈 칸으로 뜬다")
            end
            -- 차수는 0 이상이어야 한다. **0차 = 시작부터 사용 가능**이 정상값이다
            -- (2026-08-21: 시작이 0차, 전직이 1~5차). 음수만 잘못된 값이다.
            if skill.tier < 0 then
                log_error("  [스킬차수] " .. id .. " 의 tier가 음수다: " .. tostring(skill.tier))
            end
        end
        local tierCount = {}
        for _, skill in pairs(_GameData.skills) do
            local t = tostring(math.floor(skill.tier))
            tierCount[t] = (tierCount[t] or 0) + 1
        end
        local tierText = ""
        for t, n in pairs(tierCount) do tierText = tierText .. t .. "차 " .. tostring(n) .. "종  " end
        local ladder = ""
        for i = 1, 5 do
            local lv = _GameData:GetBalance("tier_level_" .. tostring(i))
            if lv > 0 then ladder = ladder .. tostring(i) .. "차 Lv" .. tostring(math.floor(lv)) .. "  " end
        end
        log("[스킬차수] " .. tierText .. " (시작 0차 / 전직 " .. ladder .. ")")
        log("[스킬메타] 공격 " .. tostring(attackCount) .. " / 방어 " .. tostring(defenseCount)
            .. "  (방어도 같은 슬롯을 먹는다 — 대표 지시 2026-08-16)")
        for id, skill in pairs(_GameData.skills) do
            log("  [스킬메타] " .. skill.name .. " [" .. skill.skill_kind .. "/" .. skill.effect_type
                .. "] 대상=" .. skill.target_mode
                .. (skill.effect_value > 0 and ("  효과값 " .. tostring(skill.effect_value)) or "")
                .. (skill.duration > 0 and ("  " .. tostring(skill.duration) .. "초") or "")
                .. "  \"" .. skill.description .. "\"")
        end
    end

    @ExecSpace("ServerOnly")
    method void VerifyMonsters()
        -- 테이블 값 vs 밸런스시트 공식. 어긋나면 시트와 코드가 갈라진 것이므로 즉시 드러내야 한다.
        local hpBase = _GameData:GetBalance("monster_hp_base")
        local hpRatio = _GameData:GetBalance("monster_hp_ratio")
        local defBase = _GameData:GetBalance("monster_def_base")
        local defRatio = _GameData:GetBalance("monster_def_ratio")
        local expBase = _GameData:GetBalance("monster_exp_base")
        local expRatio = _GameData:GetBalance("monster_exp_ratio")

        for id, monster in pairs(_GameData.monsters) do
            local step = monster.level - 1
            local hpExpected = math.floor(hpBase * hpRatio ^ step + 0.5)
            local defExpected = math.floor(defBase * defRatio ^ step * 10 + 0.5) / 10
            local expExpected = math.floor(expBase * expRatio ^ step + 0.5)

            local mark = "일치"
            if monster.hp ~= hpExpected or monster.def ~= defExpected or monster.exp ~= expExpected then
                mark = "불일치!"
                log_warning("  [몬스터] " .. id .. " 시트 공식과 어긋남 → 기대 HP=" .. tostring(hpExpected)
                    .. " DEF=" .. tostring(defExpected) .. " EXP=" .. tostring(expExpected))
            end
            log("  [몬스터] " .. id .. " " .. monster.name .. " Lv" .. tostring(monster.level)
                .. " HP=" .. tostring(monster.hp) .. " DEF=" .. tostring(monster.def)
                .. " EXP=" .. tostring(monster.exp) .. " 드랍=" .. monster.drop_skill_id
                .. " [공식 " .. mark .. "]")

            -- 격파 보상 스킬(T16-3)이 표에 실존하는지 본다. 없는 id를 적어 두면
            -- 이겨 놓고 아무것도 안 들어오는 상태가 되는데, 그때는 원인이 안 남는다.
            for i = 1, #monster.npc_skill_ids do
                local sid = monster.npc_skill_ids[i]
                local skill = _GameData:GetSkill(sid)
                if skill == nil then
                    log_error("  [NPC보상] " .. id .. " 가 없는 스킬을 준다: " .. sid)
                else
                    log("  [NPC보상] " .. monster.name .. " → [" .. skill.name .. "] "
                        .. tostring(math.floor(skill.tier)) .. "차")
                end
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void VerifyRooms()
        -- 방 목록 + 연결 무결성(가리키는 방이 실존하는가, 역방향이 되돌아오는가).
        local opposite = { north = "south", south = "north", east = "west", west = "east" }
        local roomCount = 0
        local linkCount = 0
        local brokenCount = 0

        for id, room in pairs(_GameData.rooms) do
            roomCount += 1
            local gateText = "게이트 없음"
            if room.gate_type ~= "none" and room.gate_type ~= "" then
                gateText = "게이트 " .. room.gate_type .. " " .. room.gate_key .. " " .. tostring(room.gate_value)
            end
            log("  [방] " .. id .. " " .. room.name .. " (" .. room.room_type .. ") 맵="
                .. room.map_name .. " " .. gateText)
            if room.map_name == "" then
                log_error("    " .. id .. " 에 map_name이 비어 있다 — 포탈 연결 불가")
            end

            for dir, back in pairs(opposite) do
                local target = room.connections[dir]
                if target ~= "" then
                    linkCount += 1
                    local targetRoom = _GameData:GetRoom(target)
                    if targetRoom == nil then
                        brokenCount += 1
                        log_error("    " .. dir .. " -> " .. target .. " : 그런 방이 없다")
                    elseif targetRoom.connections[back] ~= id then
                        brokenCount += 1
                        log_error("    " .. dir .. " -> " .. target .. " : 역방향(" .. back .. ")이 되돌아오지 않는다")
                    else
                        log("    " .. dir .. " -> " .. target .. " (양방향 OK)")
                    end
                end
            end
        end

        log("[방] 총 " .. tostring(roomCount) .. "개 / 연결 " .. tostring(linkCount)
            .. "개 / 깨진 연결 " .. tostring(brokenCount) .. "개")
    end

    @ExecSpace("ServerOnly")
    method void VerifyAreas()
        -- 지역 테이블 (T12). 마을 게이트가 여기를 읽어 목록을 만든다.
        --
        -- 특히 세 가지가 조용히 어긋날 수 있어서 전부 대조한다:
        --   ① 진입 방이 실재하는가 (오타 하나면 게이트가 빈 곳으로 보낸다)
        --   ② 랜드마크가 주는 area 보상이 AreaTable에 있는가 (없으면 해금해도 갈 데가 없다)
        --   ③ 방의 area_id가 AreaTable에 있는가
        local ids = _GameData:GetOrderedAreaIds()
        log("[지역] 총 " .. tostring(#ids) .. "개")

        for i = 1, #ids do
            local area = _GameData:GetArea(ids[i])
            local entryText = area.entry_room_id
            if entryText == "" then
                entryText = "(진입 방 미정 — 마을 게이트 목록에서 건너뛴다)"
            else
                local entry = _GameData:GetRoom(area.entry_room_id)
                if entry == nil then
                    log_error("  [지역] " .. area.id .. " 의 진입 방이 없다: " .. area.entry_room_id)
                    entryText = area.entry_room_id .. " (없는 방!)"
                else
                    entryText = area.entry_room_id .. " " .. entry.name
                end
            end
            log("  [지역] " .. area.id .. " " .. area.name
                .. "  진입=" .. entryText
                .. "  기본해금=" .. tostring(area.default_unlocked)
                .. "  순서=" .. tostring(area.sort_order))
        end

        -- ② 랜드마크의 area 보상이 실재하는 지역인가
        local cap = _GameData:GetBalance("initial_level_cap")
        local rewards = _GameData:GetLandmarksAtLevel(cap)
        for i = 1, #rewards do
            if rewards[i].reward_type == "area" then
                if _GameData:GetArea(rewards[i].reward_value) == nil then
                    log_error("  [지역] 랜드마크가 없는 지역을 준다: " .. rewards[i].reward_value)
                else
                    log("  [지역] 랜드마크 Lv" .. tostring(cap) .. " → "
                        .. rewards[i].reward_value .. " 해금 (AreaTable에 있음)")
                end
            end
        end

        -- ③ 방의 area_id 대조
        local roomIds = _GameData:GetAllRoomIds()
        for i = 1, #roomIds do
            local room = _GameData:GetRoom(roomIds[i])
            if room.area_id ~= "" and _GameData:GetArea(room.area_id) == nil then
                log_error("  [지역] 방 " .. room.id .. " 이 없는 지역을 가리킨다: " .. room.area_id)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void VerifyItems()
        -- 아이템 테이블 (T13-2). 조용히 어긋날 수 있는 네 가지를 대조한다:
        --   ① item_type이 equip/consume 중 하나인가
        --   ② 장비에 slot이 있고, 소비에는 없는가
        --   ③ drop_from이 실재하는 몬스터인가 (오타면 영원히 안 떨어진다)
        --   ④ 아이콘 RUID가 비어 있지 않은가 (비면 인벤토리에 빈 칸으로 보인다)
        local ids = _GameData:GetAllItemIds()
        log("[아이템] 총 " .. tostring(#ids) .. "개")

        for i = 1, #ids do
            local item = _GameData:GetItem(ids[i])

            if item.item_type ~= "equip" and item.item_type ~= "consume" then
                log_error("  [아이템] " .. item.id .. " 의 item_type이 이상하다: '"
                    .. item.item_type .. "' (equip/consume 중 하나여야 한다)")
            end

            if item.item_type == "equip" then
                if item.slot == "" then
                    log_error("  [아이템] " .. item.id .. " 는 장비인데 slot이 비어 있다")
                end
            elseif item.slot ~= "" then
                log_warning("  [아이템] " .. item.id .. " 는 소비인데 slot이 채워져 있다: " .. item.slot)
            end

            if item.drop_from ~= "" and _GameData:GetMonster(item.drop_from) == nil then
                log_error("  [아이템] " .. item.id .. " 가 없는 몬스터에서 떨어진다: " .. item.drop_from)
            end

            if item.icon_ruid == "" then
                log_warning("  [아이템] " .. item.id .. " 에 아이콘 RUID가 없다 — 인벤토리에서 빈 칸으로 보인다")
            end

            local statText = ""
            if item.item_type == "equip" then
                statText = "ATK+" .. tostring(_GameData:GetItemStatBonus(item.id, "ATK"))
                    .. " INT+" .. tostring(_GameData:GetItemStatBonus(item.id, "INT"))
                    .. " DEF+" .. tostring(_GameData:GetItemStatBonus(item.id, "DEF"))
                    .. " LUK+" .. tostring(_GameData:GetItemStatBonus(item.id, "LUK"))
                if item.stat_all > 0 then
                    statText = statText .. " (올스탯 +" .. tostring(item.stat_all) .. ")"
                end
                -- 중복 상한과 만작 수치를 같이 남긴다 (T15-1). 상한이 1로 되돌아가면
                -- 중복 합산이 통째로 죽는데, 죽어도 에러가 나지 않아 로그로만 보인다.
                local cap = _GameData:GetItemStackCap(item.id)
                statText = statText .. "  [최대 " .. tostring(cap) .. "개 중첩 → 만작 "
                    .. "ATK+" .. tostring(_GameData:GetItemStackedStatBonus(item.id, "ATK", cap))
                    .. " INT+" .. tostring(_GameData:GetItemStackedStatBonus(item.id, "INT", cap))
                    .. " DEF+" .. tostring(_GameData:GetItemStackedStatBonus(item.id, "DEF", cap))
                    .. " LUK+" .. tostring(_GameData:GetItemStackedStatBonus(item.id, "LUK", cap)) .. "]"
            else
                statText = "HP회복 " .. tostring(item.heal_hp) .. " / 최대 " .. tostring(item.stack_max) .. "개"
            end

            local dropText = "드랍 없음"
            if item.drop_from ~= "" then
                dropText = item.drop_from .. " " .. tostring(item.drop_rate * 100) .. "%"
            end

            log("  [아이템] " .. item.id .. " " .. item.name
                .. " (" .. item.item_type .. (item.slot ~= "" and "/" .. item.slot or "") .. ")  "
                .. statText .. "  " .. dropText)
        end

        -- 몬스터 → 드랍 역인덱스가 실제로 만들어졌는지. 드랍 판정(T13-6)이 이걸 읽는다.
        local monsterIds = _GameData:GetAllMonsterIds()
        for i = 1, #monsterIds do
            local drops = _GameData:GetItemDropsOf(monsterIds[i])
            if #drops > 0 then
                local names = ""
                for k = 1, #drops do
                    if names ~= "" then names = names .. ", " end
                    names = names .. drops[k]
                end
                log("  [드랍표] " .. monsterIds[i] .. " → " .. names)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void VerifyLandmarks()
        -- 슬라이스 사다리(Lv30 3축)가 들어왔는지 본다.
        local cap = _GameData:GetBalance("initial_level_cap")
        local rewards = _GameData:GetLandmarksAtLevel(cap)
        log("[랜드마크] Lv" .. tostring(cap) .. " 보상 " .. tostring(#rewards) .. "건")
        for i = 1, #rewards do
            log("  [랜드마크] " .. rewards[i].reward_type .. " = " .. rewards[i].reward_value)
        end
    end

    @ExecSpace("ServerOnly")
    method void VerifySaveSchema()
        -- 세이브 구조체가 실제로 생성/직렬화되는지, 영구/회차가 다른 키로 갈라지는지 확인한다.
        local run = SaveRunData()
        run:Init()

        local perm = SavePermanentData()
        perm:Init(_GameData:GetBalance("monster_slot_start"))

        local payload = {}
        run:Serialize(payload)
        perm:Serialize(payload)

        local keys = ""
        for key, value in pairs(payload) do
            if keys ~= "" then keys = keys .. ", " end
            keys = keys .. key
        end
        log("[세이브] 분리된 최상위 키 = [" .. keys .. "]")
        log("[세이브] 회차: level=" .. tostring(run.level))
        log("[세이브] 영구: 슬롯=" .. tostring(perm.monster_slot_count)
            .. " 환생=" .. tostring(perm.rebirth_count)
            .. " 최고레벨=" .. tostring(perm.highest_level))
    end

end
