-- @서버 (드랍 판정은 반드시 서버 — 개발 규칙 2)
--
-- 처치 시 무엇을 떨어뜨릴지 굴리고, 바닥에 놓는 곳 (T13-6).
--
-- @Logic인 이유: 판정 규칙은 몬스터 한 마리의 것이 아니라 게임 전체의 것이다.
-- RoomMonster에 넣으면 몬스터 스크립트가 아이템 시스템을 알아야 하고,
-- 나중에 상자·퀘스트 보상에서 같은 판정을 부를 곳이 없어진다.
--
-- ## 드랍률에 LUK을 곱한다 (기획서 §4.7 — 대표 승인 2026-08-13)
--
--   확률 = drop_rate x (1 + LUK x drop_luk_multiplier)
--
-- 포획처럼 정액(+0.1%p)으로 두지 않은 이유: 아이템별 확률이 2%~15%로 폭이 넓어,
-- 정액을 얹으면 2% 희귀템이 LUK 100에서 7%가 된다 — 3.5배다. 그러면 "최종
-- 목표템"(올스탯 반지)이 희귀하지 않게 되어 T13-2의 설계가 무너진다.
-- 비례는 희귀도 서열을 지킨 채로 LUK을 보상한다 (2%→3% / 15%→22.5%).

@Logic
script ItemDrop extends Logic

    -- 드랍 엔티티 모델. SpawnByModelId에 넘기는 id다 (.model의 EntryKey 소문자).
    property string dropModelId = "dropitem"

    -- 여러 개가 동시에 떨어질 때 겹치지 않게 벌리는 간격(월드 유닛).
    property number spreadStep = 0.45

    @ExecSpace("ServerOnly")
    method void TrySpawnDrops(string monsterId, Vector3 position, Entity mapEntity, Entity killer)
        -- 처치 지점에 드랍을 놓는다. 아무것도 안 나오면 조용히 끝난다.
        if mapEntity == nil then return end

        local candidates = _GameData:GetItemDropsOf(monsterId)
        if #candidates == 0 then return end

        local luk = 0
        local ownerUserId = ""
        local killerInv = nil
        if isvalid(killer) then
            -- 상한에 닿은 아이템을 굴리지 않기 위해 인벤토리도 본다 (T15-1).
            killerInv = killer:GetComponent("script.PlayerInventory")
            ---@type PlayerStats
            local stats = killer:GetComponent("script.PlayerStats")
            -- 장비 LUK도 포함된 값이다(GetTotalLuk). 장비가 드랍을 돕는 것은
            -- 의도한 것이다 — 게이트만 장비를 빼고 잰다 (T13-4).
            if stats ~= nil then luk = stats:GetTotalLuk() end
            if isvalid(killer.PlayerComponent) then
                ownerUserId = killer.PlayerComponent.UserId
            end
        end

        local multiplier = 1 + luk * _GameData:GetBalance("drop_luk_multiplier")
        local dropped = 0

        -- 보스방의 **전용 장비**는 확정 드랍한다 (T53). `drop_from=*`인 빨간 포션까지
        -- 확정하면 보스 한 번마다 소비템도 반드시 쌓여 보상 의도보다 커지므로 제외한다.
        -- 보스 여부는 몬스터 종이 아니라 방이 정한다 — RoomMonster의 배율 판정과 같다.
        local bossRoom = false
        local room = _GameData:GetRoomByMapName(mapEntity.Name)
        if room ~= nil and room.room_type == "boss" then bossRoom = true end

        for i = 1, #candidates do
            local itemId = candidates[i]
            local item = _GameData:GetItem(itemId)
            if item ~= nil and item.drop_rate > 0 then
                -- 이미 상한만큼 가진 아이템은 굴리지 않는다 (T15-1).
                --
                -- 떨어뜨려도 밟는 순간 AddItem이 0을 돌려주며 버린다 — 화면에는
                -- "주웠는데 아무 일도 안 일어난다"로만 보여서 고장처럼 읽힌다.
                -- 굴리지 않으면 바닥에 뜨지 않으니 헷갈릴 자리가 없다.
                local cap = _GameData:GetItemStackCap(itemId)
                local held = 0
                if killerInv ~= nil then
                    ---@type PlayerInventory
                    local inv = killerInv
                    held = inv:GetCount(itemId)
                end
                if held >= cap then
                    log("[ItemDrop] " .. monsterId .. " → " .. itemId
                        .. "  이미 상한 " .. tostring(held) .. "/" .. tostring(cap) .. " — 굴리지 않는다")
                    continue
                end

                local guaranteedBossItem = bossRoom and item.drop_from ~= "*"
                local chance = item.drop_rate * multiplier
                if guaranteedBossItem then chance = 1 end
                local roll = _UtilLogic:RandomDouble()
                if roll < chance then
                    -- 여러 개면 좌우로 조금씩 벌린다. 같은 자리에 겹치면 하나만 보인다.
                    local offset = (dropped - 0.5) * self.spreadStep
                    local spot = Vector3(position.x + offset, position.y, position.z)
                    self:SpawnOne(itemId, spot, mapEntity, ownerUserId)
                    dropped = dropped + 1
                end
                log("[ItemDrop] " .. monsterId .. " → " .. itemId
                    .. "  굴림=" .. string.format("%.3f", roll)
                    .. " / 확률=" .. string.format("%.3f", chance)
                    .. " (기본 " .. string.format("%.3f", item.drop_rate)
                    .. " x LUK배율 " .. string.format("%.2f", multiplier) .. ")"
                    .. (guaranteedBossItem and " [보스 전용 확정]" or "")
                    .. (roll < chance and "  → 드랍" or ""))
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void SpawnOne(string itemId, Vector3 position, Entity mapEntity, string ownerUserId)
        -- 바닥 아이템 하나를 놓는다.
        --
        -- parent에 맵 엔티티를 넘긴다 — nil이면 런타임 에러다 (platform §8).
        local name = "drop_" .. itemId .. "_" .. tostring(math.floor(_UtilLogic.ElapsedSeconds * 1000))
        local entity = _SpawnService:SpawnByModelId(self.dropModelId, name, position, mapEntity)
        if entity == nil then
            -- 모델이 없으면 조용히 nil이 온다 (platform §8). 크게 남긴다.
            log_error("[ItemDrop] 드랍 모델을 찾을 수 없다: " .. self.dropModelId)
            return
        end

        ---@type DropItem
        local drop = entity:GetComponent("script.DropItem")
        if drop == nil then
            log_error("[ItemDrop] 드랍 모델에 script.DropItem이 없다")
            return
        end

        drop.ItemId = itemId
        drop.Count = 1
        drop.OwnerUserId = ownerUserId
    end

end
