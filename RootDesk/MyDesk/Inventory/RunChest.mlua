@Component
script RunChest extends Component

	@Sync
	property integer ChestSerial = 0

	@Sync
	property string ChestType = "UPGRADE"

	@Sync
	property string ChestState = "AVAILABLE"

	property any touchHandler = nil

	property any touchEntity = nil

	property any visualTouchHandler = nil

	property any visualTouchEntity = nil

	@ExecSpace("ClientOnly")
	method void OnInitialize()
		        -- InteractionComponent(E키)와 같은 서버 개봉 판정을 터치에도 연결한다.
		        self.touchEntity = self.Entity
		        self.touchHandler = self.Entity:ConnectEvent(TouchEvent, self.HandleTouch)
		        local visual = self.Entity:GetChildByName("Visual", false)
		        if isvalid(visual) then
		            self.visualTouchEntity = visual
		            self.visualTouchHandler = visual:ConnectEvent(TouchEvent, self.HandleTouch)
		        end
	end

	@ExecSpace("ClientOnly")
	method void OnDestroy()
		        if self.touchHandler ~= nil and isvalid(self.touchEntity) then
		            self.touchEntity:DisconnectEvent(TouchEvent, self.touchHandler)
		            self.touchHandler = nil
		        end
		        if self.visualTouchHandler ~= nil and isvalid(self.visualTouchEntity) then
		            self.visualTouchEntity:DisconnectEvent(TouchEvent, self.visualTouchHandler)
		            self.visualTouchHandler = nil
		        end
		        self.touchEntity = nil
		        self.visualTouchEntity = nil
	end

	@ExecSpace("ClientOnly")
	method void HandleTouch(TouchEvent event)
		        if self.ChestState ~= "AVAILABLE" then return end
		        log("[RunChestTouch] tap serial=" .. tostring(self.ChestSerial))
		        self:RequestTouchOpen()
	end

	@ExecSpace("Server")
	method void RequestTouchOpen()
		        if self.ChestState ~= "AVAILABLE" then return end
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if isvalid(player) == false or isvalid(player.PlayerComponent) == false then return end
		        if player.CurrentMap ~= self.Entity.CurrentMap then return end
		        local p = player.TransformComponent.WorldPosition
		        local c = self.Entity.TransformComponent.WorldPosition
		        local range = _GameData:GetBalance("run_chest_interact_range")
		        if range <= 0 then range = 1.35 end
		        local dx = p.x - c.x
		        local dy = p.y - c.y
		        if dx * dx + dy * dy > range * range then return end
		        _GameData:TryOpenRunChest(self.ChestSerial, player)
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		        self:RefreshVisual()
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		        if name == "ChestType" or name == "ChestState" then self:RefreshVisual() end
	end

	@ExecSpace("ServerOnly")
	method void ActivateServer()
		        self.ChestState = "AVAILABLE"
		        local interaction = self.Entity.InteractionComponent
		        if isvalid(interaction) then
		            local range = _GameData:GetBalance("run_chest_interact_range")
		            if range <= 0 then range = 1.35 end
		            interaction.ColliderType = ColliderType.Circle
		            interaction.CircleRadius = range
		            interaction.ShowActionInfo = true
		            if self.ChestType == "HEAL" then
		                interaction.ActionName = "회복 상자 열기"
		            elseif self.ChestType == "ELITE_UPGRADE" then
		                interaction.ActionName = "특수 강화 선택"
		            else
		                interaction.ActionName = "랜덤 강화 상자 열기"
		            end
		        end
		        log("[RunChest] AVAILABLE serial=" .. tostring(self.ChestSerial)
		            .. " type=" .. self.ChestType .. " map=" .. tostring(self.Entity.CurrentMap.Name))
	end

	@ExecSpace("ServerOnly")
	method void PrepareRemove(string reason)
		        if self.ChestState == "AVAILABLE" then self.ChestState = "OPENED" end
		        log("[RunChest] REMOVE serial=" .. tostring(self.ChestSerial) .. " reason=" .. reason)
	end

	@ExecSpace("ClientOnly")
	method void RefreshVisual()
		        if isvalid(self.Entity) == false then return end
		        local visual = self.Entity:GetChildByName("Visual", false)
		        if isvalid(visual) and isvalid(visual.SpriteRendererComponent) then
		            -- 같은 공식 보물상자 자산을 재사용하되 회복=초록, 강화=금색으로 즉시 구분한다.
		            if self.ChestType == "HEAL" then
		                visual.SpriteRendererComponent.Color = Color(0.48, 1.00, 0.60, 1)
		            elseif self.ChestType == "ELITE_UPGRADE" then
		                visual.SpriteRendererComponent.Color = Color(0.92, 0.55, 1.00, 1)
		            else
		                visual.SpriteRendererComponent.Color = Color(1.00, 0.82, 0.32, 1)
		            end
		        end
		        self.Entity:SetVisible(self.ChestState == "AVAILABLE")
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleInteraction(InteractionEvent event)
		        if self.ChestState ~= "AVAILABLE" then return end
		        local player = event.InteractionEntity
		        if isvalid(player) == false or isvalid(player.PlayerComponent) == false then return end
		        _GameData:TryOpenRunChest(self.ChestSerial, player)
	end

end
