@Logic
script SkillDropManager extends Logic

	property string dropModelId = "skilldrop"

	property table activeDrops = {}

	property integer nextSerial = 0

	property boolean firstSkillDropResolved = false

	property table duplicateNoticeByUser = {}

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		        self:ClearAll("INSTANCE_END")
	end

	@ExecSpace("ServerOnly")
	method string CurrentRunId()
		        return tostring(_GameData.RogueRunRevision) .. ":" .. tostring(_GameData.RogueAreaId)
		            .. ":" .. tostring(_GameData.RogueSeed)
	end

	@ExecSpace("ServerOnly")
	method boolean IsPlayerMissingSkill(Entity player, string skillId)
		        if isvalid(player) == false or isvalid(player.PlayerComponent) == false then return false end
		        if _GameData:IsRunParticipant(player.PlayerComponent.UserId) == false then return false end
		        if _GameData.RogueParticipantResults[player.PlayerComponent.UserId] == "ABANDONED" then return false end
		        ---@type PlayerSkillSlots
		        local slots = player:GetComponent("script.PlayerSkillSlots")
		        return slots ~= nil and slots.RogueliteRunActive and slots:HasRunOwnedSkill(skillId) == false
	end

	@ExecSpace("ServerOnly")
	method table GetActiveMissingParticipants(string skillId)
		        local missing = {}
		        for i = 1, #_GameData.RogueParticipantIds do
		            local userId = _GameData.RogueParticipantIds[i]
		            local player = _UserService:GetUserEntityByUserId(userId)
		            if self:IsPlayerMissingSkill(player, skillId) then missing[#missing + 1] = player end
		        end
		        return missing
	end

	@ExecSpace("ServerOnly")
	method boolean TrySpawnFromKill(string monsterId, Vector3 position, Entity mapEntity, table eligiblePlayers)
		        -- 이름은 레거시 호출자와의 호환 때문에 유지한다. 신규 Run에서는
		        -- 확률 판정 뒤 바닥 Entity를 만들지 않고 서버가 참가자에게 바로 지급한다.
		        if _GameData.RogueRunActive == false or isvalid(mapEntity) == false then return false end
		        if eligiblePlayers == nil or #eligiblePlayers == 0 then return false end
		        local monster = _GameData:GetMonster(monsterId)
		        if monster == nil or monster.drop_skill_id == nil or monster.drop_skill_id == "" then return false end
		        local skillId = monster.drop_skill_id
		        local skill = _GameData:GetSkill(skillId)
		        if skill == nil or skill.source ~= "monster" or skill.slot_type ~= "monster"
		            or skill.skill_kind == "passive" then return false end
		
		        -- 처치에 참여한 근처 플레이어 중 미보유자만 후보로 둔다.
		        -- 이미 가진 사람에게 뽑혔다가 사라지는 일이 없도록 추첨 전에 필터링한다.
		        local missing = {}
		        for _, player in ipairs(eligiblePlayers) do
		            if self:IsPlayerMissingSkill(player, skillId) and player.CurrentMap == mapEntity then
		                missing[#missing + 1] = player
		            end
		        end
		        if #missing == 0 then
		            if #eligiblePlayers == 1 and isvalid(eligiblePlayers[1])
		                and isvalid(eligiblePlayers[1].PlayerComponent) then
		                local player = eligiblePlayers[1]
		                local userId = player.PlayerComponent.UserId
		                local now = _UtilLogic.ServerElapsedSeconds
		                if now - (self.duplicateNoticeByUser[userId] or -100) >= 10 then
		                    self.duplicateNoticeByUser[userId] = now
		                    self:NotifyRejected(player, "이미 가진 능력이라 이번에는 획득할 수 없습니다.")
		                end
		            end
		            log("[SkillDropRoll] SKIP_ALL_OWNED monster=" .. monsterId .. " skill=" .. skillId
		                .. " first_resolved=" .. tostring(self.firstSkillDropResolved))
		            return false
		        end
		
		        local guaranteed = self.firstSkillDropResolved == false
		local chance = guaranteed and 1 or _GameData:GetBalance("run_ability_acquire_rate")
		if chance <= 0 then chance = 0.50 end
		if _GameData.RogueEliteKillInProgress then
			chance = math.max(chance, _GameData:GetBalance("run_elite_skill_drop_chance"))
		end
		        local roll = _GameData:RogueStreamNextDouble("skill_drop:shared")
		        local dropped = guaranteed or roll < chance
		        log("[SkillDropRoll] scope=RUN_SHARED monster=" .. monsterId .. " skill=" .. skillId
		            .. " missing=" .. tostring(#missing) .. " first=" .. tostring(guaranteed)
		            .. " roll=" .. string.format("%.5f", roll) .. " chance=" .. string.format("%.2f", chance)
			.. " dropped=" .. tostring(dropped)
			.. " elite=" .. tostring(_GameData.RogueEliteKillInProgress))
		        if dropped == false then return false end
		
		        local first = _GameData:RogueStreamNextInt("skill_drop:recipient", #missing)
		        for offset = 0, #missing - 1 do
		            local player = missing[((first + offset - 1) % #missing) + 1]
		            if self:IsPlayerMissingSkill(player, skillId) then
		                local slots = player:GetComponent("script.PlayerSkillSlots")
		                if slots ~= nil and slots:ClaimRunSkillDrop(monsterId, skillId) then
		                    local userId = player.PlayerComponent.UserId
		                    _GameData:StageRogueliteDiscovery(userId, monsterId, skillId)
		                    local collection = player:GetComponent("script.PlayerCollection")
		                    if collection ~= nil then collection:UnlockPermanentSkill(skillId) end
		                    if guaranteed then self.firstSkillDropResolved = true end
		                    log("[SkillDropAuto] SUCCESS user=" .. userId .. " monster=" .. monsterId
		                        .. " skill=" .. skillId .. " candidates=" .. tostring(#missing)
		                        .. " first=" .. tostring(guaranteed))
		                    return true
		                end
		            end
		        end
		        -- 지급이 실제로 성립하지 않았다면 첫 획득 보장도 유지한다.
		        log_warning("[SkillDropAuto] NO_ELIGIBLE_RECIPIENT monster=" .. monsterId .. " skill=" .. skillId)
		        return false
	end

	@ExecSpace("ServerOnly")
	method any SpawnDrop(string monsterId, string skillId, Vector3 position, Entity mapEntity, number lifetimeOverride)
		        if isvalid(mapEntity) == false then return nil end
		        self:PruneInvalid()
		        local maxDrops = math.floor(_GameData:GetBalance("skill_drop_max_per_map"))
		        if maxDrops < 1 then maxDrops = 8 end
		        self:RemoveOldestForMapId(mapEntity.Name, maxDrops - 1)
		
		        local lifetime = lifetimeOverride
		        if lifetime <= 0 then lifetime = _GameData:GetBalance("skill_drop_lifetime") end
		        if lifetime <= 0 then lifetime = 60 end
		        local now = _UtilLogic.ServerElapsedSeconds
		        self.nextSerial += 1
		        local record = {
		            runId = self:CurrentRunId(), mapId = mapEntity.Name,
		            monsterId = monsterId, skillId = skillId, position = position,
		            spawnedAt = now, expireAt = now + lifetime, state = "AVAILABLE",
		            serial = self.nextSerial, entity = nil, drop = nil, expiryTimer = 0
		        }
		        self.activeDrops[#self.activeDrops + 1] = record
		        record.expiryTimer = _TimerService:SetTimerOnce(function()
		            self:ExpireRecord(record.serial)
		        end, lifetime)
		        local drop = self:MaterializeRecord(record, mapEntity)
		        if drop == nil then
		            self:RemoveRecordBySerial(record.serial, "SPAWN_FAILED")
		            return nil
		        end
		        log("[SkillDropRecord] CREATE serial=" .. tostring(record.serial)
		            .. " run=" .. record.runId .. " map=" .. record.mapId
		            .. " spawn=" .. string.format("%.2f", record.spawnedAt)
		            .. " expire=" .. string.format("%.2f", record.expireAt))
		        return drop
	end

	@ExecSpace("ServerOnly")
	method any MaterializeRecord(table record, Entity mapEntity)
		        if record == nil or record.state ~= "AVAILABLE" or isvalid(mapEntity) == false then return nil end
		        if record.runId ~= self:CurrentRunId() or record.mapId ~= mapEntity.Name then return nil end
		        if isvalid(record.entity) and record.drop ~= nil then return record.drop end
		        local remain = record.expireAt - _UtilLogic.ServerElapsedSeconds
		        if remain <= 0 then return nil end
		
		        local name = "skilldrop_" .. tostring(record.serial)
		        local entity = _SpawnService:SpawnByModelId(self.dropModelId, name, record.position, mapEntity)
		        if isvalid(entity) == false then
		            log_error("[SkillDrop] SpawnByModelId 실패 model=" .. self.dropModelId
		                .. " serial=" .. tostring(record.serial))
		            return nil
		        end
		        ---@type SkillDrop
		        local drop = entity:GetComponent("script.SkillDrop")
		        if drop == nil then
		            log_error("[SkillDrop] model에 script.SkillDrop이 없음")
		            entity:Destroy()
		            return nil
		        end
		        drop.RecordSerial = record.serial
		        drop.MonsterId = record.monsterId
		        drop.SkillId = record.skillId
		        record.entity = entity
		        record.drop = drop
		        drop:ActivateServer(remain)
		        log("[SkillDropRecord] MATERIALIZE serial=" .. tostring(record.serial)
		            .. " map=" .. record.mapId .. " remain=" .. string.format("%.2f", remain))
		        return drop
	end

	@ExecSpace("ServerOnly")
	method any FindRecordBySerial(integer serial)
		        for i = 1, #self.activeDrops do
		            if self.activeDrops[i].serial == serial then return self.activeDrops[i] end
		        end
		        return nil
	end

	@ExecSpace("ServerOnly")
	method boolean TryClaim(any drop, Entity player)
		        if drop == nil or isvalid(drop.Entity) == false or drop.ClaimState ~= "AVAILABLE" then return false end
		        local record = self:FindRecordBySerial(drop.RecordSerial)
		        if record == nil or record.state ~= "AVAILABLE" or record.drop ~= drop then return false end
		        if isvalid(player) == false or isvalid(player.PlayerComponent) == false then return false end
		        local userId = player.PlayerComponent.UserId
		        if _GameData.RogueRunActive == false or _GameData:IsRunParticipant(userId) == false then return false end
		        if player.CurrentMap ~= drop.Entity.CurrentMap then return false end
		
		        local range = _GameData:GetBalance("skill_drop_interact_range")
		        if range <= 0 then range = 1.25 end
		        local p = player.TransformComponent.WorldPosition
		        local d = drop.Entity.TransformComponent.WorldPosition
		        local dx = p.x - d.x
		        local dy = p.y - d.y
		        if dx * dx + dy * dy > range * range then
		            self:NotifyRejected(player, "드롭에 더 가까이 가세요.")
		            return false
		        end
		
		        ---@type PlayerSkillSlots
		        local slots = player:GetComponent("script.PlayerSkillSlots")
		        if slots == nil or slots.RogueliteRunActive == false then return false end
		        if slots:HasRunOwnedSkill(drop.SkillId) then
		            self:NotifyRejected(player, "이미 보유한 능력입니다.")
		            log("[SkillDropClaim] REJECT_ALREADY_OWNED user=" .. userId .. " skill=" .. drop.SkillId)
		            return false
		        end
		
		        -- Record를 먼저 CLAIMED로 전이한다. 같은 프레임의 Interaction/RPC가 와도
		        -- 첫 요청만 통과하며 실패 시에만 AVAILABLE로 되돌린다.
		        record.state = "CLAIMED"
		        drop.ClaimState = "CLAIMED"
		        local acquired = slots:ClaimRunSkillDrop(drop.MonsterId, drop.SkillId)
		        if acquired == false then
		            record.state = "AVAILABLE"
		            drop.ClaimState = "AVAILABLE"
		            return false
		        end
		        _GameData:StageRogueliteDiscovery(userId, drop.MonsterId, drop.SkillId)
		        local collection = player:GetComponent("script.PlayerCollection")
		        if collection ~= nil then collection:UnlockPermanentSkill(drop.SkillId) end
		        record.state = "REMOVED"
		        drop.ClaimState = "REMOVED"
		        log("[SkillDropClaim] SUCCESS user=" .. userId .. " monster=" .. drop.MonsterId
		            .. " skill=" .. drop.SkillId .. " serial=" .. tostring(record.serial))
		        self:RemoveRecordBySerial(record.serial, "CLAIMED")
		        return true
	end

	@ExecSpace("ServerOnly")
	method void NotifyRejected(Entity player, string message)
		        ---@type PlayerSkillSlots
		        local slots = player:GetComponent("script.PlayerSkillSlots")
		        if slots ~= nil then slots:ShowSkillDropClaimRejected(message, player.PlayerComponent.UserId) end
	end

	@ExecSpace("ServerOnly")
	method void ExpireDrop(any drop)
		        if drop == nil or drop.ClaimState ~= "AVAILABLE" then return end
		        self:ExpireRecord(drop.RecordSerial)
	end

	@ExecSpace("ServerOnly")
	method void ExpireRecord(integer serial)
		        local record = self:FindRecordBySerial(serial)
		        if record == nil or record.state ~= "AVAILABLE" then return end
		        if _UtilLogic.ServerElapsedSeconds + 0.01 < record.expireAt then return end
		        record.state = "EXPIRED"
		        self:RemoveRecordBySerial(serial, "EXPIRED")
	end

	@ExecSpace("ServerOnly")
	method void RemoveDrop(any drop, string reason)
		        if drop == nil then return end
		        self:RemoveRecordBySerial(drop.RecordSerial, reason)
	end

	@ExecSpace("ServerOnly")
	method void RemoveRecordBySerial(integer serial, string reason)
		        local removed = nil
		        local retained = {}
		        for i = 1, #self.activeDrops do
		            local record = self.activeDrops[i]
		            if record.serial == serial then removed = record
		            else retained[#retained + 1] = record end
		        end
		        if removed == nil then return end
		        self.activeDrops = retained
		        if removed.expiryTimer ~= nil and removed.expiryTimer ~= 0 then
		            _TimerService:ClearTimer(removed.expiryTimer)
		            removed.expiryTimer = 0
		        end
		        local drop = removed.drop
		        if drop ~= nil then drop:PrepareRemove(reason) end
		        if isvalid(removed.entity) then removed.entity:Destroy() end
		        removed.entity = nil
		        removed.drop = nil
		        log("[SkillDropRecord] REMOVE serial=" .. tostring(serial) .. " reason=" .. reason
		            .. " map=" .. tostring(removed.mapId))
	end

	@ExecSpace("ServerOnly")
	method void RemoveOldestForMapId(string mapId, integer allowedBeforeSpawn)
		        local onMap = {}
		        for i = 1, #self.activeDrops do
		            local record = self.activeDrops[i]
		            if record.mapId == mapId and record.state == "AVAILABLE" then onMap[#onMap + 1] = record end
		        end
		        table.sort(onMap, function(a, b) return a.serial < b.serial end)
		        while #onMap > allowedBeforeSpawn do
		            self:RemoveRecordBySerial(onMap[1].serial, "MAP_CAP_OLDEST")
		            table.remove(onMap, 1)
		        end
	end

	@ExecSpace("ServerOnly")
	method void PruneInvalid()
		        local now = _UtilLogic.ServerElapsedSeconds
		        local remove = {}
		        for i = 1, #self.activeDrops do
		            local record = self.activeDrops[i]
		            if record.state ~= "AVAILABLE" or record.expireAt <= now
		                or record.runId ~= self:CurrentRunId() then
		                remove[#remove + 1] = record.serial
		            elseif isvalid(record.entity) == false then
		                -- 맵 unload는 Record 삭제 사유가 아니다. 시각 참조만 정리한다.
		                record.entity = nil
		                record.drop = nil
		            end
		        end
		        for i = 1, #remove do self:RemoveRecordBySerial(remove[i], "PRUNE") end
	end

	@ExecSpace("ServerOnly")
	method void SuspendMapEntities(Entity mapEntity, string reason)
		        if isvalid(mapEntity) == false then return end
		        local count = 0
		        for i = 1, #self.activeDrops do
		            local record = self.activeDrops[i]
		            if record.mapId == mapEntity.Name and record.state == "AVAILABLE" then
		                if record.drop ~= nil then record.drop:PrepareSuspend(reason) end
		                if isvalid(record.entity) then record.entity:Destroy() end
		                record.entity = nil
		                record.drop = nil
		                count += 1
		            end
		        end
		        if count > 0 then
		            log("[SkillDropRecord] SUSPEND map=" .. mapEntity.Name .. " count=" .. tostring(count)
		                .. " reason=" .. reason)
		        end
	end

	@ExecSpace("ServerOnly")
	method void RestoreMap(Entity mapEntity)
		        if _GameData.RogueRunActive == false or isvalid(mapEntity) == false then return end
		        self:PruneInvalid()
		        local restored = 0
		        for i = 1, #self.activeDrops do
		            local record = self.activeDrops[i]
		            if record.mapId == mapEntity.Name and record.state == "AVAILABLE"
		                and isvalid(record.entity) == false then
		                if self:MaterializeRecord(record, mapEntity) ~= nil then restored += 1 end
		            end
		        end
		        if restored > 0 then
		            log("[SkillDropRecord] RESTORE map=" .. mapEntity.Name .. " count=" .. tostring(restored))
		        end
	end

	@ExecSpace("ServerOnly")
	method void ClearAll(string reason)
		        local old = self.activeDrops
		        self.activeDrops = {}
		        self.firstSkillDropResolved = false
		        self.duplicateNoticeByUser = {}
		        for i = 1, #old do
		            local record = old[i]
		            if record.expiryTimer ~= nil and record.expiryTimer ~= 0 then
		                _TimerService:ClearTimer(record.expiryTimer)
		            end
		            if record.drop ~= nil then record.drop:PrepareRemove(reason) end
		            if isvalid(record.entity) then record.entity:Destroy() end
		        end
		        log("[SkillDrop] CLEAR_ALL reason=" .. reason .. " count=" .. tostring(#old)
		            .. " first_guarantee_reset=true")
	end

	@ExecSpace("ServerOnly")
	method void ClearMap(Entity mapEntity, string reason)
		        if isvalid(mapEntity) == false then return end
		        local remove = {}
		        for i = 1, #self.activeDrops do
		            local record = self.activeDrops[i]
		            if record.mapId == mapEntity.Name then remove[#remove + 1] = record.serial end
		        end
		        for i = 1, #remove do self:RemoveRecordBySerial(remove[i], reason) end
	end

	@ExecSpace("ServerOnly")
	method any DebugSpawn(string monsterId, number lifetime)
		        if Environment:IsMakerPlay() == false or _GameData.RogueRunActive == false then return nil end
		        local monster = _GameData:GetMonster(monsterId)
		        if monster == nil or monster.drop_skill_id == "" then return nil end
		        for i = 1, #_GameData.RogueParticipantIds do
		            local player = _UserService:GetUserEntityByUserId(_GameData.RogueParticipantIds[i])
		            if isvalid(player) then
		                local pos = player.TransformComponent.WorldPosition + Vector3(1.2, 0, 0)
		                return self:SpawnDrop(monsterId, monster.drop_skill_id, pos, player.CurrentMap, lifetime)
		            end
		        end
		        return nil
	end

	@ExecSpace("Server")
	method void DebugSpawnRequest(string monsterId, number lifetime, number offsetX)
		        if Environment:IsMakerPlay() == false or _GameData.RogueRunActive == false then return end
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if isvalid(player) == false or _GameData:IsRunParticipant(senderUserId) == false then return end
		        local monster = _GameData:GetMonster(monsterId)
		        if monster == nil or monster.drop_skill_id == "" then return end
		        local pos = player.TransformComponent.WorldPosition + Vector3(offsetX, 0, 0)
		        local drop = self:SpawnDrop(monsterId, monster.drop_skill_id, pos, player.CurrentMap, lifetime)
		        log("[QA_SKILL_DROP_FINAL] SPAWN_REQUEST user=" .. senderUserId
		            .. " monster=" .. monsterId .. " success=" .. tostring(drop ~= nil))
	end

	@ExecSpace("Server")
	method void DebugMoveRequest(string mapName, number x, number y, boolean suspendCurrent)
		        if Environment:IsMakerPlay() == false or _GameData.RogueRunActive == false then return end
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if isvalid(player) == false or _GameData:IsRunParticipant(senderUserId) == false then return end
		        if suspendCurrent and isvalid(player.CurrentMap) then
		            self:SuspendMapEntities(player.CurrentMap, "QA_MAP_UNLOAD")
		        end
		        _TeleportService:TeleportToMapPosition(player, Vector3(x, y, 0), mapName)
		        _TimerService:SetTimerOnce(function()
		            if isvalid(player) and isvalid(player.CurrentMap) then self:RestoreMap(player.CurrentMap) end
		        end, 0.5)
		        log("[QA_SKILL_DROP_FINAL] MOVE_REQUEST user=" .. senderUserId .. " map=" .. mapName
		            .. " suspend=" .. tostring(suspendCurrent))
	end

	@ExecSpace("Server")
	method void DebugDescribeRequest()
		        if Environment:IsMakerPlay() == false then return end
		        log("[QA_SKILL_DROP_FINAL] RECORDS " .. self:DebugDescribeRecords())
	end

	@ExecSpace("Server")
	method void DebugClearRecordsRequest()
		        if Environment:IsMakerPlay() == false then return end
		        self:ClearAll("QA_RESET")
	end

	@ExecSpace("Server")
	method void DebugRollRequest(string monsterId, boolean forceOwned, integer repeatedEligibleCount)
		        if Environment:IsMakerPlay() == false or _GameData.RogueRunActive == false then return end
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if isvalid(player) == false or isvalid(player.CurrentMap) == false then return end
		        local monster = _GameData:GetMonster(monsterId)
		        if monster == nil or monster.drop_skill_id == "" then return end
		        ---@type PlayerSkillSlots
		        local slots = player:GetComponent("script.PlayerSkillSlots")
		        if slots == nil then return end
		        local skillId = monster.drop_skill_id
		        local previous = slots.OwnedSkillPool[skillId]
		        if forceOwned then slots.OwnedSkillPool[skillId] = 1
		        else slots.OwnedSkillPool[skillId] = nil end
		        local eligible = {}
		        local count = math.max(1, repeatedEligibleCount)
		        for i = 1, count do eligible[#eligible + 1] = player end
		        local before = #self.activeDrops
		        local firstBefore = self.firstSkillDropResolved
		local spawned = self:TrySpawnFromKill(monsterId,
		    player.TransformComponent.WorldPosition + Vector3(1.2, 0, 0), player.CurrentMap, eligible)
		        if previous ~= nil then slots.OwnedSkillPool[skillId] = previous
		        elseif forceOwned then slots.OwnedSkillPool[skillId] = nil end
		        log("[QA_SKILL_DROP_RULE] monster=" .. monsterId .. " forceOwned=" .. tostring(forceOwned)
		            .. " repeatedEligible=" .. tostring(count) .. " spawned=" .. tostring(spawned)
		            .. " delta=" .. tostring(#self.activeDrops - before)
		            .. " firstBefore=" .. tostring(firstBefore)
		            .. " firstAfter=" .. tostring(self.firstSkillDropResolved))
	end

	@ExecSpace("Server")
	method void DebugClaimTwiceRequest()
		        if Environment:IsMakerPlay() == false or _GameData.RogueRunActive == false then return end
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if isvalid(player) == false then return end
		        local record = nil
		        for i = 1, #self.activeDrops do
		            local candidate = self.activeDrops[i]
		            if candidate.mapId == player.CurrentMap.Name and candidate.state == "AVAILABLE"
		                and candidate.drop ~= nil then record = candidate break end
		        end
		        if record == nil then log("[QA_SKILL_DROP_CLAIM] no_available_drop") return end
		        local drop = record.drop
		        local first = self:TryClaim(drop, player)
		        local second = self:TryClaim(drop, player)
		        log("[QA_SKILL_DROP_CLAIM] serial=" .. tostring(record.serial)
		            .. " first=" .. tostring(first) .. " second=" .. tostring(second)
		            .. " remainingRecord=" .. tostring(self:FindRecordBySerial(record.serial) ~= nil))
	end

	@ExecSpace("Server")
	method void DebugOwnerRejectRequest(string monsterId)
		        if Environment:IsMakerPlay() == false or _GameData.RogueRunActive == false then return end
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if isvalid(player) == false then return end
		        local monster = _GameData:GetMonster(monsterId)
		        if monster == nil or monster.drop_skill_id == "" then return end
		        ---@type PlayerSkillSlots
		        local slots = player:GetComponent("script.PlayerSkillSlots")
		        if slots == nil then return end
		        local skillId = monster.drop_skill_id
		        local previous = slots.OwnedSkillPool[skillId]
		        slots.OwnedSkillPool[skillId] = 1
		        local drop = self:SpawnDrop(monsterId, skillId,
		            player.TransformComponent.WorldPosition + Vector3(0.8, 0, 0), player.CurrentMap, 60)
		        local rejected = drop ~= nil and self:TryClaim(drop, player) == false
		        local remains = drop ~= nil and self:FindRecordBySerial(drop.RecordSerial) ~= nil
		        if previous ~= nil then slots.OwnedSkillPool[skillId] = previous
		        else slots.OwnedSkillPool[skillId] = nil end
		        log("[QA_SKILL_DROP_OWNER] monster=" .. monsterId .. " rejected=" .. tostring(rejected)
		            .. " remains=" .. tostring(remains))
	end

	@ExecSpace("ServerOnly")
	method string DebugDescribeRecords()
		        local rows = {}
		        for i = 1, #self.activeDrops do
		            local r = self.activeDrops[i]
		            rows[#rows + 1] = tostring(r.serial) .. "~" .. r.mapId .. "~" .. r.skillId
		                .. "~" .. r.state .. "~" .. tostring(math.max(0, r.expireAt - _UtilLogic.ServerElapsedSeconds))
		                .. "~" .. tostring(isvalid(r.entity))
		        end
		        return "first=" .. tostring(self.firstSkillDropResolved) .. ";" .. table.concat(rows, "|")
	end

end
