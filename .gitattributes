# 메이플스토리 월드 에디터가 파일을 직접 쓰므로 깃의 줄바꿈 자동 변환을 끈다.
# (변환을 켜두면 에디터가 저장할 때마다 파일 전체가 변경된 것처럼 보여 diff가 무의미해진다)
* -text

# 바이너리 — diff 대상 아님
*.xlsx  binary
*.png   binary
*.jpg   binary
*.wav   binary
*.mp3   binary

# Maker writes map files as CRLF; existing committed maps use LF.
# Normalize map blobs in Git while retaining Maker's CRLF working files.
# Do not renormalize frozen audit baselines or the entire repository.
map/*.map text eol=crlf

# CRLF is a valid line ending, not trailing whitespace. Real trailing spaces
# and tabs remain checked. This does not change file bytes.
* whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
