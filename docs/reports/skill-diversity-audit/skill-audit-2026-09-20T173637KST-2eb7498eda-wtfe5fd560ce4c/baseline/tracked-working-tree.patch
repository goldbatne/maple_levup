+    method string PickRandomOwnedActive(table pool)
+        -- 복원 추출. 신규 랜덤 전투에서는 모든 보유 액티브 종이 정확히 Weight 1이다.
+        -- 보유 장수는 후보를 복제하지 않으며 슬롯 안 중복은 매 추첨의 독립 결과다.
+        if pool == nil or #pool <= 0 then return "" end
+        local total = 0
+        local scaled = {}
+        for i = 1, #pool do
+            local weight = self:GetSkillSupplyWeight(pool[i], self.SelectedTrait)
+            local units = math.max(1, math.floor(weight * 1000 + 0.5))
+            scaled[i] = units
+            total += units
+        end
+        local roll = _UtilLogic:RandomIntegerRange(1, total)
+        local cursor = 0
+        for i = 1, #pool do
+            cursor += scaled[i]
+            if roll <= cursor then return pool[i] end
+        end
+        return pool[#pool]
+    end
+
+    method string NormalizeTraitId(string traitId)
+        if traitId == nil or traitId == "" or _GameData:GetTrait(traitId) == nil then
+            return "balance"
+        end
+        return traitId
+    end
+
+    method boolean SkillMatchesTrait(string skillId, string traitId)
+        local trait = _GameData:GetTrait(self:NormalizeTraitId(traitId))
+        if trait == nil or trait.preferred_tags == nil or #trait.preferred_tags <= 0 then return false end
+        local tags = _GameData:GetSkillTags(skillId)
+        for i = 1, #tags do
+            for j = 1, #trait.preferred_tags do
+                if tags[i] == trait.preferred_tags[j] then return true end
+            end
+        end
+        return false
+    end
+
+    method number GetSkillSupplyWeight(string skillId, string traitId)
+        if self:IsPhase1CombatEnabled() then return 1 end
+        local trait = _GameData:GetTrait(self:NormalizeTraitId(traitId))
+        if trait == nil or self:SkillMatchesTrait(skillId, trait.id) == false then return 1 end
+        return math.max(0.01, trait.weight_multiplier)
+    end
+
+    method number GetTraitEffectMultiplierForSkill(string skillId)
+        -- Phase 3.5: 신규 전투에서 Trait는 완전 비활성이다. 기존 데이터와 호출부는
+        -- 세이브/레거시 호환을 위해 남기되 어떤 액티브에도 성능 배율을 주지 않는다.
+        if self:IsPhase1CombatEnabled() then return 1 end
+        if _GameData:IsCapturableMonsterSkill(skillId) == false then return 1 end
+        local trait = _GameData:GetTrait(self:NormalizeTraitId(self.SelectedTrait))
+        if trait == nil or self:SkillMatchesTrait(skillId, trait.id) == false then return 1 end
+        return math.max(1, trait.effect_multiplier)
+    end
+
+    method boolean CanChangeTrait()
+        -- 초기 구현의 안전 상태는 전투가 없는 시작 마을 하나로 명확히 한정한다.
+        local map = self.Entity.CurrentMap
+        local start = _GameData:GetStartRoom()
+        if map == nil or start == nil then return false end
+        return map.Name == start.map_name
+    end
+
+    @ExecSpace("Server")
+    method void RequestSetTrait(string traitId)
+        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
+        if self:IsPhase1CombatEnabled() then
+            log_warning("[Trait] 신규 랜덤 전투에서는 특성 선택을 사용하지 않는다")
+            return
+        end
+        self:SetTrait(traitId)
+    end
+
+    @ExecSpace("ServerOnly")
+    method boolean SetTrait(string traitId)
+        if self:IsPhase1CombatEnabled() then
+            log_warning("[Trait] 신규 랜덤 전투에서는 레거시 특성을 변경하지 않는다")
+            return false
+        end
+        local normalized = self:NormalizeTraitId(traitId)
+        if _GameData:GetTrait(traitId) == nil then
+            log_warning("[Trait] 존재하지 않는 특성: " .. tostring(traitId))
+            return false
+        end
+        if self:CanChangeTrait() == false then
+            log_warning("[Trait] 특성은 시작 마을에서만 바꿀 수 있다")
+            return false
+        end
+        if self.SelectedTrait == normalized then return true end
+        self.SelectedTrait = normalized
+        -- 현재 5칸은 그대로 둔다. 다음 5초 공급부터 새 가중치를 읽는다.
+        self:MarkSavePerm("특성 변경")
+        log("[Trait] 선택 " .. normalized .. " — 현재 손패 유지, 다음 공급부터 적용")
+        return true
+    end
+
+    method void DebugDescribeTraitWeights(string traitId)
+        -- Maker 콘솔에서 보유 풀의 태그·기본/최종 가중치·정규화 확률을 확인한다.
+        local pool = self:GetOwnedActiveSkillIds()
+        local total = 0
+        for i = 1, #pool do total += self:GetSkillSupplyWeight(pool[i], traitId) end
+        log("[TraitDebug] trait=" .. self:NormalizeTraitId(traitId)
+            .. " pool=" .. tostring(#pool) .. " totalWeight=" .. string.format("%.2f", total))
+        for i = 1, #pool do
+            local tags = _GameData:GetSkillTags(pool[i])
+            local weight = self:GetSkillSupplyWeight(pool[i], traitId)
+            local chance = total > 0 and weight / total * 100 or 0
+            log("[TraitDebug] " .. pool[i] .. " tags=" .. table.concat(tags, "|")
+                .. " base=1.00 final=" .. string.format("%.2f", weight)
+                .. " chance=" .. string.format("%.4f", chance) .. "%")
+        end
+    end
+
+    @ExecSpace("ServerOnly")
+    method table DebugSampleTrait(string traitId, integer iterations)
+        -- 실제 포획 경로가 있는 66종 전체를 대상으로 서버 RNG를 표본 추출한다.
+        -- 10,000회 검증이 한 프레임에서 끝나도록 누적 가중치는 한 번만 만든다.
+        local pool = _GameData:GetCapturableActiveSkillIds()
+        local counts = {}
+        if iterations < 1 then iterations = 10000 end
+
+        local cumulative = {}
+        local total = 0
+        for i = 1, #pool do
+            local units = math.max(1, math.floor(self:GetSkillSupplyWeight(pool[i], traitId) * 1000 + 0.5))
+            total += units
+            cumulative[i] = total
+        end
+        for i = 1, iterations do
+            local roll = _UtilLogic:RandomIntegerRange(1, total)
+            local index = 1
+            while index < #pool and roll > cumulative[index] do index += 1 end
+            local id = pool[index]
+            counts[id] = (counts[id] or 0) + 1
+        end
+        log("[TraitSample] " .. self:NormalizeTraitId(traitId) .. " "
+            .. tostring(iterations) .. "회 / 후보 " .. tostring(#pool) .. "종")
+        return counts
+    end
+
+    @ExecSpace("ServerOnly")
+    method void DebugStartTraitSample(string traitId, integer iterations)
+        -- Maker 실행 스크립트의 한 프레임 예산을 넘지 않도록 500회씩 나눠 집계한다.
+        local normalized = self:NormalizeTraitId(traitId)
+        local pool = _GameData:GetCapturableActiveSkillIds()
+        if iterations < 1 then iterations = 10000 end
+
+        local tickets = {}
+        for i = 1, #pool do
+            local ticketCount = math.max(1, math.floor(self:GetSkillSupplyWeight(pool[i], normalized) * 10 + 0.5))
+            for k = 1, ticketCount do tickets[#tickets + 1] = pool[i] end
+        end
+
+        local counts = {}
+        local remaining = iterations
+        local timer = 0
+        timer = _TimerService:SetTimerRepeat(function()
+            local batch = math.min(500, remaining)
+            for i = 1, batch do
+                local index = _UtilLogic:RandomIntegerRange(1, #tickets)
+                local id = tickets[index]
+                counts[id] = (counts[id] or 0) + 1
+            end
+            remaining -= batch
+            if remaining <= 0 then
+                _TimerService:ClearTimer(timer)
+                local minCount = iterations + 1
+                local maxCount = 0
+                local zero = 0
+                local preferred = 0
+                for i = 1, #pool do
+                    local n = counts[pool[i]] or 0
+                    if n <= 0 then zero += 1 end
+                    if n < minCount then minCount = n end
+                    if n > maxCount then maxCount = n end
+                    if self:SkillMatchesTrait(pool[i], normalized) then preferred += n end
+                end
+                log("[TraitSampleDone] trait=" .. normalized
+                    .. " total=" .. tostring(iterations)
+                    .. " candidates=" .. tostring(#pool)
+                    .. " preferred=" .. tostring(preferred)
+                    .. " min=" .. tostring(minCount)
+                    .. " max=" .. tostring(maxCount)
+                    .. " zero=" .. tostring(zero))
+            end
+        end, 0.05)
+    end
