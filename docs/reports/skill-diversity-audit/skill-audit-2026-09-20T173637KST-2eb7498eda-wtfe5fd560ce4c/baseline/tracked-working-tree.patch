+            self.RandomModeActive = false
+            log("[SkillSlots] 랜덤 전투 대기  보유 액티브 0종")
+            return
+        end
+
+        self.RandomModeActive = true
+        self:StartRandomSkillSupply()
+        log("[SkillSlots] 일회성 스킬 재고 시작  보유 액티브 " .. tostring(#pool)
+            .. "종 / 초기 재고 0개")
+    end
