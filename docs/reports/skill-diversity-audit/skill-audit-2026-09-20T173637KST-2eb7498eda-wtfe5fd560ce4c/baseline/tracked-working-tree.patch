+    @ExecSpace("ServerOnly")
+    method void StartRandomSkillSupply()
+        -- 한 번짜리 서버 타이머다. 빈칸 하나를 채운 뒤에도 빈칸이 남으면 다음 5초를
+        -- 다시 예약한다. 가득 찬 동안에는 타이머 자체가 없고, 소비 순간부터 새로 센다.
+        self:StopRandomSkillSupply()
+        if self:IsPhase1CombatEnabled() == false then return end
+        if self.RandomModeActive == false then return end
+        if self:HasEmptyRandomSlot() == false then return end
+        if #self:GetOwnedActiveSkillIds() <= 0 then return end
+
+        local interval = _GameData:GetBalance("random_skill_supply_interval")
+        if interval <= 0 then interval = 5 end
+        self.randomSupplyTimer = _TimerService:SetTimerOnce(function()
+            self.randomSupplyTimer = 0
+            self:SupplyOneRandomSkill()
+            self:StartRandomSkillSupply()
+        end, interval)
+    end
+
+    @ExecSpace("ServerOnly")
+    method boolean SupplyOneRandomSkill()
+        -- 전체 OwnedSkills 액티브 풀에서 복원 추출해 앞쪽 빈칸 하나만 채운다.
+        if self:IsPhase1CombatEnabled() == false then return false end
+        if self.RandomModeActive == false then return false end
+
+        local pool = self:GetOwnedActiveSkillIds()
+        if #pool <= 0 then return false end
+
+        for i = 1, self:GetSkillSlotMax() do
+            if self.RandomSlots[i] == nil or self.RandomSlots[i] == "" then
+                local id = self:PickRandomOwnedActive(pool)
+                if id ~= "" then
+                    self.RandomSlots[i] = id
+                    log("[SkillSlots] 랜덤 공급  " .. tostring(i) .. "번 ← " .. id)
+                    return true
+                end
+                return false
+            end
+        end
+        return false
+    end
