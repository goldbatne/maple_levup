+    method void OnOwnedSkillPoolChanged()
+        -- 포획은 추첨 풀만 넓힌다. 이미 생성된 재고는 다시 뽑거나 밀어내지 않는다.
+        -- 첫 액티브를 얻었을 때만 빈 재고의 첫 5초 타이머를 시작한다.
+        if self:IsPhase1CombatEnabled() == false then return end
+        local pool = self:GetOwnedActiveSkillIds()
+        if #pool <= 0 then
+            self.RandomModeActive = false
+            self:StopRandomSkillSupply()
+            self:ClearRandomSlots()
+            return
+        end
+
+        if self.RandomModeActive == false then
+            self.RandomModeActive = true
+            self:StartRandomSkillSupply()
+            log("[SkillSlots] 첫 액티브 획득 — 5초 공급 시작")
